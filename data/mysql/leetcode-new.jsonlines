{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 543, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player_id, player_name, count(*) grand_slams_count from players p join ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) c on p.player_id = c.player_id group by c.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 544, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with record as (select year, wimbledon game from championships union all select year, fr_open game from championships union all select year, us_open game from championships union all select year, au_open game from championships) select game player_id,player_name, count(*) grand_slams_count from record inner join players on game=player_id group by game"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 545, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(case when p.player_id = wimbledon then 1 else 0 end)+sum(case when p.player_id = fr_open then 1 else 0 end)+sum(case when p.player_id = us_open then 1 else 0 end)+ sum(case when p.player_id = au_open then 1 else 0 end) as grand_slams_count from championships c, players p group by player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 546, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as grand_slam_player from championships union all select fr_open as grand_slams from championships union all select us_open as grand_slams from championships union all select au_open as grand_slams from championships) select cte.grand_slam_player as player_id, player_name, count(grand_slam_player) as grand_slams_count from cte inner join players p on cte.grand_slam_player = p.player_id group by cte.grand_slam_player, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 547, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, b.player_name, count(a.gs) as grand_slams_count from ( select wimbledon as gs from championships union all select fr_open as gs from championships union all select us_open as gs from championships union all select au_open as gs from championships ) a left join players b on a.gs = b.player_id group by b.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 548, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as (select a.player_id,sum(a.total) as total from(select wimbledon as player_id, count(*) as total from championships group by 1 union all select fr_open as player_id, count(*) as total from championships group by 1 union all select us_open as player_id, count(*) as total from championships group by 1 union all select au_open as player_id, count(*) as total from championships group by 1) a group by 1) select t1.player_id,p.player_name,t1.total as grand_slams_count from t1 join players p on t1.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 549, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, count(1) as grand_slams_count from (select player_id, player_name from players p join championships c on p.player_id = c.wimbledon union all select player_id, player_name from players p join championships c on p.player_id = c.fr_open union all select player_id, player_name from players p join championships c on p.player_id = c.us_open union all select player_id, player_name from players p join championships c on p.player_id = c.au_open) t group by 1, 2"]}
