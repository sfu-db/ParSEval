{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 317, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_wins as ( select year, wimbledon as winner from championships c union all select year, fr_open as winner from championships c union all select year, us_open as winner from championships c union all select year, au_open as winner from championships c ) select a.winner as player_id, p.player_name, count(a.winner) as grand_slams_count from all_wins a left join players p on p.player_id = a.winner group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 318, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with base as ( select year, 'wimbledon' as game, wimbledon as winner from championships union all select year, 'fr_open' as game, fr_open as winner from championships union all select year, 'us_open' as game, us_open as winner from championships union all select year, 'au_open' as game, au_open as winner from championships ), base2 as ( select winner, count(1) as grand_slams_count from base group by 1 ) select p.player_id, p.player_name, b.grand_slams_count from base2 b inner join players p on b.winner = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 319, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with base as ( select year, wimbledon as matches from championships union all select year, fr_open as matches from championships union all select year, us_open as matches from championships union all select year, au_open as matches from championships) select distinct matches as player_id, player_name, count(*) as grand_slams_count from base left join players on base.matches = players.player_id group by 1"]}
