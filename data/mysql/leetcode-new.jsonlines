{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 515, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with t as ( select reports_to, count(reports_to) as reports_count, round(avg(age), 0) as average_age from employees where reports_to is not null group by reports_to ) select employee_id, name, reports_count, average_age from employees e join t on e.employee_id = t.reports_to order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 516, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id,m.name,count(*) as reports_count, round(avg(e.age),0) as average_age from employees e join employees m on e.reports_to = m.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 517, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id, b.name, count(distinct a.employee_id) as reports_count, round(avg(a.age),0) as average_age from employees a join employees b on a.reports_to = b.employee_id group by a.reports_to order by a.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 518, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id, m.name, count(e.employee_id) as reports_count, round(avg(e.age)) as average_age from employees e join employees m on e.reports_to = m.employee_id group by m.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 519, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select managers.employee_id, managers.name , count(*) as reports_count, round(avg(e.age),0) as average_age from employees managers left join employees e on managers.employee_id=e.reports_to where e.name is not null group by managers.employee_id order by managers.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 520, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.employee_id) reports_count, round(avg(e2.age)) average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by 1,2 order by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 521, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select distinct a.employee_id, a.name, count(*) as reports_count, round(avg(b.age),0)as average_age from employees as a left join employees as b on a.employee_id=b.reports_to group by a.employee_id having count(b.name)>=1 order by a.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 522, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id, e.name, t1.reports_count, t1.avg_age average_age from ( select reports_to, count(reports_to) reports_count, round(avg(age),0) avg_age from employees group by reports_to having reports_to is not null ) t1 left join employees e on e.employee_id = t1.reports_to order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 523, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id as employee_id, e1.name as name, count(e2.reports_to) as reports_count, round(avg(e2.age)) as average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by 1 order by 1"]}
