{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 597, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select all_wins from ( select c1.wimbledon as all_wins from championships as c1 union all select c2.fr_open from championships as c2 union all select c3.us_open from championships as c3 union all select c4.au_open from championships as c4) as new_table) select p.player_id,p.player_name, count(temp.all_wins) as grand_slams_count from temp left join players as p on temp.all_wins = p.player_id group by temp.all_wins"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 598, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (select sum(case when wimbledon = p.player_id then 1 else 0 end) + sum(case when fr_open = p.player_id then 1 else 0 end) + sum(case when us_open = p.player_id then 1 else 0 end) + sum(case when au_open = p.player_id then 1 else 0 end) from championships c ) as grand_slams_count from players p group by 1,2 having grand_slams_count>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 599, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, grand_slams_count from (select g.player_id, count(*) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) as g group by g.player_id) as temp join players p on p.player_id = temp.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 600, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id,p.player_name, sum(games) as grand_slams_count from ( select year,wimbledon as player, count(1) as games from championships group by year,wimbledon union all select year,fr_open as player, count(1) as games from championships group by year,fr_open union all select year,us_open as player, count(1) as games from championships group by year,us_open union all select year,au_open as player, count(1) as games from championships group by year,au_open )a inner join players p on a.player = p.player_id group by p.player_id,p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 601, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select wimbledon as uid from championships union all select fr_open as uid from championships union all select us_open as uid from championships union all select au_open as uid from championships ) select uid as player_id, player_name, count(*) as grand_slams_count from t join players as p on t.uid = p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 602, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(case when p.player_id = c.wimbledon then 1 else 0 end) + sum(case when p.player_id = c.fr_open then 1 else 0 end) + sum(case when p.player_id = c.us_open then 1 else 0 end) + sum(case when p.player_id = c.au_open then 1 else 0 end) as grand_slams_count from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 603, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select distinct p.player_id, p.player_name, sum(c.wimbledon=p.player_id)+sum(c.fr_open=p.player_id)+sum(c.us_open=p.player_id)+sum(c.au_open=p.player_id) as grand_slams_count from players p join championships c on c.wimbledon=p.player_id or c.fr_open=p.player_id or c.us_open=p.player_id or c.au_open=p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 604, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(player_id = c.wimbledon) + sum(player_id = c.fr_open) + sum(player_id = c.us_open) + sum(player_id = c.au_open) grand_slams_count from players p left join championships c on c.wimbledon = p.player_id or c.fr_open = p.player_id or c.us_open = p.player_id or c.au_open = p.player_id group by p.player_id, p.player_name having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 605, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimbledon as ( select player_id, player_name, count(year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.wimbledon group by player_id, player_name ), fr_open as (select player_id, player_name, count(year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.fr_open group by player_id, player_name ), us_open as (select player_id, player_name, count(year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.us_open group by player_id, player_name ), au_open as (select player_id, player_name, count(year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.au_open group by player_id, player_name ), cte as (select * from wimbledon union all select * from fr_open union all select * from us_open union all select * from au_open ) select player_id, player_name, sum(grand_slams_count) as grand_slams_count from cte group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 606, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with base as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select b.player_id,p.player_name as player_name,count(b.player_id) as grand_slams_count from base b join players p on p.player_id = b.player_id group by b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 607, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) select p.player_id, p.player_name, t.grand_slams_count from players p join (select player_id, count(*) as grand_slams_count from temp group by player_id) t on p.player_id = t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 608, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(if(wimbledon=player_id, 1, 0)) + sum(if(fr_open=player_id, 1, 0)) + sum(if(us_open=player_id, 1, 0)) + sum(if(au_open=player_id, 1, 0)) as grand_slams_count from players, championships group by player_id having grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 609, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as (select pid,count(pid) as grand_slams_count from ( select wimbledon as pid from championships union all select fr_open as pid from championships union all select us_open as pid from championships union all select au_open as pid from championships ) a group by pid) select player_id, player_name, grand_slams_count from players p join c on player_id = c.pid"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 610, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, sum( case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end ) as grand_slams_count from players cross join championships group by player_id) t where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 611, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( (select wimbledon player_id from championships) union all (select fr_open from championships) union all (select us_open from championships) union all (select au_open from championships) ) select cte.player_id as player_id, p.player_name as player_name, count(*) as grand_slams_count from cte join players p on p.player_id=cte.player_id group by cte.player_id order by cte.player_id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 612, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select wimbledon as title from championships union all select fr_open as title from championships union all select us_open as title from championships union all select au_open as title from championships ) select p.player_id, p.player_name, count(*) as grand_slams_count from players as p join t on p.player_id = t.title group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 613, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select t1.player_id, player_name, count(*) as grand_slams_count from wins t1 inner join players t2 on t1.player_id = t2.player_id group by t1.player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 614, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id,player_name , count(player_id) as grand_slams_count from (select player_id,player_name from players p join championships c on p.player_id=c.wimbledon union all select player_id,player_name from players p join championships c on p.player_id=c.fr_open union all select player_id,player_name from players p join championships c on p.player_id=c.us_open union all select player_id,player_name from players p join championships c on p.player_id=c.au_open) t group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 615, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimbledon_counts as ( select wimbledon as player_id, count(year) as count_wins from championships group by wimbledon ), fropen_counts as ( select fr_open as player_id, count(year) as count_wins from championships group by fr_open ), usopen_counts as ( select us_open as player_id, count(year) as count_wins from championships group by us_open ), au_open as ( select au_open as player_id, count(year) as count_wins from championships group by au_open ), union_wins as ( select player_id, sum(count_wins) as grand_slams_count from ( select * from wimbledon_counts union all select * from fropen_counts union all select * from usopen_counts union all select * from au_open ) t1 group by player_id ) select a.player_id, a.player_name, grand_slams_count from players a left join union_wins b on a.player_id=b.player_id where grand_slams_count is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 616, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select p.player_id,p.player_name,count(*) grand_slams_count from cte c join players p on p.player_id=c.id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 617, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as play, count(*) as num from championships group by wimbledon union all select fr_open as play, count(*) as num from championships group by fr_open union all select us_open as play, count(*) as num from championships group by us_open union all select au_open as play, count(*) as num from championships group by au_open) select cte.play as player_id, players.player_name, sum(cte.num) as grand_slams_count from cte left join players on cte.play = players.player_id group by cte.play"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 618, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select year, wimbledon as player from championships union all select year, fr_open as player from championships union all select year, us_open as player from championships union all select year, au_open as player from championships ) select distinct player as player_id, player_name, count(player) grand_slams_count from cte join players on player=player_id group by player_id,player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 619, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_titles (player_id) as (select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select all_titles.player_id, player_name, count(all_titles.player_id) grand_slams_count from all_titles left join players on all_titles.player_id = players.player_id group by all_titles.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 620, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as(select wimbledon as champions from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select player_id, player_name, count(*) as grand_slams_count from cte1 join players p on p.player_id = cte1.champions group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 621, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, p.player_name,sum(slams_count) as grand_slams_count from ( select count(1) as slams_count, wimbledon as player_id from championships group by wimbledon union all select count(1) as slams_count, fr_open as player_id from championships group by fr_open union all select count(1) as slams_count, us_open as player_id from championships group by us_open union all select count(1) as slams_count, au_open as player_id from championships group by au_open ) a left outer join players p on a.player_id=p.player_id group by a.player_id"]}
