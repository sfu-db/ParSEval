{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 809, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(player_id = wimbledon) + sum(player_id = fr_open) + sum(player_id = us_open) + sum(player_id = au_open) as grand_slams_count from players as p join championships as c on player_id = wimbledon or player_id = fr_open or player_id = us_open or player_id = au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 810, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as (select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships) select w.player_id,p.player_name,count(year) as grand_slams_count from wins w join players p on w.player_id=p.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 811, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tbl as ( select pw.player_id, pw.player_name from players pw right outer join championships c on pw.player_id = c.wimbledon union all select player_id, player_name from players p right outer join championships c on p.player_id = c.fr_open union all select player_id, player_name from players p right outer join championships c on p.player_id = c.us_open union all select player_id, player_name from players p right outer join championships c on p.player_id = c.au_open ) select player_id, player_name, count(*) as grand_slams_count from tbl group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 812, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(num) as grand_slams_count from players as p, (select p.player_id, count(c.wimbledon) as num from championships as c, players as p where p.player_id = c.wimbledon group by p.player_id union all select p.player_id, count(c.fr_open) from championships as c, players as p where p.player_id = c.fr_open group by p.player_id union all select p.player_id, count(c.us_open) from championships as c, players as p where p.player_id = c.us_open group by p.player_id union all select p.player_id, count(c.au_open) from championships as c, players as p where p.player_id = c.au_open group by p.player_id) as a where p.player_id = a.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 813, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id,player_name, sum(player_id=wimbledon)+sum(player_id=fr_open)+sum(player_id=us_open)+sum(player_id=au_open) as grand_slams_count from championships left join players on wimbledon=player_id or fr_open =player_id or us_open=player_id or au_open=player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 814, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select player_id, player_name, count(*) grand_slams_count from cte left join players using(player_id) group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 815, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, coalesce(c1, 0) + coalesce(c2, 0) + coalesce(c3, 0) + coalesce(c4, 0) as grand_slams_count from players p left join (select wimbledon as id, count(*) as c1 from championships group by wimbledon) w on p.player_id = w.id left join (select fr_open as id, count(*) as c2 from championships group by fr_open) f on p.player_id = f.id left join (select us_open as id, count(*) as c3 from championships group by us_open) u on p.player_id = u.id left join (select au_open as id, count(*) as c4 from championships group by au_open) a on p.player_id = a.id where coalesce(c1, 0) + coalesce(c2, 0) + coalesce(c3, 0) + coalesce(c4, 0) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 816, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id,p.player_name, sum(p.player_id=c.wimbledon)+sum(p.player_id=c.fr_open)+sum(p.player_id=c.us_open)+sum(p.player_id=c.au_open) as grand_slams_count from players p inner join championships c on p.player_id=c.wimbledon or p.player_id=c.fr_open or p.player_id=c.us_open or p.player_id=c.au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 817, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select player_id,player_name,count(*) grand_slams_count from cte c join players p on c.id=p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 818, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, coalesce((select sum(case when wimbledon = player_id then 1 else 0 end) + sum(case when fr_open = player_id then 1 else 0 end) + sum(case when us_open = player_id then 1 else 0 end) + sum(case when au_open = player_id then 1 else 0 end) from championships),0) as grand_slams_count from players having grand_slams_count >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 819, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(wimbledon=player_id)+sum(fr_open=player_id)+sum(us_open=player_id)+sum(au_open=player_id) as grand_slams_count from players left join championships on player_id in (wimbledon, fr_open, us_open, au_open) group by player_id having grand_slams_count is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 820, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as ( select year, wimbledon player_id from championships union all select year, fr_open player_id from championships union all select year, us_open player_id from championships union all select year, au_open player_id from championships ), wins_player as ( select player_id, count(player_id) grand_slams_count from wins group by 1 ) select t0.player_id, t0.player_name, t1.grand_slams_count from players t0 join wins_player t1 using (player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 821, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with allchampionships as (select wimbledon as grand_slam_winner from championships union all select fr_open as grand_slam_winner from championships union all select us_open as grand_slam_winner from championships union all select au_open as grand_slam_winner from championships) select p.player_id,p.player_name,count(grand_slam_winner) as grand_slams_count from allchampionships a,players p where a.grand_slam_winner = p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 822, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wi as ( select wimbledon as player_id, count(*) times from championships group by player_id ), fr as ( select fr_open as player_id, count(*) times from championships group by player_id ), us as ( select us_open as player_id, count(*) times from championships group by player_id ), au as ( select au_open as player_id, count(*) times from championships group by player_id ) select players.player_id, players.player_name, ifnull(wi.times,0) + ifnull(fr.times,0) + ifnull(us.times,0) + ifnull(au.times,0) as grand_slams_count from players left join wi on players.player_id = wi.player_id left join fr on players.player_id = fr.player_id left join us on players.player_id = us.player_id left join au on players.player_id = au.player_id having grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 823, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champ as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select p.player_id, p.player_name, count(c.id) as grand_slams_count from players as p join champ c on p.player_id = c.id group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 824, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select result.player_id, player_name, grand_slams_count from (select slam as player_id, sum(counto) as grand_slams_count from (select wimbledon as slam, count(wimbledon) as counto from championships group by wimbledon union all select fr_open as slam, count(fr_open) as counto from championships group by fr_open union all select us_open as slam, count(us_open) as counto from championships group by us_open union all select au_open as slam, count(au_open) as counto from championships group by au_open) agg group by slam) result left join players on players.player_id = result.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 825, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select temp2.player_id, p.player_name, temp2.cnt as grand_slams_count from (select player_id, count(player_id) cnt from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) temp group by player_id ) temp2 left join players p on temp2.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 826, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(player_id = wimbledon) + sum(player_id = fr_open) + sum(player_id = us_open) + sum(player_id = au_open) ) as grand_slams_count from players p join championships c on p.player_id in (wimbledon, fr_open, us_open, au_open) group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 827, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_champ as (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships), champ_count as (select player_id, count(*) as grand_slams_count from all_champ group by player_id) select p.player_id, player_name, grand_slams_count from players p join champ_count on p.player_id = champ_count.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 828, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, new_table.grand_slams_count from players as p inner join (select player,count(*) as grand_slams_count from (select wimbledon as player from championships union all select fr_open as player from championships union all select us_open as player from championships union all select au_open as player from championships) as temp group by player) as new_table on p.player_id=new_table.player group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 829, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as( select year, wimbledon as name from championships union all select year, fr_open as name from championships union all select year, us_open as name from championships union all select year, au_open as name from championships ) select p.player_id, p.player_name,count(*) as grand_slams_count from t1 left join players p on p.player_id = t1.name group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 830, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select p.player_id, p.player_name, (case when p.player_id=c.wimbledon then 1 else 0 end + case when p.player_id=c.fr_open then 1 else 0 end + case when p.player_id=c.us_open then 1 else 0 end + case when p.player_id=c.au_open then 1 else 0 end) wins from players p cross join championships c) select player_id, player_name, sum(wins) grand_slams_count from cte group by player_id having sum(wins)>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 831, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(grand_slams_count) grand_slams_count from (select p.player_id, p.player_name, (case when c.wimbledon = p.player_id then 1 else 0 end) + (case when c.fr_open = p.player_id then 1 else 0 end) + (case when c.us_open = p.player_id then 1 else 0 end) + (case when c.au_open = p.player_id then 1 else 0 end) grand_slams_count from players p join championships c on p.player_id = c.wimbledon or c.fr_open = p.player_id or c.us_open = p.player_id or c.au_open = p.player_id ) s group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 832, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champions as ( select wimbledon as champion from championships c union all select fr_open as champion from championships c union all select us_open as champion from championships c union all select au_open as champion from championships c ) select p.player_id, p.player_name, count(c.champion) as grand_slams_count from players p inner join champions c on c.champion = p.player_id group by 1, 2 having count(c.champion) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 833, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(c1) + sum(c2) + sum(c3) + sum(c4) as grand_slams_count from ( select player_id, player_name, case when wimbledon = player_id then 1 else 0 end as c1, case when fr_open = player_id then 1 else 0 end as c2,case when us_open = player_id then 1 else 0 end as c3,case when au_open = player_id then 1 else 0 end as c4 from players, championships ) p group by player_id,player_name having sum(c1) + sum(c2) + sum(c3) + sum(c4) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 834, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with abc as( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select abc.id as player_id, p.player_name, count(abc.id) as grand_slams_count from abc join players p on abc.id=p.player_id group by abc.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 835, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id, year from championships union all select fr_open as id, year from championships union all select us_open as id, year from championships union all select au_open as id, year from championships ) select cte.id as player_id , p.player_name, count(cte.id) as grand_slams_count from cte left join players p on cte.id = player_id group by cte.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 836, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select c. player_id, p. player_name, count(c. player_id) as grand_slams_count from cte c inner join players p on c. player_id =p. player_id group by c. player_id, p. player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 837, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t.player as player_id, players.player_name,sum(win_number) as grand_slams_count from (select wimbledon as player, count(wimbledon) as win_number from championships group by wimbledon union all select fr_open as player, count(fr_open) as win_number from championships group by fr_open union all select us_open as player, count(us_open) as win_number from championships group by us_open union all select au_open as player, count(au_open) as win_number from championships group by au_open) as t left join players on t.player=players.player_id group by t.player order by sum(win_number)"]}
