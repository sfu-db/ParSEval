{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 73, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from sales s left join product p on s.product_id=p.product_id group by s.buyer_id having sum(p.product_name = 's8')>0 and sum(p.product_name ='iphone')=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 74, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from sales as s inner join product as p on s.product_id = p.product_id group by s.buyer_id having sum(case when p.product_name = 's8' then 1 else 0 end) > 0 and sum(case when p.product_name = 'iphone' then 1 else 0 end) = 0"]}
