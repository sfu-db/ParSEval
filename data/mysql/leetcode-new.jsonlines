{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 118, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "select name, (case when sum(rest) is null then 0 else sum(rest) end) as rest, (case when sum(paid) is null then 0 else sum(paid) end) as paid, (case when sum(canceled) is null then 0 else sum(canceled) end) as canceled, (case when sum(refunded) is null then 0 else sum(refunded) end) as refunded from invoice i right join product p on p.product_id = i.product_id group by name order by name"]}
