{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 584, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when (operator = '>' and t1.value > t2.value) or (operator = '=' and t1.value = t2.value) or (operator = '<' and t1.value < t2.value) then true else false end as value from expressions e join variables t1 on e.left_operand = t1.name join variables t2 on e.right_operand = t2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 585, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case (case operator when '>' then l.value>r.value when '<' then l.value<r.value else l.value=r.value end) when 0 then false else true end as value from expressions e join variables l on e.left_operand=l.name join variables r on e.right_operand=r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 586, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t1 as (select left_operand, operator, right_operand, v.name as v1, v.value as v1v from expressions left join variables v on left_operand=name), t2 as( select left_operand, operator, right_operand, v1, v1v, v.name as v2, v.value as v2v from t1 left join variables v on v.name=right_operand ) select left_operand, operator, right_operand, case when operator='=' and v1v=v2v then true when operator='>' and v1v>v2v then true when operator='<' and v1v<v2v then true else false end as value from t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 587, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand , operator , right_operand, case when operator ='>' and l.value > r.value then true when operator ='>' and l.value <= r.value then false when operator ='<' and l.value >= r.value then false when operator ='<' and l.value < r.value then true when operator ='=' and l.value=r.value then true when operator ='=' and l.value!=r.value then false end as value from expressions e left join variables l on e.left_operand = l.name left join variables r on e.right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 588, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as ( select v.value as left_, e.left_operand, e.operator, row_number()over() as rn from variables as v inner join expressions e on v.name = e.left_operand ), cte1 as ( select v.value as right_, e.right_operand, row_number()over() as rn from variables as v inner join expressions e on v.name = e.right_operand ) select cte.left_operand, cte.operator, cte1.right_operand, case when cte.operator = '=' then case when cte.left_ = cte1.right_ then true else false end when cte.operator = '>' then case when cte.left_ > cte1.right_ then true else false end when cte.operator = '<' then case when cte.left_ < cte1.right_ then true else false end end as value from cte inner join cte1 on cte.rn = cte1.rn"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 589, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator , right_operand ,case when a.value>b.value and operator='>' then true when a.value<b.value and operator='<' then true when a.value=b.value and operator='=' then true else false end as value from expressions e join variables a on left_operand=a.name join variables b on right_operand=b.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 590, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = '>' then if(v1.value > v2.value, 'true','false') when operator = '<' then if (v1.value < v2.value, 'true','false') when operator = '=' then if (v1.value = v2.value, 'true','false') end) as value from expressions e left join variables v1 on v1.name = e.left_operand left join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 591, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as ( select t0.value as left_value, t2.value as right_value, t1.* from expressions t1 join variables t0 on t0.name = t1.left_operand join variables t2 on t2.name = t1.right_operand ) select left_operand, operator, right_operand, case when operator = '>' and left_value > right_value then true when operator = '<' and left_value < right_value then true when operator = '=' and left_value = right_value then true else false end as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 592, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand,e.operator,e.right_operand, case when operator = '>' and (select value from variables where name = e.left_operand) > (select value from variables where name = e.right_operand) then true when operator = '<' and (select value from variables where name = e.left_operand) < (select value from variables where name = e.right_operand) then true when operator = '=' and (select value from variables where name = e.left_operand) = (select value from variables where name = e.right_operand) then true else false end as value from expressions e"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 593, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when a.operator = '<' and b.value < c.value then true when a.operator = '=' and b.value = c.value then true when a.operator = '>' and b.value > c.value then true else false end as value from expressions as a left join variables as b on a.left_operand = b.name left join variables as c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 594, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.*, case when a.operator = '<' and b.value < c.value then true when a.operator = '=' and b.value = c.value then true when a.operator = '>' and b.value > c.value then true else false end as value from expressions a join variables b on a.left_operand = b.name join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 595, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when v1.value > v2.value and operator = '>' then true when v1.value < v2.value and operator = '<' then true when v1.value = v2.value and operator = '=' then true else false end) as value from variables v1 join expressions e on v1.name = e.left_operand join variables v2 on e.right_operand = v2.name"]}
