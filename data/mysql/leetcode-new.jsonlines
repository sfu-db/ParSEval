{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 350, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as player_id, (select wimbledon ) as game from championships union all select year, fr_open as player_id, (select fr_open ) as game from championships union all select year, us_open as player_id, (select us_open ) as game from championships union all select year,au_open as player_id, (select au_open ) as game from championships) select cte.player_id as player_id, p.player_name, count(cte.game) as grand_slams_count from cte left join players p on cte.player_id = p.player_id group by cte.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 351, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year,'wimbledon as championship',wimbledon as player_id from championships union all select year,'fr_open as championship',fr_open from championships union all select year,'us_open as championship',us_open from championships union all select year,'au_open as championship',au_open from championships ) select a.player_id,player_name,count(*) grand_slams_count from cte a inner join players b on a.player_id =b.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 352, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year,wimbledon as cl from championships union all select year,fr_open as cl from championships union all select year,us_open as cl from championships union all select year,au_open as cl from championships ) select cl as player_id,player_name,count(*) as grand_slams_count from cte join players as p on cte.cl=p.player_id group by cl"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 353, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year,wimbledon as title from championships union all select year,fr_open as title from championships union all select year,us_open as title from championships union all select year,au_open as title from championships ) select player_id,player_name,count(title) as grand_slams_count from cte join players on cte.title = players.player_id group by 1 order by 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 354, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as ids, count(wimbledon) as win from championships group by 1 union all select fr_open, count(fr_open) from championships group by 1 union all select us_open, count(us_open) from championships group by 1 union all select au_open, count(au_open) from championships group by 1) select p.player_id, p.player_name, temp.wn as grand_slams_count from players p join (select cte.ids, sum(win) as wn from cte group by 1) temp on temp.ids = p.player_id"]}
