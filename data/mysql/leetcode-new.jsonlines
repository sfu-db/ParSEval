{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 515, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t as ( select a.product_id, a.units, b.price from unitssold a left join prices b on a.product_id = b.product_id and a.purchase_date between b.start_date and b.end_date ) select product_id, round(sum(units * price) / sum(units),2) as average_price from t group by 1"]}
