{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 719, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, balance from users join ( select account, sum(amount) as balance from transactions group by account) as tmp on users.account = tmp.account where balance>10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 720, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name, sum(t.amount) as balance from users u right join transactions t using(account) group by t.account having balance>10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 721, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as (select account, sum(amount) as balance from transactions group by account) select u.name, c.balance from users u left join cte c on u.account =c.account where balance>10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 722, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, sum(amount) as balance from transactions join users on users.account = transactions.account group by users.account, name having sum(amount) > 10000"]}
