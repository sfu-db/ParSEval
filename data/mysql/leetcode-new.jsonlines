{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 252, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select distinct project_id, round(avg(experience_years) over(partition by project_id),2) as average_years from project join employee on project.employee_id = employee.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 253, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with t1 as (select p.project_id , e.experience_years from project p join employee e on p.employee_id = e.employee_id) select project_id,round(avg(experience_years),2) as average_years from t1 group by project_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 254, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select temp.project_id, round(sum(temp.experience_years)/count(*),2) as average_years from (select e.employee_id, e.experience_years, p.project_id from employee e join project p on e.employee_id = p.employee_id) as temp group by temp.project_id"]}
