{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 466, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with ad_sessions as ( select distinct session_id from playback p join ads a on p.customer_id = a.customer_id and p.start_time <= a.timestamp and p.end_time >= a.timestamp ) select session_id from playback where session_id not in ( select session_id from ad_sessions )"]}
