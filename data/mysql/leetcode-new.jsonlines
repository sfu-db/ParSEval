{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 373, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with transaction_totals as ( select transactions.account as account, sum(transactions.amount) as balance from transactions group by transactions.account ) select users.name as name, transaction_totals.balance as balance from users join transaction_totals on users.account = transaction_totals.account where transaction_totals.balance > 10000"]}
