{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 255, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) apple_count, sum(orange_count) orange_count from( select boxes.apple_count + ifnull(chests.apple_count,0) apple_count, boxes.orange_count + ifnull(chests.orange_count,0) orange_count from boxes left join chests on boxes.chest_id = chests.chest_id) cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 256, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) as apple_count, sum(orange_count) as orange_count from (select b.apple_count + ifnull(c.apple_count, 0) as apple_count, b.orange_count + ifnull(c.orange_count, 0) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id) as t"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 257, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) as apple_count,sum(orange_count) as orange_count from (select box_id, (a.apple_count+coalesce(b.apple_count,0)) as apple_count, (a.orange_count+coalesce(b.orange_count,0)) as orange_count from boxes as a left join chests as b on a.chest_id = b.chest_id group by box_id) as a"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 258, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(b.apple_count) + coalesce(sum(c.apple_count), 0) as apple_count, sum(b.orange_count) + coalesce(sum(c.orange_count), 0) as orange_count from boxes as b left join chests as c on b.chest_id = c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 259, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) as apple_count, sum(orange_count) as orange_count from ( select b.apple_count + ifnull(c.apple_count, 0) as apple_count, b.orange_count + ifnull(c.orange_count, 0) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id ) temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 260, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_tl)as apple_count,sum(orange_tl) as orange_count from ( select box_id, ifnull((b.apple_count+c.apple_count),b.apple_count)as apple_tl ,ifnull((b.orange_count+c.orange_count),b.orange_count) as orange_tl from boxes b left join chests c on b.chest_id=c.chest_id ) tt"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 261, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with box_chest as ( select box_id,a.chest_id, a.apple_count,a.orange_count, ifnull(b.apple_count,0) as chest_apple_count, ifnull(b.orange_count,0) as chest_orange_count from boxes a left join chests b on a.chest_id = b.chest_id ) select sum(apple_count+chest_apple_count) as apple_count, sum(orange_count+chest_orange_count) as orange_count from box_chest"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 262, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(ifnull(b.apple_count, 0)) + sum(ifnull(c.apple_count, 0)) as apple_count, ifnull(sum(b.orange_count),0) + ifnull(sum(c.orange_count), 0) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 263, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(ifnull(b.apple_count, 0) + ifnull(c.apple_count, 0)) as apple_count, sum(ifnull(b.orange_count, 0) + ifnull(c.orange_count, 0)) as orange_count from boxes as b left join chests as c using (chest_id)"]}
