{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 356, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with temp as(select *, count(followee) over(partition by followee ) as followeecount, count(follower ) over(partition by follower ) as followercount from follow) select distinct follower, followeecount as num from ( select b.follower, a.followeecount from temp a join temp b on a.followee= b.follower where a.followeecount>=1 and b.followercount>=1 )f order by follower"]}
