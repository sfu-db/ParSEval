{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 140, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte1 as ( select visits.visit_id, visits.customer_id, transactions.transaction_id from visits left join transactions on visits.visit_id = transactions.visit_id having transaction_id is null) select customer_id, count(*) as count_no_trans from cte1 group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 141, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with no_visits as ( select v.customer_id, v.visit_id from visits v left join transactions t on v.visit_id = t.visit_id where t.transaction_id is null ) select no_visits.customer_id, count(distinct no_visits.visit_id) count_no_trans from no_visits group by no_visits.customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 142, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with table1 as (select visits.visit_id,customer_id, amount from visits left join transactions on visits.visit_id = transactions.visit_id where amount is null) select customer_id, count(*) as count_no_trans from table1 group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 143, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with temp as ( select v.customer_id, v.visit_id from visits v left outer join transactions t on v.visit_id = t.visit_id where t.visit_id is null ), finaltable as ( select customer_id, count(visit_id) as count_no_trans from temp group by customer_id ) select * from finaltable"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 144, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with temp as ( select v.customer_id, v.visit_id, t.visit_id as hastransaction from visits v left outer join transactions t on v.visit_id = t.visit_id having t.visit_id is null ), finaltable as ( select customer_id, count(visit_id) as count_no_trans from temp group by customer_id ) select * from finaltable"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 145, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with visits as ( select v.customer_id, v.visit_id, count(transaction_id) num_trans from visits v left join transactions t on v.visit_id = t.visit_id group by visit_id ) select customer_id, count(num_trans) count_no_trans from visits where num_trans = 0 group by customer_id"]}
