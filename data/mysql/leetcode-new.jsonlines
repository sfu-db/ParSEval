{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 53, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(box_apple_count + chest_apple_count) as apple_count, sum(box_orange_count + chest_orange_count) as orange_count from ( select box_id, b.apple_count as box_apple_count, b.orange_count as box_orange_count, coalesce(c.apple_count, 0) as chest_apple_count, coalesce(c.orange_count, 0) as chest_orange_count from boxes b left join chests c on b.chest_id = c.chest_id ) a"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 54, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(c.apple_count) as apple_count, sum(c.orange_count) as orange_count from ( select box_id, sum(c.apple_count) as apple_count, sum(c.orange_count) as orange_count from boxes b inner join chests c on b.chest_id = c.chest_id group by box_id union all select box_id, apple_count, orange_count from boxes b ) c"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 55, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(total_apples) as apple_count ,sum(total_oranges) as orange_count from ( select a.box_id ,a.apple_count + ifnull(b.apple_count,0) as total_apples ,a.orange_count + ifnull(b.orange_count,0) as total_oranges from boxes a left join chests b on a.chest_id=b.chest_id ) a"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 56, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(total_apples) as apple_count, sum(total_oranges) as orange_count from (select b.apple_count + coalesce(c.c_apple_count, 0) as total_apples, b.orange_count + coalesce(c.c_orange_count, 0) as total_oranges from boxes b left join (select chest_id, apple_count as c_apple_count, orange_count as c_orange_count from chests) c on b.chest_id = c.chest_id) t"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 57, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select ba + ca as apple_count, bo + co as orange_count from ( select sum(b.apple_count) as ba, sum(b.orange_count) as bo, sum(ifnull(c.apple_count,0)) as ca, sum(ifnull(c.orange_count,0)) as co from boxes b left outer join chests c on (b.chest_id = c.chest_id) ) as t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 58, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(a.total_apple_count) as apple_count,sum(a.total_orange_count) as orange_count from ( select coalesce(b.apple_count,0)+coalesce(c.apple_count,0) as total_apple_count,coalesce(b.orange_count,0)+coalesce(c.orange_count,0) as total_orange_count from boxes b left join chests c on b.chest_id = c.chest_id ) as a"]}
