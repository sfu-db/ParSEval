{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 303, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as ( select distinct f1.follower as follower, count(distinct f2.follower) as num from follow f1 left join follow f2 on f1.follower = f2.followee group by 1 ) select * from cte where num > 0 order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 304, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as ( select distinct follower as follower from follow ) select cte.follower, count(distinct f.follower) as num from cte left join follow f on cte.follower = f.followee group by cte.follower having num >= 1"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 305, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as ( select f.followee, count(distinct f.follower) as followercount from follow f group by 1 ), cte2 as ( select f.follower from follow f group by 1 ) select cte2.follower, cte.followercount as num from cte2 left join cte on cte2.follower = cte.followee where followercount is not null order by 1 asc"]}
