{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 53, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "with distinct_leads as ( select dailysales.date_id as date_id, dailysales.make_name as make_name, count(distinct dailysales.lead_id) as unique_leads from dailysales group by dailysales.date_id, dailysales.make_name ), distinct_partners as ( select dailysales.date_id as date_id, dailysales.make_name as make_name, count(distinct dailysales.partner_id) as unique_partners from dailysales group by dailysales.date_id, dailysales.make_name ) select dailysales.date_id as date_id, dailysales.make_name as make_name, distinct_leads.unique_leads as unique_leads, distinct_partners.unique_partners as unique_partners from dailysales join distinct_leads on dailysales.date_id = distinct_leads.date_id and dailysales.make_name = distinct_leads.make_name join distinct_partners on dailysales.date_id = distinct_partners.date_id and dailysales.make_name = distinct_partners.make_name group by dailysales.date_id, dailysales.make_name"]}
