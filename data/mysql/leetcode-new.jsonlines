{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 410, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select t2.left_operand, t2.operator, t2.right_operand, ( case when t2.operator = '>' then if(t2.left_value > t2.right_value, 'true', 'false') when t2.operator = '<' then if(t2.left_value < t2.right_value, 'true', 'false') when t2.operator = '=' then if(t2.left_value = t2.right_value, 'true', 'false') else false end ) as value from ( select t1.left_operand, t1.operator, t1.right_operand, t3.value as left_value, t4.value as right_value from expressions t1 left join variables t3 on t1.left_operand = t3.name left join variables t4 on t1.right_operand = t4.name ) t2"]}
