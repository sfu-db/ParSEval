{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 339, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with visit_t as ( select visit_id, sum(amount) as total from transactions group by visit_id ) ,visit_c as ( select v.visit_id, v.customer_id, vt.total from visits v left join visit_t vt on v.visit_id = vt.visit_id ) select customer_id, count(*) as count_no_trans from visit_c vc where vc.total is null group by customer_id"]}
