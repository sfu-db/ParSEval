{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 250, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.ip_address != b.ip_address where a.login between b.login and b.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 251, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id = b.account_id where a.login between b.login and b.logout and a.ip_address != b.ip_address group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 252, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id=b.account_id where a.ip_address<>b.ip_address and ((a.login<b.login and a.logout>=b.login) or (b.login<a.login and b.logout>=a.login))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 253, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and l1.login between l2.login and l2.logout group by l1.account_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 254, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l.account_id from loginfo l join loginfo r on l.account_id = r.account_id where ( (l.logout >= r.login and l.logout <= r.logout) or (r.logout >= l.login and r.logout <= l.logout) ) and l.ip_address <> r.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 255, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and((l1.login <l2.logout and l1.logout>=l2.login) or (l2.login <l1.logout and l2.logout>=l1.login))"]}
