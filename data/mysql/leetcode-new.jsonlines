{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 197, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.win as player_id,b.player_name, num_win as grand_slams_count from (select win, count(win) as num_win from (select wimbledon as win from championships union all select fr_open as win from championships union all select us_open as win from championships union all select au_open as win from championships) a group by win)a left join players b on a.win=b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 198, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, p.player_name, b.grand_slams_count from (select prize as player_id, count(*) as grand_slams_count from (select wimbledon as prize from championships union all select fr_open as prize from championships union all select us_open as prize from championships union all select au_open as prize from championships)a group by prize)b left join players p on b.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 199, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player_id, p.player_name, count(c.player_id) as grand_slams_count from players p right join (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) c on p.player_id = c.player_id group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 200, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select distinct player_id, player_name, sum(player_id = wimbledon)+ sum(player_id = fr_open)+ sum(player_id = us_open)+sum(player_id = au_open) as grand_slams_count from players join championships on player_id = wimbledon or player_id = fr_open or player_id = us_open or player_id = au_open group by player_id order by 3 desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 201, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select distinct t.player_id,t.player_name,sum(t.ct) grand_slams_count from (select p.player_id,p.player_name ,count(*) as ct from championships c inner join players p on p.player_id=c.wimbledon group by p.player_id union all select p.player_id,p.player_name,count(*) as ct from championships c inner join players p on p.player_id=c.fr_open group by p.player_id union all select p.player_id,p.player_name,count(*) as ct from championships c inner join players p on p.player_id=c.us_open group by p.player_id union all select p.player_id,p.player_name,count(*)as ct from championships c inner join players p on p.player_id=c.au_open group by p.player_id) t group by t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 202, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select id as player_id, p.player_name,sum(cnt)as grand_slams_count from players p right join ( select wimbledon as id, count(*)as cnt from championships c group by 1 union all select fr_open as id, count(*)as cnt from championships c group by 1 union all select us_open as id, count(*)as cnt from championships c group by 1 union all select au_open as id, count(*)as cnt from championships c group by 1 )t on t.id = p.player_id group by t.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 203, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select id as player_id, player_name, grand_slams_count from (select id, count(id) as grand_slams_count from ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) as ids group by id ) as id_count join players as p on id_count.id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 204, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select inr.player_id, p.player_name, count(1) grand_slams_count from ( select wimbledon player_id from championships union all select fr_open player_id from championships union all select us_open player_id from championships union all select au_open player_id from championships ) inr join players p on p.player_id = inr.player_id group by inr.player_id , p.player_name order by inr.player_id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 205, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.*, count(c.tour) as grand_slams_count from players p left join ( select year, wimbledon as tour from championships union all select year, fr_open as tour from championships union all select year, us_open as tour from championships union all select year, au_open as tour from championships ) c on p.player_id = c.tour group by 1, 2 having count(c.tour) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 206, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.*, count(w.winner) grand_slams_count from players p join (select wimbledon winner from championships union all select fr_open winner from championships union all select us_open winner from championships union all select au_open winner from championships) w on w.winner = p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 207, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(c.wimbledon = p.player_id)+sum(c.fr_open = p.player_id) + sum(c.us_open =p.player_id)+sum(c.au_open = p.player_id)) grand_slams_count from players p, championships c group by p.player_id having grand_slams_count > 0"]}
