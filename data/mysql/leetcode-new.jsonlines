{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 88, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select a1.machine_id, round(avg(a2.timestamp-a1.timestamp),3) as processing_time from activity as a1 join activity as a2 on (a1.machine_id = a2.machine_id) and (a1.process_id = a2.process_id) and (a2.timestamp > a1.timestamp) group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 89, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select activity_start.machine_id ,round(avg(activity_end.timestamp - activity_start.timestamp), 3) processing_time from activity activity_start inner join activity activity_end on activity_start.machine_id = activity_end.machine_id and activity_start.process_id = activity_end.process_id and activity_start.activity_type = 'start' and activity_end.activity_type = 'end' group by activity_start.machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 90, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select b.machine_id, round(avg(a.timestamp - b.timestamp), 3) as processing_time from activity b join activity a on a.machine_id = b.machine_id and a.process_id = b.process_id and a.activity_type = 'end' and b.activity_type = 'start' group by a.machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 91, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select distinct a.machine_id, round(avg(b.timestamp-a.timestamp),3) as processing_time from activity a join activity b on a.machine_id=b.machine_id and a.activity_type='start' and b.activity_type='end' group by a.machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 92, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select distinct machine_id, round(sum(if(activity_type = 'start', -timestamp, timestamp)) / count(distinct process_id), 3) as processing_time from activity group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 93, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(avg(diff_time),3) as processing_time from ( select machine_id , process_id , sum(case when activity_type = 'end' then timestamp else 0 end) - sum(case when activity_type = 'start' then timestamp else 0 end) as diff_time from activity group by 1 ,2 ) agg group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 94, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(2*avg(if(activity_type='end', timestamp, -1* timestamp)), 3) as processing_time from activity group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 95, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(avg(duration),3) as processing_time from ( select s.machine_id , s.process_id , sum(case when e.activity_type = 'end' then e.timestamp end - case when s.activity_type = 'start' then s.timestamp end) as duration from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id group by 1,2 ) a group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 96, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(avg(endt-startt),3) as processing_time from (select distinct machine_id ,process_id , sum(case when activity_type = 'start' then timestamp end) as startt , sum(case when activity_type = 'end' then timestamp end) as endt from activity group by 1,2) t1 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 97, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(avg(processing_time),3) as processing_time from ( select machine_id , process_id , avg(case when activity_type = 'end' then timestamp else null end) - avg(case when activity_type = 'start' then timestamp else null end) as processing_time from activity group by machine_id , process_id ) x group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 98, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id , round(sum(if(activity_type = 'start', -1, 1) *timestamp)/count(distinct process_id),3) as processing_time from activity group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 99, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, round((sum(case when activity_type = 'end' then timestamp else 0 end) - sum(case when activity_type = 'start' then timestamp else 0 end)) / count(distinct process_id),3) as processing_time from activity group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 100, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, round(avg((case when activity_type='start' then -1 else 1 end)*timestamp)*2, 3) as processing_time from activity a group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 101, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, round(avg(time),3) processing_time from ( select machine_id, max(timestamp)-min(timestamp) time from activity group by machine_id, process_id ) mp group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 102, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, round(sum(if(activity_type='start',-timestamp,timestamp))/count(distinct process_id),3) as processing_time from activity group by machine_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 103, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, ifnull(round(avg(processing_time),3),0)as processing_time from ( select a1.machine_id, a1.process_id, a1.timestamp - a2.timestamp as processing_time from (select * from activity where activity_type = 'end') a1 left join (select * from activity where activity_type = 'start') a2 on a1.machine_id = a2.machine_id and a1.process_id = a2.process_id ) c group by 1"]}
