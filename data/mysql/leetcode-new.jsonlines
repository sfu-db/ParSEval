{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 423, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id , count(customer_id) as count_no_trans from visits as v left join transactions as t on t.visit_id = v.visit_id where transaction_id is null group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 424, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte as ( select customer_id,amount from ( select v.visit_id,v.customer_id ,t.amount from visits v left outer join transactions t on v.visit_id=t.visit_id) a where a.amount is null ) select customer_id , count(customer_id) as count_no_trans from cte group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 425, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(customer_id) as count_no_trans from visits where not exists (select transaction_id from transactions where visits.visit_id = transactions.visit_id) group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 426, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with temp as (select visits.visit_id, transactions.transaction_id from visits left join transactions on visits.visit_id = transactions.visit_id), nulledtemp as (select * from temp where temp.transaction_id is null) select customer_id,count(*) as count_no_trans from visits inner join nulledtemp on nulledtemp.visit_id=visits.visit_id group by customer_id order by count(*) desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 427, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select visits.customer_id as customer_id, sum(ifnull(transactions.transaction_id, 1)) as count_no_trans from visits left join transactions on transactions.visit_id = visits.visit_id where transactions.transaction_id is null group by visits.customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 428, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte as ( select visit_id, count(transaction_id) as count_trans , sum(amount) as total from transactions group by visit_id ) select customer_id, count(ifnull(cte.count_trans,0)) as count_no_trans from visits v left join cte using(visit_id) where ifnull(total, 0) = 0 group by customer_id order by 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 429, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct(visit_id) from transactions) group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 430, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select a.customer_id, (count(a.visit_id) - count(b.visit_id)) as count_no_trans from visits as a left join transactions as b on a.visit_id = b.visit_id group by a.customer_id having (count(a.visit_id) - count(b.visit_id)) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 431, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select v.customer_id, count(v.visit_id) as count_no_trans from visits as v where v.visit_id not in ( select visit_id from transactions ) group by v.customer_id"]}
