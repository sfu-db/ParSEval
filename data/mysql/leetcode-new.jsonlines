{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 200, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with cte as ( select project_id, a.employee_id, experience_years from project a join employee b on a.employee_id = b.employee_id) select project_id, round(avg(experience_years),2) as average_years from cte group by project_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 201, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with proj_exp as ( select a.*, b. experience_years from project as a left join employee as b on a.employee_id = b.employee_id ) select project_id, round(avg(experience_years), 2) as average_years from proj_exp group by project_id order by project_id"]}
