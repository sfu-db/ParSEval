{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 201, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with temp_tbl as (select employee_id, department_id, primary_flag from employee where primary_flag = 'y') select employee_id, department_id from (select employee_id, department_id, primary_flag, row_number() over(partition by employee_id) as rn from employee) aa where aa.rn = 1 and aa.primary_flag = 'n' and employee_id not in (select employee_id from temp_tbl) union select employee_id, department_id from temp_tbl"]}
