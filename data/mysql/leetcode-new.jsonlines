{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 256, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select b.project_id,round((sum(a.experience_years)/count(a.experience_years)),2) as average_years from employee a left join project b on a.employee_id = b.employee_id where b.project_id group by b.project_id"]}
