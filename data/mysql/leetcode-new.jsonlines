{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 685, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select nnew.product_id, nnew.product_name from ( select new.product_id, new.product_name, max(new.sale_date), min(new.sale_date) from (select sales.product_id, product_name, sale_date from sales left join product on sales.product_id = product.product_id ) as new group by new.product_id, new.product_name having max(new.sale_date) between '2019-01-01' and '2019-03-31' and min(new.sale_date) between '2019-01-01' and '2019-03-31' ) as nnew"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 686, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as( select product_id as pid from sales group by pid having sum(sale_date >'2019-03-31' or sale_date<'2019-01-01')=0 ) select product_id,product_name from product join t1 on product.product_id = t1.pid"]}
