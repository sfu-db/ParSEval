{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 399, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when e.operator = '>' then case when l.value > r.value then true else false end when e.operator = '=' then case when l.value = r.value then true else false end when e.operator = '<' then case when l.value < r.value then true else false end end as value from expressions e join variables l on e.left_operand=l.name join variables r on e.right_operand=r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 400, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand , operator , right_operand , case when operator = '>' and v1.value > v2.value then true when operator = '=' and v1.value = v2.value then true when operator = '<' and v1.value < v2.value then true else false end as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 401, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '<' then if(vl.value < vr.value, 'true', 'false') when operator = '>' then if(vl.value > vr.value, 'true', 'false') when operator = '=' then if(vl.value = vr.value, 'true', 'false') end value from expressions e join variables vl on e.left_operand = vl.name join variables vr on e.right_operand = vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 402, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator='>' then if(v1.value > v2.value, 'true', 'false') when operator='<' then if(v1.value < v2.value, 'true', 'false') when v1.value=v2.value then if(v1.value = v2.value, 'true', 'false') else false end) as value from variables v1 inner join expressions e on v1.name=e.left_operand inner join variables v2 on e.right_operand=v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 403, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' and lv.value > rv.value or operator = '<' and lv.value < rv.value or operator = '=' and lv.value = rv.value then true else false end as value from expressions as e inner join variables as lv on e.left_operand = lv.name inner join variables as rv on e.right_operand = rv.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 404, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte1 as ( select e.left_operand, e.right_operand, v1.value as left_value, e.operator, v2.value as right_value from expressions as e left join variables as v1 on e.left_operand = v1.name left join variables as v2 on e.right_operand = v2.name) select left_operand, operator, right_operand, case when left_value > right_value and operator = '>' then true when left_value < right_value and operator = '<' then true when left_value = right_value and operator = '=' then true else false end as value from cte1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 405, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, if(operator=if(l.value <r.value,'<',if(l.value>r.value,'>','=')),'true','false') as value from expressions e join variables l on e.left_operand=l.name join variables r on e.right_operand=r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 406, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, (case when e.operator = '>' then if(v1.value > v2.value,'true', 'false') when e.operator = '<' then if(v1.value < v2.value,'true', 'false') when e.operator = '=' then if(v1.value = v2.value,'true', 'false') end) as value from expressions e left outer join variables v1 on e.left_operand = v1.name left outer join variables v2 on e.right_operand = v2.name"]}
