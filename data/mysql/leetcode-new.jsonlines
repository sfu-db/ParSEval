{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 393, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with second_degree as ( select distinct a.followee as second_degree from follow a inner join follow b on a.followee=b.follower ), group_count as ( select c.second_degree as follower,count(*) as num from second_degree c inner join follow d on c.second_degree = d.followee group by c.second_degree order by c.second_degree ) select * from group_count"]}
