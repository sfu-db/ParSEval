{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 382, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with temp as ( select a.employee_id, a.name, b.employee_id as direct_report, b.age from employees a join employees b on a.employee_id = b.reports_to ) select employee_id, name, count(direct_report) as reports_count, round(avg(age)) as average_age from temp group by 1, 2 order by 1"]}
