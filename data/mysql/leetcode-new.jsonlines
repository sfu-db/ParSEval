{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 649, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from sales s left join product p using(product_id) group by s.buyer_id having sum(if(p.product_name = 's8',1,0))>=1 and sum(if(p.product_name='iphone',1,0))=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 650, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with s8 as (select distinct buyer_id from sales where product_id in (select product_id from product where product_name='s8')) select buyer_id from s8 where buyer_id not in (select distinct buyer_id from sales where product_id in (select product_id from product where product_name='iphone'))"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 651, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales as s left join product as p on s.product_id = p.product_id group by 1 having sum(product_name = 'iphone' ) = 0 and sum(product_name = 's8')>=1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 652, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with big_table as ( select p.product_name, s.product_id, s.buyer_id from product p join sales s on p.product_id = s.product_id ), s8 as ( select buyer_id from big_table where product_name = 's8' ), iphones as ( select buyer_id from big_table where product_name = 'iphone' ) select distinct buyer_id from sales where buyer_id in (select * from s8) and buyer_id not in (select * from iphones)"]}
