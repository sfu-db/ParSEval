{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 512, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select s1.player_id, s2.player_name, s1.grand_slams_count from (select a.player_id, count(a.player_id) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) a group by 1 order by 1) s1 inner join players s2 on s1.player_id = s2.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 513, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(num) as grand_slams_count from ( select wimbledon as player_id, count(*) as num from championships group by wimbledon union all select fr_open as player_id, count(*) as num from championships group by fr_open union all select us_open as player_id, count(*) as num from championships group by us_open union all select au_open as player_id, count(*) as num from championships group by au_open ) temp left join players using (player_id) group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 514, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) select player_id, player_name, count(id) as grand_slams_count from players join tmp on tmp.id = players.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 515, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select p.player_id, player_name, count(*) as grand_slams_count from cte join players p on cte.player_id=p.player_id group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 516, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select wimbledon id from championships union all select fr_open id from championships union all select us_open id from championships union all select au_open id from championships ) select t.id player_id, p.player_name, count(*) as grand_slams_count from t left join players p on t.id = p.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 517, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with a as ( select wimbledon value from championships union all select us_open value from championships union all select fr_open value from championships union all select au_open value from championships ) select b.player_id, p.player_name, b.grand_slams_count from ( select a.value as player_id, count(*) as grand_slams_count from a group by a.value ) b left join players p on b.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 518, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select players.player_id, players.player_name, wins_by_id.grand_slams_count from ( select player_id, sum(win_count) as grand_slams_count from ( select wimbledon as player_id, count(*) as win_count from championships group by 1 union all select fr_open as player_id, count(*) as win_count from championships group by 1 union all select us_open as player_id, count(*) as win_count from championships group by 1 union all select au_open as player_id, count(*) as win_count from championships group by 1 ) t group by 1 ) as wins_by_id join players on players.player_id = wins_by_id.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 519, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with a as ( select p.player_id , p.player_name , count(c.wimbledon) as x1 from players p left join championships c on p.player_id = c.wimbledon group by p.player_id,c.year union all select p.player_id , p.player_name , count(c.fr_open) as x1 from players p left join championships c on p.player_id = c.fr_open group by p.player_id ,c.year union all select p.player_id , p.player_name , count(c.us_open) as x1 from players p left join championships c on p.player_id = c.us_open group by p.player_id ,c.year union all select p.player_id , p.player_name , count(c.au_open) as x1 from players p left join championships c on p.player_id = c.au_open group by p.player_id ,c.year ) select player_id , player_name , sum(x1) as grand_slams_count from a where case when x1 =0 then 0 else 1 end group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 520, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select year, wimbledon player from championships union all select year, fr_open player from championships union all select year, us_open player from championships union all select year, au_open player from championships ) , temp2 as ( select player, count(player) as cnt from temp group by player ) select a.player_id, a.player_name, b.cnt grand_slams_count from players a left join temp2 b on a.player_id=b.player where b.player is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 521, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( (select player_id, player_name from players p join championships c on p.player_id = c.wimbledon) union all (select player_id, player_name from players p join championships c2 on p.player_id = c2.fr_open) union all (select player_id, player_name from players p join championships c3 on p.player_id = c3.us_open) union all (select player_id, player_name from players p join championships c4 on p.player_id = c4.au_open) ) select player_id, player_name, count(*) as grand_slams_count from temp group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 522, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id,a.player_name,a.grand_slams_count from (select player_id, player_name, ( select sum(case when wimbledon = player_id then 1 else 0 end) +sum(case when fr_open = player_id then 1 else 0 end) +sum(case when us_open = player_id then 1 else 0 end) +sum(case when au_open = player_id then 1 else 0 end) from championships ) as grand_slams_count from players) a where a.grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 523, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( (select wimbledon player_id from championships) union all (select fr_open from championships) union all (select us_open from championships) union all (select au_open from championships) ) select player_id, player_name, count(*) grand_slams_count from cte join players p using(player_id) group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 524, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, count(gs) as grand_slams_count from players inner join (select year, wimbledon as gs from championships union all select year, fr_open as gs from championships union all select year, us_open as gs from championships union all select year, au_open as gs from championships) as temp on temp.gs = player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 525, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p1.player_id, p1.player_name, count(p2.gc) as grand_slams_count from players p1 join ( select year, wimbledon as gc from championships union all select year, fr_open as gc from championships union all select year, us_open as gc from championships union all select year, au_open as gc from championships ) p2 on p1.player_id = p2.gc group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 526, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with grandslams as ( select p.player_id, p.player_name, sum( if(c.wimbledon = p.player_id, 1, 0) + if(c.fr_open = p.player_id, 1, 0) + if(c.us_open = p.player_id, 1, 0) + if(c.au_open = p.player_id, 1, 0) ) as grand_slams_count from players p, championships c group by 1 ) select * from grandslams where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 527, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select year, wimbledon as player_id from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships ) select p.player_id, p.player_name, count(t.player_id ) as grand_slams_count from players p inner join t on p.player_id = t.player_id group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 528, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select id as player_id, player_name, num as grand_slams_count from (select id, count(id) as num from (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships)sub group by 1)sub1 join players p on p.player_id = sub1.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 529, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(p.player_id) as grand_slams_count from (select year, 'wimbledon' as grand_slam, wimbledon as player_id from championships union select year, 'fr_open' as grand_slam, fr_open as player_id from championships union select year, 'us_open' as grand_slam, us_open as player_id from championships union select year, 'au_open' as grand_slam, au_open as player_id from championships) t join players p on t.player_id = p.player_id group by player_id"]}
