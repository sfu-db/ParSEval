{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 349, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select ge.employee_id, e.name, ge.reports_count, round(ge.average_age) as average_age from (select reports_to as employee_id, count(employee_id) as reports_count, avg(age) as average_age from employees group by reports_to having reports_to is not null) ge left join employees e on ge.employee_id=e.employee_id order by ge.employee_id"]}
