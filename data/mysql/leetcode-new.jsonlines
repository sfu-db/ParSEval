{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 609, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id,product_name from product where product_id not in ( select p.product_id from product p join sales s on p.product_id = s.product_id where sale_date not between date('2019-01-01') and date('2019-03-31') )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 610, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, min(p.product_name) as product_name from product p inner join sales s on p.product_id = s.product_id group by p.product_id having min(s.sale_date)>='2019-01-01' and max(s.sale_date)<='2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 611, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct(a.product_id),a.product_name from product a join sales b on a.product_id=b.product_id where a.product_id in (select product_id from sales where sale_date>='2019-01-01' and sale_date <='2019-03-31') and a.product_id not in (select product_id from sales where sale_date<'2019-01-01' or sale_date >'2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 612, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s.product_id, p.product_name from product p join sales s on p.product_id = s.product_id group by s.product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 613, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p right join sales s on p.product_id = s.product_id group by p.product_id having max(quarter(s.sale_date)) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 614, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product.product_name from product inner join (select distinct(s1.product_id) from sales as s1 left join (select distinct(s2.product_id) from sales as s2 where s2.sale_date not between '2019-01-01' and '2019-03-31') s3 on s1.product_id = s3.product_id where s3.product_id is null ) as temp on product.product_id = temp.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 615, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with out_frame as ( select s.product_id from sales s where s.sale_date > cast('2019-03-31' as date) or s.sale_date < cast('2019-01-01' as date) ) select p.product_id, p.product_name from product p where product_id not in (select product_id from out_frame)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 616, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sa as( select p.product_id as product_id ,p.product_name as product_name,quarter(s.sale_date) as qt from product p join sales s on p.product_id = s.product_id )select product_id,product_name from sa group by product_id having max(qt)=1"]}
