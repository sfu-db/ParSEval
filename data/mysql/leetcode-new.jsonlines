{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 510, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as ( select left_operand, t2.value as left_value, operator, right_operand, t3.value as right_value from expressions t1 left join variables t2 on t1.left_operand = t2.name left join variables t3 on t1.right_operand = t3.name ), cte2 as ( select left_operand, operator, right_operand, case when operator = '>' then left_value > right_value when operator = '=' then left_value = right_value else left_value < right_value end as value from cte ) select left_operand, operator, right_operand, case when value = 1 then true else false end as value from cte2"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 511, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when value = 1 then true else false end as value from (select left_operand, operator, right_operand, case when operator = '<' then v1.value < v2.value when operator = '>' then v1.value > v2.value else v1.value = v2.value end as value from variables v1, expressions e, variables v2 where v1.name = e.left_operand and v2.name = e.right_operand) as t"]}
