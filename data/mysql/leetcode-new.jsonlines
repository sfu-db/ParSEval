{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 110, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte3 as ( select distinct * from follow ), cte1 as ( select distinct follower from cte3), cte2 as ( select followee, count(*) as ct from cte3 group by followee) select follower, ct as num from cte1 join cte2 on cte1.follower = cte2.followee order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 111, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with counts as ( select followee, count(distinct follower) as num from follow group by followee ) select distinct follower, num from follow as f left join counts as c on f.follower = c.followee where num is not null order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 112, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with temp1 as (select distinct followee from follow where followee in (select follower from follow)), temp2 as (select distinct followee, follower from follow) select followee as follower,count(follower) as num from temp2 where followee in (select followee from temp1) group by followee order by followee"]}
