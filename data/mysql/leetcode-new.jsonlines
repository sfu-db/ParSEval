{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 422, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select a.session_id from playback a left outer join ads b on a.customer_id=b.customer_id and a.start_time<=b.timestamp and a.end_time>=b.timestamp where b.customer_id is null and b.timestamp is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 423, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with t1 as(select session_id as exception from playback p left join ads a on a.customer_id=p.customer_id where p.start_time<=a.timestamp and a.timestamp<=p.end_time ) select session_id from playback where session_id not in (select t1.exception from t1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 424, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with temp as ( select session_id from playback as a inner join ads as b on a.start_time<=b.timestamp and a.end_time>=b.timestamp and a.customer_id=b.customer_id ) select session_id from playback where session_id not in (select * from temp)"]}
