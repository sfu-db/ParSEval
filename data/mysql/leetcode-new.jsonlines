{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 48, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id as product_id, 'store1' as store, store1 as price from products where store1 not like 'null%' union select product_id , 'store2' as store, store2 as price from products where store2 not like 'null%' union select product_id, 'store3' as store, store3 as price from products where store3 not like 'null%'"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 49, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, store, price from ( select product_id, store1 as price, 'store1' as store from products union all select product_id, store2 as price, 'store2' as store from products union all select product_id, store3 as price, 'store3' as store from products ) f where price is not null order by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 50, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with a as ( select product_id, 'store1' as store, store1 as price from products union all select product_id, 'store2' as store, store2 from products union all select product_id, 'store3' as store, store3 from products) select * from a where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 51, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with recursive cte as ( select 1 as num union all select num+1 as num from cte where num+1<=3) , cj as ( select distinct product_id, case when num = 1 then store1 when num = 2 then store2 when num = 3 then store3 end as store, case when num = 1 then store1 when num =2 then store2 when num=3 then store3 end as price from products cross join cte) select * from cj where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 52, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with stores(store) as ( select 'store1' union select 'store2' union select 'store3' ) select product_id, store, (case when store = 'store1' then 'store1' when store = 'store2' then 'store2' else 'store3' end) as price from products inner join stores on ('store1' is not null and store = 'store1') or ('store2' is not null and store = 'store2') or ('store3' is not null and store = 'store3')"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 53, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with tb1 as (select product_id, 'store1' as store,store1 as price from products union all select product_id, 'store2' as store, store2 as price from products union all select product_id, 'store3' as store, store3 as price from products) select product_id, store, price from tb1 where price is not null"]}
