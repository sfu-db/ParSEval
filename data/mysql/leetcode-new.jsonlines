{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 699, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(customer_id) as count_no_trans from visits where visits.visit_id not in (select t.visit_id from visits v inner join transactions t on v.visit_id = t.visit_id) group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 700, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select v.customer_id , count(customer_id) as count_no_trans from visits v left join transactions t on v.visit_id=t.visit_id where t.visit_id is null group by v.customer_id order by count_no_trans desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 701, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with trans as ( select visit_id, count(amount) n_trans from transactions group by visit_id ) select v.customer_id, count(v.visit_id) count_no_trans from visits v left join trans t using (visit_id) where n_trans is null group by customer_id"]}
