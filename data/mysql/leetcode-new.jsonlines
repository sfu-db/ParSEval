{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 278, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with cte as( select '[0-5>' as bin union select '[5-10>' bin union select '[10-15>' bin union select '15 or more' bin), cte2 as( select case when duration/60 between 0 and 5 then '[0-5>' when duration/60 between 5 and 10 then '[5-10>' when duration/60 between 10 and 15 then '[10-15>' when duration/60 > 15 then '15 or more' end as bin ,count(case when duration/60 between 0 and 5 then 1 when duration/60 between 5 and 10 then 1 when duration/60 between 10 and 15 then 1 when duration/60 > 15 then 1 end) as cnt from sessions group by bin) select c.bin, coalesce(s.cnt,0) total from cte c left join cte2 s on c.bin = s.bin"]}
