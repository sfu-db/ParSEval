{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 615, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as( select s.buyer_id,p.product_name,s.product_id from sales s left join product p on s.product_id=p.product_id ) select distinct buyer_id from cte where buyer_id not in (select buyer_id from cte where product_name = 'iphone') and product_name='s8'"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 616, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from( select distinct buyer_id from sales where product_id in (select product_id from product where product_name = 's8') ) as a where a.buyer_id not in ( select distinct buyer_id from sales where product_id in (select product_id from product where product_name = 'iphone') )"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 617, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales join product using (product_id) group by buyer_id having sum(case when product_name = 's8' then 1 else 0 end) >= 1 and sum(case when product_name = 'iphone' then 1 else 0 end) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 618, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as (select buyer_id from sales s join product p on p.product_id = s.product_id where p.product_name = 's8') select distinct buyer_id from cte where cte.buyer_id not in (select buyer_id from sales s join product p on p.product_id = s.product_id where p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 619, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales s join product p on s.product_id=p.product_id where product_name = 's8' and buyer_id not in (select buyer_id from product p join sales s on p.product_id=s.product_id where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 620, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales s left join product p on s.product_id = p.product_id group by buyer_id having sum(product_name='s8') > 0 and sum(product_name='iphone') < 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 621, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id as buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 's8' and buyer_id not in ( select buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 'iphone' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 622, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales left join product using (product_id) group by 1 having sum(case when product_name = 's8' then 1 else 0 end) > 0 and sum(case when product_name = 'iphone' then 1 else 0 end) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 623, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with wls as( select s.buyer_id,sum(p.product_name = 's8') as s8,sum(p.product_name = 'iphone') as iphone from sales s join product p on s.product_id = p.product_id group by buyer_id ) select buyer_id from wls where s8>=1 and iphone = 0"]}
