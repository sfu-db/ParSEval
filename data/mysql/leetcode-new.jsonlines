{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 398, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id , a.device_id from activity a inner join (select player_id , min(event_date) as event_date from activity group by player_id) b on a.player_id = b.player_id and a.event_date = b.event_date"]}
