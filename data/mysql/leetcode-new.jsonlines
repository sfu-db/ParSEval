{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 145, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select player_id, player_name, count(*) as grand_slams_count from players left join t using (player_id) where t.player_id is not null group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 146, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as(select wimbledon, count(wimbledon) nw from championships group by wimbledon), t2 as(select fr_open, count(fr_open) nf from championships group by fr_open), t3 as(select us_open, count(us_open) nu from championships group by us_open), t4 as(select au_open, count(au_open) na from championships group by au_open) select player_id, player_name, ifnull(t1.nw, 0) + ifnull(t2.nf, 0)+ifnull(t3.nu,0)+ifnull(t4.na,0) grand_slams_count from players p left join t1 on t1.wimbledon = p.player_id left join t2 on t2.fr_open = p.player_id left join t3 on t3.us_open = p.player_id left join t4 on t4.au_open = p.player_id having grand_slams_count>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 147, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as race from championships union all select fr_open as race from championships union all select us_open as race from championships union all select au_open as race from championships ) select race as player_id, p.player_name, count(*) as grand_slams_count from temp t join players p on t.race = p.player_id group by t.race, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 148, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as slam from championships union all select fr_open as slam from championships union all select us_open as slam from championships union all select au_open as slam from championships ) select player_id, player_name, count(*) as grand_slams_count from temp left join players on temp.slam = players.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 149, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon id from championships union all select fr_open id from championships union all select us_open id from championships union all select au_open id from championships ) select player_id, player_name, count(id) grand_slams_count from players p join temp on p.player_id = temp.id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 150, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as( (select player_id, player_name, c.year from players p join championships c on p.player_id = c.wimbledon) union all (select player_id, player_name, c.year from players p join championships c on p.player_id = c.fr_open) union all (select player_id, player_name, c.year from players p join championships c on p.player_id = c.us_open) union all (select player_id, player_name, c.year from players p join championships c on p.player_id = c.au_open) ) select player_id, player_name, count(year) as grand_slams_count from temp group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 151, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select a.player_id, count(a.player_id) as grand_slams_count from ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) as a group by player_id ) select a.player_id, a.player_name, b.grand_slams_count from players as a join temp as b on a.player_id = b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 152, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as (select year, player_name, player_id from championships join players on wimbledon=player_id union all select year, player_name, player_id from championships join players on fr_open=player_id union all select year, player_name, player_id from championships join players on us_open=player_id union all select year, player_name, player_id from championships join players on au_open=player_id) select player_id, player_name, count(*) as grand_slams_count from tmp group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 153, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with w as ( select wimbledon as player_id, count(*) as cnt from championships group by wimbledon ), f as ( select fr_open as player_id, count(*) as cnt from championships group by fr_open ), u as ( select us_open as player_id, count(*) as cnt from championships group by us_open ), a as ( select au_open as player_id, count(*) as cnt from championships group by au_open ), s as ( select p.player_id, p.player_name, coalesce(w.cnt, 0) + coalesce(f.cnt, 0) + coalesce(u.cnt, 0) + coalesce(a.cnt, 0) as grand_slams_count from players p left join w on p.player_id = w.player_id left join f on p.player_id = f.player_id left join u on p.player_id = u.player_id left join a on p.player_id = a.player_id ) select * from s where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 154, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with w as ( select year, wimbledon as w_player from championships c), f as ( select year, fr_open as f_player from championships c), u as ( select year, us_open as u_player from championships c), a as ( select year, au_open as a_player from championships c) select w_player as player_id, p.player_name, count(*) as grand_slams_count from (select * from w union all select * from f union all select * from u union all select * from a) as t left join players p on p.player_id = t.w_player group by w_player"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 155, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winner as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select winner.player_id, players.player_name, count(winner.player_id) as grand_slams_count from winner inner join players on winner.player_id = players.player_id group by winner.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 156, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winners as ( select p.player_id, p.player_name, sum(p.player_id = c.wimbledon) as wimbledon, sum(p.player_id = c.fr_open) as french, sum(p.player_id = c.us_open) as us, sum(p.player_id = c.au_open) as au from players p left join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by player_id ) select player_id, player_name, sum(wimbledon+french+us+au) as grand_slams_count from winners group by player_id, player_name having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 157, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winners as ( select winner, count(*) as grand_slams_count from ( select year, wimbledon as winner from championships union all select year, fr_open as winner from championships union all select year, us_open as winner from championships union all select year, au_open as winner from championships ) as combined group by winner ) select winner as player_id, players.player_name, grand_slams_count from winners left join players on winners.winner = players.player_id"]}
