{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 528, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, e2.subs as reports_count, e2.average_age from employees as e1 left join ( select reports_to as manager, count(*) as subs, round(avg(age)) as average_age from employees where reports_to is not null group by reports_to ) as e2 on e1.employee_id = e2.manager where e2.subs is not null order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 529, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to as employee_id, e2.name as name, count(distinct e1.employee_id) as reports_count, round(sum(e1.age)/count(distinct e1.employee_id),0) as average_age from employees e1 left join employees e2 on e1.reports_to = e2.employee_id where e1.reports_to is not null group by 1,2"]}
