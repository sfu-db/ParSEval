{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 345, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followee as (select followee, count(followee) ee_cnt from follow group by followee), follower as (select follower, count(follower) er_cnt from follow group by follower) select ee.followee follower, ee.ee_cnt num from follower er inner join followee ee on er.follower = ee.followee order by 1 asc"]}
