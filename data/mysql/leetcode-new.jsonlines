{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 258, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with t as (select '[0-5>' as bin, 0 as min_duration, 5*60 as max_duration union all select '[5-10>' as bin, 5*60 as min_duration, 10*60 as max_duration union all select '[10-15>' as bin, 10*60 as min_duration, 15*60 as max_duration union all select '15 or more' as bin, 15*60 as min_duration, 1223333333 as max_duration) select t.bin, count(s.session_id) as total from sessions s right join t on s.duration < t.max_duration and s.duration >= t.min_duration group by t.bin"]}
