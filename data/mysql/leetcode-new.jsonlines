{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 46, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id as product_id, round(sum(units * price) / sum(units), 2) as average_price from unitssold us left join prices p on us.product_id = p.product_id and p.start_date <= us.purchase_date and p.end_date >= us.purchase_date group by p.product_id order by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 47, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id product_id, round((sum(u.units*p.price) / sum(u.units)),2) average_price from unitssold u join prices p on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 48, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, cast(sum(sold.units * p.price)/sum(sold.units) as decimal(18,2)) as average_price from unitssold sold inner join prices p on p.product_id = sold.product_id and sold.purchase_date between p.start_date and p.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 49, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, ifnull(round((sum(p.price * u.units) / sum(u.units)), 2), 0) as average_price from prices p join unitssold u on p.product_id = u.product_id where u.purchase_date <= p.end_date and u.purchase_date >= p.start_date group by p.product_id order by 1"]}
