{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 650, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name, totals.total as balance from users u, (select t.account, sum(t.amount) as total from transactions t group by t.account) as totals where u.account = totals.account and totals.total > 10000"]}
