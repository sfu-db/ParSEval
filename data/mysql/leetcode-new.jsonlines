{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 397, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(sum(rating/position)/count(*),2) as quality, round(100 * sum(rating<3)/count(*),2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 398, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with q as ( select query_name, round(sum(rating/position)/count(*),2) as quality from queries group by 1 ) , p as ( select query_name, count(*) as badnum from queries where rating <3 group by 1 ), n as ( select query_name, count(*) num from queries group by 1 ) select n.query_name, q.quality, coalesce(round(p.badnum/n.num*100,2),0) as poor_query_percentage from n left join p on n.query_name=p.query_name join q on q.query_name=n.query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 399, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality, round((sum(if(rating < 3, 1, 0))/count(query_name))*100, 2) as poor_query_percentage from queries q group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 400, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with temp as ( select query_name, round(sum(rating/position)/count(*),2) as quality, sum(case when rating<3 then 1 else 0 end) as less, sum(case when rating is not null then 1 else 0 end) as alll from queries group by query_name ) select query_name, quality, round((less/alll)*100,2) as poor_query_percentage from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 401, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select q.query_name, round(avg(rating/position), 2) quality, ifnull(round(sub1.cnt / count(*) * 100, 2), 0.00) poor_query_percentage from queries q left join ( select query_name, count(*) cnt from queries where rating < 3 group by query_name) sub1 on q.query_name = sub1.query_name group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 402, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality, round((sum(if(rating<3,1,0))/count(query_name))*100,2) as poor_query_percentage from queries group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 403, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select distinct queries.query_name ,round(avg(queries.rating/position),2) as quality ,round(avg(queries.rating<3)*100,2) as poor_query_percentage from queries group by queries.query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 404, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select queries.query_name, round( avg( queries.rating / queries.position), 2 ) as quality, round( sum( queries.rating < 3 ) * 100 / count( queries.rating ) , 2 ) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 405, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(sum(rating/position)/count(*),2) as quality, round(avg(if(rating < 3,1,0))*100,2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 406, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select q.query_name, q.quality, round(100*ifnull(p.pr,0)/q.nr, 2) as poor_query_percentage from (select query_name, round(avg(rating/position),2) as quality, count(rating) as nr from queries group by query_name ) as q left join (select query_name, count(rating) as pr from queries where rating < 3 group by query_name ) as p on p.query_name = q.query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 407, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position), 2) as quality, round((select sum(rating < 3)) * 100 / count(*), 2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 408, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select sub.query_name, round(avg(sub.quality),2) as quality, round(100*sum(poor_qual_or_not)/count(sub.position),2) as poor_query_percentage from (select query_name, position, rating/position as quality, case when rating <3 then 1 else 0 end as poor_qual_or_not from queries) sub group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 409, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) quality, round(sum(rating < 3)/count(*) * 100, 2) poor_query_percentage from queries group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 410, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with quality as (select query_name, round(avg(rating/position),2) as quality from queries group by 1), pqp as (select q1.query_name, round((sum(case when rating <3 then 1 else 0 end)/res)*100,2) as pqp from queries q1 join (select query_name,count(result) as res from queries group by query_name) q on q1.query_name=q.query_name group by 1 ) select quality.query_name,quality.quality,pqp.pqp as poor_query_percentage from quality join pqp on quality.query_name=pqp.query_name"]}
