{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 433, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(visits.visit_id) as count_no_trans from visits left join transactions on visits.visit_id = transactions.visit_id where (transaction_id is null) group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 434, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select v.customer_id, count(distinct v.visit_id) as count_no_trans from visits v where v.visit_id not in (select visit_id from transactions) group by v.customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 435, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select tb1.customer_id,count(tb1.visit_id) as count_no_trans from visits as tb1 left join (select tb3.visit_id, sum(tb3.amount) as amount from transactions as tb3 group by tb3.visit_id) as tb2 on tb1.visit_id = tb2.visit_id where tb2.amount is null group by tb1.customer_id"]}
