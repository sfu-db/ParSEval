{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 365, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct account_id from (select log1.account_id, log1.ip_address as ip1, log2.ip_address as ip2 from loginfo log1 join loginfo log2 on log1.account_id=log2.account_id where log1.login<=log2.login and log2.login<=log1.logout ) t where ip1!=ip2"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 366, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where l1.account_id = l2.account_id and l1.ip_address <> l2.ip_address and ((l1.login between l2.login and l2.logout or l1.logout between l2.login and l2.logout) or (l2.login between l1.login and l1.logout or l2.logout between l1.login and l1.logout))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 367, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 inner join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and (l1.login between l2.login and l2.logout or l2.login between l1.login and l1.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 368, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id where l1.ip_address != l2.ip_address and date(l1.logout) = date(l2.login) and time(l2.login) between time(l1.login) and time(l1.logout) group by l1.account_id"]}
