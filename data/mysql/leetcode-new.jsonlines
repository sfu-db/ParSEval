{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 0, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select a.name , sum(amount) as balance from users as a join transactions as b on a.account = b.account group by a.account having sum(amount) >= 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 1, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, sum(amount) balance from users u right join transactions t on t.account=u.account group by t.account having sum(amount)>10000"]}
