{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 530, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as ( select user2_id from friendship where user1_id = 1 union select user1_id from friendship where user2_id = 1 ), liked as ( select page_id from likes where user_id = 1 ) select l.page_id recommended_page from likes l where l.user_id in (select user2_id from friends) and l.page_id not in (select page_id from liked) group by l.page_id order by count(user_id) desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 531, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as (select ( case when user1_id = 1 then user2_id else user1_id end ) as friend from friendship where user1_id = 1 or user2_id = 1) select distinct(page_id) as recommended_page from friends join likes on friends.friend = likes.user_id where page_id not in (select page_id from likes where user_id = 1)"]}
