{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 137, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with cte as ( select distinct product_id from products ) select cte.product_id, a.price as store1 , b.price as store2 , c.price as store3 from cte left join products as a on cte.product_id = a.product_id and a.store = 'store1' left join products as b on cte.product_id = b.product_id and b.store = 'store2' left join products as c on cte.product_id = c.product_id and c.store = 'store3'"]}
