{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 34, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(c.wimbledon = p.player_id) + sum(c.fr_open = p.player_id) + sum(c.us_open = p.player_id) + sum(c.au_open = p.player_id)) as grand_slams_count from players as p, championships as c group by p.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 35, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(c.grand_slams) as grand_slams_count from players p join ( select wimbledon as grand_slams from championships union all select fr_open as grand_slams from championships union all select us_open as grand_slams from championships union all select au_open as grand_slams from championships ) c on p.player_id=c.grand_slams group by p.player_id, p.player_name"]}
