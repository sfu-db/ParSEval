{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 424, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as( select year, 'wimbledon' col, wimbledon value from championships union all select year, 'fr_open' col, fr_open value from championships union all select year, 'us_open' col, us_open value from championships union all select year, 'au_open' col, au_open value from championships ) select temp.value as player_id , p.player_name, count(temp.value) as grand_slams_count from temp join players as p on temp.value=p.player_id group by temp.value order by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 425, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp1 as( select wimbledon as grand_slams from championships union all select fr_open as grand_slams from championships union all select us_open as grand_slams from championships union all select au_open as grand_slams from championships ) select player_id,player_name, count(grand_slams) as grand_slams_count from players inner join temp1 on player_id = grand_slams group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 426, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp_table as ( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships) select player_id, player_name, count(player_name) as grand_slams_count from temp_table left join players on player_id = winner group by player_id, player_name"]}
