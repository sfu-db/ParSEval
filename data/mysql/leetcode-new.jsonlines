{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 152, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select distinct activity.player_id, activity.device_id from activity join (select player_id, min(event_date) as event_date from activity group by player_id) as firstlogin on firstlogin.player_id = activity.player_id and firstlogin.event_date = activity.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 153, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select distinct a.player_id as player_id, a.device_id as device_id from activity as a, (select distinct player_id, min(event_date) as dt from activity group by player_id order by player_id, dt asc) as tmp where a.player_id = tmp.player_id and a.event_date = tmp.dt"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 154, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select distinct a.player_id, a.device_id from activity a inner join (select distinct player_id, min(event_date) as event_date from activity group by player_id) b on a.player_id = b.player_id and a.event_date = b.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 155, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select distinct a.player_id, a.device_id from activity a where (a.player_id ,a.event_date) in (select player_id, min(event_date) from activity group by player_id)"]}
