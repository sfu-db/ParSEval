{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 383, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as(select player_id, player_name, sum(wimbledon = player_id) wim, sum(fr_open = player_id) fr, sum(us_open = player_id) us, sum(au_open = player_id) au from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by player_id) select player_id, player_name, wim+fr+us+au as grand_slams_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 384, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as(select year,wimbledon as player from championships group by 1 union all select year,fr_open as player from championships group by 1 union all select year,us_open as player from championships group by 1 union all select year,au_open as player from championships group by 1) select player as player_id,player_name,count(player) as grand_slams_count from cte c join players p on c.player=p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 385, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte(player_id) as ( select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select player_id, player_name, count(player_id) grand_slams_count from cte natural join players group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 386, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte(player_id, champ) as ( select year, wimbledon from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships ) select champ as player_id, b.player_name, count(1) as grand_slams_count from cte a left join players b on a.champ = b.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 387, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as ( select p1.player_id, p1.player_name, (select sum(if(wimbledon=p1.player_id,1,0)+if(fr_open=p1.player_id,1,0)+if(us_open=p1.player_id,1,0)+if(au_open=p1.player_id,1,0)) from championships) as grand_slams_count from players p1 ) select * from cte1 where grand_slams_count<>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 388, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as ( select year, wimbledon as grand_slam from championships union all select year, fr_open as grand_slam from championships union all select year, us_open as grand_slam from championships union all select year, au_open as grand_slam from championships ) ,cte2 as ( select grand_slam as player_id, count(*) as grand_slams_count from cte1 group by player_id ) select cte2.player_id, p.player_name, cte2.grand_slams_count from cte2 join players p using(player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 389, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with get_player as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) ,grp as (select player_id , count(1) as grand_slams_count from get_player group by player_id) select p.player_id,q.player_name,grand_slams_count from grp p left join players q on p.player_id=q.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 390, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with grandslam_cte as ( select year ,'wimbledon' as event_name ,wimbledon as player_id from championships union all select year ,'fr_open' as event_name ,fr_open as player_id from championships union all select year ,'us_open' as event_name ,us_open as player_id from championships union all select year ,'au_open' as event_name ,au_open as player_id from championships ) select p.player_id ,p.player_name ,count(event_name) as grand_slams_count from players as p inner join grandslam_cte as c on c.player_id = p.player_id group by p.player_id ,p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 391, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with grandslam_cte as ( select year ,'wimbledon' as event_name ,wimbledon as player_id from championships union select year ,'fr_open' as event_name ,fr_open as player_id from championships union select year ,'us_open' as event_name ,us_open as player_id from championships union select year ,'au_open' as event_name ,au_open as player_id from championships ) select p.player_id ,p.player_name ,count(event_name) as grand_slams_count from players as p inner join grandslam_cte as c on c.player_id = p.player_id group by p.player_id ,p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 392, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with player_wins as( select players.player_id, players.player_name, count(1) cnt from championships join players on championships.wimbledon = players.player_id group by 1, 2 union all select players.player_id, players.player_name, count(1) cnt from championships join players on championships.fr_open = players.player_id group by 1, 2 union all select players.player_id, players.player_name, count(1) cnt from championships join players on championships.us_open = players.player_id group by 1, 2 union all select players.player_id, players.player_name, count(1) cnt from championships join players on championships.au_open = players.player_id group by 1, 2 ) select p.player_id, p.player_name, sum(cnt) grand_slams_count from player_wins p group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 393, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with slamz as ( select wimbledon as slammer,1 as total from championships union all select fr_open as slammer,1 as total from championships union all select us_open as slammer,1 as total from championships union all select au_open as slammer,1 as total from championships ) select slammer as player_id, player_name, sum(total) as grand_slams_count from slamz left join players on slammer=players.player_id group by slammer"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 394, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as ( select wimbledon as player_id,year,1 as num_slams from championships union all select au_open as player_id,year,1 as num_slams from championships union all select us_open as player_id,year,1 as num_slams from championships union all select fr_open as player_id,year,1 as num_slams from championships ) select p.player_id,p.player_name,sum(num_slams) as grand_slams_count from players p join t on p.player_id = t.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 395, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as (select a.player_id, a.player_name, ((select count(b.wimbledon) from championships b where b.wimbledon = a.player_id) + (select count(b.fr_open) from championships b where b.fr_open = a.player_id) + (select count(b.us_open) from championships b where b.us_open = a.player_id) + (select count(b.au_open) from championships b where b.au_open = a.player_id)) as grand_slams_count from players a ) select * from t where t.grand_slams_count <> 0 order by grand_slams_count desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 396, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as (select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships) select player_id, player_name, count(*) grand_slams_count from t join players p on t.winner=p.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 397, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as (select wimbledon as player_id, count(*) as slams_count from championships group by wimbledon), t2 as (select fr_open as player_id, count(*) as slams_count from championships group by fr_open ), t3 as (select us_open as player_id, count(*) as slams_count from championships group by us_open ), t4 as (select au_open as player_id, count(*) as slams_count from championships group by au_open ) ,temp as (select * from t union all select * from t2 union all select * from t3 union all select * from t4) select temp.player_id, player_name, sum(slams_count) as grand_slams_count from temp left join players on temp.player_id = players.player_id group by temp.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 398, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as (select year, wimbledon as t from championships union all select year, fr_open as t from championships union all select year, us_open as t from championships union all select year, au_open as t from championships) select p.player_id, p.player_name, count(*) as grand_slams_count from players as p inner join t on p.player_id = t.t group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 399, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t(id) as (select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select player_id,player_name,count(t.id) as grand_slams_count from t inner join players p on p.player_id=t.id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 400, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t0 as (select wimbledon as grand_slam from championships union all select fr_open as grand_slam from championships union all select us_open as grand_slam from championships union all select au_open as grand_slam from championships) select player_id, player_name, count(player_id) as grand_slams_count from players join t0 on player_id = grand_slam group by player_id having count(player_id) >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 401, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( select wimbledon as player_id, count(wimbledon) as win_count from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as win_count from championships group by fr_open union all select us_open as player_id, count(us_open) as win_count from championships group by us_open union all select au_open as player_id, count(au_open) as win_count from championships group by au_open) select t1.player_id, player_name, sum(win_count) as grand_slams_count from t1 join players on t1.player_id = players.player_id group by t1.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 402, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( select year,wimbledon as player_id from championships union all select year,fr_open as player_id from championships union all select year,us_open as player_id from championships union all select year,au_open as player_id from championships ) select player_id,player_name,count(t1.player_id) as grand_slams_count from players join t1 using (player_id) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 403, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as (select wimbledon as player_id , count(wimbledon) as cnt from championships group by wimbledon union all select fr_open as player_id , count(fr_open) as cnt from championships group by fr_open union all select us_open as player_id , count(us_open) as cnt from championships group by us_open union all select au_open as player_id , count(au_open) as cnt from championships group by au_open) select t1.player_id, player_name, sum(cnt) as grand_slams_count from t1 join players p on (t1.player_id = p.player_id) group by t1.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 404, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as (select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select t1.player_id, player_name, count(*) as grand_slams_count from t1 join players on t1.player_id = players.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 405, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as( select a.player_id,a.player_name, sum(a.player_id =b.wimbledon)+sum(a.player_id=b.fr_open)+sum(a.player_id=b.us_open)+sum(a.player_id=b.au_open) as grand_slams_count from players a join championships b on (a.player_id =b.wimbledon ) or (a.player_id =b.fr_open) or(a.player_id = b.us_open) or (a.player_id =b.au_open) group by player_id ) select player_id,player_name, grand_slams_count from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 406, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as(select wimbledon as game from championships union all select fr_open as game from championships union all select us_open as game from championships union all select au_open as game from championships ) select p.player_id, p.player_name, count(t1.game) as grand_slams_count from t1 join players as p on t1.game = p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 407, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tb1 as( select wimbledon as id,count(wimbledon) as w_num from championships group by wimbledon union all select fr_open,count(fr_open) from championships group by fr_open union all select us_open,count(us_open) as s_num from championships group by us_open union all select au_open,count(au_open) as a_num from championships group by au_open ) select player_id, player_name, sum(w_num) as grand_slams_count from players right join tb1 on player_id = id group by id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 408, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select temp.player_id, p.player_name, count(*) as grand_slams_count from temp join players p on temp.player_id=p.player_id group by temp.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 409, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select temp.player_id, p.player_name, count(*) as grand_slams_count from temp left join players p on temp.player_id = p.player_id group by temp.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 410, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select p.player_id, p.player_name from championships c left join players p on c.wimbledon = p.player_id union all select p.player_id, p.player_name from championships c left join players p on c.fr_open = p.player_id union all select p.player_id, p.player_name from championships c left join players p on c.us_open = p.player_id union all select p.player_id, p.player_name from championships c left join players p on c.au_open = p.player_id ) select player_id, player_name, count(*) as grand_slams_count from temp group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 411, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select wimbledon as player_id, count(*) one_gs_count, 'wimbledon' as grand_slam from championships group by wimbledon union all select fr_open as player_id, count(*) one_gs_count, 'fr_open' as grand_slam from championships group by fr_open union all select us_open as player_id, count(*) one_gs_count, 'us_open' as grand_slam from championships group by us_open union all select au_open as player_id, count(*) one_gs_count, 'au_open' as grand_slam from championships group by au_open ) select t.player_id, p.player_name, sum(one_gs_count) as grand_slams_count from temp t left join players p on t.player_id = p.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 412, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select id, count(*) as count from ( select year, 'wimbledon' as game, wimbledon as id from championships union select year, 'fr_open' as game, fr_open as id from championships union select year, 'us_open' as game, us_open as id from championships union select year, 'au_open' as game, au_open as id from championships ) as a group by id ) select p.player_id, p.player_name, count as grand_slams_count from players as p join temp on p.player_id=temp.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 413, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select player_id, count(*) as cnt from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) as t group by player_id ) select p.player_id, p.player_name, cnt as grand_slams_count from players as p join temp on p.player_id = temp.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 414, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select player_id, player_name, count(player_id) as num_tournament from players p inner join championships c on p.player_id = c.wimbledon group by 1,2 union all select player_id, player_name, count(player_id) as num_tournament from players p inner join championships c on p.player_id = c.fr_open group by 1,2 union all select player_id, player_name, count(player_id) as num_tournament from players p inner join championships c on p.player_id = c.us_open group by 1,2 union all select player_id, player_name, count(player_id) as num_tournament from players p inner join championships c on p.player_id = c.au_open group by 1,2 ) select player_id, player_name, sum(num_tournament) as grand_slams_count from temp group by 1,2 order by grand_slams_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 415, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select player_id, player_name, wcnt as cnt from players as p left join (select wimbledon, count(year) as wcnt from championships group by wimbledon) as w on player_id = wimbledon union all select player_id, player_name, fcnt as cnt from players as p left join (select fr_open, count(year) as fcnt from championships group by fr_open) as w on player_id = fr_open union all select player_id, player_name, ucnt as cnt from players as p left join (select us_open, count(year) as ucnt from championships group by us_open) as w on player_id = us_open union all select player_id, player_name, acnt as cnt from players as p left join (select au_open, count(year) as acnt from championships group by au_open) as w on player_id = au_open ) select player_id, player_name, sum( case when cnt is null then 0 else cnt end ) as grand_slams_count from temp group by player_id having grand_slams_count > 0"]}
