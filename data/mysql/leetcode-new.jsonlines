{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 739, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(visit_id) as count_no_trans from ( select v.customer_id, v.visit_id, t.transaction_id from visits v left join transactions t on v.visit_id = t.visit_id where t.transaction_id is null ) abc group by customer_id"]}
