{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 216, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id,'store1' as store,store1 as price from products where store1 > 0 union select product_id,'store2' as store,store2 price from products where store2 > 0 union select product_id,'store3' as store, store3 price from products where store3 > 0 order by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 217, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id,'store1' as store, store1 as price from products where store1 union select product_id,'store2' as store, store2 as price from products where store2 union select product_id,'store3' as store, store3 as price from products where store3"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 218, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with cte as (select product_id, max(case when store1 is not null then store1 end) as store, max(case when store1 is not null then store1 end) as price from products group by 1 union all select product_id, max(case when store2 is not null then store2 end) as store, max(case when store2 is not null then store2 end) as price from products group by 1 union all select product_id, max(case when store3 is not null then store3 end) as store, max(case when store3 is not null then store3 end) as price from products group by 1) select product_id,store,price from cte where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 219, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select p.product_id, 'store1' as store, p2.store1 as price from products p join products p2 on p.product_id = p2.product_id and p2.store1 is not null union select p.product_id, 'store2' as store, p2.store2 as price from products p join products p2 on p.product_id = p2.product_id and p2.store2 is not null union select p.product_id, 'store3' as store, p2.store3 as price from products p join products p2 on p.product_id = p2.product_id and p2.store3 is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 0, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select b.session_id from (select a.session_id, max(a.label) as max_label from (select p.session_id, case when a.timestamp < p.start_time or a.timestamp > p.end_time or a.timestamp is null then 0 else 1 end as label from playback as p left join ads as a on p.customer_id = a.customer_id) as a group by a.session_id) as b where b.max_label = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 1, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select distinct p.session_id from playback p left join ads a on p.customer_id = a.customer_id group by p.session_id having sum(case when a.timestamp between p.start_time and p.end_time then 1 else 0 end) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 2, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select distinct p.session_id from playback p left join ads a on (p.customer_id = a.customer_id and (a.timestamp between p.start_time and p.end_time)) where a.timestamp is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 3, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select distinct p.session_id from playback p left join ads a on (p.customer_id = a.customer_id and a.timestamp >= p.start_time and a.timestamp <= p.end_time) where a.timestamp is null"]}
