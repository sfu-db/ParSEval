{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 197, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with a as ( select count(*) as c1 from delivery where order_date = customer_pref_delivery_date ), b as ( select count(*) as c2 from delivery ) select round(coalesce(100*c1/c2, 0), 2) as immediate_percentage from a,b"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 198, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with a as( select (order_date = customer_pref_delivery_date ) as nb from delivery ) select round(sum(nb)/count(nb )*100,2) as immediate_percentage from a"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 199, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as ( select *, if(customer_pref_delivery_date=order_date,1,0) as immediate_d from delivery group by delivery_id ) select round(sum(immediate_d)/max(delivery_id)*100,2) as immediate_percentage from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 200, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as ( select delivery_id, (case when datediff(order_date,customer_pref_delivery_date) = 0 then 1 else 0 end) as flag from delivery ) select round(sum(flag)/count(flag),4)*100 as immediate_percentage from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 201, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as (select *, case when order_date = customer_pref_delivery_date then 1 else 0 end as immediate , case when order_date > customer_pref_delivery_date then 1 else 0 end as scheduled from delivery) select round(count(*)*100.00/(select count(*) from delivery),2) as immediate_percentage from cte where immediate = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 202, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as (select count(*) as c from delivery where order_date=customer_pref_delivery_date), cte2 as (select count(*) as total from delivery) select round((c/total)*100,2) as immediate_percentage from cte,cte2"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 203, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as (select delivery_id , customer_id , order_date , customer_pref_delivery_date, sum(case when order_date = customer_pref_delivery_date then 1 else 0 end) as immediate , sum(case when order_date <> customer_pref_delivery_date then 1 else 0 end) as scheduled from delivery) select round((immediate*100.00)/(select count(*) from delivery),2) as immediate_percentage from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 204, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as (select delivery_id, case when order_date = customer_pref_delivery_date then 1 else 0 end as df from delivery) select round(sum(df)/count(df)*100,2) as immediate_percentage from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 205, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as(select case when order_date = customer_pref_delivery_date then 'immediate' else 'scheduled' end temp from delivery) select round(avg(temp = 'immediate')*100,2) immediate_percentage from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 206, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as(select count(delivery_id) as cnt from delivery where order_date=customer_pref_delivery_date ) select round(((select cnt from cte)/count(delivery_id))*100 ,2) as immediate_percentage from delivery"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 207, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte1 as ( select * from delivery where order_date=customer_pref_delivery_date), cte2 as ( select count(order_date) as total from delivery) select round(ifnull(100*count(c1.order_date)/c2.total,0),2) as immediate_percentage from cte1 c1 cross join cte2 c2"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 208, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with delivery as( select sum(if (order_date = customer_pref_delivery_date,1,0)) as immediate_order , count(*) as total_order from delivery ) select round((immediate_order/total_order)*100,2) as immediate_percentage from delivery"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 209, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with im as ( select delivery_id from delivery group by delivery_id having sum(case when abs(datediff(order_date, customer_pref_delivery_date)) = 0 then 1 else 0 end) = 1) select round((count(im.delivery_id)/count(*))*100,2) as immediate_percentage from delivery d left join im on d.delivery_id = im.delivery_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 210, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with immediate as ( select order_date from delivery where order_date = customer_pref_delivery_date ) select round(count(*) * 100 / (select count(*) from delivery), 2) immediate_percentage from immediate"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 211, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with immediate_count as ( select count(*) as i_c from delivery where order_date = customer_pref_delivery_date ), total_count as ( select count(*) as t_c from delivery ) select truncate((i_c / t_c * 100),2) immediate_percentage from immediate_count, total_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 212, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with immediate_ind as ( select case when order_date = customer_pref_delivery_date then 1 else 0 end as ind from delivery ) select round(avg(ind) * 100, 2) as immediate_percentage from immediate_ind"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 213, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with main as ( select row_number() over() as num from delivery where order_date = customer_pref_delivery_date ) select case when round((select max(num) from main) / (select max(delivery_id) from delivery)*100, 2) is null then 0.00 else round((select max(num) from main) / (select max(delivery_id) from delivery)*100, 2) end as immediate_percentage"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 214, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with t as (select count(*) as immediate from delivery where order_date = customer_pref_delivery_date), a as (select count(*) as total from delivery ) select round (immediate/total * 100,2) as immediate_percentage from t ,a"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 215, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with t1 as (select case when order_date= customer_pref_delivery_date then 1 else 0 end as total_immediate_orders from delivery) select round(sum(total_immediate_orders)/count(total_immediate_orders)*100,2) as immediate_percentage from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 216, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with t1 as (select count(delivery_id) ct1 from delivery where order_date=customer_pref_delivery_date), t2 as (select count(delivery_id) ct2 from delivery) select round((ct1*100)/ct2,2) as immediate_percentage from t1,t2"]}
