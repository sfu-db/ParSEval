{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 305, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select tb2.winner as player_id,p.player_name,tb2.num as grand_slams_count from ( select winner,count(winner) as num from ( select wimbledon as winner from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) tb group by 1) tb2 join players p on tb2.winner=p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 306, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select win as player_id, player_name, count(win) as grand_slams_count from( select wimbledon as win from championships union all select fr_open as win from championships union all select us_open as win from championships union all select au_open as win from championships) as a join players as p on p.player_id = a.win group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 307, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select y.player_id, y.player_name, t.grand_slams_count from players as y, (select count(x.year) as grand_slams_count, x.c from (((select year, wimbledon as c from championships union all select year, fr_open as c from championships) union all select year, us_open as c from championships) union all select year, au_open as c from championships) as x group by x.c) as t where y.player_id = t.c"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 308, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ), c1 as ( select player_id, count(*) as grand_slams_count from c group by player_id ) select c1.player_id, p.player_name, c1.grand_slams_count from c1 inner join players as p on c1.player_id=p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 309, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, 'wimbledon' as match_name, wimbledon as player from championships union all select year, 'fr_open' as match_name, fr_open as player from championships union all select year, 'us_open' as match_name, us_open as player from championships union all select year, 'au_open' as match_name, au_open as player from championships ) select player_id, player_name, count(player) as grand_slams_count from cte inner join players p on cte.player=p.player_id group by player_id,player_name"]}
