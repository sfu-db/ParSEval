{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 3, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select cast((t.immediate/t.total_order_count)*100 as decimal(18,2)) as immediate_percentage from ( select count(1) as total_order_count, sum(case when order_date = customer_pref_delivery_date then 1 else 0 end) as immediate, sum(case when order_date != customer_pref_delivery_date then 1 else 0 end) as scheduled from delivery d ) as t"]}
