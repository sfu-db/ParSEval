{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 709, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product right join sales using(product_id) group by buyer_id having sum(case when product_name = 's8' then 1 else 0 end) > 0 and sum(case when product_name = 'iphone' then 1 else 0 end) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 710, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from (select a.buyer_id, b.product_name from sales as a left join product as b on a.product_id=b.product_id) as t1 where product_name='s8' and buyer_id not in (select a.buyer_id from sales as a left join product as b on a.product_id=b.product_id where b.product_name in ('g4','iphone'))"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 711, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s.buyer_id from sales s inner join product p on s.product_id = p.product_id where p.product_name = 's8' and s.buyer_id not in (select s1.buyer_id from sales s1 inner join product p1 on s1.product_id = p1.product_id where p1.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 712, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with temp as ( select buyer_id,product_name from sales t1 join product t2 on t1.product_id = t2.product_id), both_data as (select distinct buyer_id from temp where product_name in ('s8','iphone')), only_iphone as (select distinct buyer_id from temp where product_name in ('iphone')) select buyer_id from both_data where buyer_id not in (select buyer_id from only_iphone)"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 713, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct c.buyer_id from sales c join product d on c.product_id = d.product_id where product_name = 's8' and buyer_id not in (select f.buyer_id from sales f join product e on f.product_id = e.product_id where e.product_name = 'iphone')"]}
