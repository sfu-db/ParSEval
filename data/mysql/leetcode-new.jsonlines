{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 431, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as (select year, 'wimbledon' as comp, wimbledon as winner from championships union select year,'fr_open' as comp, fr_open as winner from championships union select year,'us_open' as comp, us_open as winner from championships union select year,'au_open' as comp, au_open as winner from championships ) select a.player_id, a.player_name, count(*) as grand_slams_count from players a inner join tmp b on a.player_id=b.winner group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 432, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as( select wimbledon as win from championships union all select fr_open as win from championships union all select us_open as win from championships union all select au_open as win from championships ) select p.player_id, p.player_name, count(win) as grand_slams_count from players as p left join tmp on p.player_id = tmp.win group by p.player_id having count(win) >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 433, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with total_wins_player as( select wimbledon as player_id, count(*) as wins from championships group by wimbledon union all select fr_open as player_id, count(*) as wins from championships group by fr_open union all select us_open as player_id, count(*) as wins from championships group by us_open union all select au_open as player_id, count(*) as wins from championships group by au_open) select a.player_id, player_name, a.grand_slams_count from (select player_id, sum(wins) as grand_slams_count from total_wins_player group by player_id)a join players p on p.player_id = a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 434, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tournament as ( select player_id, player_name from players join championships on player_id=wimbledon union all select player_id, player_name from players join championships on player_id=fr_open union all select player_id, player_name from players join championships on player_id=us_open union all select player_id, player_name from players join championships on player_id=au_open ) select player_id, player_name, count(player_id) as grand_slams_count from tournament group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 435, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tournaments as ( select year, 'wimbledon' as tournament, wimbledon as player_id from championships union all select year, 'fr_open' as tournament, fr_open as player_id from championships union all select year, 'us_open' as tournament, us_open as player_id from championships union all select year, 'au_open' as tournament, au_open as player_id from championships ) select p.player_id, p.player_name, count(year) as grand_slams_count from players p join tournaments t on p.player_id = t.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 436, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with w as ( select wimbledon id , count(1) amount from championships group by 1), f as (select fr_open id , count(1) amount from championships group by 1), u as (select us_open id , count(1) amount from championships group by 1), a as (select au_open id , count(1) amount from championships group by 1), all1 as (select * from w union all select * from f union all select * from u union all select * from a) select id player_id, players.player_name, sum(amount) grand_slams_count from all1 left join players on all1.id = players.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 437, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with w as( select year, wimbledon id from championships), f as (select year, fr_open id from championships), u as (select year, us_open id from championships), a as (select year, au_open id from championships) select p.player_id, p.player_name, count(c.id) grand_slams_count from (select * from w union all select * from f union all select * from u union all select * from a) c left join players p on c.id = p.player_id group by p.player_name order by p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 438, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with w_wins as ( select wimbledon as id, count(*) as w_w from championships group by wimbledon ) , f_wins as ( select fr_open as id, count(*) as f_w from championships group by fr_open ) , u_wins as ( select us_open as id, count(*) as u_w from championships group by us_open ) , au_wins as ( select au_open as id, count(*) as a_w from championships group by au_open ) , win_count as ( select player_id, player_name, ifnull(w_wins.w_w,0) as ww, ifnull(f_wins.f_w,0) as fw, ifnull(u_wins.u_w,0) as uw, ifnull(au_wins.a_w,0) as aw from players left join w_wins on players.player_id = w_wins.id left join f_wins on players.player_id = f_wins.id left join u_wins on players.player_id = u_wins.id left join au_wins on players.player_id = au_wins.id ) select player_id, player_name, ww + fw + uw + aw as grand_slams_count from win_count where ww >0 or fw >0 or uw >0 or aw >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 439, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimb as ( select p.player_id, p.player_name, count(*) titles from players p join championships c on p.player_id = c.wimbledon group by player_id union all select p.player_id, p.player_name, count(*) titles from players p join championships c on p.player_id = c.fr_open group by player_id union all select p.player_id, p.player_name, count(*) titles from players p join championships c on p.player_id = c.us_open group by player_id union all select p.player_id, p.player_name, count(*) titles from players p join championships c on p.player_id = c.au_open group by player_id) select wimb.player_id, wimb.player_name, sum(wimb.titles) as grand_slams_count from wimb group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 440, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimb as (select wimbledon as player_id, count(*) as cnt from championships group by wimbledon union all select fr_open as player_id, count(*) as cnt from championships group by fr_open union all select us_open as player_id, count(*) as cnt from championships group by us_open union all select au_open as player_id, count(*) as cnt from championships group by au_open) select w.player_id as player_id, p.player_name as player_name, sum(cnt) as grand_slams_count from wimb w, players p where p.player_id = w.player_id group by w.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 441, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimbledon as (select p.*, 'wimbledon' from players p inner join championships w on p.player_id = w.wimbledon), fr as (select p.*, 'fr_open' from players p inner join championships w on p.player_id = w.fr_open), au as (select p.*, 'au_open' from players p inner join championships w on p.player_id = w.au_open), us as (select p.*, 'us_open' from players p inner join championships w on p.player_id = w.us_open), all_champ as ( select * from wimbledon union all select * from fr union all select * from au union all select * from us ) select player_id, player_name, count(*) as grand_slams_count from all_champ group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 442, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimbledon as( select wimbledon as player_id, count(*) as wins from championships group by wimbledon), fr_open as( select fr_open as player_id, count(*) as wins from championships group by fr_open), us_open as( select us_open as player_id, count(*) as wins from championships group by us_open), au_open as( select au_open as player_id, count(*) as wins from championships group by au_open), total_wins_player as( select * from wimbledon union all select * from fr_open union all select * from us_open union all select * from au_open ) select a.player_id, player_name, a.grand_slams_count from (select player_id, sum(wins) as grand_slams_count from total_wins_player group by player_id)a join players p on p.player_id = a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 443, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with win as (select wimbledon as player_id, year from championships union all select fr_open as player_id, year from championships union all select us_open as player_id, year from championships union all select au_open as player_id, year from championships order by player_id, year) select a.player_id, b.player_name, count(a.year) as grand_slams_count from win as a left outer join players as b on a.player_id=b.player_id group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 444, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with win_occ as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select players.player_id, player_name, count(*) as grand_slams_count from players inner join win_occ on players.player_id = win_occ.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 445, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winner as ( select winner, count(game) as grand_slams_count from ( select year, 'w' as game, wimbledon as winner from championships union select year, 'f' as game, fr_open as winner from championships union select year, 'u' as game, us_open as winner from championships union select year, 'a' as game, au_open as winner from championships ) as a group by 1 ) select a.*, b.grand_slams_count from players a inner join winner b on a.player_id=b.winner"]}
