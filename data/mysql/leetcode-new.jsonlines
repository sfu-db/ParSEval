{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 324, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with v as ( select player_id, min(event_date) as first_log from activity group by player_id ) select round( count(v.player_id) / (select count(*) from v), 2) as fraction from v inner join activity a on v.player_id = a.player_id where date_add( v.first_log, interval 1 day) = a.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 325, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct b.player_id) / count(distinct a.player_id), 2) as fraction from activity a left join (select player_id, min(event_date) as first_date from activity group by player_id) b on a.player_id = b.player_id and datediff(a.event_date, b.first_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 326, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with retention (select d1.player_id, max(if(d2.player_id is not null,1,0)) as retained_1d from ( select player_id, min(event_date) as first_event_date from activity group by 1 ) d1 left join activity d2 on d1.player_id = d2.player_id and d1.first_event_date + interval 1 day = d2.event_date group by 1 ) select round(avg(retained_1d),2) as fraction from retention"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 327, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct(a1.player_id))/(select count(distinct a.player_id) from activity a), 2) as fraction from activity a1 inner join (select player_id, min(event_date) as new_event_date from activity t1 group by 1) as t1 on a1.player_id = t1.player_id and datediff(a1.event_date, t1.new_event_date)= 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 328, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round( ( with cte as ( select t.player_id, min(t.event_date) as first_login from activity t group by player_id) select count(distinct t1.player_id) from cte t1 left join activity t2 on (t1.player_id, t1.first_login + 1) = (t2.player_id, t2.event_date) where t2.player_id is not null ) / (select count(distinct player_id) from activity ) ,2) as fraction"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 329, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct b.player_id) / count(distinct a.player_id),2) as fraction from (select player_id, min(event_date) first_login from activity group by player_id ) a left join activity b on a.player_id = b.player_id and a.first_login + 1 = b.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 330, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with cte as ( select player_id, min(event_date) as first_login from activity group by player_id ) select round(sum(case when datediff(event_date, first_login)=1 then 1 else 0 end)/count(distinct cte.player_id),2) as fraction from activity as sub join cte on cte.player_id=sub.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 331, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with player_first_logins as ( select player_id , first_login , date_add(first_login, interval 1 day) as day_after from ( select player_id , min(event_date) as first_login from activity group by 1 ) as first_login ) select round(sum(case when p.day_after is not null then 1 else 0 end)/count(distinct a.player_id),2) as fraction from activity a left join player_first_logins p on p.player_id = a.player_id and p.day_after = a.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 332, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with tb as ( select player_id, min(event_date) as first_date from activity group by player_id ), tb1 as ( select s.player_id from tb as f join activity as s on datediff(s.event_date, f.first_date) = 1 and f.player_id = s.player_id ) select round((select count(distinct player_id) from tb1)/(select count(distinct player_id) from tb),2) as fraction"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 333, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with t1 as ( select player_id, min(event_date) as event_date from activity group by player_id ), t2 as ( select count(t1.player_id) as num from t1 join activity on t1.player_id = activity.player_id and datediff(activity.event_date,t1.event_date) = 1 ) select round(ifnull((select num from t2),0)/(select count(distinct(player_id)) from activity),2) as fraction"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 334, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(a2.player_id)/count(f.player_id), 2) as fraction from ( select a1.player_id, min(a1.event_date) as event_date from activity as a1 group by a1.player_id ) as f left join activity as a2 on f.player_id = a2.player_id and f.event_date = a2.event_date - '1'"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 335, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct a1.player_id)/(select count(distinct player_id) from activity),2) as fraction from activity a1 where (a1.player_id, a1.event_date) in (select player_id, date_add(min(event_date), interval 1 day) as sec_day from activity group by player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 336, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(t1.player_id)/ (select count(distinct(player_id)) from activity), 2) as fraction from ( select player_id, min(event_date) as event_date from activity group by player_id ) as t1, activity as t2 where (to_days(t1.event_date)) = (to_days(t2.event_date)-1) and t1.player_id = t2.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 337, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with f as ( select player_id, min(event_date) as first_date from activity group by player_id ) select round(count(*) / (select count(player_id) from f), 2) as fraction from f, activity a where f.player_id = a.player_id and datediff(a.event_date, f.first_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 338, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(a4.conse_login/(select count(distinct player_id) from activity),2)as fraction from (select count(*) as conse_login from(select player_id,min(event_date)as first_login from activity group by player_id)a1 left join (select a3.player_id, a3.event_date as second_login from (select player_id, event_date,dense_rank()over(partition by player_id order by event_date)as rank_2 from activity)a3 where a3.rank_2=2)a2 on a1.player_id=a2.player_id where datediff(a2.second_login,a1.first_login)=1)a4"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 339, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with first_two as (select player_id, event_date, rank() over(partition by player_id order by event_date) as rnk from activity), first_two_2 as (select player_id, event_date, rnk, lead(event_date, 1)over(partition by player_id order by event_date) as day2 from first_two where rnk = 1 or rnk = 2), numerator as (select count(distinct player_id) as numerator from first_two_2 where datediff(day2, event_date) = 1), denominator as (select count(distinct player_id) as denominator from activity) select round(numerator/denominator,2) as fraction from numerator, denominator"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 340, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(sum(res)/count(distinct player_id),2) as fraction from (select if(datediff(b.event_date,a.event_date) = 1,1,0) as res, a.player_id from (select player_id, min(event_date) as event_date from activity group by player_id) as a left join activity b on a.player_id = b.player_id )c"]}
