{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 136, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id,a.name,b.reports_count,b.average_age from employees a join (select distinct(reports_to) as manager, count(reports_to) as reports_count, round(avg(age)) as average_age from employees where reports_to is not null group by reports_to) b on a.employee_id = b.manager order by a.employee_id"]}
