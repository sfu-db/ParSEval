{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 743, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with tb1 as ( select a.buyer_id, max(case when b.product_name='s8' then 1 else 0 end) as ind_s8, max(case when b.product_name='iphone' then 1 else 0 end) as ind_phn from sales a join product b on a.product_id=b.product_id group by 1 ) select buyer_id from tb1 where ind_s8=1 and ind_phn=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 744, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales s1 join product p1 on s1.product_id = p1.product_id and p1.product_name = 's8' and buyer_id not in ( select distinct buyer_id from sales s1 join product p1 on s1.product_id = p1.product_id and p1.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 745, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product as a1 join sales as a2 on a1.product_id=a2.product_id group by 1 having sum(case when product_name='s8' then 1 else 0 end)>0 and sum( case when product_name='iphone' then 1 else 0 end)=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 746, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with a as (select product_name, buyer_id from product p join sales s on p.product_id = s.product_id), b as (select distinct buyer_id from a where product_name = 'iphone') select distinct buyer_id from a where product_name = 's8' and buyer_id not in (select * from b)"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 747, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s.buyer_id from sales s left join product p on p.product_id = s.product_id group by s.buyer_id having sum(case when p.product_name='iphone' then 1 else 0 end) = 0 and sum(case when p.product_name='s8' then 1 else 0 end) >0"]}
