{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 141, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance as i1 where i1.tiv_2015 in (select i2.tiv_2015 from insurance i2 where i1.pid != i2.pid) and (i1.lat, i1.lon) not in (select lat, lon from insurance i3 where i1.pid != i3.pid)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 142, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance i1 where i1.tiv_2015 in (select i2.tiv_2015 from insurance i2 where i1.pid != i2.pid) and (i1.lat, i1.lon) not in (select lat, lon from insurance i3 where i1.pid != i3.pid)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 143, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from (select *, count(*) over(partition by lat, lon) as cnt1, count(*) over(partition by tiv_2015) as cnt2 from insurance ) a where cnt1 = 1 and cnt2 >= 2"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 144, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance where (lat,lon) in (select lat,lon from insurance group by 1,2 having count(*)=1) and tiv_2015 in (select tiv_2015 from insurance group by 1 having count(*)>1)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 145, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) tiv_2016 from (select distinct a.pid pid, a.tiv_2016 tiv_2016 from insurance a join insurance b where a.pid != b.pid and a.tiv_2015=b.tiv_2015 and a.pid not in ( select c.pid from insurance c join insurance d where c.pid!=d.pid and c.lat=d.lat and c.lon=d.lon ) ) r1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 146, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(a.tiv_2016) tiv_2016 from ( select a.tiv_2016, a.lat, a.lon, count(*) over (partition by a.tiv_2015) row_number from insurance a ) a inner join ( select lat,lon,count(*) from insurance group by lat,lon having count(*) = 1 ) b on a.lat = b.lat and a.lon = b.lon where a.row_number > 1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 147, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016 ) as tiv_2016 from insurance a where (select count(*) from insurance b where a.lat=b.lat and a.lon=b.lon)=1 and (select count(*) from insurance c where a.tiv_2015=c.tiv_2015)>1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 148, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from (select * from insurance group by concat(lat, lon) having count(pid)=1) b where pid not in (select distinct pid from insurance group by tiv_2015 having count(pid)=1)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 149, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) tiv_2016 from ( select *, count(*) over (partition by tiv_2015) cnt1, count(*) over (partition by lat,lon) cnt2 from insurance ) t where cnt1 >1 and cnt2=1"]}
