{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 878, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select (select player_id,sum(grand_slams_count) as grand_slams_count from ( select wimbledon as player_id , count(*) as grand_slams_count from championships group by player_id union all select fr_open as player_id , count(*) as grand_slams_count from championships group by player_id union all select us_open as player_id , count(*) as grand_slams_count from championships group by player_id union all select au_open as player_id , count(*) as grand_slams_count from championships group by player_id )a group by player_id)b join (select * from players)p on p.player_id=b.player_id"]}
