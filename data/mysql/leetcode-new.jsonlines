{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 97, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(price*units)/sum(units),2)as average_price from unitssold u left join prices p on u.product_id=p.product_id and purchase_date between start_date and end_date group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 98, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(u.units*p.price) / sum(u.units) , 2) as average_price from prices as p inner join unitssold as u on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 99, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id,round(sum(price*units)/sum(units),2) as average_price from prices inner join unitssold using(product_id) where unitssold.purchase_date between prices.start_date and prices.end_date group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 100, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round((sum((a.price * b.units)) / sum(b.units)), 2) as average_price from prices a join unitssold b on a.product_id = b.product_id and (b.purchase_date >= a.start_date and b.purchase_date <= a.end_date) group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 101, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id,round(sum(a.units*b.price)/sum(a.units),2) as average_price from unitssold a join prices b on a.product_id = b.product_id and a.purchase_date between b.start_date and b.end_date group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 102, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select d.product_id, round((sum(price*units)+0.00)/(sum(units)+0.00),2) as average_price from( select * from prices p natural join unitssold u where u.purchase_date between p.start_date and p.end_date) d group by d.product_id"]}
