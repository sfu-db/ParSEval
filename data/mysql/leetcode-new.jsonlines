{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 0, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "from ( select sum(b.apple_count) as ba, sum(b.orange_count) as bo, sum(ifnull(c.apple_count,0)) as ca, sum(ifnull(c.orange_count,0)) as co from boxes b left outer join chests c on (b.chest_id = c.chest_id) ) as t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 1, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select (sum(b.apple_count) + ifnull(sum(c.apple_count),0)) as apple_count, (sum(b.orange_count) + ifnull(sum(c.orange_count),0)) as orange_count from boxes b left join chests c on c.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 2, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select coalesce(sum(b.apple_count),0)+coalesce(sum(c.apple_count),0) apple_count,coalesce(sum(b.orange_count),0)+coalesce(sum(c.orange_count),0) orange_count from boxes b left join chests c using(chest_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 3, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select d.apple_count, d.orange_count from (select sum(a.a_count) over (order by a_count) apple_count, sum(a.o_count) over (order by a_count) orange_count from (select coalesce(b.apple_count + c.apple_count, b.apple_count) a_count, coalesce(b.orange_count + c.orange_count, b.orange_count) o_count from boxes b left join chests c on b.chest_id = c.chest_id) a) d order by d.apple_count desc limit 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 4, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select ifnull(sum(b.apple_count), 0) + ifnull(sum(c.apple_count), 0) as apple_count, ifnull(sum(b.orange_count), 0) + ifnull(sum(c.orange_count), 0) as orange_count from boxes as b left join chests as c on b.chest_id = c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 5, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select ifnull(sum(b.apple_count), 0) + ifnull(sum(c.apple_count), 0) as apple_count, ifnull(sum(b.orange_count), 0) + ifnull(sum(c.orange_count), 0) as orange_count from boxes b left join chests c using (chest_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 6, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum( b.apple_count + coalesce( c.apple_count, 0) ) apple_count ,sum( b.orange_count + coalesce( c.orange_count, 0) ) orange_count from boxes b left join chests c using(chest_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 7, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum( b.apple_count + if(c.chest_id, c.apple_count, 0) ) as apple_count, sum( b.orange_count + if(c.chest_id, c.orange_count, 0) ) as orange_count from boxes as b left join chests as c on b.chest_id=c.chest_id"]}
