{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 287, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t as(select company_id, employee_id , employee_name , salary , max(salary) over (partition by company_id) as max_salary from salaries), new_t as (select company_id, employee_id , employee_name , salary, ( case when max_salary<1000 then 0 when max_salary >= 1000 and max_salary <= 10000 then 0.24 when max_salary > 10000 then 0.49 end) as tax_percent from t) select company_id, employee_id , employee_name , round(salary*(1-tax_percent),0) as salary from new_t"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 288, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t1 as ( select *, max(salary) over (partition by company_id) as max_salary from salaries ) select company_id, employee_id, employee_name, round(case when max_salary < 1000 then salary when max_salary between 1000 and 10000 then (0.76*salary) else (0.51*salary) end) as salary from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 289, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t1 as ( select s1.*, s2.max_salary from salaries s1 join ( select company_id, max(salary) as max_salary from salaries group by company_id ) s2 on s1.company_id = s2.company_id ) select company_id, employee_id, employee_name, case when max_salary < 1000 then round(salary,0) when max_salary between 1000 and 10000 then round(salary*0.76,0) when max_salary > 10000 then round(salary * 0.51,0) end as salary from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 290, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t1 as (select company_id, max(salary) as max_s from salaries group by 1), t2 as (select company_id, case when max_s < 1000 then 1 when max_s <= 10000 then 0.76 else 0.51 end as tax from t1) select a.company_id, employee_id, employee_name, round(a.salary*tax) as salary from salaries a join t2 on a.company_id = t2.company_id"]}
