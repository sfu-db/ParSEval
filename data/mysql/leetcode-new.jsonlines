{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 630, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with temp as ( select v.*,t.transaction_id from visits v left join transactions t on v.visit_id = t.visit_id), temp1 as ( select customer_id,temp.transaction_id from temp where transaction_id is null) select customer_id,count(customer_id) as count_no_trans from temp1 group by customer_id"]}
