{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 148, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select distinct p1.product_id, p2.price store1, p3.price store2, p4.price store3 from products p1 left join products p2 on p1.product_id=p2.product_id and p2.store='store1' left join products p3 on p1.product_id=p3.product_id and p3.store='store2' left join products p4 on p1.product_id=p4.product_id and p4.store='store3'"]}
