{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 399, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select s.product_id, round(sum(s.units*p.price)/sum(s.units),2) as average_price from prices as p inner join unitssold as s on p.product_id = s.product_id where s.purchase_date between p.start_date and p.end_date group by s.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 400, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id as product_id,round(sum(price*units)/sum(units),2) as average_price from prices, unitssold where prices.product_id=unitssold.product_id and purchase_date between start_date and end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 401, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t2.product_id, round(t2.revenue/t2.amt,2) as average_price from (select a.product_id, sum(a.units*b.price) as revenue, sum(a.units) as amt from unitssold a left join prices b on (a.product_id=b.product_id and a.purchase_date>=b.start_date and a.purchase_date<=b.end_date) group by a.product_id)t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 402, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id,round(sum(sales)/sum(units),2) as average_price from (select p.product_id,p.price*u.units as sales, u.units from prices as p join unitssold as u on p.product_id=u.product_id where u.purchase_date between p.start_date and p.end_date) as j group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 403, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(p.price * u.units)/sum(u.units),2) as average_price from unitssold u left join prices p on u.product_id = p.product_id and u.purchase_date between start_date and end_date group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 404, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(u.units * p.price) / sum(u.units), 2) as average_price from prices p join unitssold u on p.product_id=u.product_id and u.purchase_date between p.start_date and p.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 405, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price*u.units)/sum(u.units),2) as average_price from prices p inner join unitssold u on p.product_id = u.product_id where start_date<=purchase_date and purchase_date<=end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 406, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round((sum(price*units) / sum(units)), 2) as average_price from prices join unitssold on prices.product_id = unitssold.product_id and purchase_date between start_date and end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 407, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price*u.units)/sum(u.units),2) as average_price from prices as p left join unitssold as u on p.product_id = u.product_id and p.start_date<=u.purchase_date and p.end_date>=u.purchase_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 408, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with avg_price as ( select u.product_id, sum(p.price * u.units) as tot_price, sum(u.units) as cnt from unitssold u inner join prices p on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date group by u.product_id ) select product_id, round(tot_price / cnt, 2) as average_price from avg_price"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 409, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t1 as( select p.product_id as product_id, s.units as quantity, p.price*s.units as sales from prices p left join unitssold s on p.product_id=s.product_id and s.purchase_date between p.start_date and p.end_date ) select t1.product_id as product_id, round(sum(t1.sales)/sum(t1.quantity),2) as average_price from t1 group by t1.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 410, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units)/ sum(u.units), 2) as average_price from prices p join unitssold u on u.purchase_date between p.start_date and p.end_date and p.product_id = u.product_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 411, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(units*price)/sum(units), 2) as average_price from unitssold u left join prices p on u.product_id=p.product_id and (purchase_date between start_date and end_date) group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 412, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select temp.product_id as product_id, round(sum(temp.units * temp.product_price) / sum(temp.units), 2) as average_price from (select prices.price as product_price, prices.product_id, unitssold.units from unitssold join prices on unitssold.product_id = prices.product_id where unitssold.purchase_date between prices.start_date and prices.end_date ) as temp group by temp.product_id"]}
