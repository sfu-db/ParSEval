{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 359, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select visits.customer_id, sum(case when transactions.transaction_id is null then 1 else 0 end) as count_no_trans from visits left join transactions on visits.visit_id = transactions.visit_id group by visits.customer_id having count_no_trans > 0"]}
