{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 421, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round((avg(rating / position)), 2) as quality, round(((sum(case when rating < 3 then 1 else 0 end)) / count(*)) * 100.0, 2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 422, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with tmp as ( select distinct query_name, result, position,rating from queries ) select query_name, round(avg(rating/position),2) as quality, round(100*avg(rating < 3),2) as poor_query_percentage from tmp group by query_name"]}
