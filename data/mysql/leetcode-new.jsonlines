{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 466, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte1 as (select follower, count(followee) as followee_cnt from follow group by follower), cte2 as (select followee, count(follower) as follower_cnt from follow group by followee) select a.follower, follower_cnt as num from cte1 a join cte2 b on a.follower = b.followee order by a.follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 467, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with table1 as (select followee , count(*) as follower_count from follow group by followee), table2 as (select follower , count(*) as following_count from follow group by follower) select follower , follower_count as num from table1 t1 inner join table2 t2 on t1.followee = t2.follower order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 468, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followee as ( select followee as id from follow f group by 1 having count(*)>=1 ) , follower as ( select follower as id from follow f group by 1 having count(*)>=1 ), cte as ( select a.id from followee a join follower b on a.id=b.id) select id as follower, count( follower) as num from cte join follow c on cte.id=c.followee group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 469, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select f2.followee as follower, count(distinct f2.follower) as num from follow as f1 join follow as f2 on f1.follower = f2.followee group by f2.followee order by f2.followee"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 470, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with user_list as ( select followee as user from follow union select follower as user from follow) ,cte2 as ( select follower as user from follow group by 1 having count(followee) >= 1 ), cte3 as ( select followee as user, count(follower) as num from follow group by 1 having count(follower) >= 1 ) select u.user as follower ,cte3.num from user_list u join cte3 on u.user = cte3.user where u.user in (select user from cte2) order by 1 asc"]}
