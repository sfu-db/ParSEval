{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 184, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(c.tiv_2016) as tiv_2016 from ( select a.pid, a.tiv_2015,a.tiv_2016,a.lat,a.lon from insurance a inner join insurance b on a.tiv_2015 = b.tiv_2015 and a.pid != b.pid group by a.pid, a.tiv_2015,a.tiv_2016,a.lat,a.lon )c left join insurance d on (c.lat = d.lat) and (c.lon = d.lon) and c.pid != d.pid where d.pid is null"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 185, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(distinct a.tiv_2016) as tiv_2016 from (select * from insurance group by lat, lon having count(*) = 1) as a, insurance as b where a.pid != b.pid and a.tiv_2015 = b.tiv_2015"]}
