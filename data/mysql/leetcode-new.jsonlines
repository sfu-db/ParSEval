{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 767, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(p.player_id = c.wimbledon) + sum(p.player_id = c.fr_open) + sum(p.player_id = c.us_open) + sum(p.player_id = c.au_open) as grand_slams_count from players p join championships c on (p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open) group by p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 768, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(p.player_id) as grand_slams_count from( select p.player_id, p.player_name from players p join championships c on p.player_id = c.wimbledon union all select p.player_id, p.player_name from players p join championships c on p.player_id = c.fr_open union all select p.player_id, p.player_name from players p join championships c on p.player_id = c.us_open union all select p.player_id, p.player_name from players p join championships c on p.player_id = c.au_open ) p group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 769, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as( select wimbledon cha, count(*) c from championships group by wimbledon union all select fr_open cha, count(*) c from championships group by fr_open union all select us_open cha, count(*) c from championships group by us_open union all select au_open cha, count(*) c from championships group by au_open ), t1 as( select cha, sum(c) grand_slams_count from t group by cha ) select t1.cha player_id, p.player_name , t1.grand_slams_count from t1 left join players p on t1.cha=p.player_id"]}
