{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 750, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select pa.player_id, pa.player_name, a.grand_slams_count from ( select p.player_id, sum( if(c.wimbledon=p.player_id, 1, 0) +if(c.fr_open=p.player_id, 1, 0) +if(c.us_open=p.player_id, 1, 0) +if(c.au_open=p.player_id, 1, 0)) as grand_slams_count from players p, championships c group by p.player_id) a join players pa on a.player_id=pa.player_id where grand_slams_count!=0 order by grand_slams_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 751, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ((select wimbledon as player_id from championships) union all (select fr_open as player_id from championships) union all (select us_open as player_id from championships) union all (select au_open as player_id from championships)), num as (select player_id, count(*) as grand_slams_count from cte group by 1) select num.player_id, player_name, grand_slams_count from num join players on players.player_id=num.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 752, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(wimbledon + french_open + us_open + aus_open) as grand_slams_count from (select p.*, c.year, case when c.wimbledon = player_id then 1 else 0 end as wimbledon, case when c.fr_open = player_id then 1 else 0 end as french_open, case when c.us_open = player_id then 1 else 0 end as us_open, case when c.au_open = player_id then 1 else 0 end as aus_open from players as p cross join championships as c order by player_id) as t group by 1,2 having grand_slams_count != 0"]}
