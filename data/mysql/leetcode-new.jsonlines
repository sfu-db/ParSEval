{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 285, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, wimbledon + fr_open + us_open + au_open as grand_slams_count from ( select t1.player_id, t1.player_name, sum(if(player_id = t2.wimbledon, 1, 0)) as wimbledon, sum(if(player_id = t2.fr_open, 1, 0)) as fr_open, sum(if(player_id = t2.us_open, 1, 0)) as us_open, sum(if(player_id = t2.au_open, 1, 0)) as au_open from players t1 join championships t2 on t2.wimbledon = t1.player_id or t2.fr_open = t1.player_id or t2.us_open = t1.player_id or t2.au_open = t1.player_id group by t1.player_id ) t"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 286, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id,player_name, (win+fr+us+au) as grand_slams_count from( select player_id,player_name, sum(case when wimbledon=player_id then 1 else 0 end) as win, sum(case when fr_open=player_id then 1 else 0 end) as fr, sum(case when us_open=player_id then 1 else 0 end) as us, sum(case when au_open=player_id then 1 else 0 end) as au from championships, players group by player_id,player_name) a where (win+fr+us+au)>0"]}
