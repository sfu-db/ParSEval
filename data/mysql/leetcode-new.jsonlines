{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 20, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, case when sum(store = 'store1') = 0 then null else sum((store = 'store1') * price) end as store1, case when sum(store = 'store2') = 0 then null else sum((store = 'store2') * price) end as store2, case when sum(store = 'store3') = 0 then null else sum((store = 'store3') * price) end as store3 from products group by product_id"]}
