{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 61, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select distinct date_id, make_name, count(distinct lead_id) unique_leads, count(distinct partner_id) unique_partners from dailysales group by date_id, make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 62, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, (select count(distinct(lead_id)) from dailysales as d where dailysales.date_id = d.date_id and dailysales.make_name = d.make_name) as unique_leads, (select count(distinct(partner_id)) from dailysales as d1 where dailysales.date_id = d1.date_id and dailysales.make_name = d1.make_name) as unique_partners from dailysales group by date_id,make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 63, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, (select count(distinct(lead_id)) from dailysales d where d.date_id=ds.date_id and d.make_name=ds.make_name) as unique_leads, (select count(distinct(partner_id)) from dailysales d where d.date_id=ds.date_id and d.make_name=ds.make_name) as unique_partners from dailysales ds group by date_id,make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 64, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, sum(case when lead_id not in (0) then 1 end) unique_leads, sum(case when partner_id not in (0) then 1 end) unique_partners from ( (select date_id,make_name, lead_id+1 as lead_id, 0 as partner_id from dailysales group by 1,2,3 ) union all (select date_id,make_name, 0 as lead_id, partner_id+1 as partner_id from dailysales group by 1,2,4 )) as a group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 65, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "with sale_lead as (select date_id, make_name, count(distinct lead_id) as unique_leads from dailysales group by date_id, make_name), sale_partner as (select date_id, make_name, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name) select l1.date_id, l1.make_name, l1.unique_leads, p1.unique_partners from sale_lead l1 inner join sale_partner p1 on l1.date_id = p1.date_id and l1.make_name = p1.make_name"]}
