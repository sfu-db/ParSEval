{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 129, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with tmp as (select *, if(store = 'store1', price, null) store1, if(store = 'store2', price, null) store2, if(store = 'store3', price, null) store3 from products) select product_id, sum(store1) store1, sum(store2) store2, sum(store3) store3 from tmp group by product_id"]}
