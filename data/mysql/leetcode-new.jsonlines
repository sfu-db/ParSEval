{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 333, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with t1 as(select employee_id, count(*) as c from employee group by employee_id), t2 as(select e.*, c from employee as e left join t1 using(employee_id)) select employee_id,department_id from t2 where c=1 or primary_flag='y'"]}
