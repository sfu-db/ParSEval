{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 114, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(a.apple_count) apple_count, sum(a.orange_count) orange_count from ( select box_id , case when c.apple_count is null then b.apple_count else (c.apple_count+b.apple_count) end as apple_count, case when c.orange_count is null then b.orange_count else (c.orange_count+b.orange_count) end as orange_count from boxes b left join chests c on b.chest_id=c.chest_id) a"]}
