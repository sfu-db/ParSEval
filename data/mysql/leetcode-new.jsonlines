{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 187, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, a.player_name, count(b.win) as grand_slams_count from players a join (select year, wimbledon as win from championships union all select year, fr_open as win from championships union all select year, us_open as win from championships union all select year, au_open as win from championships) b on a.player_id=b.win group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 188, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, a.player_name, sum(a.player_id = b.wimbledon) + sum(a.player_id = b.fr_open) + sum(a.player_id = b.us_open) + sum(a.player_id = b.au_open) as grand_slams_count from players a join championships b on a.player_id = b.wimbledon or a.player_id = b.fr_open or a.player_id = b.us_open or a.player_id = b.au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 189, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, a.player_name, sum(a.w) as grand_slams_count from ( select p.player_id, p.player_name, ((case when c.wimbledon = p.player_id then 1 else 0 end) + (case when c.fr_open = p.player_id then 1 else 0 end) + (case when c.us_open = p.player_id then 1 else 0 end) + (case when c.au_open = p.player_id then 1 else 0 end)) as w from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open) a group by a.player_id, a.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 190, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, a.player_name, truncate(a.grand_slams_count,0) as grand_slams_count from (select p.player_id, p.player_name, sum(case when c.wimbledon = p.player_id then c.wimbledon else 0 end)/p.player_id + sum(case when c.fr_open = p.player_id then c.fr_open else 0 end)/p.player_id + sum(case when c.us_open = p.player_id then c.us_open else 0 end)/p.player_id + sum(case when c.au_open = p.player_id then c.au_open else 0 end)/p.player_id as grand_slams_count from players p, championships c group by p.player_id, p.player_name) as a where a.grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 191, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, b.player_name, sum(a.n) as grand_slams_count from ((select wimbledon as player_id, count(*) as n from championships group by wimbledon) union all (select fr_open as player_id, count(*) as n from championships group by fr_open) union all (select us_open as player_id, count(*) as n from championships group by us_open) union all (select au_open as player_id, count(*) as n from championships group by au_open)) a left join players b on a.player_id = b.player_id group by a.player_id"]}
