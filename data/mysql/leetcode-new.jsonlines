{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 57, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum( if(c.wimbledon = player_id, 1, 0) + if(c.fr_open = player_id, 1, 0) + if(c.us_open = player_id, 1, 0) + if(c.au_open = player_id, 1, 0) ) grand_slams_count from players p cross join championships c where p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 58, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(case when wimbledon = players.player_id then 1.0 else 0 end) + sum(case when fr_open = players.player_id then 1.0 else 0 end) + sum(case when us_open = players.player_id then 1.0 else 0 end) + sum(case when au_open = players.player_id then 1.0 else 0 end) as grand_slams_count from players join championships group by players.player_id having grand_slams_count > 0"]}
