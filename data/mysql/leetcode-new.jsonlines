{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 367, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e1.employee_id) as reports_count, round(avg(e2.age),0) as average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by e1.employee_id order by e1.employee_id asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 368, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(distinct e2.employee_id) as reports_count, round(avg(e2.age),0) as average_age from employees e1 join employees e2 on e1.employee_id=e2.reports_to group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 369, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(distinct b.employee_id) as reports_count, round(avg(age),0) as average_age from (select employee_id, name from employees group by employee_id, name) a join (select employee_id, name, reports_to, age from employees) b on a.employee_id = b.reports_to group by a.employee_id, a.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 370, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id, m.name, count(e.employee_id) as reports_count, round(avg(e.age),0) as average_age from employees m join employees e on m.employee_id = e.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 371, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(a.reports_to) as reports_count, round(avg(a.age),0) as average_age from employees a inner join employees b on a.reports_to = b.employee_id group by b.employee_id order by b.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 372, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with grouped as ( select reports_to as employee_id, count(*) as reports_count, round(avg(age), 0) as average_age from employees where reports_to is not null group by reports_to ) select g.employee_id, e.name, reports_count, average_age from grouped g join employees e on e.employee_id = g.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 373, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(*) as reports_count, round(avg(e2.age)) as average_age from employees as e1 inner join employees as e2 on e1.employee_id = e2.reports_to group by e2.reports_to order by e2.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 374, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id, name, count(*) as reports_count, round(avg(age),0) as average_age from (select em.reports_to as employee_id, em2.name, em.age from employees em join employees em2 on em.reports_to = em2.employee_id where em.reports_to is not null) mytable group by employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 375, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id,name,reports_count,average_age from employees e join( select distinct reports_to, count(reports_to) as reports_count,round(avg(age),0) as average_age from employees group by reports_to having reports_count>=1) a on e.employee_id=a.reports_to order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 376, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(distinct e1.employee_id) as reports_count, round(avg(e1.age),0) as average_age from employees e1 join employees e2 on e1.reports_to = e2.employee_id group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 377, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with managers as ( select reports_to as employee_id, count(*) reports_count, avg(age) as average_age from employees group by 1 ) select a.employee_id, b.name, a.reports_count, round(a.average_age) average_age from managers a join employees b on a.employee_id = b.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 378, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id, b.name, count(a.reports_to) as reports_count, round(avg(a.age), 0) as average_age from employees as a inner join employees as b on a.reports_to = b.employee_id where a.employee_id in (select distinct(employee_id) from employees where reports_to is not null) group by a.reports_to order by a.reports_to"]}
