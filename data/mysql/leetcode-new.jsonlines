{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 663, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when e.operator = '<' and left_v.value < right_v.value then true when e.operator = '=' and left_v.value = right_v.value then true when e.operator = '>' and left_v.value > right_v.value then true else false end as value from expressions e join variables left_v on e.left_operand = left_v.name join variables right_v on e.right_operand = right_v.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 664, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select s1.left_operand, s1.operator, s1.right_operand, case when (s1.operator = '>' and s1.value_left > s1.value_right) then true when (s1.operator = '<' and s1.value_left < s1.value_right) then true when (s1.operator = '=' and s1.value_left = s1.value_right) then true else false end as value from (select e.*, v.value as value_left, v1.value as value_right from expressions e join variables v on v.name = e.left_operand join variables v1 on v1.name = e.right_operand) s1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 665, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand,e.operator,e.right_operand, case when operator = '>' and v1.value > v2.value then true when operator = '<' and v1.value < v2.value then true when operator = '=' and v1.value = v2.value then true else false end as value from expressions e left join variables v1 on e.left_operand = v1.name left join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 666, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator like '=' and v1.value = v2.value then true when e.operator like '>' and v1.value > v2.value then true when e.operator like '<' and v1.value < v2.value then true else false end as value from expressions e left join variables v1 on v1.name = e.left_operand left join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 667, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as (select v.value as v1, e.left_operand, e.operator, e.right_operand, v2.value as v2 from variables v right join expressions e on v.name = e.left_operand left join variables v2 on v2.name = e.right_operand) select cte.left_operand, cte.operator, cte.right_operand, case when cte.v1 = cte.v2 and cte.operator = '=' then true when cte.v1 > cte.v2 and cte.operator = '>' then true when cte.v1 < cte.v2 and cte.operator = '<' then true else false end as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 668, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with a as ( select left_operand, operator, right_operand, case when v1.value>v2.value then '>' when v1.value<v2.value then '<' else '=' end as operator1 from expressions e inner join variables v1 on v1.name=left_operand inner join variables v2 on v2.name=right_operand) select left_operand, operator, right_operand, if(operator=operator1, 'true', 'false') as value from a"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 669, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand,operator,right_operand, ( case when e.operator = '=' and v1.value = v2.value then true when e.operator = '>' and v1.value > v2.value then true when e.operator = '<' and v1.value < v2.value then true else false end ) as value from expressions as e join variables as v1 on e.left_operand = v1.name join variables as v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 670, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when operator = '>' then if(v1.value > v2.value, 'true', 'false') when operator = '<' then if(v1.value < v2.value, 'true', 'false') else if(v1.value = v2.value, 'true', 'false') end as value from expressions e left join variables v1 on v1.name = e.left_operand left join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 671, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when a.operator = '>' and b.value > c.value then true when a.operator = '<' and b.value < c.value then true when a.operator = '=' and b.value = c.value then true else false end as value from expressions a left join variables b on a.left_operand = b.name left join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 672, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = '=' and a.value = b.value then true when operator = '>' and a.value > b.value then true when operator = '<' and a.value < b.value then true else false end) as value from expressions x join variables a on x.left_operand = a.name join variables b on x.right_operand = b.name"]}
