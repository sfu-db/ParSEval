{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 377, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select distinct winner, count(game) as grand_slams_count from( select year, 'wimbledon as game', wimbledon as winner from championships union select year, 'fr_open as game', fr_open as winner from championships union select year, 'us_open as game', us_open as winner from championships union select year, 'au_open as game', au_open as winner from championships ) as a group by winner ) select cte.winner as player_id, player_name, grand_slams_count from cte join players p on cte.winner = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 378, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select p.player_id ,p.player_name ,sum(case when c.wimbledon is not null then 1 else 0 end) as grand_slams_count from players p left join championships c on p.player_id = c.wimbledon group by 1,2 union all select p.player_id ,p.player_name ,sum(case when c.fr_open is not null then 1 else 0 end) as grand_slams_count from players p left join championships c on p.player_id = c.fr_open group by 1,2 union all select p.player_id ,p.player_name ,sum(case when c.us_open is not null then 1 else 0 end) as grand_slams_count from players p left join championships c on p.player_id = c.us_open group by 1,2 union all select p.player_id ,p.player_name ,sum(case when c.au_open is not null then 1 else 0 end) as grand_slams_count from players p left join championships c on p.player_id = c.au_open group by 1,2 ) select player_id ,player_name ,sum(grand_slams_count) as grand_slams_count from cte group by 1,2 having sum(grand_slams_count) > 0 order by 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 379, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select player_id, player_name, case when twim.wimbledon is null then 0 else 1 end as score from players drv left join championships twim on drv.player_id = twim.wimbledon union all select player_id, player_name, case when tfr.fr_open is null then 0 else 1 end as score from players drv left join championships tfr on drv.player_id = tfr.fr_open union all select player_id, player_name, case when tus.us_open is null then 0 else 1 end as score from players drv left join championships tus on drv.player_id = tus.us_open union all select player_id, player_name, case when tau.au_open is null then 0 else 1 end as score from players drv left join championships tau on drv.player_id = tau.au_open ) select player_id, player_name, sum(score) as grand_slams_count from cte group by player_id, player_name having sum(score)>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 380, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships) select player_id,player_name,count(player_id) as grand_slams_count from players,cte where players.player_id =cte.winner group by players.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 381, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select year as year, wimbledon as winner_id from championships union all select year as year, fr_open as winner_id from championships union all select year as year, us_open as winner_id from championships union all select year as year, au_open as winner_id from championships) select c.winner_id as player_id, p.player_name, count(*) as grand_slams_count from cte c left join players p on c.winner_id = p.player_id group by 1"]}
