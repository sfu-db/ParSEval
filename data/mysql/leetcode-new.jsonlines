{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 685, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t1.product_id, round(sum((units*price))/sum(units),2) as average_price from unitssold t1 left join prices t2 on t1.product_id = t2.product_id and (purchase_date between start_date and end_date) group by t1.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 686, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round(sum(a.units * b.price)/sum(a.units),2) as average_price from unitssold a left join prices b on a.product_id = b.product_id and a.purchase_date between b.start_date and b.end_date group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 687, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(ifnull(sum(price * units) / sum(units), 0) , 2) as average_price from prices as p left join unitssold as s on p.product_id=s.product_id and s.purchase_date between p.start_date and p.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 688, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t1.product_id , round(sum(t2.units*t1.price)/sum(t2.units),2) as average_price from prices as t1 inner join unitssold as t2 on t1.product_id = t2.product_id and t2.purchase_date between t1.start_date and t1.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 689, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(buy_price) / sum(units), 2) average_price from ( select p.product_id, (us.units * p.price) buy_price, us.units from prices p join unitssold us on p.product_id = us.product_id and purchase_date between start_date and end_date ) t group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 690, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(price * units) / sum(units),2) as average_price from prices p inner join unitssold u on p.product_id = u.product_id and purchase_date between start_date and end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 691, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(price * units)/sum(units), 2) as average_price from unitssold u join prices p on p.product_id = u.product_id where purchase_date >= start_date and purchase_date <= end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 692, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select distinct(u.product_id) ,round(sum(p.price*u.units)/sum(u.units),2) as average_price from prices p right join unitssold u on p.product_id=u.product_id where u.purchase_date between p.start_date and p.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 693, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(units*price)/sum(units), 2) as average_price from unitssold u left join prices p on u.product_id=p.product_id and purchase_date between start_date and end_date group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 694, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(units * price) / sum(units), 2) average_price from ( select us.product_id, us.purchase_date, us.units, p.price from unitssold us left join prices p on us.product_id = p.product_id and (us.purchase_date between p.start_date and p.end_date) ) t group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 695, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(prices.price*unitssold.units)/sum(unitssold.units),2) as average_price from prices join unitssold on prices.product_id = unitssold.product_id and unitssold.purchase_date between prices.start_date and prices.end_date group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 696, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(price*units)/sum(units),2) as average_price from prices p join unitssold u on p.product_id= u.product_id where u.purchase_date between p.start_date and p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 697, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(price * units) / sum(units), 2) as average_price from ( select u.product_id, u.purchase_date, u.units, prices.price from unitssold u left join prices on u.product_id = prices.product_id and u.purchase_date between prices.start_date and prices.end_date ) as t group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 698, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, ifnull(round(sum(price*units)/ sum(units),2),0) as average_price from prices p left join unitssold u on u.product_id = p.product_id and purchase_date between start_date and end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 699, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t as ( select p.product_id, p.price*u.units as rev , u.units from prices p left join unitssold u on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date) select product_id, round(sum(rev)/sum(units),2) as average_price from t group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 700, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, cast(sum(p.price * u.units)/sum(u.units) as decimal(10,2)) as average_price from prices p join unitssold u on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 701, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(u.units*p.price)/sum(u.units),2) as average_price from prices p join unitssold u on p.product_id = u.product_id and (u.purchase_date >= p.start_date and u.purchase_date <= p.end_date) group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 702, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with priced_units as ( select u.product_id, u.units, 1.0*p.price*u.units as total_price from unitssold u inner join prices p on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date ) select product_id, round(sum(total_price)/sum(units), 2) as average_price from priced_units group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 703, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * us.units) / sum(us.units),2) as average_price from prices p join unitssold us on p.product_id=us.product_id and (us.purchase_date between p.start_date and p.end_date) group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 704, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t as (select prices.product_id, prices.price, units from prices left join unitssold on prices.product_id = unitssold.product_id where purchase_date between start_date and end_date) select distinct product_id, round(sum(price*units)/sum(units),2) as average_price from t group by 1"]}
