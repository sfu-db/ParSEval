{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 329, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id as employee_id, e2.name as name, count(e1.reports_to) as reports_count, cast(avg(e1.age) as unsigned) as average_age from employees e1 join employees e2 on e1.reports_to = e2.employee_id where e1.reports_to is not null group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 330, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id, e.name, e2.reports_count, e2.average_age from employees e inner join ( select reports_to, count(*) reports_count, round(avg(age), 0) average_age from employees where reports_to is not null group by reports_to ) e2 on e.employee_id = e2.reports_to order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 331, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.reports_to as employee_id, e1.name, count(e2.employee_id) as reports_count, round(avg(e2.age), 0) as average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 332, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with manager as ( select reports_to as id, count(employee_id) as reports_count, round(avg(age)) as average_age from employees group by reports_to ) select m.id as employee_id, name, m.reports_count, m.average_age from manager m join employees e on m.id = e.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 333, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id, b.name, count(distinct a.employee_id) as reports_count, round(avg(a.age),0) average_age from employees a join employees b on a.reports_to = b.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 334, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with managers as (select reports_to, round(avg(age)) as avg_age , count(name) as e_count from employees where reports_to is not null group by reports_to) select managers.reports_to as employee_id, employees.name, managers.e_count as reports_count, managers.avg_age as average_age from managers left join employees on managers.reports_to = employees.employee_id order by managers.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 335, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select manager.employee_id, manager.name, count(employees.employee_id) as reports_count, round(avg(employees.age)) as average_age from employees join employees manager on employees.reports_to = manager.employee_id group by employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 336, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to as employee_id, e2.name, count(e1.employee_id) as reports_count, round(sum(e1.age)/count(e1.employee_id),0) as average_age from employees e1 join employees e2 on e1.reports_to = e2.employee_id group by e1.reports_to order by e1.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 337, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(*) as reports_count, round(avg(e2.age), 0) as average_age from employees e1, employees e2 where e1.employee_id = e2.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 338, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.employee_id) as reports_count, round(avg(e2.age)) as average_age from employees e1 join employees e2 on e1.employee_id=e2.reports_to group by e1.employee_id, e1.name order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 339, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id, e.name, count(*) as reports_count, round(avg(c.age)) as average_age from employees e join employees c on c.reports_to = e.employee_id group by c.reports_to order by c.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 340, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(a.reports_to) reports_count, round(avg(a.age)) average_age from employees a, employees b where a.reports_to = b.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 341, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(distinct b.employee_id) reports_count ,round(avg(b.age),0) as average_age from employees a join employees b on b.reports_to=a.employee_id group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 342, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id,e.name,count(r.reports_to) reports_count,round(avg(r.age),0) as average_age from employees e join employees r on e.employee_id =r.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 343, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name,count(b.employee_id) as reports_count, round(avg(b.age)) as average_age from employees a left join employees b on a.employee_id = b.reports_to group by 1 having count(b.employee_id) >= 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 344, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id,name, count(*) as reports_count ,round(avg(age),0) as average_age from ( select e1.employee_id, e1.name, e2.age from employees e1 join employees e2 on e1.employee_id = e2.reports_to ) a group by 1,2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 345, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.reports_to as employee_id, t.name, count(*) as reports_count, round(avg(e.age), 0) as average_age from employees as e join ( select * from employees ) as t on e.reports_to = t.employee_id where e.reports_to is not null group by e.reports_to order by e.reports_to asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 346, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(a.reports_to) as reports_count, round(avg(a.age)) as average_age from employees a join employees b on a.reports_to = b. employee_id group by b.employee_id order by b.employee_id"]}
