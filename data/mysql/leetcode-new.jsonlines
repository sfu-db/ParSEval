{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 227, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as (select user1_id as user_id from friendship where user2_id = 1 union select user2_id as user_id from friendship where user1_id = 1) select distinct a.page_id as recommended_page from likes a where a.user_id in (select user_id from friends) and a.page_id not in (select page_id from likes where user_id = 1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 228, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as( select user1_id user_id, user2_id friend_id from friendship where user1_id = 1 union select user2_id user_id, user1_id friend_id from friendship where user2_id = 1) select distinct l.page_id recommended_page from friends f left join likes l on f.friend_id = l.user_id where l.page_id not in (select page_id from likes where user_id = 1) and l.page_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 229, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as( select user2_id as friend from friendship where user1_id = 1 union select user1_id as friend from friendship where user2_id = 1 ), notlike as ( select page_id from likes where user_id = 1 ) select distinct page_id as recommended_page from likes where user_id in (select friend from friends) and page_id not in (select page_id from notlike)"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 230, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends as( select user2_id u from friendship where user1_id=1 union select user1_id u from friendship where user2_id=1 ), pages as( select user_id,page_id from likes where page_id not in (select page_id from likes where user_id=1)) select distinct page_id recommended_page from pages p join friends f on p.user_id=f.u"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 231, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends1 as ( select user2_id user_id from friendship where user1_id=1 union all select user1_id user_id from friendship where user2_id=1 group by user_id), friend_like as (select l.page_id from friends1 f join likes l on f.user_id=l.user_id group by page_id) select page_id recommended_page from friend_like where page_id not in (select page_id from likes where user_id =1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 232, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friends_of_1 as ( select user2_id as user_1_friend from friendship where user1_id=1 union select user1_id as user_1_friend from friendship where user2_id=1 ) select distinct page_id as recommended_page from likes where user_id in (select user_1_friend from friends_of_1 ) and page_id not in (select page_id from likes where user_id=1) order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 233, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with friendtable as( select user1_id as id, user2_id as friend from friendship union select user2_id as id, user1_id as friend from friendship ) select distinct l.page_id as recommended_page from likes as l join friendtable as f on f.friend=l.user_id where f.id=1 and l.page_id not in( select page_id from likes where user_id=1 )"]}
{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 234, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with frs as(select user1_id as me, user2_id as friends from friendship union all select user2_id as me, user1_id as friends from friendship) select distinct l.page_id as recommended_page from frs f join likes l on f.friends=l.user_id where f.me =1 and l.page_id not in (select distinct page_id from likes where user_id=1)"]}
