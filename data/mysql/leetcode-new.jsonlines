{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 166, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(b.apple_count) as apple_count, sum(b.orange_count) as orange_count from (select box_id, (case when chests.apple_count is null then boxes.apple_count else boxes.apple_count + chests.apple_count end) as apple_count, (case when chests.orange_count is null then boxes.orange_count else boxes.orange_count + chests.orange_count end) as orange_count from boxes left join chests on boxes.chest_id = chests.chest_id) b"]}
