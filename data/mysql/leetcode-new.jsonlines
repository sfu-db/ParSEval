{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 311, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with temp as ( select a.name, sum(b.rest) as rest, sum(b.paid) as paid, sum(b.canceled) as canceled, sum(b.refunded) as refunded from product a left join invoice b on a.product_id=b.product_id group by a.product_id order by a.name ) select name, case when rest is null then 0 else rest end as rest, case when paid is null then 0 else paid end as paid, case when canceled is null then 0 else canceled end as canceled, case when refunded is null then 0 else refunded end as refunded from temp"]}
