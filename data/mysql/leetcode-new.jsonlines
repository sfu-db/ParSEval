{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 523, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units)/sum(u.units),2) as average_price from prices p join unitssold u on p.product_id = u.product_id and (u.purchase_date between p.start_date and p.end_date) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 524, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select pr.product_id, round(sum(pr.price*us.units)/sum(us.units),2) as average_price from prices as pr left join unitssold as us on pr.product_id = us.product_id where us.purchase_date between pr.start_date and pr.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 525, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(units*price)/sum(units),2) as average_price from unitssold u join prices p on u.product_id = p.product_id and u.purchase_date >= p.start_date and u.purchase_date <= p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 526, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units)/sum(u.units),2) as average_price from prices as p join unitssold as u on u.purchase_date between p.start_date and p.end_date and p.product_id = u.product_id group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 527, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id,round(sum(a.price*a.units)/sum(a.units),2) average_price from (select us.*,p.price from unitssold us join prices p on us.product_id=p.product_id and us.purchase_date between p.start_date and p.end_date)a group by a.product_id"]}
