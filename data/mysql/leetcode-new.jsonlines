{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 86, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte as (select count(*) cnt1 from delivery where order_date = customer_pref_delivery_date), cte1 as (select count(*) cnt2 from delivery) select round((select cnt1 from cte)*100/(select cnt2 from cte1),2) as immediate_percentage from dual"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 87, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with delivery_type as ( select * , case when order_date = customer_pref_delivery_date then 'immediate' else 'scheduled' end as delivery_type from delivery ) select round(count(case when delivery_type = 'immediate' then delivery_id else null end) / count(delivery_id)*100,2) as immediate_percentage from delivery_type"]}
