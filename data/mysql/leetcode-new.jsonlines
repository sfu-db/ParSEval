{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 83, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(b.reports_to) as reports_count, round(avg(b.age)) as average_age from employees a, employees b where a.employee_id = b.reports_to group by a.employee_id order by a.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 84, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employees.employee_id,employees.name,tab1.cnt as reports_count,tab1.average_age as average_age from employees inner join (select coalesce(reports_to,0) as rt,count(reports_to) as cnt,round(avg(age)) as average_age from employees where reports_to<>0 group by reports_to having count(reports_to)>=1) tab1 on tab1.rt=employees.employee_id order by employees.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 85, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, b.reports_count, b.average_age from employees a left join ( select reports_to, count(reports_to) as reports_count, round(avg(age),0) as average_age from employees group by reports_to) as b on a.employee_id = b.reports_to where b.reports_count is not null order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 86, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(distinct a.employee_id) reports_count, round(avg(a.age)) average_age from employees a join employees b on a.reports_to = b.employee_id group by b.employee_id, b.name"]}
