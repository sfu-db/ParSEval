{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 20, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(units*price) / sum(units), 2) average_price from prices join unitssold us on prices.product_id = us.product_id and us.purchase_date between prices.start_date and prices.end_date group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 21, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(units*price)/ sum(units),2) as average_price from prices inner join unitssold on prices.product_id = unitssold.product_id and (unitssold.purchase_date between prices.start_date and prices.end_date) group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 22, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t.id as product_id, round(sum(t.unit*t.price)/sum(t.unit), 2) as average_price from (select u.product_id as id, u.units as unit, p.price as price from prices as p, unitssold as u where (u.purchase_date between p.start_date and p.end_date) and p.product_id = u.product_id ) as t group by t.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 23, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t.product_id, round(sum(t.total_price)/sum(t.units),2) as average_price from ( select p.product_id, (units*price) as total_price, price, units from prices as p join unitssold as us on p.product_id = us.product_id where purchase_date between start_date and end_date ) as t group by t.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 24, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t.product_id, round(total_p/total_q,2) as average_price from ( select p.product_id, sum(price*units) as total_p, sum(units) as total_q from prices p join unitssold u on p.product_id=u.product_id where purchase_date between start_date and end_date group by p.product_id) t order by t.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 25, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id , round(sum(u.units*p.price)/sum(u.units),2) as average_price from unitssold u join prices p on u.product_id = p.product_id where purchase_date between start_date and end_date group by u.product_id order by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 26, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id , round(sum(u.units*p.price)/sum(u.units),2) as average_price from unitssold u left join prices p on u.product_id = p.product_id where purchase_date between start_date and end_date group by u.product_id order by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 27, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round((sum(u.units*p.price)/sum(u.units)),2) as average_price from unitssold as u inner join prices as p on u.product_id=p.product_id and u.purchase_date between p.start_date and p.end_date group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 28, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select unitssold.product_id, round(sum(prices.price * unitssold.units) / sum(unitssold.units), 2) as average_price from unitssold inner join prices on unitssold.product_id = prices.product_id and (unitssold.purchase_date between prices.start_date and prices.end_date) group by unitssold.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 29, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id , round(sum(b.units*a.price)/sum(b.units),2) as average_price from prices as a join unitssold as b on a.product_id=b.product_id and (b.purchase_date between a.start_date and a.end_date) group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 30, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id as product_id, round(sum(a.units * b.price)/sum(a.units),2) as average_price from unitssold a join prices b on a.product_id = b.product_id and a.purchase_date between b.start_date and b.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 31, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round(cast(sum(a.units*b.price) as decimal (7,2))/cast(sum(a.units) as decimal (7,2)),2) as average_price from unitssold a left join prices b on a.product_id=b.product_id and a.purchase_date between b.start_date and b.end_date group by a.product_id"]}
