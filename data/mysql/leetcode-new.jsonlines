{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 361, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with cte as (select product_id, sum(rest) as rest, sum(paid) as paid, sum(canceled) as canceled, sum(refunded) as refunded from invoice group by product_id) select p.name, ifnull(cte.rest,0) as rest, ifnull(cte.paid,0) as paid, ifnull(cte.canceled,0) as canceled, ifnull(cte.refunded,0) as refunded from product p left join cte on cte.product_id = p.product_id order by name"]}
{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 362, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with data as (select distinct product_id, ifnull(sum(rest) over(partition by product_id),0) as rest, ifnull(sum(paid) over(partition by product_id),0) as paid, ifnull(sum(canceled) over(partition by product_id),0) as canceled, ifnull(sum(refunded) over(partition by product_id),0) as refunded from invoice) select p.name, coalesce(d.rest,0) as rest, coalesce(d.paid,0) as paid, coalesce(d.canceled,0) as canceled, coalesce(d.refunded,0) as refunded from product as p left join data as d on d.product_id = p.product_id order by p.name asc"]}
