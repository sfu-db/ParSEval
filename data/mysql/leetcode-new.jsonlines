{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 105, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(units*price)/sum(units),2) as average_price from prices p join unitssold u on p.product_id = u.product_id and u.purchase_date between p.start_date and p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 106, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id,round((total)/total_units,2) as average_price from ( select sum(price*units) as total ,p.product_id, sum(units) as total_units from prices p join unitssold u on p.product_id=u.product_id and u.purchase_date between p.start_date and p.end_date group by p.product_id )a"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 107, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(u.units*p.price)/sum(u.units), 2) as average_price from prices as p join unitssold as u on p.product_id = u.product_id and u.purchase_date between p.start_date and p.end_date group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 108, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte1 as ( select distinct * from unitssold ), cte2 as ( select p.product_id, start_date, end_date, purchase_date, price, units from prices as p join cte1 as u on p.product_id = u.product_id having start_date<=purchase_date and end_date>=purchase_date) select product_id, round(sum(price*units)/sum(units), 2) as average_price from cte2 group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 109, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with ppus as ( select prices.product_id, start_date, end_date, price, purchase_date, units from prices inner join unitssold on prices.product_id = unitssold.product_id where purchase_date between start_date and end_date) select product_id, round(sum(units*price)/sum(units),2) as average_price from ppus group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 110, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with ta as (select p.product_id, u.purchase_date, price, units from prices p join unitssold u on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date) select product_id, round(sum(price * units)/sum(units), 2) as average_price from ta group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 111, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cost as (select p.product_id, (p.price * u.units) as total_cost, u.units, u.purchase_date from unitssold u left join prices p on u.product_id = p.product_id and (u.purchase_date between p.start_date and p.end_date) group by p.product_id, u.purchase_date) select product_id, round(sum(total_cost)/sum(units), 2) as average_price from cost group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 112, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as ( select p.product_id, p.price*u.units as sales, u.units from prices p join unitssold u on u.purchase_date between p.start_date and p.end_date and p.product_id = u.product_id ) select product_id, round(sum(sales)/sum(units),2) as average_price from cte group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 113, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as (select u.product_id, u.units, p.price, u.units*p.price as total from prices p join unitssold u on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date) select product_id, round(sum(total)/sum(units),2) as average_price from cte group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 114, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as (select u.product_id, u.units, p.price, u.units*p.price as total from prices p join unitssold u on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date) select product_id, round(sum(units*price)/sum(units),2) as average_price from cte group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 115, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as( select u.product_id, u.purchase_date, u.units, p.price from unitssold u join prices p on u.product_id = p.product_id and (purchase_date between start_date and end_date)) select product_id, round(sum(price * units) / sum(units),2) as average_price from cte group by product_id order by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 116, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with raw_data as ( select u.*, price, units*price as value from unitssold as u inner join prices as p on u.product_id = p.product_id and purchase_date between start_date and end_date ) select product_id, round(sum(value)/sum(units),2) as average_price from raw_data group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 117, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t1 as (select p.product_id, p.price, u.units from prices p join unitssold u on p.product_id = u.product_id and u.purchase_date >= p.start_date and u.purchase_date <= p.end_date) select product_id, round(sum(units*price)/sum(units),2) as average_price from t1 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 118, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with temp as ( select u.product_id, sum(p.price * u.units) as total_price, sum(u.units) as total_units from unitssold u inner join prices p on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date group by u.product_id ) select product_id, round(total_price / total_units,2) as average_price from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 119, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with temp as (select u.product_id, u.purchase_date, u.units, p.price, u.units*p.price as tot_price from unitssold u left join prices p on p.product_id = u.product_id where u.purchase_date between p.start_date and p.end_date) select product_id, round(sum(tot_price)/sum(units), 2) as average_price from temp group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 120, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with temp as( select u.product_id, u.units as totalunits, u.units * p.price as totalprice from prices p join unitssold u on u.purchase_date between p.start_date and p.end_date and p.product_id = u.product_id) select product_id, round(sum(totalprice)/sum(totalunits),2) as average_price from temp group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 121, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with total_units as (select u1.product_id, sum(u1.units) total_units from unitssold u1 group by u1.product_id), total_daily_revenue as ( select p.product_id, u2.purchase_date, (p.price * u2.units) total_daily_revenue from prices p inner join unitssold u2 on p.product_id = u2.product_id where u2.purchase_date between p.start_date and p.end_date ), total_revenue as ( select total_daily_revenue.product_id, sum(total_daily_revenue.total_daily_revenue) total_revenue from total_daily_revenue group by total_daily_revenue.product_id ) select total_units.product_id, round((total_revenue.total_revenue / total_units.total_units), 2) average_price from total_units join total_revenue on total_units.product_id = total_revenue.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 122, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with temp as ( select a.product_id, a.purchase_date, a.units, b.price from unitssold a, prices b where a.product_id = b.product_id and a.purchase_date between b.start_date and b.end_date) select product_id, round(sum(price*units)/sum(units),2) as average_price from temp group by product_id"]}
