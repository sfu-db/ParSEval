{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 109, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from players p join (select winner, count(winner) as grand_slams_count from ( select year,wimbledon as winner from championships union all select year,fr_open from championships union all select year,us_open from championships union all select year,au_open from championships ) a group by winner ) b on p.player_id = b.winner"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 110, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(wim) + sum(french) + sum(us) + sum(aus) as grand_slams_count from ( select p.player_id, p.player_name, case when p.player_id = c.wimbledon then 1 else 0 end as wim, case when p.player_id = c.fr_open then 1 else 0 end as french, case when p.player_id = c.us_open then 1 else 0 end as us, case when p.player_id = c.au_open then 1 else 0 end as aus from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open ) x group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 111, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with base as ( select year, wimbledon as tournament from championships union all select year, fr_open as tournament from championships union all select year, us_open as tournament from championships union all select year, au_open as tournament from championships ) select p.player_id, p.player_name, count(tournament) as grand_slams_count from players as p inner join base as b on p.player_id = b.tournament group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 112, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cet as(select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select c.player_id, p.player_name, count(*) as grand_slams_count from cet c join players p on c.player_id = p.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 113, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( (select wimbledon player_id, count(wimbledon) cn from championships group by wimbledon) union all (select fr_open player_id, count(fr_open) cn from championships group by fr_open) union all (select us_open player_id, count(us_open) cn from championships group by us_open) union all (select au_open player_id, count(au_open) cn from championships group by au_open) ) select c.player_id, player_name, sum(cn) grand_slams_count from cte c left join players p on c.player_id = p.player_id group by player_id order by grand_slams_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 114, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select player_id,player_name,count(*) as grand_slams_count from players inner join cte on players.player_id = cte.id group by player_id"]}
