{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 601, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product.product_name from product where product_id not in (select sales.product_id from sales where sales.sale_date > cast('2019-03-31' as date) or sales.sale_date < cast('2019-01-01' as date))"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 602, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as (select p.product_id from product p join sales s on p.product_id = s.product_id where sale_date not between '2019-01-01' and '2019-03-31') select product_id, product_name from product where product_id not in (select product_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 603, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product as p where exists ( select 1 from sales as s where s.product_id = p.product_id and (s.sale_date >= str_to_date('2019-01-01', '%y-%m-%d') and s.sale_date < str_to_date('2019-04-01', '%y-%m-%d')) ) and not exists ( select 1 from sales as s where s.product_id = p.product_id and (s.sale_date < str_to_date('2019-01-01', '%y-%m-%d') or s.sale_date >= str_to_date('2019-04-01', '%y-%m-%d')) )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 604, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct product_id, product_name from product p right join sales s using(product_id) where sale_date>='2019-01-01' and sale_date<'2019-04-01' and product_id not in (select product_id from sales where sale_date<'2019-01-01' or sale_date>='2019-04-01' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 605, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, product_name from product as p left join sales as s on p.product_id = s.product_id group by p.product_id having min(unix_timestamp(sale_date)) >= unix_timestamp('2019-01-01') and max(unix_timestamp(sale_date)) <= unix_timestamp('2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 606, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product where product_id not in (select p.product_id from sales s left join product p using (product_id) where sale_date not between '2019-01-01' and '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 607, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id , product_name from product where product_id not in ( select product_id from sales where datediff(sale_date, '2019-03-31') > 0 or datediff(sale_date, '2019-01-01') < 0 )"]}
