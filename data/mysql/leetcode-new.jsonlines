{"benchmark": "benchmark/leetcode/raw_data/610.csv", "index": 107, "schema": "create table triangle (x integer not null, y integer not null, z integer not null, constraint pk_triangle primary key (x, y, z), constraint check_triangle check (x > 0 and y > 0 and z > 0));", "pair": ["select x, y, z, if(x+y>z and x+z>y and y+z>x, 'yes', 'no') as triangle from triangle", "with ineqs as (select *, case when x+y>z then t else f end as c1, case when y+z>x then t else f end as c2, case when x+z>y then t else f end as c3 from triangle) select x, y, z, case when c1='t' and c2='t' and c3='t then 'yes' else no' end as triangle from ineqs"]}
