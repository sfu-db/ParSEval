{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 126, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select * from ( select product_id, (case when store1 is not null then store1 else null end) store, store1 price from products union all select product_id, (case when store2 is not null then store2 else null end) store, store2 price from products union all select product_id, (case when store3 is not null then store3 else null end) store, store3 price from products ) a where a.price is not null order by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 127, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id , 'store1' store, store1 as price from products where store1 is not null union select product_id ,'store2' store,store2 as price from products where store2 is not null union select product_id , 'store3' store,store3 as price from products where store3 is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 128, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select * from ( select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products ) sq where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 129, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with cte as (select 'store1' as store union select 'store2' union select 'store3' ) select sub.* from (select product_id, store, case when store = 'store1' then 'store1' when store = 'store2' then 'store2' else 'store3' end as price from products cross join cte) sub where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 130, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, 'store1' as store, store1 as price from products where store1 is not null union all select product_id, 'store2' as store, store2 as price from products where store2 is not null union all select product_id, 'store3' as store, store3 as price from products where store3 is not null order by 1,2 asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 131, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select a.product_id, b.column_name as store, case when b.column_name = 'store1' then store1 when b.column_name = 'store2' then store2 when b.column_name = 'store3' then store3 end as price from products a, information_schema.columns b where table_name = 'products' and column_name != 'product_id' having price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 132, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select a.product_id, a.store, a.price from ( select product_id, 'store1' as store, store1 as price from products where store1 is not null union select product_id, 'store2' as store, store2 as price from products where store2 is not null union select product_id, 'store3' as store, store3 as price from products where store3 is not null ) a"]}
