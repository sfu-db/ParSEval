{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 350, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with cte1 as ( select b.project_id ,a.employee_id, sum(a.experience_years) as exp_years from employee as a join project as b on a.employee_id = b.employee_id group by b.project_id, a.employee_id) select project_id, round(avg(exp_years),2) as average_years from cte1 group by project_id"]}
