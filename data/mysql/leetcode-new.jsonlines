{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 543, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte_followee as( select followee, count(*) as count_followee from follow group by followee), cte_follower as ( select follower, count(*) as count_follower from follow group by follower) select f1.follower, count_followee as num from cte_follower f1 inner join cte_followee f2 on f1.follower = f2.followee group by f1.follower order by f1.follower"]}
