{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 312, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with t1 as ( select employee_id, department_id from employee group by employee_id having count(department_id) = 1 ), t2 as ( select employee_id from employee group by employee_id having count(department_id) > 1 ), t3 as ( select employee_id, department_id from employee where employee_id in (select * from t2) and primary_flag = 'y' ) select * from t1 full union select * from t3"]}
