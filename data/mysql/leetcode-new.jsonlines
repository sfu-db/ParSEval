{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 457, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id, name, reports_count, average_age from employees join ( select reports_to, count(reports_to ) as reports_count, cast(avg(age) as unsigned) as average_age from employees group by reports_to) t on t.reports_to = employees.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 458, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(distinct e1.employee_id) as reports_count, round(avg(e1.age),0) as average_age from employees e1 left join employees e2 on e1.reports_to = e2.employee_id where e2.employee_id is not null group by e1.reports_to order by e2.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 459, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.employee_id) as reports_count, round(avg(e2.age), 0) as average_age from employees e1 join employees e2 on (e1.employee_id = e2.reports_to) group by e1.employee_id, e1.name order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 460, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(a.reports_to) as reports_count, round(avg(a.age),0) as average_age from employees a inner join employees b on a.reports_to = b.employee_id group by b.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 461, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(*) as reports_count, round(avg(b.age)) as average_age from employees as a join employees as b on a.employee_id = b.reports_to group by a.employee_id, a.name order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 462, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select distinct a.reports_to as employee_id, b.name, count(a.employee_id) over(partition by a.reports_to) as reports_count, round(avg(a.age) over(partition by a.reports_to),0) as average_age from employees a, employees b where a.reports_to=b.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 463, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id as employee_id, m.name, count(distinct e.employee_id) as reports_count, round(avg(e.age)) as average_age from employees m inner join employees e on e.reports_to = m.employee_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 464, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id, e.name, manager.reports_count, round(manager.average_age) as average_age from employees as e join (select reports_to as id, count(reports_to) as reports_count , avg(age) as average_age from employees group by reports_to) as manager on manager.id = e.employee_id order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 465, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with cte1 as( select reports_to, count(reports_to) as reports_count, round(avg(age),0) as average_age from employees group by 1) select cte1.reports_to as employee_id, name, reports_count, average_age from cte1 join employees e on cte1.reports_to = e.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 466, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.reports_to employee_id, e1.name, count(e.employee_id) reports_count, round(avg(e.age),0) average_age from employees e inner join employees e1 on e.reports_to=e1.employee_id group by e.reports_to order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 467, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, sum(e1.employee_id=e2.reports_to) as reports_count, round(avg(e2.age)) as average_age from employees e1 join employees e2 on e1.employee_id=e2.reports_to group by e1.employee_id order by e1.employee_id asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 468, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, ifnull(count(b.reports_to), 0) reports_count, round(avg(b.age), 0) as average_age from employees a, employees b where a.employee_id = b.reports_to group by a.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 469, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(a.name) as reports_count , round(avg(a.age),0) as average_age from employees a left join employees b on (a.reports_to - b.employee_id ) = 0 where a.reports_to is not null group by b.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 470, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(b.employee_id) as reports_count, round(avg(b.age),0) as average_age from employees a, employees b where a.employee_id=b.reports_to group by 1, 2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 471, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.reports_to as employee_id, m.name, count(*) as reports_count, round(avg(e.age)) as average_age from employees e join employees m on e.reports_to = m.employee_id group by m.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 472, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with t1 as (select employee_id, name, reports_to, age from employees where reports_to is not null) select distinct t1.reports_to as employee_id, e.name as name, count(t1.employee_id) over (partition by t1.reports_to) as reports_count, round(avg(t1.age) over (partition by t1.reports_to),0) as average_age from t1 join employees e on t1.reports_to = e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 473, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select t1.reports_to as employee_id, t2.name, t1.reports_count, t1.average_age from (select reports_to, count(distinct(employee_id)) as reports_count, round(avg(age)) as average_age from employees where reports_to is not null group by reports_to ) t1 join employees t2 on t1.reports_to = t2.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 474, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with temp as (select reports_to as manager_id, count(employee_id) as reports_count, round(avg(age),0) as avg_age from employees group by 1 having reports_to is not null) select e.employee_id, e.name, t.reports_count, t.avg_age as average_age from temp t join employees e where t.manager_id = e.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 475, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id, m.name, count(e.employee_id) as reports_count, round(avg(e.age),0) as average_age from employees m join employees e on m.employee_id = e.reports_to group by 1 having count(e.employee_id) >= 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 476, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(b.employee_id) as reports_count, round(avg(b.age),0) as average_age from employees a inner join employees b on a.employee_id = b.reports_to group by a.employee_id order by a.employee_id"]}
