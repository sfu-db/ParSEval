{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 513, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select activity.player_id player_id, device_id from activity join (select player_id, min(event_date) as first from activity group by player_id) mytable on activity.player_id = mytable.player_id and activity.event_date = mytable.first"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 514, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id, a.device_id from activity a inner join (select player_id, min(event_date) as first_login from activity group by player_id) as t on a.player_id = t.player_id and a.event_date = t.first_login group by a.player_id, a.device_id"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 515, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select r.player_id, r.device_id from ( select player_id, device_id, rank() over (partition by player_id order by event_date) as rk from activity ) r where rk=1 group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 516, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select tmp.player_id, tmp.device_id from ( select player_id, device_id, rank() over (partition by player_id order by event_date) as rnk from activity ) tmp where tmp.rnk = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 517, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with cte as (select distinct player_id, min(event_date) over(partition by player_id) as first_login from activity ) select distinct cte.player_id, device_id from activity a join cte on a.player_id=cte.player_id and first_login=a.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 518, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with mindate as (select player_id, min(event_date) as min_eventdate from activity group by player_id) select a1.player_id, a1.device_id from activity as a1 join mindate as t1 on a1.player_id = t1.player_id and a1.event_date = t1.min_eventdate"]}
