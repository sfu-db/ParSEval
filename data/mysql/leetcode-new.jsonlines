{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 95, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select distinct employee_id, department_id from employee where primary_flag='y' union all select distinct employee_id, department_id from employee where primary_flag='n' and employee_id not in (select distinct employee_id from employee where primary_flag='y')"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 96, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select distinct employee_id,department_id from employee where primary_flag='y' union select distinct employee_id, department_id from employee where employee_id not in ( select distinct employee_id from (select distinct employee_id,department_id from employee where primary_flag='y')a )"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 97, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select e.employee_id, case when f.c>1 and e.primary_flag='y' then e.department_id when f.c=1 then e.department_id end as department_id from employee e left join (select employee_id, department_id, count(primary_flag) as c from employee group by employee_id) f on e.employee_id = f.employee_id having department_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 98, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select e.employee_id, e.department_id from employee e where primary_flag = 'y' or (select count(*) from employee where employee_id = e.employee_id) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 99, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select e1.employee_id, e1.department_id from employee e1 left join (select employee_id, department_id, primary_flag, count(employee_id) as cnt from employee group by employee_id) as e2 on e1.employee_id = e2.employee_id where e1.primary_flag = 'y' or e2.cnt = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 100, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id , department_id from employee where employee_id in ( select employee_id from employee group by 1 having count(distinct department_id) = 1 ) union select employee_id , department_id from employee where primary_flag = 'y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 101, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id , max(department_id ) as department_id from employee group by 1 having count(*) = 1 union select employee_id , max(case when primary_flag = 'y' then department_id end ) as department_id from employee group by 1 having count(*) > 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 102, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id , max(department_id) as department_id from employee group by employee_id having count(1) = 1 union select employee_id , department_id from employee where primary_flag = 'y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 103, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id ,department_id from employee where primary_flag = 'y' union select a.employee_id ,a.department_id from employee a inner join (select employee_id from employee group by employee_id having sum(1) = 1) b on a.employee_id = b.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 104, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, case when (count(department_id)> 1 ) then sum( if( primary_flag = 'y',department_id , null)) when (count(department_id))= 1 then department_id end department_id from employee group by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 105, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, case when count(*) = 1 then department_id else sum(if(primary_flag='y',department_id,0)) end as department_id from employee group by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 106, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from ( select *, count(*) over(partition by employee_id) as num_department from employee ) as e1 where (num_department>1 and primary_flag='y') or (num_department=1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 107, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from ( select employee_id, count(department_id) ct from employee group by employee_id ) r1 natural join employee where primary_flag='y' or (ct=1 and primary_flag='n')"]}
