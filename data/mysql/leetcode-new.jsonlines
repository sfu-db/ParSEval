{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 116, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "select install_dt, count(distinct player_id) as installs, round(sum(back)/sum(installs),2) as day1_retention from ( select player_id, min(event_date) over (partition by player_id) as install_dt, case when min(event_date) over (partition by player_id) = event_date then 1 else 0 end as installs, case when (min(event_date) over (partition by player_id))+1 = event_date then 1 else 0 end as back from activity) t group by install_dt order by install_dt"]}
