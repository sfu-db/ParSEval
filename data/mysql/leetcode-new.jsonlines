{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 215, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from employee e where primary_flag = 'y' or (primary_flag = 'n' and employee_id in (select employee_id from employee group by 1 having count(department_id) = 1) )"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 216, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with cte as ( select employee_id from employee group by 1 having count(distinct department_id) = 1) select distinct c.employee_id, e.department_id from cte c inner join employee e on c.employee_id = e.employee_id union select employee_id, department_id from employee where primary_flag = 'y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 217, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from employee group by employee_id having count(*)=1 union select employee_id, department_id from employee where primary_flag = 'y' group by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 218, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with twoormore as ( select distinct employee_id from employee where primary_flag = 'y' ) select employee_id, department_id from employee where (primary_flag = 'n' and employee_id not in (select employee_id from twoormore)) or primary_flag = 'y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 219, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from ( select employee_id, department_id, row_number() over (partition by employee_id order by primary_flag) as row_num from employee ) t where t.row_num = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 220, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from employee where employee_id in (select employee_id from employee group by employee_id having count(department_id) = 1) union all select employee_id, department_id from employee where employee_id in (select employee_id from employee group by employee_id having count(department_id) > 1) and primary_flag='y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 221, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with one_dept as ( select employee_id, department_id from employee group by 1 having count(department_id) = 1 ), multiple_dept as ( select employee_id from employee group by 1 having count(department_id) > 1 ), primary_multiple as ( select e.employee_id, e.department_id from employee e join multiple_dept on e.employee_id = multiple_dept.employee_id where e.primary_flag = 'y' ) select employee_id, department_id from one_dept union select employee_id, department_id from primary_multiple"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 222, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with cte as ( select employee_id from employee group by 1 having count(*)>1 ) select employee_id, department_id from employee where employee_id in (select employee_id from cte) and primary_flag='y' union all select employee_id, department_id from employee where employee_id not in (select employee_id from cte) order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 223, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select distinct employee_id,department_id from employee where primary_flag = 'y' union select employee_id,department_id from employee where employee_id in (select p.employee_id from (select employee_id, count(employee_id) from employee group by 1 having count(employee_id)=1) p)"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 224, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id,department_id from ( select *,count(employee_id) over(partition by employee_id) as c from employee ) t where c=1 or primary_flag='y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 225, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with cte as (select employee_id,count(department_id) from employee group by employee_id having count(department_id)=1) select employee_id , department_id from employee where primary_flag='y' or employee_id in (select employee_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 226, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "with cte as (select employee_id, department_id from employee where primary_flag = 'y') select distinct(e.employee_id), case when e.employee_id in (cte.employee_id) then cte.department_id else e.department_id end as department_id from employee e left join cte cte on cte.employee_id = e.employee_id order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1789.csv", "index": 227, "schema": "create table employee (employee_id integer not null, department_id integer, primary_flag varchar(30), constraint pk_employee primary key (employee_id), constraint check_employee check (primary_flag in (\"y\", \"n\")));", "pair": ["select employee_id, department_id from employee group by employee_id having count(*) = 1 union select employee_id, department_id from employee where primary_flag = 'y'", "select employee_id, department_id from employee where primary_flag = 'y' union select employee_id, department_id from employee group by 1 having count(employee_id) = 1 order by 1"]}
