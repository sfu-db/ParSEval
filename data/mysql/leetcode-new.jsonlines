{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 449, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followee as (select followee , sum(case when follower is not null then 1 else 0 end) as num_follower from follow group by 1 ) select a.follower as follower , b.num_follower as num from follow a join followee b on a.follower = b.followee group by 1 order by follower"]}
