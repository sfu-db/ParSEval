{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 611, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator,a.right_operand, case when ( case when a.operator = '>' then a.value > b.value when a.operator = '=' then a.value = b.value else a.value<b.value end) = 1 then true else false end as value from ( select * from expressions e join variables o on e.left_operand = o.name) a join ( select * from expressions e join variables o on e.right_operand = o.name) b on a.left_operand = b.left_operand and a.operator= b.operator and a.right_operand= b.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 612, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, value from (select *, (@a := (select value from variables where name = left_operand)), (@b := (select value from variables where name = right_operand)), if((case operator when '>' then @a > @b when '<' then @a<@b else @a = @b end),'true','false') value from expressions) t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 613, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when operator = '=' and v1.value=v2.value then true when operator = '>' and v1.value>v2.value then true when operator = '<' and v1.value<v2.value then true else false end as value from expressions e inner join variables v1 on e.left_operand = v1.name inner join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 614, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, if(case e.operator when '=' then l.value = r.value when '>' then l.value > r.value when '<' then l.value < r.value end = 1, 'true', 'false') as value from expressions e left join variables l on e.left_operand = l.name left join variables r on e.right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 615, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when e.operator = '>' and v.value > v2.value then true when e.operator = '>' and v.value <= v2.value then false when e.operator = '<' and v.value < v2.value then true when e.operator = '<' and v.value >= v2.value then false when e.operator = '=' and v.value = v2.value then true when e.operator = '=' and v.value <> v2.value then false else '' end as value from expressions as e left join variables v on e.left_operand = v.name left join variables v2 on e.right_operand = v2.name"]}
