{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 627, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when (operator = '>' and t1.value > t2.value) then true when (operator = '<' and t1.value < t2.value) then true when (operator = '=' and t1.value = t2.value) then true else false end as value from expressions e join variables t1 on e.left_operand = t1.name join variables t2 on e.right_operand = t2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 628, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator='>' then if(a.value>b.value, 'true','false') when operator='<' then if(a.value<b.value, 'true','false') else if(a.value=b.value, 'true','false') end as value from expressions e join variables a on a.name=left_operand join variables b on b.name=right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 629, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when operator like '>' then if(v1.value > v2.value,'true','false') when operator like '<' then if(v1.value < v2.value,'true','false') when operator like '=' then if(v1.value = v2.value,'true','false') end as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand=v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 630, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t1 as( select case when left_operand = v1.name then v1.value end left_value, case when right_operand = v2.name then v2.value end right_value, e.* from expressions e left join variables v1 on e.left_operand = v1.name left join variables v2 on e.right_operand = v2.name) select left_operand, operator,right_operand , case when operator = '>' then if(left_value>right_value,'true','false') when operator = '<' then if(left_value<right_value,'true','false') when operator = '=' then if(left_value = right_value,'true','false') end value from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 631, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t as ( select left_operand, operator, right_operand ,value as value1 from expressions e inner join variables v on e.left_operand = v.name ), t1 as ( select left_operand, operator, right_operand ,value as value2 from expressions e inner join variables v on e.right_operand = v.name ) select left_operand, operator, right_operand, case when operator = '>' and value1 > value2 then true when operator = '<' and value1 < value2 then true when operator = '=' and value1 = value2 then true when operator = '>' and value1 > value2 then true when operator = '<' and value1 < value2 then true when operator = '=' and value1 = value2 then true else false end as value from t inner join t1 using (left_operand, operator, right_operand)"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 632, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, (case when operator = '>' and v1.value > v2.value then true when operator = '<' and v1.value < v2.value then true when operator = '=' and v1.value = v2.value then true else false end) as value from expressions e join variables v1 on v1.name = e.left_operand join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 633, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' and v1.value - v2.value >0 then true when operator = '=' and v1.value - v2.value =0 then true when operator = '<' and v1.value - v2.value <0 then true else false end as value from expressions inner join variables v1 on expressions.left_operand = v1.name inner join variables v2 on expressions.right_operand = v2.name"]}
