{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 200, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from (select distinct a.pid, a.tiv_2016 from insurance a inner join insurance b on a.tiv_2015 = b.tiv_2015 and a.pid <> b.pid where a.pid not in (select a.pid from insurance a inner join insurance b on a.lat = b.lat and a.lon = b.lon and a.pid <> b.pid) ) a"]}
