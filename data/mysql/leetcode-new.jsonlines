{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 181, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from insurance where pid in (select distinct i1.pid from insurance i1 inner join insurance i2 on i1.pid != i2.pid and i1.tiv_2015 = i2.tiv_2015 where i1.pid not in (select i1.pid from insurance i1 inner join insurance i2 on i1.pid != i2.pid and (i1.lat = i2.lat and i1.lon = i2.lon)))"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 182, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from insurance where pid not in (select pid from insurance group by tiv_2015 having count(tiv_2015) = 1) and pid in (select pid from insurance group by lat, lon having count(*) = 1)"]}
