{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 683, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(case when player_id = wimbledon then 1 else 0 end) + sum(case when player_id = fr_open then 1 else 0 end) + sum(case when player_id = us_open then 1 else 0 end) + sum(case when player_id = au_open then 1 else 0 end) as grand_slams_count from players p join championships c on wimbledon = player_id or fr_open = player_id or us_open = player_id or au_open = player_id group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 684, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte_1 as (select player_id,player_name,count(wimbledon) as wimbledon_count from players p join championships c on p.player_id = c.wimbledon group by 1,2 union all select player_id,player_name,count(fr_open) as french_count from players p join championships c on p.player_id = c.fr_open group by 1,2 union all select player_id,player_name,count(us_open) as us_count from players p join championships c on p.player_id = c.us_open group by 1,2 union all select player_id,player_name,count(au_open) as au_count from players p join championships c on p.player_id = c.au_open group by 1,2) select player_id,player_name, sum(wimbledon_count) as grand_slams_count from cte_1 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 685, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as (select distinct wimbledon as player_id, count(wimbledon) as game from championships group by 1), t2 as (select distinct fr_open as player_id, count(fr_open) as game from championships group by 1), t3 as (select distinct us_open as player_id, count(us_open) as game from championships group by 1), t4 as (select distinct au_open as player_id, count(au_open) as game from championships group by 1) select p.player_id, p.player_name, coalesce(t1.game,0)+coalesce(t2.game,0)+coalesce(t3.game,0)+coalesce(t4.game,0) as grand_slams_count from players p left join t1 on p.player_id=t1.player_id left join t2 on p.player_id=t2.player_id left join t3 on p.player_id=t3.player_id left join t4 on p.player_id=t4.player_id where coalesce(t1.game,0)+coalesce(t2.game,0)+coalesce(t3.game,0)+coalesce(t4.game,0)>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 686, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with slams as ((select wimbledon as slam from championships) union all (select fr_open as slam from championships) union all (select us_open as slam from championships) union all (select au_open as slam from championships)) select player_id, player_name, count(*) as grand_slams_count from slams join players on players.player_id=slams.slam group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 687, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player as player_id,players.player_name,count(*) as grand_slams_count from ( select wimbledon as player from championships union all select fr_open as player from championships union all select us_open as player from championships union all select au_open as player from championships ) a left join players on players.player_id = a.player group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 688, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tbl_grp as( select wimbledon as match from championships union all select fr_open as match from championships union all select us_open as match from championships union all select au_open as match from championships ) select a.*,count(b.match) as grand_slams_count from players a inner join tbl_grp b on a.player_id=b.match group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 689, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id,player_name,count(id) as grand_slams_count from ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) a ,players b where a.id=b.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 690, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(player_id=wimbledon)+sum(player_id=fr_open)+sum(player_id=us_open)+sum(player_id=au_open) as grand_slams_count from championships c inner join players p on wimbledon = p.player_id or fr_open = p.player_id or us_open = p.player_id or au_open = p.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 691, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) select player_id, player_name, count(*) as grand_slams_count from cte left join players p on p.player_id = cte.id group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 692, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, count(*) as grand_slams_count from ( select p.player_id, player_name from players p join championships c on p.player_id = c.wimbledon union all select p.player_id, player_name from players p join championships c on p.player_id = c.fr_open union all select p.player_id, player_name from players p join championships c on p.player_id = c.us_open union all select p.player_id, player_name from players p join championships c on p.player_id = c.au_open ) t group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 693, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select year, wimbledon as player_id, 'wimbledon' as tournament from championships union select year, fr_open as player_id, 'fr_open' as tournament from championships union select year, us_open as player_id, 'us_open' as tournament from championships union select year, au_open as player_id, 'au_open' as tournament from championships ) select player_id, player_name, count(tournament) as grand_slams_count from cte join players using (player_id) group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 694, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wimbledon as ( select player_id, player_name, wimbledon as c from players as p inner join championships as c on p.player_id = c.wimbledon ), fr_open as ( select player_id, player_name, fr_open as c from players as p inner join championships as c on p.player_id = c.fr_open ), us_open as ( select player_id, player_name, us_open as c from players as p inner join championships as c on p.player_id = c.us_open ), au_open as ( select player_id, player_name, au_open as c from players as p inner join championships as c on p.player_id = c.au_open ), cte as ( select * from wimbledon union all select * from fr_open union all select * from us_open union all select * from au_open ) select player_id, player_name, count(c) as grand_slams_count from cte group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 695, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, grand_slams_count from players p join ( select t as player_id , count(t) as grand_slams_count from ( select wimbledon as t from championships c1 union all select fr_open as t from championships c2 union all select us_open as t from championships c3 union all select au_open as t from championships c4) t group by t) t2 on t2.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 696, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, player_name, count(*) as grand_slams_count from ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) a inner join players b on a.player_id = b.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 697, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from players right join (select id, count(id) as grand_slams_count from (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) as subquery group by id) subquery on subquery.id = players.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 698, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, b.player_name, a.grand_slams_count from (select j.gs, count(j.year) as grand_slams_count from ( select year, wimbledon as gs from championships union all select year, fr_open as gs from championships union all select year, us_open as gs from championships union all select year, au_open as gs from championships) j group by 1) a inner join players b on a.gs = b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 699, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( select year, 'wimbledon' as field, wimbledon as winner from championships union all select year, 'fr_open' as field, fr_open as winner from championships union all select year, 'us_open' as field, us_open as winner from championships union all select year, 'au_open' as field, au_open as winner from championships) select t1.winner as player_id, player_name, count(t1.winner) as grand_slams_count from t1 inner join players p on t1.winner = p.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 700, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from (select player_id, player_name, (select sum(if(wimbledon = player_id,1,0)) + sum(if(fr_open = player_id,1,0)) + sum(if(us_open = player_id, 1,0)) + sum(if(au_open = player_id,1,0)) from championships) as grand_slams_count from players) t where t.grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 701, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships), cte2 as (select id, count(*) as num from cte group by id) select p.player_id, p.player_name, cte2.num as grand_slams_count from cte2 join players as p on p.player_id = cte2.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 702, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, (select sum(wimbledon=player_id)+sum(fr_open=player_id)+sum(us_open=player_id)+sum(au_open=player_id) from championships) as grand_slams_count from players where (select sum(wimbledon=player_id)+sum(fr_open=player_id)+sum(us_open=player_id)+sum(au_open=player_id) from championships) != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 703, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, p.player_name, count(*) grand_slams_count from ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) a inner join players p on a.player_id = p.player_id group by a.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 704, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as( select year, wimbledon gs from championships union all select year, fr_open gs from championships union all select year, us_open gs from championships union all select year, au_open gs from championships) select player_id, player_name, count(gs) grand_slams_count from players join c on player_id=gs group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 705, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as (select p.player_id, player_name, count(c.wimbledon) as grand_slams_count from championships c join players p on p.player_id = c.wimbledon group by 1 union all select p.player_id, player_name, count(c.fr_open) as grand_slams_count from championships c join players p on p.player_id = c.fr_open group by 1 union all select p.player_id, player_name, count(c.us_open) as grand_slams_count from championships c join players p on p.player_id = c.us_open group by 1 union all select p.player_id, player_name, count(c.au_open) as grand_slams_count from championships c join players p on p.player_id = c.au_open group by 1) select player_id, player_name, sum(grand_slams_count) as grand_slams_count from tmp group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 706, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id,p.player_name,b.grand_slams_count from ( select a.player_id,sum(a.game_count) as grand_slams_count from ( select wimbledon as player_id, count(wimbledon) as game_count from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as game_count from championships group by fr_open union all select us_open as player_id, count(us_open) as game_count from championships group by us_open union all select au_open as player_id, count(au_open) as game_count from championships group by au_open )a group by a.player_id )b join players p on b.player_id = p.player_id where b.grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 707, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with total as ((select wimbledon as c, count(wimbledon) as w from championships group by wimbledon) union all (select fr_open as c, count(fr_open) as w from championships group by fr_open) union all (select us_open as c, count(us_open) as w from championships group by us_open) union all (select au_open as c, count(au_open) as w from championships group by au_open)) select c as player_id, player_name, sum(w) as grand_slams_count from total join players on total.c = players.player_id group by c"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 708, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(wimbledon=p.player_id)+ sum(fr_open=p.player_id) + sum(us_open=p.player_id) + sum(au_open=p.player_id)) as grand_slams_count from players p, championships group by p.player_id having grand_slams_count <> 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 709, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon winner from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select p.*, count(c.winner) grand_slams_count from players p join cte c on p.player_id=c.winner group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 710, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, t.grand_slams_count from players as p right join (select tournament as player, count(*) as grand_slams_count from( select year, wimbledon as tournament, 'wimbledon' as slam from championships union select year, fr_open as tournament, 'french' as slam from championships union select year, us_open as tournament, 'us' as slam from championships union select year, au_open as tournament, 'australian' as slam from championships) as t group by player ) as t on p.player_id = t.player"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 711, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id , p.player_name, sum( (case when p.player_id = c.wimbledon then 1 else 0 end)+ (case when p.player_id = c.fr_open then 1 else 0 end)+ (case when p.player_id = c.us_open then 1 else 0 end)+ (case when p.player_id = c.au_open then 1 else 0 end) )grand_slams_count from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 712, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c1 as ( select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select c1.player_id, p.player_name, count(c1.player_id) as grand_slams_count from c1 join players p on c1.player_id = p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 713, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from players join (select wimbledon as player_id, count(*) grand_slams_count from (select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) u group by player_id) w using (player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 714, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ), winners as ( select player_id, count(*) as grand_slams_count from cte group by player_id ) select p.player_id, p.player_name, w.grand_slams_count from winners w join players p on w.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 715, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id,p.player_name,sum(a.wins) as grand_slams_count from ( select count(wimbledon) as wins ,wimbledon as player_id from championships group by wimbledon union all select count(fr_open) as wins ,fr_open as player_id from championships group by fr_open union all select count(us_open) as wins ,us_open as player_id from championships group by us_open union all select count(au_open) as wins ,au_open as player_id from championships group by au_open ) a inner join players p on p.player_id=a.player_id group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 716, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_winner as( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships ) select a.winner as player_id, p.player_name, count(*) as grand_slams_count from players p join all_winner a on p.player_id = a.winner group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 717, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(case when p.player_id = wimbledon then 1 else 0 end)+sum(case when p.player_id = fr_open then 1 else 0 end)+sum(case when p.player_id = us_open then 1 else 0 end)+ sum(case when p.player_id = au_open then 1 else 0 end) as grand_slams_count from championships c, players p where player_id = wimbledon or player_id = fr_open or player_id = us_open or player_id = au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 718, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(if(player_id = wimbledon, 1, 0) + if(player_id = fr_open, 1, 0) + if(player_id = us_open, 1, 0) + if(player_id = au_open, 1, 0)) as grand_slams_count from players join championships on ( player_id = wimbledon or player_id = fr_open or player_id = us_open or player_id = au_open ) group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 719, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select x.player_id, x.player_name, sum(x.winner) as grand_slams_count from ( select p.player_id, player_name, count(wimbledon) as winner from championships c left join players p on p.player_id = c.wimbledon group by p.player_id union all select p.player_id, player_name, count(fr_open) as winner from championships c left join players p on p.player_id = c.fr_open group by p.player_id union all select p.player_id, player_name, count(us_open) as winner from championships c left join players p on p.player_id = c.us_open group by p.player_id union all select p.player_id, player_name, count(au_open) as winner from championships c left join players p on p.player_id = c.au_open group by p.player_id ) x group by x.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 720, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as(select year, wimbledon as win from championships union all select year, fr_open as win from championships union all select year, us_open as win from championships union all select year, au_open as win from championships) select p.player_id, player_name, count(*) as grand_slams_count from temp join players p on temp.win = p.player_id group by p.player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 721, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( select wimbledon as scores from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select p.player_id, p.player_name, count(t1.scores) as grand_slams_count from t1 left join players p on t1.scores = p.player_id group by p.player_id"]}
