{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 478, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select b.follower as follower , a.follower_num as num from (select followee, count(follower) as follower_num from follow group by followee having count(follower) >= 1) a inner join (select follower, count(followee) as followee_num from follow group by follower having count(followee) >= 1) b on a.followee = b.follower order by b.follower asc"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 479, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followee as ( select followee, count(follower) as num_followee from follow group by followee ), follower as ( select follower, count(followee) as num_follower from follow group by follower ) select followee as follower, num_followee as num from followee inner join follower on followee = follower where num_followee >= 1 and num_follower >= 1 order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 480, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with f1 as( select followee as name, count(distinct follower) as follower_num from follow group by followee ), f2 as( select follower, count(distinct followee) as followee_num from follow group by follower ), combine_table as( select * from f1 union all select * from f2) select name as follower, follower_num as num from f1 where name in (select name from combine_table group by name having count(name)>=2)"]}
