{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 22, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t1.player_id, player_name, sum(wins) as grand_slams_count from players as t1 join ( select wimbledon as player_id, count(wimbledon) as wins from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as wins from championships group by fr_open union all select us_open as player_id, count(us_open) as wins from championships group by us_open union all select au_open as player_id, count(au_open) as wins from championships group by au_open ) as t2 on(t1.player_id = t2.player_id) group by player_id order by player_id desc"]}
