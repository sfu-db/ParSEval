{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 77, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct li.account_id from loginfo li, loginfo lg where li.account_id = lg.account_id and ( lg.login between li.login and li.logout or lg.logout between li.login and li.logout) and li.ip_address != lg.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 78, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with cte1 as ( select distinct * from loginfo order by login, logout) select distinct a.account_id from cte1 as a, cte1 as b where a.account_id = b.account_id and a.ip_address != b.ip_address and a.login<=b.login and b.login<=a.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 79, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with cte_log as ( select account_id, login as log_time, 'login' as log_type, ip_address from loginfo union select account_id, logout as log_time, 'logout' as log_type, ip_address from loginfo ) select distinct account_id from ( select account_id, ip_address as current_address, log_type as current_log_type, lead(log_type, 1) over (partition by account_id order by log_time) as next_log_type, lead(ip_address, 1) over (partition by account_id order by log_time) as next_adress from cte_log ) l where current_log_type = next_log_type and current_address != next_adress"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 80, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with distinct_records as ( select distinct account_id, ip_address, login, logout from loginfo ), find_next_login as ( select *, lead(login, 1) over(partition by account_id order by login) as next_login, lead(ip_address, 1) over(partition by account_id order by login) as next_ip from distinct_records ) select distinct account_id from find_next_login where next_login >= login and next_login <= logout and ip_address <> next_ip"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 81, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with find_next_login as ( select *, lead(login, 1) over(partition by account_id order by login) as next_login, lead(ip_address, 1) over(partition by account_id order by login) as next_ip from loginfo ) select distinct account_id from find_next_login where next_login >= login and next_login <= logout and ip_address <> next_ip"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 82, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with main as ( select account_id, (case when lead(ip_address) over w is null then 0 when ip_address <> lead(ip_address) over w and timestampdiff(second,logout,lead(login) over w) <= 0 then 1 else 0 end) as stat from loginfo window w as (partition by account_id order by login) ) select distinct account_id from main where stat=1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 83, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with new_log as ( select l1.account_id, l1.ip_address from loginfo l1, loginfo l2 where l2.login >= l1.login and l2.login <= l1.logout and l1.account_id = l2.account_id and l1.ip_address != l2.ip_address ) select distinct account_id from new_log"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 84, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with remove_duplicates as (select * from loginfo) select distinct login1.account_id from remove_duplicates login1 join remove_duplicates login2 on login1.account_id = login2.account_id and login1.ip_address != login2.ip_address where login2.login between login1.login and login1.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 85, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with table1 as( select account_id, ip_address, login, logout, lead(login)over(partition by account_id order by login asc) as lead_login, lead(ip_address)over(partition by account_id order by login asc) lead_ip from loginfo ) select distinct account_id from table1 where (lead_login <= logout) and (ip_address != lead_ip)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 86, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id from loginfo a inner join loginfo b on a.account_id = b.account_id and a.ip_address <> b.ip_address and a.login between b.login and b.logout group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 87, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id from loginfo a join loginfo b on a.account_id = b.account_id where ((a.login >= b.login and a.login <= b.logout) or (a.logout >= b.login and a.logout <= b.logout) or (a.login <= b.login and a.logout >= b.logout)) and (a.ip_address != b.ip_address) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 88, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id from loginfo a, loginfo b where a.login between b.login and b.logout and a.account_id = b.account_id and a.ip_address <> b.ip_address group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 89, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id from loginfo a inner join loginfo b on a.account_id = b.account_id and a.ip_address<> b.ip_address where a.login between b.login and b.logout group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 90, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.ip_address != b.ip_address where b.login >= a.login and b.login <= a.logout group by account_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 91, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select account_id from ( select l1.account_id, case when l1.login <= l2.login and l1.logout >= l2.login then 1 else 0 end as flag from loginfo l1 left join loginfo l2 on l1.account_id = l2.account_id where l1.ip_address != l2.ip_address ) cte group by 1 having sum(flag) >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 92, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select account_id from loginfo a where exists (select 1 from loginfo where a.account_id = account_id and a.login between login and logout and a.ip_address != ip_address) group by account_id"]}
