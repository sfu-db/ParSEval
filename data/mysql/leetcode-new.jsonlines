{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 26, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "select install_dt, count(install_dt) as installs, round(count(a.event_date)/count(install_dt),2) as day1_retention from (select player_id, min(event_date) as install_dt from activity group by player_id) as b left join activity a on a.event_date = b.install_dt + 1 and b.player_id = a.player_id group by install_dt"]}
