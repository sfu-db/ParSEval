{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 47, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "select bins.bin, coalesce(t.total, 0) as total from (select case when duration < 5*60 and duration >= 0 then '[0-5>' when duration < 10*60 and duration >= 5*60 then '[5-10>' when duration < 15*60 and duration >= 10*60 then '[10-15>' else '15 or more' end as bin, count(*) as total from sessions group by 1) t right join (select '[0-5>' as bin union all select '[5-10>' as bin union all select '[10-15>' as bin union all select '15 or more' as bin) bins on t.bin = bins.bin"]}
