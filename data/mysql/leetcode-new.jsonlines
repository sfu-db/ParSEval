{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 312, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with cte as ( select session_id, duration, sum(round(duration/60, 2)<5) as bin1, sum((round(duration/60, 2)>=5) and round(duration/60, 2)<10) as bin2, sum((round(duration/60, 2)>=10) and (round(duration/60, 2)<15)) as bin3, sum(round(duration/60, 2)>=15) as bin4 from sessions) select '[0-5>' as bin, bin1 as total from cte union select '[5-10>' as bin, bin2 as total from cte union select '[10-15>' as bin, bin3 as total from cte union select '15 or more' as bin, bin4 as total from cte"]}
