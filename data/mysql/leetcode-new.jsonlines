{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 159, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as ( select wimbledon as player_win from championships union all select fr_open as player_win from championships union all select us_open as player_win from championships union all select au_open as player_win from championships ) select p.player_id, p.player_name, count(w.player_win) as grand_slams_count from players as p join wins as w on p.player_id = player_win group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 160, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with won as ( select wimbledon as player_id, year from championships union all select fr_open as player_id, year from championships union all select us_open as player_id, year from championships union all select au_open as player_id, year from championships) select p.player_id, p.player_name, count(w.year) as grand_slams_count from players as p inner join won as w on p.player_id = w.player_id group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 161, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) select c.id as player_id, p.player_name, count(id) as grand_slams_count from cte c left join players p on c.id = p.player_id group by c.id order by c.id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 162, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as tournaments from championships union all select fr_open as tournaments from championships union all select us_open as tournaments from championships union all select au_open as tournaments from championships) select player_id, player_name, count(tournaments) as grand_slams_count from cte c join players p on c.tournaments = p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 163, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select winner, count(winner) as grand_slams_count from (select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships) temp group by winner) select p.player_id, p.player_name, cte.grand_slams_count from cte inner join players p on cte.winner = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 164, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year, wimbledon as id from championships ch union all select year,fr_open as id from championships union all select year,us_open as id from championships union all select year,au_open as id from championships) select player_id, player_name, count(id) as grand_slams_count from cte join players pl on cte.id = pl.player_id group by id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 165, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, (select count(year) from championships where wimbledon=p.player_id) + (select count(year) from championships where fr_open=p.player_id) + (select count(year) from championships where us_open=p.player_id) + (select count(year) from championships where au_open=p.player_id) as grand_slams_count from players as p ) as a where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 166, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select ans.player_id, ans.player_name, (wimbledon+fr_open+us_open+au_open) as grand_slams_count from ( select w1.player_id, w1.player_name, w1.wimbledon, f1.fr_open, u1.us_open, a1.au_open from (select w.player_id, w.player_name, count(w.wimbledon) as wimbledon from (select p.player_id, p.player_name, c.year as wimbledon from players p left join championships c on p.player_id = c.wimbledon) w group by w.player_id, w.player_name) w1 left join (select f.player_id, f.player_name, count(f.fr_open) as fr_open from (select p.player_id, p.player_name, c.year as fr_open from players p left join championships c on p.player_id = c.fr_open) f group by f.player_id, f.player_name) f1 on w1.player_id = f1.player_id and w1.player_name = f1.player_name left join (select u.player_id, u.player_name, count(u.us_open) as us_open from (select p.player_id, p.player_name, c.year as us_open from players p left join championships c on p.player_id = c.us_open) u group by u.player_id, u.player_name) u1 on w1.player_id = u1.player_id and w1.player_name = u1.player_name left join (select a.player_id, a.player_name, count(a.au_open) as au_open from (select p.player_id, p.player_name, c.year as au_open from players p left join championships c on p.player_id = c.au_open) a group by a.player_id, a.player_name) a1 on w1.player_id = a1.player_id and w1.player_name = a1.player_name ) ans ) ans1 where ans1.grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 167, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from (select p.player_id, p.player_name, sum(case when wimbledon = player_id then 1 else 0 end + case when fr_open = player_id then 1 else 0 end + case when us_open = player_id then 1 else 0 end + case when au_open = player_id then 1 else 0 end) as grand_slams_count from players p, championships c group by 1,2) tmp where grand_slams_count != 0"]}
