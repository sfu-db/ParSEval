{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 736, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, (count(visits.visit_id)-count(transaction_id)) as count_no_trans from visits left outer join transactions on visits.visit_id = transactions.visit_id group by customer_id having count_no_trans != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 737, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with no_transaction_visits as ( select customer_id, visit_id from visits where visit_id not in ( select visit_id from transactions ) ) select customer_id, count(visit_id) as count_no_trans from no_transaction_visits group by customer_id"]}
