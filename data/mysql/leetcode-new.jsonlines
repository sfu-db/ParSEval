{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 17, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by make_name, date_id order by make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 18, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "with cte_lead as ( select date_id, make_name, count(distinct lead_id) as unique_leads from dailysales group by date_id, make_name ), cte_partner as ( select date_id, make_name, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name ) select a.date_id, a.make_name, a.unique_leads, b.unique_partners from cte_lead a inner join cte_partner b on a.date_id = b.date_id and a.make_name = b.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 19, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select distinct date_id,make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 20, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select a.date_id, a.make_name, count(distinct a.lead_id) as unique_leads, count(distinct a.partner_id) as unique_partners from dailysales b left join dailysales a on a.date_id = b.date_id and a.make_name = b.make_name group by a.date_id, a.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 21, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select a.date_id, a.make_name, count(distinct a.lead_id) as unique_leads, count(distinct a.partner_id) as unique_partners from dailysales b left join dailysales a on a.date_id = b.date_id and a.make_name = b.make_name where b.lead_id <= a.lead_id and b.partner_id <= a.partner_id group by a.date_id, a.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 22, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select a.date_id, a.make_name, count(distinct(a.lead_id)) as unique_leads, count(distinct(a.partner_id)) as unique_partners from dailysales a join dailysales b where a.date_id = b.date_id and a.make_name = b.make_name group by a.date_id, a.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 23, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select a.date_id, a.make_name,a.unique_leads,b.unique_partners from (select date_id, make_name, count(distinct lead_id) as unique_leads from dailysales where date_id is not null and make_name is not null group by date_id, make_name) a left join (select date_id, make_name, count(distinct partner_id) as unique_partners from dailysales where date_id is not null and make_name is not null group by date_id, make_name) b on a.date_id=b.date_id and a.make_name=b.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 24, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select d.date_id, d.make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales d group by 1,2"]}
