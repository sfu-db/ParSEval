{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 359, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select distinct champion,count(game) as grand_slams_count from (select year, 'wimbledon' as game, wimbledon as champion from championships union select year, 'fr_open' as game, fr_open as champion from championships union select year, 'us_open' as game, us_open as champion from championships union select year, 'au_open' as game, au_open as champion from championships)a group by champion) select cte.champion as player_id, p.player_name, cte.grand_slams_count from cte join players p on cte.champion=p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 360, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select id, count(id) as num from (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) a group by id) select p.player_id, player_name, num as grand_slams_count from cte c join players p on c.id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 361, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select p.player_id, sum(p.player_id=wimbledon)+sum(p.player_id=fr_open)+sum(p.player_id=us_open)+sum( p.player_id=au_open) as grand_slams_count from players as p join championships as c on (p.player_id=wimbledon or p.player_id=fr_open or p.player_id=us_open or p.player_id=au_open) group by player_id ) select p.player_id, p.player_name, grand_slams_count from players as p join cte on p.player_id = cte.player_id"]}
