{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 317, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select vi.customer_id,count(*) as count_no_trans from visits vi left join transactions trn on vi.visit_id = trn.visit_id where trn.transaction_id is null group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 318, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select visits.customer_id as customer_id,count(visits.visit_id)as count_no_trans from visits left join transactions on visits.visit_id = transactions.visit_id where transaction_id is null group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 319, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select visits.customer_id, count(visits.visit_id)as count_no_trans from visits left outer join transactions on visits.visit_id= transactions.visit_id where transactions.transaction_id is null group by visits.customer_id order by count_no_trans desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 320, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with a as (select v.customer_id, v.visit_id, t.transaction_id, t.amount from visits v left join transactions t on v.visit_id = t.visit_id where transaction_id is null) select customer_id, count(customer_id) as count_no_trans from a group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 321, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte as ( select v.*,t.transaction_id from visits v left join transactions t on v.visit_id = t.visit_id where transaction_id is null ) select customer_id ,count(visit_id) as count_no_trans from cte group by customer_id order by count_no_trans desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 322, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte as ( select v.customer_id,t.transaction_id from visits as v left join transactions as t on v.visit_id=t.visit_id where t.transaction_id is null ) select customer_id,count(*) as count_no_trans from cte group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 323, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte as( select * from visits where visit_id not in (select visit_id from transactions) ) select customer_id, count(visit_id) as count_no_trans from cte group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 324, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with cte_agg_filter as ( select customer_id, count(distinct v.visit_id) as count_no_trans from visits as v left join transactions as t on v.visit_id = t.visit_id where transaction_id is null group by 1 ) select * from cte_agg_filter"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 325, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with new as ( select v.customer_id, ifnull(t.visit_id,0) as counting from visits v left join transactions t on v.visit_id = t.visit_id ) select customer_id, count(*) as count_no_trans from new where counting = 0 group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 326, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with ta as (select v.*, t.visit_id as t_visit, t.transaction_id from visits v left join transactions t on v.visit_id = t.visit_id where t.visit_id is null) select customer_id, count(*) as count_no_trans from ta group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 327, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with tran_per_visit as ( select visit_id, sum(amount) as total_amount from transactions group by visit_id ), visits_trans as ( select a.*, b.total_amount from visits as a left join tran_per_visit as b on a.visit_id = b.visit_id ) select customer_id, count(*) as count_no_trans from visits_trans where total_amount is null group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 328, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with visit_totals as ( select v.customer_id, v.visit_id, coalesce(sum(t.amount),0) as visit_total from visits v left join transactions t on t.visit_id = v.visit_id group by v.visit_id ) select customer_id, count(visit_id) as count_no_trans from visit_totals where visit_total = 0 group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 329, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select a.customer_id, count(*) as count_no_trans from visits a left join transactions b on a.visit_id = b.visit_id where b.transaction_id is null group by 1"]}
