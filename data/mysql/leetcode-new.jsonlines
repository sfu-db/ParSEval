{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 96, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with t1 as( select count(delivery_id) as count_immediate from delivery where order_date = customer_pref_delivery_date ), t2 as( select count(delivery_id) as count_total from delivery ) select round(count_immediate/count_total*100,2) as immediate_percentage from t1, t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 97, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as (select delivery_id, customer_id, (case when customer_pref_delivery_date = order_date then 'immediate' when customer_pref_delivery_date != order_date then 'scheduled' else null end) as order_type from delivery) select round( (count(case when temp.order_type = 'immediate' then 1 end))/(count(distinct delivery_id)) * 100, 2) as immediate_percentage from temp"]}
