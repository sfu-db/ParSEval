{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 403, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "select p.name,sum(coalesce(rest,'0')) as rest ,sum(coalesce(paid,'0')) as paid, sum(coalesce(canceled,'0'))as canceled, sum(coalesce(refunded,'0'))as refunded from product p left join invoice i on i.product_id=p.product_id group by name order by name"]}
{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 404, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with cal as (select product_id,sum(rest) as rest, sum(paid) as paid, sum(canceled) as canceled, sum(refunded) as refunded from invoice group by product_id) select b.name, ifnull(a.rest,0) as rest, ifnull(a.paid,0) as paid, ifnull(a.canceled,0) as canceled, ifnull(a.refunded,0) as refunded from cal a right join product b on a.product_id=b.product_id order by b.name"]}
