{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 312, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select project_id, round(avg(experience_years),2) as average_years from( select p.project_id, e.experience_years, row_number() over (partition by p.project_id, p.employee_id) = 1 as rn from project p join employee e on p.employee_id = e.employee_id ) a where rn =1 group by project_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 313, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select a.project_id , round(a.exp / a.cnt , 2) as average_years from (select a.project_id , sum(coalesce(b.experience_years , 0)) as exp , if(count(*) = 0 , 1 ,count(*)) as cnt from project a left join employee b on a.employee_id = b.employee_id group by project_id) a"]}
