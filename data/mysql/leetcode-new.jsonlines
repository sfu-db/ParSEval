{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 394, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t.product_id, round(sum(price*units) / sum(units), 2) as average_price from prices t join unitssold s on t.product_id = s.product_id and s.purchase_date between t.start_date and t.end_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 395, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id as product_id,round(sum(u.units * p.price)/ sum(u.units),2) as average_price from prices p join unitssold u on p.product_id=u.product_id and (purchase_date between start_date and end_date) group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 396, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with priced_units as ( select u.product_id, u.units, p.price*u.units as total_price from unitssold u inner join prices p on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date ) select product_id, round(sum(total_price)/sum(units), 2) as average_price from priced_units group by product_id"]}
