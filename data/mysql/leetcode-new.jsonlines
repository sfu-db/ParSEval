{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 646, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id,p.player_name, sum(player_id=wimbledon)+sum(player_id=fr_open)+sum(player_id=us_open)+sum(player_id=au_open) as grand_slams_count from players p join championships c group by p.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 647, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with grand_slam as ( select wimbledon as player_id, count(1) as tourney_cnt from championships group by 1 union all select fr_open as player_id, count(1) as tourney_cnt from championships group by 1 union all select us_open as player_id, count(1) as tourney_cnt from championships group by 1 union all select au_open as player_id, count(1) as tourney_cnt from championships group by 1 ) select p.player_id, p.player_name,sum(tourney_cnt) as grand_slams_count from grand_slam g left join players p on g.player_id = p.player_id where p.player_id is not null group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 648, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as grand_slam, year from championships union all select fr_open as grand_slam, year from championships union all select us_open as grand_slam, year from championships union all select au_open as grand_slam, year from championships ) select player_id, player_name, count(*) as grand_slams_count from cte left join players on cte.grand_slam = players.player_id group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 649, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select q1.player_id, pl.player_name, sum(matches) as grand_slams_count from ( select distinct player_id, count(player_id) as matches from ( select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships )pv group by 1 )q1 join players pl on pl.player_id = q1.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 650, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, sum(if(wimbledon = player_id, 1, 0)) + sum(if(fr_open = player_id, 1, 0)) + sum(if(us_open = player_id, 1, 0)) + sum(if(au_open = player_id, 1, 0)) as grand_slams_count from players cross join championships group by player_id ) as w where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 651, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as total from championships union all select fr_open as total from championships union all select us_open as total from championships union all select au_open as total from championships ), cte2 as ( select total as id,count(*) as win_count from cte group by total ) select player_id,player_name,cte2.win_count as grand_slams_count from players p join cte2 on p.player_id=cte2.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 652, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as( select year, wimbledon as games from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships) select player_id, player_name, count(games) as grand_slams_count from cte1 join players p on cte1.games = p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 653, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from (select player_id, player_name, (select sum(if(wimbledon = player_id,1,0))+ sum(if(fr_open = player_id,1,0))+ sum(if(us_open = player_id,1,0))+ sum(if(au_open = player_id,1,0)) from championships) as grand_slams_count from players) as t where grand_slams_count >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 654, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select year, wimbledon as player_id from championships union all select year, fr_open as grand from championships union all select year, us_open as grand from championships union all select year, au_open as grand from championships) select a.player_id, b.player_name, count(*) as grand_slams_count from cte a inner join players b on a.player_id = b.player_id group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 655, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(player_id = wimbledon)+ sum(player_id= fr_open)+ sum(player_id= us_open)+ sum(player_id= au_open) as grand_slams_count from players join championships on player_id = wimbledon or player_id= fr_open or player_id= us_open or player_id= au_open group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 656, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as(select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, au_open as player_id from championships union all select year, us_open as player_id from championships) select a.player_id, player_name, count(*) as grand_slams_count from cte a join players b on a.player_id=b.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 657, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t.player_id, p.player_name, sum(t.cnt) as grand_slams_count from ( select wimbledon as player_id, count(*) as cnt from championships group by wimbledon union all select fr_open as player_id, count(*) as cnt from championships group by fr_open union all select us_open as player_id, count(*) as cnt from championships group by us_open union all select au_open as player_id, count(*) as cnt from championships group by au_open) t join players p on p.player_id = t.player_id group by t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 658, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id,player_name,grand_slams_count from players p join ( select player_id,count(*) as grand_slams_count from ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships )x group by player_id)x on p.player_id=x.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 659, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as ( select id, count(1) cnt from ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) a group by 1 ) select id as player_id , b.player_name , cnt as grand_slams_count from cte1 a , players b where a.id = player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 660, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as winner from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships ) select p.player_id, p.player_name, count(c.year) as grand_slams_count from players p join cte c on p.player_id=c.winner group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 661, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(player_id=wimbledon)+sum(player_id=fr_open)+sum(player_id=us_open)+sum(player_id=au_open) as grand_slams_count from players as p join championships as c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 662, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name,sum(grand_slams_count) as grand_slams_count from (select p.player_id,p.player_name,count(*) as grand_slams_count from players p join championships p1 on p.player_id = p1.wimbledon group by 1 union all select p.player_id,p.player_name,count(*) as grand_slams_count from players p join championships p2 on p.player_id = p2.fr_open group by 1 union all select p.player_id,p.player_name,count(*) as grand_slams_count from players p join championships p3 on p.player_id = p3.au_open group by 1 union all select p.player_id,p.player_name,count(*) as grand_slams_count from players p join championships p4 on p.player_id = p4.us_open group by 1) temp group by player_id"]}
