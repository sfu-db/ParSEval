{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 377, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, ifnull(round(sum(total_price) / sum(units), 2), 0) as average_price from ( select p.product_id as product_id, units, price * units as total_price from prices p left join unitssold us on p.product_id = us.product_id and purchase_date between start_date and end_date ) as dates group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 378, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(ifnull(sum(p.price*u.units)/sum(units),0),2) as average_price from prices p left join unitssold u on p.product_id=u.product_id and u.purchase_date between p.start_date and p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 379, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t1 as( select *, units * price as total from (select u.* , p.start_date, p.end_date, p.price from unitssold u left join prices p on u.product_id = p.product_id) as t where purchase_date >= start_date and purchase_date <= end_date) select product_id, round(sum(total)/sum(units), 2) as average_price from t1 group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 380, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select x.product_id, round((sum(p.price*x.units)/sum(x.units)),2) as average_price from unitssold x left join prices p on (x.purchase_date between p.start_date and p.end_date and x.product_id=p.product_id) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 381, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(s.units*p.price) / sum(s.units),2)as average_price from prices p join unitssold s on p.product_id = s.product_id and s.purchase_date between p.start_date and p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 382, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price*u.units)/sum(u.units),2) as average_price from prices p left join unitssold u on p.product_id=u.product_id where u.purchase_date between p.start_date and p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 383, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id, round(sum(p.price*u.units)/sum(u.units),2) as average_price from unitssold u left join prices p on p.product_id=u.product_id and purchase_date between start_date and end_date group by u.product_id order by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 384, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units)/sum(u.units), 2) as average_price from prices p left join unitssold u on p.product_id = u.product_id and u.purchase_date>= p.start_date and u.purchase_date<= p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 385, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price*units)/sum(units),2) average_price from prices p join unitssold u on p.product_id=u.product_id and u.purchase_date >=p.start_date and u.purchase_date <=p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 386, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with sell as (select p.product_id, price,units from prices p join unitssold u on p.product_id = u.product_id where purchase_date >= start_date and purchase_date <= end_date) select product_id, round(sum(price*units)/sum(units),2) as average_price from sell group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 387, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(price*units)/sum(units),2) as average_price from prices join unitssold on prices.product_id = unitssold.product_id where purchase_date between start_date and end_date group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 388, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price*s.units) / sum(s.units),2) as average_price from prices p join unitssold s on p.product_id = s.product_id where s.purchase_date >= p.start_date and s.purchase_date <= p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 389, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(prices.price*unitssold.units)/sum(unitssold.units),2) as average_price from prices inner join unitssold on unitssold.purchase_date between prices.start_date and prices.end_date and unitssold.product_id = prices.product_id group by unitssold.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 390, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as ( select a.product_id, sum(a.price*b.units) as total,sum(b.units) as units from prices a left join unitssold b on a.product_id=b.product_id where b.purchase_date>=a.start_date and b.purchase_date<= a.end_date group by a.product_id ) select product_id,round(total/sum(units),2) as average_price from cte group by 1 order by 1 asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 391, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select distinct p.product_id, round(sum(p.price*u.units)/sum(u.units),2) as average_price from prices p join unitssold u on p.product_id = u.product_id and u.purchase_date between p.start_date and p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 392, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select unitssold.product_id, round(sum(units * price) / sum(units),2) as average_price from unitssold left join prices on prices.start_date <= unitssold.purchase_date and unitssold.purchase_date <= prices.end_date and prices.product_id = unitssold.product_id group by unitssold.product_id"]}
