{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 538, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select r.follower as follower, count(distinct e.follower) as num from follow r inner join follow e on r.follower = e.followee group by 1 order by follower"]}
