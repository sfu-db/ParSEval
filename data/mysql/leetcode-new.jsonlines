{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 365, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units) / sum(units), 2) as average_price from prices p join unitssold u on p.product_id = u.product_id and u.purchase_date <= p.end_date and u.purchase_date >= p.start_date group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 366, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round((sum(p.price*us.units)/sum(us.units)),2) as average_price from prices p, unitssold us where p.product_id = us.product_id and us.purchase_date between p.start_date and p.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 367, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with t1 as ( select p.product_id, sum(units*price) as total_price from unitssold as u join prices as p on purchase_date between start_date and end_date and u.product_id=p.product_id group by p.product_id), t2 as (select product_id, sum(units) as total_units from unitssold group by product_id) select t1.product_id, round(total_price/total_units,2) as average_price from t1 join t2 using(product_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 368, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with priced_units as ( select u.product_id, u.units, p.price from unitssold u join prices p on u.product_id = p.product_id and u.purchase_date between p.start_date and p.end_date ) ,total_prices as ( select product_id, units, units*price as total_price from priced_units ) select product_id, round(sum(total_price)/sum(units), 2) as average_price from total_prices group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 369, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select pid1 as product_id, round(total_price / total_count, 2) as average_price from (select pid1, sum(u * p) as total_price, sum(u) as total_count from (select product_id as pid1, price as p, start_date as s_date, end_date as e_date from prices) d1 right outer join (select product_id as pid2, units as u, purchase_date as date from unitssold) d2 on d1.pid1 = d2.pid2 where d1.s_date <= d2.date and d1.e_date >= d2.date group by pid1) d3"]}
