{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 703, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with t1 as ( select s.buyer_id, s.product_id from sales s join product p on s.product_id = p.product_id and p.product_name = 's8' ), t2 as ( select s.buyer_id, s.product_id from sales s join product p on s.product_id = p.product_id and p.product_name = 'iphone' ) select distinct t1.buyer_id from t1 where t1.buyer_id not in (select buyer_id from t2)"]}
