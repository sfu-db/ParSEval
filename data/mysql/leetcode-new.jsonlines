{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 94, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as ( select delivery_id, case when order_date = customer_pref_delivery_date then 'immediate' else 'scheduled' end as order_type from delivery ) select round((select count(delivery_id) from temp where order_type = 'immediate') * 100 / (select count(delivery_id) from temp), 2) as immediate_percentage"]}
