{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 318, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s2.buyer_id from sales s2 join (select buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 's8') x on x.buyer_id = s2.buyer_id where x.buyer_id not in (select a.buyer_id from sales a join product b on a.product_id = b.product_id where b.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 319, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct t1.buyer_id from (select x.buyer_id from sales as x where x.buyer_id not in (select s.buyer_id from sales as s where s.product_id in (select product_id from product where product_name = 'iphone'))) as t1 where t1.buyer_id in (select y.buyer_id from sales as y where y.product_id in (select product_id from product where product_name = 's8'))"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 320, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct(b.buyer_id) from sales b where b.buyer_id in( select b.buyer_id from sales b left join product a on a.product_id=b.product_id where a.product_name='s8') and b.buyer_id not in( select b.buyer_id from sales b left join product a on a.product_id=b.product_id where a.product_name='iphone')"]}
