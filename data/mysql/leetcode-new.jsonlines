{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 366, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as playerid,count(*) as cnt from championships group by wimbledon union all select fr_open as playerid,count(*) as cnt from championships group by fr_open union all select us_open as playerid,count(*) as cnt from championships group by us_open union all select au_open as playerid,count(*) as cnt from championships group by au_open ) select playerid as player_id,player_name,sum(cnt) as grand_slams_count from cte a join players b on a.playerid=b.player_id group by playerid"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 367, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year , wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select a.player_id ,a.player_name, count(b.player_id) as grand_slams_count from players a left join cte b on a.player_id = b.player_id where b.player_id is not null group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 368, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year, wimbledon as prize from championships union all select year, fr_open as prize from championships union all select year, us_open as prize from championships union all select year, au_open as prize from championships) select cte.prize as player_id, player_name, count(*) grand_slams_count from cte join players on cte.prize = players.player_id group by cte.prize order by cte.prize asc"]}
