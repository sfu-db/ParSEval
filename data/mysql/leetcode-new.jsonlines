{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 141, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with binned_sessions as ( select *, case when duration < 300 then '[0-5>' when duration < 600 then '[5-10>' when duration < 900 then '[10-15>' else '15 or more' end as bin from sessions ), all_bins as ( select * from ( select '[0-5>' as bin union all select '[5-10>' union all select '[10-15>' union all select '15 or more' ) as a ), bin_counts as ( select bin, count(*) as total from binned_sessions group by bin ) select a.bin, coalesce(b.total, 0) as total from all_bins as a left join bin_counts as b on a.bin = b.bin"]}
