{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 92, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, sum(case when t.amount is null then 1 else 0 end) as count_no_trans from visits v left join transactions t on v.visit_id = t.visit_id group by 1 having count_no_trans > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 93, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, sum(no_trans) as count_no_trans from (select v.customer_id, v.visit_id, t.amount, case when t.amount is null then 1 else 0 end as no_trans from visits v left join transactions t on v.visit_id = t.visit_id) t group by 1 having count_no_trans >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 94, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, sum(num_transactions is null) as count_no_trans from visits v left join ( select count(transaction_id) as num_transactions, visit_id from transactions group by visit_id ) n on v.visit_id = n.visit_id group by customer_id having sum(num_transactions is null) > 0"]}
