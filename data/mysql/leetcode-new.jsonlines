{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 401, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with a as(select account_id, login <= lag(logout, 1,'1970-01-01 00:00:00') over (partition by account_id order by login) as ind1, ip_address != lag(ip_address, 1) over (partition by account_id order by login) as ind2 from loginfo ) select account_id from a where ind1=1 and ind2=1 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 402, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with p as (select *, lead(login) over(partition by account_id order by login) as next_login, lead(ip_address,1,-1) over(partition by account_id order by login) as next_ip from loginfo) select distinct account_id from p where next_login <= logout and next_ip != ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 403, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 inner join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and (l1.login between l2.login and l2.logout or l1.logout between l2.login and l2.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 404, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 left join loginfo l2 on l1.account_id = l2.account_id where l2.login between l1.login and l1.logout and l1.ip_address != l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 405, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id where l1.ip_address != l2.ip_address and ((l1.logout between l2.login and l2.logout) or (l2.logout between l1.login and l1.logout))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 406, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo as a inner join loginfo as b where a.account_id = b.account_id and a.ip_address <> b.ip_address and (a.login between b.login and b.logout or b.login between a.login and a.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 407, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and l2.login <= l1.logout and l2.logout >= l1.login"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 408, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and ((l2.login between l1.login and l1.logout) or (l2.logout between l1.login and l1.logout))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 409, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct(account_id) from( select account_id, logout, ip_address, lead(login,1,'9999-12-31') over (partition by account_id order by login) next_login, lead(ip_address,1,0) over (partition by account_id order by login) next_ip_address from loginfo) a where logout >= next_login and ip_address != next_ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 410, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct account_id from loginfo where account_id in (select l1.account_id from loginfo l1 join loginfo l2 on l1.account_id=l2.account_id and l1.ip_address!=l2.ip_address and (l1.login between l2.login and l2.logout or l2.login between l1.login and l1.logout))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 411, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l.account_id from loginfo l, loginfo l2 where l.login between l2.login and l2.logout and l.account_id = l2.account_id and l.ip_address != l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 412, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select l1.account_id from loginfo l1 join loginfo l2 on (l1.account_id=l2.account_id and l1.login<l2.login and l1.ip_address!=l2.ip_address) where greatest(l1.login, l2.login)<=least(l1.logout,l2.logout) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 413, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with cte as( select a.account_id as aid, a.ip_address as aip, a.login as ain, a.logout as aout, b.account_id as bid, b.ip_address as bip, b.login as bin, b.logout as bout from loginfo a join loginfo b on a.account_id=b.account_id and a.ip_address !=b.ip_address ) select distinct aid as account_id from cte where (bin<=aout and bout>=aout) or (ain<=bout and aout>=bout)"]}
