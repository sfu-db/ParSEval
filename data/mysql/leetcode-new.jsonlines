{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 135, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with a as (select distinct s.product_id from sales s left join product p on p.product_id = s.product_id where sale_date not between '2019-01-01' and '2019-03-31') select distinct s.product_id, p.product_name from sales s left join product p on p.product_id = s.product_id where sale_date between '2019-01-01' and '2019-03-31' and s.product_id not in (select * from a)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 136, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as (select distinct product_id from sales where (sale_date between '2019-01-01' and '2019-03-31') and product_id not in (select product_id from sales where sale_date <'2019-01-01' or sale_date> '2019-03-31')) select c.product_id, product_name from cte c join product p on c.product_id=p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 137, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with nt1 as ( select product.product_id, product.product_name, sales.sale_date from sales left join product on sales.product_id = product.product_id ) select product_id, product_name from nt1 group by product_id having min(nt1.sale_date)>='2019-01-01' and max(nt1.sale_date) <= '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 138, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sold_other as (select distinct product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' ) select distinct product_id, product_name from product where product_id not in (select product_id from sold_other)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 139, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as ( select p.product_name, p.product_id, s.sale_date, case when s.sale_date between '2019-01-01' and '2019-03-31' then 1 else 0 end as temp1 from product p inner join sales s on p.product_id = s.product_id ) select distinct product_id, product_name from t1 where temp1 = 1 and product_id not in (select product_id from t1 where temp1 = 0)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 140, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with a as( select product_id, (case when sale_date>='2019-01-01' and sale_date<='2019-03-31' then 1 else 0 end) as spring_sale from sales), b as ( select product_id, sum(spring_sale) as spring_sale, count(*) as total from a group by product_id having spring_sale != 0 and total = spring_sale) select b.product_id, product.product_name from b join product on b.product_id = product.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 141, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with all_products_q_2_3_4 as ( select s.product_id from sales s inner join product p on s.product_id = p.product_id where quarter(s.sale_date) != '1' ) select product_id, product_name from product where product_id not in (select * from all_products_q_2_3_4)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 142, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product_id from sales where sale_date between '2019-01-01' and '2019-03-31' and product_id not in (select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') ) select product_id, product_name from product where product_id in (select product_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 143, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product_id, sum(quantity) as total_sold, sum(case when sale_date between '2019-01-01' and '2019-03-31' then quantity else 0 end) as sold_spring from sales group by 1 ) select c.product_id, p.product_name from cte c join product p on c.product_id = p.product_id where total_sold = sold_spring"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 144, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with janmar as ( select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31' ), nonjanmar as ( select distinct product_id from sales where sale_date < '2019-01-01' or sale_date > '2019-03-31' ), idlist as ( select i.product_id from janmar i left outer join nonjanmar n on i.product_id = n.product_id where n.product_id is null ) select i.product_id, n.product_name from idlist i left outer join product n on i.product_id = n.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 145, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with main as ( select product_id, product_name, (case when sale_date between '2019-01-01' and '2019-03-31' then 1 else 0 end) as dates, (case when sale_date not between '2019-01-01' and '2019-03-31' then 1 else 0 end) as non_dates from sales inner join product using(product_id) ) select product_id, product_name from main group by product_id having sum(dates) > 0 and sum(non_dates) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 146, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with min_max as (select s.product_id, p.product_name, min(sale_date) as min_sale, max(sale_date) as max_sale from sales s inner join product p on p.product_id = s.product_id group by 1) select mm.product_id, mm.product_name from min_max mm where mm.min_sale between '2019-01-01' and '2019-03-31' and mm.max_sale between '2019-01-01' and '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 147, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with other_than_2019_spring as ( select distinct(product_id) from sales as s where sale_date < '2019-01-01' or sale_date > '2019-03-31' ) select distinct(s.product_id), p.product_name from sales as s join product as p on s.product_id = p.product_id where sale_date >= '2019-01-01' and sale_date < '2019-04-01' and s.product_id not in (select * from other_than_2019_spring)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 148, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sold_products as ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) select s.product_id, p.product_name from sold_products s inner join product p on s.product_id = p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 149, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sold_spring as (select s.product_id, p.product_name from sales s join product p on s.product_id = p.product_id where sale_date between '2019-01-01' and '2019-03-31'), sold_other as (select s.product_id, p.product_name from sales s join product p on s.product_id = p.product_id where sale_date not between '2019-01-01' and '2019-03-31') select distinct sp.product_id, sp.product_name from sold_spring sp where sp.product_id not in (select product_id from sold_other)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 150, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with spring as ( select p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date between '2019-01-01' and '2019-03-31' ), non_spring as ( select p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where (date(s.sale_date) < date('2019-01-01') or date(s.sale_date) > date('2019-03-31')) ) select distinct spring.product_id, spring.product_name from spring where spring.product_id not in (select non_spring.product_id from non_spring)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 151, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with spring as (select s.product_id, product_name from sales as s join product as p on s.product_id = p.product_id where sale_date between '2019-01-01' and '2019-03-31'), not_spring as ( select s.product_id, product_name from sales as s join product as p on s.product_id = p.product_id where sale_date not between '2019-01-01' and '2019-03-31') select distinct spring.product_id, spring.product_name from spring where spring.product_id not in (select product_id from not_spring)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 152, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as (select distinct(product_id) pid from sales where sale_date not between '2019-01-01' and '2019-03-31'), t2 as (select s.product_id, p.product_name, s.sale_date from sales s join product p on s.product_id = p.product_id) select distinct(product_id), product_name from t2 where sale_date between '2019-01-01' and '2019-03-31' and product_id not in (select pid from t1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 153, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as (select s.product_id, p.product_name, sum(case when s.sale_date between '2019-01-01' and '2019-03-31' then 1 else 0 end) as spring_sale, sum(case when s.sale_date < '2019-01-01' or s.sale_date > '2019-03-31' then 1 else 0 end) as outside_spring_sale from sales s join product p using(product_id) group by 1,2) select product_id, product_name from t1 where spring_sale > 0 and outside_spring_sale = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 154, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte1 as (select distinct product_id from product p join sales s using(product_id) where s.sale_date not between '2019-01-01' and '2019-03-31') select distinct product_id, product_name from product where product_id not in (select * from cte1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 155, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with tb as ( select s.*, p.product_name, p.unit_price from sales s left join product p on s.product_id = p.product_id) select distinct product_id, product_name from tb where sale_date between '2019-01-01' and '2019-03-31' and product_id not in ( select distinct product_id from tb where sale_date < '2019-01-01' or sale_date >'2019-03-31' )"]}
