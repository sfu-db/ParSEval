{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 215, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with tmp1 as (select *, case when duration < 300 then '[0-5>' when duration >= 300 and duration < 600 then '[5-10>' when duration >= 600 and duration < 900 then '[10-15>' else '15 or more' end bin from sessions), tmp2 as (select '[0-5>' as bin union all select '[5-10>' as bin union all select '[10-15>' as bin union all select '15 or more' as bin) select tmp2.bin, sum(if(session_id is null, 0, 1)) total from tmp2 left join tmp1 on tmp2.bin = tmp1.bin group by tmp2.bin"]}
