{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 592, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id, m.name, count(e.reports_to) as reports_count, round(avg(e.age)) as average_age from employees e left join employees m on e.reports_to = m.employee_id group by m.employee_id having count(e.reports_to) >= 1 order by m.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 593, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(*) as reports_count, round(avg(e2.age)) as average_age from employees e1 inner join employees e2 on e1.employee_id = e2.reports_to group by 1, 2 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 594, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with allmanagers as (select distinct reports_to as employee_id,count(employee_id) over(partition by reports_to) as reports_count,round(avg(age) over(partition by reports_to)) as average_age from employees where reports_to is not null) select a.employee_id,(select name from employees where employee_id = a.employee_id) as name,a.reports_count,a.average_age from allmanagers a order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 595, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id,b.name,count(distinct a.employee_id) as reports_count,round(avg(a.age),0) as average_age from employees a join employees b on a.reports_to=b.employee_id group by a.reports_to,b.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 596, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select mgr.employee_id, mgr.name, count(emp.employee_id) as reports_count, round(avg(emp.age)) as average_age from employees mgr join employees emp on mgr.employee_id = emp.reports_to and mgr.employee_id <> emp.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 597, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.employee_id) as reports_count, round(sum(e2.age)/count(e2.age)) as average_age from employees as e1 join employees as e2 on e1.employee_id = e2.reports_to group by e1.employee_id order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 598, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(*) as reports_count , round(avg(a.age)) as average_age from employees a join employees b on a.reports_to = b.employee_id group by employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 599, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a1.employee_id, a1.name, count(a2.reports_to) as reports_count , round(avg(a2.age),0) as average_age from employees as a1 join employees as a2 on a1.employee_id=a2.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 600, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select tbl1.employee_id, tbl1.name, count(tbl2.employee_id) as reports_count, round(sum(tbl2.age)/count(tbl2.employee_id)) as average_age from employees tbl1 join employees tbl2 on tbl1.employee_id = tbl2.reports_to group by tbl1.employee_id,tbl1.name having count(tbl2.employee_id)>0 order by tbl1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 601, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select emp.employee_id, emp.name, a.reports_count, a.average_age from ( select reports_to, count(employee_id) as reports_count, round(avg(age), 0) as average_age from employees group by reports_to having count(employee_id)>=1 )a join employees emp on emp.employee_id=a.reports_to order by emp.employee_id"]}
