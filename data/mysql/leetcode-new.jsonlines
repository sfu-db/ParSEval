{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 376, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as (select account, sum(amount) as balance from transactions group by account) select name, balance from users join cte on users.account=cte.account where balance > 10000"]}
