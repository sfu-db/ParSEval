{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 473, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with numfo as ( select followee, count(*) num from follow group by followee ) select tmp.followee follower, num from (select distinct followee from follow where followee in (select follower from follow) ) tmp join numfo on tmp.followee = numfo.followee order by tmp.followee"]}
