{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 240, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with cte as (select *, min(event_date) over (partition by player_id) as min_date from activity) select player_id, device_id from cte where event_date = min_date"]}
