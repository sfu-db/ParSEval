{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 268, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) as apple_count, sum(orange_count) as orange_count from (select a.box_id,a.chest_id, a.apple_count + ifnull(b.apple_count,0) as apple_count, a.orange_count + ifnull(b.orange_count,0) as orange_count from boxes a left join chests b on a.chest_id = b.chest_id)t"]}
