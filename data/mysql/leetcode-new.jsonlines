{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 437, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(*) as reports_count, round(avg(e1.age),0) as average_age from employees e1 left join employees e2 on e1.reports_to = e2.employee_id where e1.reports_to is not null group by 1,2 order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 438, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with tmp as( select t2.employee_id, t2.name, t1.employee_id as emp_id, t1.age from employees t1 inner join employees t2 on t1.reports_to = t2.employee_id ) select employee_id, name, count(*) as reports_count, round(avg(age),0) as average_age from tmp group by employee_id order by employee_id"]}
