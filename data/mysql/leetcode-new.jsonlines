{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 323, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, (case when e.operator = '<' then if(v1.value < v2.value, 'true', 'false') when e.operator = '>' then if(v1.value > v2.value, 'true', 'false') when e.operator = '=' then if(v1.value = v2.value, 'true', 'false') end) as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 324, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = relationship then true else false end as value from(select left_operand, operator, right_operand, case when v1.value > v2.value then '>' when v1.value = v2.value then '=' else '<' end as relationship from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name) temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 325, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '>' then (case when l.value > r.value then true else false end) when e.operator = '<' then (case when l.value < r.value then true else false end) when e.operator = '=' then (case when l.value = r.value then true else false end) else null end as value from expressions e join variables l on e.left_operand = l.name join variables r on e.right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 326, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case a.operator when '>' then case when b.value > c.value then true else false end when '=' then case when b.value = c.value then true else false end when '<' then case when b.value < c.value then true else false end end as value from expressions a inner join variables b on b.name = a.left_operand inner join variables c on c.name = a.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 327, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, if(e.operator = '>' and vl.value > vr.value, 'true', if(e.operator = '=' and vl.value = vr.value, 'true', if(e.operator = '<' and vl.value < vr.value, 'true', 'false'))) as value from expressions as e left join variables as vl on e.left_operand = vl.name left join variables as vr on e.right_operand = vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 328, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' then (case when v1.value > v2.value then true else false end) when operator = '=' then (case when v1.value = v2.value then true else false end) else (case when v1.value < v2.value then true else false end) end as value from expressions join variables v1 on left_operand = v1.name join variables v2 on right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 329, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand ,operator ,right_operand , case when (operator = '>' and l.value > r.value) or (operator = '<' and l.value < r.value) or (operator = '=' and l.value = r.value) then true else false end as value from expressions e left join variables l on l.name = e.left_operand left join variables r on r.name = e.right_operand"]}
