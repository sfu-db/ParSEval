{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 247, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(ifnull(sum(price*units)/sum(units),0),2) as average_price from (select * from (select a.product_id, a.start_date,a.end_date,a.price,b.purchase_date,b.units from prices a left join unitssold b on a.product_id = b.product_id ) c where purchase_date>=start_date and purchase_date<=end_date) d group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 248, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(price)/ sum(units),2) as average_price from(select x.product_id, x.purchase_date, x.units, x.units * y.price as price from unitssold x join prices y on x.product_id = y.product_id and x.purchase_date between y.start_date and y.end_date) a group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 249, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(price*units)/sum(units),2) as average_price from (select p.product_id, price, units from prices p left join unitssold u on p.product_id = u.product_id and u.purchase_date between p.start_date and p.end_date ) a group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 250, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(price*units)/sum(units),2) as average_price from (select product_id, purchase_date, (select price from prices p where purchase_date between start_date and end_date and p.product_id=u.product_id) as price, units from unitssold u)t group by product_id"]}
