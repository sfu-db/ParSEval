{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 535, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when left_value > right_value and operator = '>' then true when left_value < right_value and operator = '<' then true when left_value = right_value and operator = '=' then true else false end as value from ( select a.value as left_value, b.value as right_value, left_operand, operator, right_operand from variables as a join expressions on a.name = expressions.left_operand join variables as b on b.name = expressions.right_operand ) as sub"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 536, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select vl.name left_operand, e.operator operator, vr.name right_operand, case when operator = '<' then case when vl.value < vr.value then true else false end when operator = '>' then case when vl.value > vr.value then true else false end when operator = '=' then case when vl.value = vr.value then true else false end else null end value from expressions e join variables vr on e.right_operand = vr.name join variables vl on e.left_operand = vl.name"]}
