{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 280, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with bin_cnt as ( select *, duration/60, case when (duration < 300) then '[0-5>' when (300 <= duration) and (duration < 600) then '[5-10>' when (600 <= duration) and (duration < 900) then '[10-15>' else '15 or more' end as bin from sessions), bin_table as ( select '[0-5>' as bin from dual union select '[5-10>' from dual union select '[10-15>' from dual union select '15 or more' from dual ) select t.bin, count(c.session_id) as total from bin_table t left join bin_cnt c on t.bin = c.bin group by t.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 281, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "select t1.bin,ifnull(t2.total,0) as total from (select '[0-5>' as bin union select '[5-10>' as bin union select '[10-15>' as bin union select '15 or more' as bin) t1 left join (select case when duration<300 then '[0-5>' when duration<600 then '[5-10>' when duration<900 then '[10-15>' else '15 or more' end as bin ,count(*) as total from sessions group by 1) as t2 on t1.bin=t2.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 282, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with cte as ( select session_id, duration, case when duration/60 < 5 then '[0-5>' when duration/60 < 10 then '[5-10>' when duration/60 < 15 then '[10-15>' else '15 or more' end as bin from sessions) select sub.bin, count(session_id) total from cte right join (select '[0-5>' bin union all select '[5-10>' bin union all select '[10-15>' bin union all select '15 or more' bin) sub on sub.bin = cte.bin group by sub.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 283, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "select s.bin, ifnull(t.total, 0) as total from ( select (case when duration/60 < 5 then '[0-5>' when duration/60 < 10 and duration/60 >= 5 then '[5-10>' when duration/60 < 15 and duration/60 >= 10 then '[10-15>' else '15 or more' end) as bin, count(*) as total from sessions group by bin) t right join (select '[0-5>' as bin union all select '[5-10>' as bin union all select '[10-15>' as bin union all select '15 or more' as bin) s on t.bin = s.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 284, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with session_time as ( select session_id, case when duration / 60.0 < 5 then '[0-5>' when duration / 60.0 >= 5 and duration / 60.0 < 10 then '[5-10>' when duration / 60.0 >= 10 and duration / 60.0 < 15 then '[10-15>' else '15 or more' end as bin from sessions ), bins as ( select '[0-5>' as bin union select '[5-10>' as bin union select '[10-15>' as bin union select '15 or more as bin' ) select b.bin, count(s.session_id) as total from bins b left join session_time s on b.bin = s.bin group by b.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 285, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with cte as (select * from (select '[0-5>' as bin union all select '[5-10>' as bin union all select '[10-15>' as bin union all select '15 or more' as bin) a) select cte.bin, ifnull(b.total,0) as total from cte left join (select case when duration between 0 and 4.999999 then '[0-5>' when duration between 5 and 9.99999 then '[5-10>' when duration between 10 and 14.99999 then '[10-15>' else '15 or more' end as bin , ifnull(count(duration),0) as total from (select session_id, duration/60 as duration from sessions) a group by bin) b on cte.bin = b.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 286, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with tmp as ( select '[0-5>' as bin union select '[5-10>' as bin union select '[10-15>' as bin union select '15 or more as bin' ), grouped as ( select case when duration / 60.0 < 5 then '[0-5>' when duration / 60.0 < 10 then '[5-10>' when duration / 60.0 < 15 then '[10-15>' else '15 or more' end as bin, count(*) as total from sessions group by bin ) select t.bin, ifnull(g.total, 0) as total from tmp t left join grouped g on t.bin = g.bin"]}
