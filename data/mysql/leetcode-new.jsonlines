{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 732, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with t as (select s.buyer_id, p.product_name from sales s inner join product p on s.product_id = p.product_id) select distinct buyer_id from t where product_name = 's8' and buyer_id not in (select buyer_id from t where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 733, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from product p inner join sales s on s.product_id = p.product_id where p.product_name = 's8' and buyer_id not in (select buyer_id from product p inner join sales s on s.product_id = p.product_id where p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 734, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s1.buyer_id from sales s1 join product p1 on s1.product_id = p1.product_id where p1.product_name = 's8' and s1.buyer_id not in ( select s.buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 'iphone' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 735, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales s join product p on s.product_id = p.product_id group by buyer_id having sum(case when product_name = 's8' then 1 else 0 end) >= 1 and sum(case when product_name = 'iphone' then 1 else 0 end) < 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 736, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte1 as( select s.buyer_id, sum(case when p.product_name='s8' then 1 else 0 end) as s8_flg, sum(case when p.product_name='iphone' then 1 else 0 end) as iphn_flg from sales as s join product p on s.product_id=p.product_id group by 1 ) select buyer_id from cte1 where s8_flg >= '1' and iphn_flg='0'"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 737, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from sales as s join product as p on s.product_id = p.product_id where p.product_name = 's8' and s.buyer_id not in (select buyer_id from sales join product on sales.product_id = product.product_id where product.product_name = 'iphone') group by s.buyer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 738, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales ss join product p on ss.product_id = p.product_id where p.product_name = 's8' and buyer_id not in (select buyer_id from sales s where s.product_id in (select product_id from product where product_name = 'iphone'))"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 739, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with temp as ( select a.*, b.product_name from sales a left join product b on a.product_id = b.product_id ) select distinct buyer_id from temp where product_name = 's8' and buyer_id not in ( select buyer_id from temp where product_name = 'iphone' ) order by buyer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 740, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct sales.buyer_id from sales inner join product on sales.product_id=product.product_id where sales.buyer_id not in (select sales.buyer_id from sales inner join product on sales.product_id=product.product_id where product.product_name ='iphone') and product.product_name ='s8'"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 741, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as( select s.buyer_id,p.product_id from sales s, product p where p.product_id=s.product_id and product_name='iphone' ) select distinct buyer_id from sales where buyer_id not in (select buyer_id from cte) and product_id = (select product_id from product where product_name='s8')"]}
