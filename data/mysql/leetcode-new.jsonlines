{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 616, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id,round(sum(price*units)/sum(units),2) as average_price from (select u.*,p.price from unitssold as u left join prices as p on p.product_id=u.product_id where u.purchase_date between p.start_date and p.end_date) as t1 group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 617, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select product_id, round(sum(price*units)/sum(units),2) as average_price from( select prices.product_id, purchase_date, price, units from prices, unitssold where purchase_date >= start_date and purchase_date <= end_date and prices.product_id = unitssold.product_id) as price_info group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 618, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id , round(sum(u.units *p.price )/sum(u.units) ,2) as average_price from prices p join unitssold u on (p.product_id =u.product_id ) where purchase_date between start_date and end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 619, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id product_id, round(sum(units*price)/sum(units) ,2) as average_price from prices a inner join unitssold b on a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 620, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with tbl as ( select product_id,sum(price*units) as cost, sum(units) as units from prices inner join unitssold using (product_id) where purchase_date between start_date and end_date and date(purchase_date)<=date(end_date) group by product_id ) select product_id, round((cost/units),2) as average_price from tbl"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 621, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select prices.product_id, round(sum(price*units)/sum(units), 2) as average_price from prices inner join unitssold on prices.product_id = unitssold.product_id and purchase_date between start_date and end_date group by prices.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 622, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select unitssold.product_id, round(sum(units*price)/sum(units), 2) as average_price from unitssold left join prices on prices.product_id = unitssold.product_id and purchase_date >= start_date and purchase_date <= end_date group by unitssold.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 623, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with temp as ( select a.product_id, a.price, b.units from prices a left outer join unitssold b on (a.product_id = b.product_id and a.start_date <= b.purchase_date and a.end_date >= b.purchase_date)) select product_id, round(sum(price * units)/sum(units), 2) as average_price from temp group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 624, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select p.product_id, round(sum(p.price * u.units) / sum(u.units), 2) as average_price from prices p join unitssold u on p.product_id = u.product_id where purchase_date between start_date and end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 625, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "with cte as( select u.product_id, u.units, case when u.purchase_date >= p.start_date and u.purchase_date <= p.end_date then p.price end as price_day from prices as p left join unitssold as u on p.product_id = u.product_id ) select product_id, round(sum(units * price_day) / sum(units),2) as average_price from cte where price_day is not null group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 626, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select unitssold.product_id, round(sum(price*units)/sum(units),2) as average_price from unitssold left join prices on prices.product_id = unitssold.product_id and prices.start_date <= unitssold.purchase_date and unitssold.purchase_date <= prices.end_date group by unitssold.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 627, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select u.product_id ,round(sum(u.units*p.price)/sum(units),2) as average_price from unitssold u, prices p where u.purchase_date between p.start_date and p.end_date and p.product_id =u.product_id group by u.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 628, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select t1.product_id, round(sum(t2.price * t1.units) / sum(t1.units), 2) as average_price from unitssold t1 join prices t2 on t1.product_id = t2.product_id and t1.purchase_date between t2.start_date and t2.end_date group by 1 order by 1"]}
