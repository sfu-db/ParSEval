{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 97, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t.player_id, t.player_name, sum(grand_slams_count) as grand_slams_count from (select p.player_id, p.player_name, count(c.year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.wimbledon group by p.player_id, p.player_name union all select p.player_id, p.player_name, count(c.year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.fr_open group by p.player_id, p.player_name union all select p.player_id, p.player_name, count(c.year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.us_open group by p.player_id, p.player_name union all select p.player_id, p.player_name, count(c.year) as grand_slams_count from players as p inner join championships as c on p.player_id = c.au_open group by p.player_id, p.player_name) as t group by t.player_id, t.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 98, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t2.player_id as player_id, t3.player_name as player_name ,t2.grand_slams_count as grand_slams_count from (select t1.player_id as player_id,count(player_id) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships )t1 group by t1.player_id) t2 left join players t3 on t2.player_id=t3.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 99, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select tmp.player_id, player_name, sum(num) as grand_slams_count from( select wimbledon as player_id, count(*) as num from championships group by wimbledon union all select fr_open as player_id, count(*) as num from championships group by fr_open union all select us_open as player_id, count(*) as num from championships group by us_open union all select au_open as player_id, count(*) as num from championships group by au_open ) tmp left join players p on tmp.player_id = p.player_id group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 100, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select tmp.player_id, tmp.player_name, (wsum + fsum + usum + asum) as grand_slams_count from (select p.player_id, p.player_name, sum( case when c.wimbledon = p.player_id then 1 else 0 end ) as wsum, sum( case when c.fr_open = p.player_id then 1 else 0 end ) as fsum, sum( case when c.us_open = p.player_id then 1 else 0 end ) as usum, sum( case when c.au_open = p.player_id then 1 else 0 end ) as asum from players p inner join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id order by p.player_id) as tmp"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 101, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select u.player_id, p.player_name, count(*) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) u join players p on u.player_id = p.player_id group by u.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 102, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p1.player_id, p1.player_name, coalesce(w1.w, 0) + coalesce(f1.f, 0) + coalesce(u1.u, 0) + coalesce(a1.a, 0) as grand_slams_count from players as p1 left join (select wimbledon as p1, count(*) as w from championships group by wimbledon) as w1 on p1.player_id =w1.p1 left join (select fr_open as f1, count(*) as f from championships group by fr_open) as f1 on p1.player_id =f1.f1 left join (select us_open as u1, count(*) as u from championships group by us_open) as u1 on p1.player_id =u1.u1 left join (select au_open as a1, count(*) as a from championships group by au_open) as a1 on p1.player_id =a1.a1 having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 103, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, a.player_name, (sum(case when a.player_id = b.wimbledon then 1 else 0 end) + sum(case when a.player_id = b.fr_open then 1 else 0 end) + sum(case when a.player_id = b.us_open then 1 else 0 end) + sum(case when a.player_id = b.au_open then 1 else 0 end) ) as grand_slams_count from players a join championships b on a.player_id = b.au_open or a.player_id = b.wimbledon or a.player_id = b.fr_open or a.player_id = b.us_open group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 104, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select championship as player_id, p.player_name, grand_slams_count from ( select championship, count(*) as grand_slams_count from ( select year , wimbledon as championship from championships union all select year , fr_open as championship from championships union all select year , us_open as championship from championships union all select year , au_open as championship from championships )a group by 1 )b join players p on player_id = championship"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 105, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum( if(c.wimbledon = p.player_id, 1, 0) + if(c.fr_open = p.player_id, 1, 0) + if(c.us_open = p.player_id, 1, 0) + if(c.au_open = p.player_id, 1, 0) ) as grand_slams_count from players p inner join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 106, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum( if(c.wimbledon = p.player_id, 1, 0) + if(c.fr_open = p.player_id, 1, 0) + if(c.us_open = p.player_id, 1, 0) + if(c.au_open = p.player_id, 1, 0) ) as grand_slams_count from players p inner join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id order by grand_slams_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 107, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(total_wins) as grand_slams_count from ( select wimbledon as player , count(wimbledon) as total_wins from championships group by player union all select fr_open as player , count(fr_open) as total_wins from championships group by player union all select us_open as player , count(us_open) as total_wins from championships group by player union all select au_open as player , count(au_open) as total_wins from championships group by player ) t1 join players p on p.player_id = t1.player group by t1.player"]}
