{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 580, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(w) as grand_slams_count from ( select player_id, player_name, count(wimbledon) as w from players p join championships c on p.player_id = c.wimbledon group by player_id union all select player_id, player_name, count(fr_open) as w from players p join championships c on p.player_id = c.fr_open group by player_id union all select player_id, player_name, count(us_open) as w from players p join championships c on p.player_id = c.us_open group by player_id union all select player_id, player_name, count(au_open) as w from players p join championships c on p.player_id = c.au_open group by player_id )a group by player_id"]}
