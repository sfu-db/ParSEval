{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 150, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id,nullif(sum(case when store='store1' then price else 0 end),0) as store1, nullif(sum(case when store='store2' then price else 0 end),0) as store2, nullif(sum(case when store='store3' then price else 0 end),0) as store3 from products group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 151, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, max(case when store = 'store1' then price end) as store1, max(case when store = 'store2' then price end) as store2, max(case when store = 'store3' then price end) as store3 from products group by 1 order by null"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 152, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, (select p.price from products p where p.product_id = p2.product_id and p.store='store1' limit 1) as store1,(select p.price from products p where p.product_id = p2.product_id and p.store='store2' limit 1) as store2, (select p.price from products p where p.product_id = p2.product_id and p.store='store3' limit 1) as store3 from products p2 group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 153, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with t as (select product_id, case when store = 'store1' then price end as store1, case when store = 'store2' then price end as store2, case when store = 'store3' then price end as store3 from products) select product_id, sum(store1) as store1, sum(store2) as store2, sum(store3) as store3 from t group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 154, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select products.product_id, max(case when products.store = 'store1' then products.price end) store1, max(case when products.store = 'store2' then products.price end) store2, max(case when products.store = 'store3' then products.price end) store3 from products group by products.product_id"]}
