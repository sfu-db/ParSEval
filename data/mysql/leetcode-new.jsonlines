{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 61, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(boxes.apple_count) + sum(coalesce(chests.apple_count, 0)) as apple_count, sum(boxes.orange_count) + sum(coalesce(chests.orange_count, 0)) as orange_count from boxes left join chests on boxes.chest_id = chests.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 62, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select ifnull(sum(b.apple_count),0) + ifnull(sum(c.apple_count),0) as apple_count, ifnull(sum(b.orange_count),0) + ifnull(sum(c.orange_count),0) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 63, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(a.apple_count+ifnull(b.apple_count,0)) as apple_count, sum(a.orange_count+ifnull(b.orange_count,0)) as orange_count from boxes as a left join chests as b on a.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 64, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(apple_count) as apple_count, sum(orange_count) as orange_count from (select case when b.chest_id is not null then sum(b.apple_count+ c.apple_count) over (partition by box_id) else b.apple_count end as apple_count, case when b.chest_id is not null then sum(b.orange_count+ c.orange_count) over (partition by box_id) else b.orange_count end as orange_count from boxes b left join chests c on b.chest_id = c.chest_id) d"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 65, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(b.apple_count + coalesce(c.apple_count,0)) as apple_count, sum(b.orange_count + coalesce(c.orange_count,0))as orange_count from boxes b left join chests c on c.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 66, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(s.a_count) as apple_count ,sum(s.o_count) as orange_count from( select b.box_id, b.chest_id, b.apple_count+ifnull(c.apple_count,0) as a_count , b.orange_count +ifnull(c.orange_count ,0) as o_count from boxes b left join chests c on b.chest_id=c.chest_id ) s"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 67, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with allfruits as (select b.box_id ,ifnull(c.apple_count,0)+b.apple_count as apple_count ,ifnull(c.orange_count,0)+b.orange_count as orange_count from boxes b left join chests c on c.chest_id = b.chest_id) select sum(apple_count) as apple_count ,sum(orange_count) as orange_count from allfruits"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 68, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with boxtotal as (select b.box_id ,ifnull(c.apple_count,0)+b.apple_count as apple_count ,ifnull(c.orange_count,0)+b.orange_count as orange_count from boxes b left join chests c on c.chest_id = b.chest_id) select sum(apple_count) as apple_count ,sum(orange_count) as orange_count from boxtotal"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 69, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with boxedfruits as (select b.box_id ,ifnull(c.apple_count,0)+b.apple_count as apple_count ,ifnull(c.orange_count,0)+b.orange_count as orange_count from boxes b left join chests c on c.chest_id = b.chest_id) select sum(apple_count) as apple_count ,sum(orange_count) as orange_count from boxedfruits"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 70, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with boxesandchests as ( select box_id, b.apple_count + ifnull(sum(c.apple_count),0) as apple_count, b.orange_count + ifnull(sum(c.orange_count),0) as orange_count from boxes b left outer join chests c on b.chest_id = c.chest_id group by box_id ) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from boxesandchests"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 71, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as ( select a.box_id, b.chest_id, (a.apple_count+ifnull(b.apple_count,0)) apple_count, (a.orange_count+ifnull(b.orange_count,0)) orange_count from boxes a left join chests b on a.chest_id=b.chest_id ) select sum(apple_count) apple_count,sum(orange_count) orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 72, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as ( select box_id, a.chest_id, a.apple_count, a.orange_count, coalesce(b.apple_count,0) as chest_apple, coalesce(b.orange_count,0) as chest_orange from boxes a left join chests b on a.chest_id = b.chest_id ) select sum(apple_count+chest_apple) as apple_count, sum(orange_count+chest_orange) as orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 73, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as ( select b.box_id, b.chest_id, b.apple_count + ifnull(c.apple_count,0) as apple_count , b.orange_count + ifnull(c.orange_count,0) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id group by b.box_id, b.chest_id ) select sum(cte.apple_count) as apple_count , sum(cte.orange_count) as orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 74, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as (select box_id, ifnull(b.apple_count, 0) as b_apple, ifnull(b.orange_count, 0) as b_orange, ifnull(c.apple_count, 0) as c_apple, ifnull(c.orange_count, 0) as c_orange from boxes b left join chests c on b.chest_id = c.chest_id) select sum(b_apple) + sum(c_apple) as apple_count, sum(b_orange) + sum(c_orange) as orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 75, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte1 as ( select b.box_id, b.apple_count+ifnull(c.apple_count, 0) as apple_count, b.orange_count+ifnull(c.orange_count, 0) as orange_count from boxes as b left join chests as c on b.chest_id = c.chest_id) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from cte1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 76, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with d as( select b.apple_count, b.orange_count, c.apple_count as a, c.orange_count as o from boxes b left join chests c on b.chest_id = c.chest_id ) select ifnull(sum(apple_count),0)+ifnull(sum(a),0) as apple_count, ifnull(sum(orange_count),0)+ifnull(sum(o),0) as orange_count from d"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 77, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with d as( select ifnull(b.apple_count,0) as apple_count, ifnull(b.orange_count,0) as orange_count, ifnull(c.apple_count,0) as a, ifnull(c.orange_count,0) as o from boxes b left join chests c on b.chest_id = c.chest_id ) select sum(apple_count)+sum(a) as apple_count, sum(orange_count)+sum(o) as orange_count from d"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 78, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with s0 as (select box_id, boxes.chest_id, ifnull(boxes.apple_count,0) + ifnull(chests.apple_count,0) as apples, ifnull(boxes.orange_count,0) + ifnull(chests.orange_count,0) as oranges from boxes left join chests on boxes.chest_id = chests.chest_id) select sum(apples) as apple_count, sum(oranges) as orange_count from s0"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 79, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with t1 as (select a.*, b.apple_count as apple2, b.orange_count as orange2 from boxes a left join chests b on a.chest_id = b.chest_id), t2 as (select box_id, chest_id, coalesce(apple_count, 0) + coalesce(apple2, 0) as apple, coalesce(orange_count, 0) + coalesce(orange2, 0) as orange from t1) select sum(apple) as apple_count, sum(orange) as orange_count from t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 80, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with temp as (select b.box_id as box_id, b.apple_count as box_apple_count, b.orange_count as box_orange_count, c.apple_count as chest_apple_count, c.orange_count as chest_orange_count from boxes b left join chests c on b.chest_id=c.chest_id) select sum(coalesce(box_orange_count, 0) + coalesce(chest_orange_count, 0)) as orange_count, sum(coalesce(box_apple_count,0) + coalesce(chest_apple_count,0)) as apple_count from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 81, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with box_contain as ( select b.box_id, b.chest_id, (b.apple_count + ifnull(c.apple_count,0)) as apple_count, (b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes as b left join chests as c on b.chest_id = c.chest_id ) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from box_contain"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 82, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with c1 as (select b.apple_count as apple_count_b, b.orange_count as orange_count_b , c.apple_count as apple_count_c, c.orange_count as orange_count_c from boxes b left join chests c on b.chest_id = c.chest_id) select sum(apple_count_b + coalesce(apple_count_c, 0) ) as apple_count , sum(orange_count_b + coalesce(orange_count_c, 0) ) as orange_count from c1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 83, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with chest_cte as ( select b.box_id, c.chest_id, coalesce(c.apple_count, 0) as chest_apple_count, coalesce(c.orange_count, 0) as chest_orange_count from boxes b left join chests c on b.chest_id = c.chest_id ) select sum(sub.apple_count) + sum(sub.chest_apple_count) as apple_count, sum(sub.orange_count) + sum(sub.chest_orange_count) as orange_count from ( select b.apple_count, b.orange_count, cc.chest_apple_count, cc.chest_orange_count from boxes b left join chest_cte cc on b.box_id = cc.box_id ) sub"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 84, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with count_in_boxes as ( select box_id, chest_id, sum(apple_count) as apples, sum(orange_count) as oranges from boxes group by box_id, chest_id), count_in_chests as ( select chest_id, sum(apple_count) as apples, sum(orange_count) as oranges from chests group by chest_id ) select sum(ifnull(b.apples,0)) + sum(ifnull(c.apples,0)) as apple_count, sum(ifnull(b.oranges,0)) + sum(ifnull(c.oranges,0)) as orange_count from count_in_boxes b left join count_in_chests c on b.chest_id = c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 85, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as ( select b.box_id, c.chest_id, c.apple_count, c.orange_count from chests c inner join boxes b using (chest_id) ), cte1 as( select * from cte union all select * from boxes b ) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from cte1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 86, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as ( select box_id, sum(boxes.apple_count)+sum(ifnull(chests.apple_count,0)) as apples, sum(boxes.orange_count)+sum(ifnull(chests.orange_count,0)) as oranges from boxes left join chests on boxes.chest_id = chests.chest_id group by box_id ) select sum(apples) as apple_count, sum(oranges) as orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 87, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte as (select box_id, case when b.chest_id = c.chest_id then b.apple_count+c.apple_count else b.apple_count end as apple, case when b.chest_id = c.chest_id then b.orange_count + c.orange_count else b.orange_count end as orange from boxes b left join chests c using (chest_id)) select sum(apple) as apple_count, sum(orange) as orange_count from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 88, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with cte1 as( select box_id, b.chest_id, b.apple_count as app1, b.orange_count as ora1, coalesce(c.apple_count,0) as app2, coalesce(c.orange_count,0) as ora2 from boxes b left join chests c on b.chest_id=c.chest_id ), cte2 as ( select app1+app2 as total_app, ora1+ora2 as total_ora from cte1 ) select sum(total_app) as apple_count, sum(total_ora) as orange_count from cte2"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 89, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with main (apple_count, orange_count) as ( select sum(apple_count), sum(orange_count) from boxes union all select sum(c.apple_count), sum(c.orange_count) from boxes b inner join chests c using(chest_id) ) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from main"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 90, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with t as( select boxes.apple_count,boxes.orange_count, chests.apple_count chest_a, chests.orange_count chest_o from boxes left join chests on boxes.chest_id = chests.chest_id ) select sum(apple_count)+ ifnull(sum(chest_a),0) apple_count, sum(orange_count)+ ifnull(sum(chest_o),0) orange_count from t"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 91, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with t_box as (select box_id, chest_id, apple_count as apples_box, orange_count as orange_box from boxes), t_chests as (select chest_id, apple_count as apples_ch, orange_count as orange_ch from chests), t_all as (select apples_box, orange_box, apples_ch, orange_ch from t_box t1 left join t_chests t2 on t1.chest_id = t2.chest_id) select sum(apples_box) + coalesce(sum(apples_ch),0) as apple_count, sum(orange_box) + coalesce(sum(orange_ch), 0) as orange_count from t_all"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 92, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with table1 as (select sum(apple_count) as apple_count, sum(orange_count) as orange_count from boxes), table2 as (select sum(ifnull(c.apple_count,0)) as apple_count, sum(ifnull(c.orange_count,0)) as orange_count from boxes as b left join chests as c on b.chest_id = c.chest_id) select sum(a.apple_count) as apple_count, sum(a.orange_count) as orange_count from (select * from table1 union all select * from table2) as a"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 93, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with table1 as( select apple_count, orange_count from boxes union all select c.apple_count, c.orange_count from chests c inner join boxes b using(chest_id) ) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from table1"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 94, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with tmp as (select coalesce(apple_count, 0) as apple_count, coalesce(orange_count, 0) as orange_count from boxes union all select coalesce(c.apple_count, 0) as apple_count, coalesce(c.orange_count, 0) as orange_count from chests as c join boxes using(chest_id)) select sum(apple_count) as apple_count, sum(orange_count) as orange_count from tmp"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 95, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select (coalesce(bsum.apple_count,0) + coalesce(csum.apple_count,0)) as apple_count, (coalesce(bsum.orange_count,0) + coalesce(csum.orange_count,0)) as orange_count from (select sum(chests.apple_count) as apple_count, sum(chests.orange_count) as orange_count from boxes left join chests on boxes.chest_id = chests.chest_id) as csum, (select sum(apple_count) as apple_count , sum(orange_count) as orange_count from boxes) as bsum"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 96, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select (sum(a.apple_count) + ifnull(sum(b.apple_count),0)) as apple_count, (sum(a.orange_count) + ifnull(sum(b.orange_count),0)) as orange_count from boxes a left join chests b on a.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 97, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select (sum(b.apple_count) + sum(case when c.apple_count is null then 0 else c.apple_count end)) as apple_count, (sum(b.orange_count) + sum(case when c.orange_count is null then 0 else c.orange_count end)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id"]}
