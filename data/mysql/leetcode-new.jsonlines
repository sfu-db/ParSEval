{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 289, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct c.buyer_id from sales c left join product g on c.product_id = g.product_id left join (select buyer_id from sales a left join product b on a.product_id = b.product_id where product_name = 'iphone')d on c.buyer_id = d.buyer_id where d.buyer_id is null and g.product_name = 's8'"]}
