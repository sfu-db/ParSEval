{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 633, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, b.player_name, count(player_id) grand_slams_count from (select year, wimbledon as tournament from championships union all select year, fr_open as tournament from championships union all select year, us_open as tournament from championships union all select year, au_open as tournament from championships ) a join players b on b.player_id = a.tournament group by b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 634, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with a as ( select p.player_id , p.player_name , count(c.wimbledon) as x1 from players p join championships c on p.player_id = c.wimbledon group by p.player_id,c.year union all select p.player_id , p.player_name , count(c.fr_open) as x1 from players p join championships c on p.player_id = c.fr_open group by p.player_id ,c.year union all select p.player_id , p.player_name , count(c.us_open) as x1 from players p join championships c on p.player_id = c.us_open group by p.player_id ,c.year union all select p.player_id , p.player_name , count(c.au_open) as x1 from players p join championships c on p.player_id = c.au_open group by p.player_id ,c.year ) select player_id , player_name , sum(x1) as grand_slams_count from a where case when x1 =0 then 0 else 1 end group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 635, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(player_id = wimbledon) + sum(player_id = fr_open) + sum(player_id = us_open) + sum(player_id = au_open) as grand_slams_count from players join championships on wimbledon = player_id or fr_open = player_id or us_open = player_id or au_open = player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 636, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as player from championships union all select fr_open as player from championships union all select us_open as player from championships union all select au_open as player from championships) select player as player_id, player_name, count(*) as grand_slams_count from cte left join players p on p.player_id = player group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 637, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year, 'wimbledon' as gs, wimbledon as id from championships union select year, 'fr_open' as gs, fr_open as id from championships union select year, 'us_open' as gs, us_open as id from championships union select year, 'au_open' as gs, au_open as id from championships) select b.player_id, b.player_name, count(*) grand_slams_count from cte a inner join players b on b.player_id = a.id group by a.id, b.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 638, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winning_ids as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select t1.player_id, t2.player_name, t1.grand_slams_count from ( select player_id, count(*) as grand_slams_count from winning_ids group by player_id ) t1 inner join players t2 on t1.player_id = t2.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 639, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select player_id, sum(grand_slams_count) as grand_slams_count from (select wimbledon player_id,count(*) grand_slams_count from championships group by 1 union all select fr_open player_id,count(*) grand_slams_count from championships group by 1 union all select us_open player_id,count(*) grand_slams_count from championships group by 1 union all select au_open player_id,count(*) grand_slams_count from championships group by 1) tmp group by 1) select cte.player_id,player_name,grand_slams_count from cte join players p on cte.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 640, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select r.player_id,r.player_name,count(*) as grand_slams_count from (select p.player_id,p.player_name from players p join championships c on (p.player_id=c.wimbledon) union all select p.player_id,p.player_name from players p join championships c on (p.player_id=c.fr_open) union all select p.player_id,p.player_name from players p join championships c on (p.player_id=c.us_open) union all select p.player_id,p.player_name from players p join championships c on (p.player_id=c.au_open))r group by r.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 641, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select wimbledon as player_id, player_name, count(wimbledon) as grand_slams_count from ( select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) t join players on t.wimbledon = players.player_id group by wimbledon"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 642, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with b as ((select year, wimbledon as win from championships) union all (select year, fr_open as win from championships) union all (select year, us_open as win from championships) union all (select year, au_open as win from championships)) select a.player_id, a.player_name, count(b.win) as grand_slams_count from players a join b on a.player_id=b.win group by a.player_id, a.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 643, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with a as (select * from players, championships order by player_id, player_name, year), b as (select a.player_id, a.player_name, a.year, if(player_id=wimbledon,1,0)+if(player_id=fr_open,1,0)+if(player_id=us_open,1,0)+if(player_id=au_open,1,0) grand_slams_count from a) select player_id, player_name, sum(grand_slams_count) grand_slams_count from b group by 1,2 having sum(grand_slams_count)>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 644, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(case when p.player_id = c.wimbledon then 1 else 0 end) + sum(case when p.player_id = c.fr_open then 1 else 0 end) + sum(case when p.player_id = c.us_open then 1 else 0 end) + sum(case when p.player_id = c.au_open then 1 else 0 end) as grand_slams_count from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by 1"]}
