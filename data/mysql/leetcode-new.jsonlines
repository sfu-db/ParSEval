{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 377, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s.product_id,p.product_name from sales s join product p on s.product_id = p.product_id where s.sale_date between '2019-01-01' and '2019-03-31' and s.product_id not in (select s.product_id from sales s join product p on s.product_id = p.product_id where s.sale_date not between '2019-01-01' and '2019-03-31') group by 1,2 order by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 378, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s1.product_id, p.product_name from (select distinct product_id from sales where product_id not in (select product_id from sales where sale_date < '2019-01-01' or sale_date >'2019-03-31') ) s1 left join product p on s1.product_id = p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 379, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select sales.product_id, product_name from sales join product on sales.product_id = product.product_id group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 380, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select t1.product_id, product_name from (select product_id from sales group by product_id having min(sale_date) between '2019-01-01' and '2019-03-31' and max(sale_date) between '2019-01-01' and '2019-03-31') t1 join product t2 on t1.product_id = t2.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 381, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as(select a.product_id, a.product_name, b.sale_date,b.quantity from product a left join sales b on a.product_id = b.product_id ) select product_id, product_name from (select product_id, product_name, sum(case when sale_date>=date('2019-01-01') and sale_date<=('2019-03-31') then quantity else 0 end) spring_19_sales, sum(case when sale_date<date('2019-01-01') or sale_date>('2019-03-31') then quantity else 0 end) other_sales from cte group by product_id) c where spring_19_sales > 0 and other_sales = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 382, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with a as( select product.product_id, product.product_name, case when sale_date between '2019-01-01' and '2019-03-31' then 'y' else 'n' end as q1_sale from sales join product on sales.product_id=product.product_id) select product_id, product_name from a group by 1,2 having min(q1_sale)='y'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 383, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with c1 as (select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31' and product_id not in (select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31')) select c1.product_id, p.product_name from c1 left join product p using(product_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 384, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select s.product_id,p.product_name,min(s.sale_date) over(partition by product_id) as minimum , max(s.sale_date) over(partition by product_id) as maximum from sales s inner join product p on s.product_id = p.product_id ) select product_id,product_name from cte where minimum >= '2019-01-01' and maximum <= '2019-03-31' group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 385, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select distinct p.product_id from product p join sales s on p.product_id = s.product_id where s.sale_date < '2019-01-01' or s.sale_date > '2019-03-31' ) select product_id, product_name from product where product_id not in (select product_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 386, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select distinct p.product_id, p.product_name from product p join sales s where sale_date between '2019-01-01' and '2019-03-31' ) select * from cte where product_id not in (select product_id from sales where month(sale_date) > 3)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 387, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product_id from sales where sale_date between '2019-01-01' and '2019-03-31' ), temp as ( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' ), sub as ( select cte.product_id from cte left join temp on cte.product_id=temp.product_id where temp.product_id is null ) select distinct sub.product_id,p.product_name from sub join product as p on sub.product_id=p.product_id order by sub.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 388, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') select product_id, product_name from product where product_id not in (select product_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 389, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product_id from sales where sale_date<'2019-01-01' or sale_date>'2019-03-31' ), demo as ( select product_id from sales where sale_date>='2019-01-01' or sale_date<='2019-03-31' ), sub as ( select demo.product_id from demo left join cte on demo.product_id=cte.product_id where cte.product_id is null ) select distinct sub.product_id,p.product_name from sub join product as p on sub.product_id=p.product_id order by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 390, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as (select a.product_id, a.sale_date, b.product_name from sales a join product b on a.product_id = b.product_id) select product_id, product_name from cte where product_id in (select product_id from cte where sale_date between '2019-01-01' and '2019-03-31') and product_id not in (select product_id from cte where (sale_date < '2019-01-01') or (sale_date > '2019-03-31')) group by product_id, product_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 391, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as (select product_id , sum(case when sale_date>='2019-01-01' and sale_date<='2019-03-31' then 1 else 0 end) as spring , sum(case when sale_date<'2019-01-01' or sale_date>'2019-03-31' then 1 else 0 end) as other from sales group by product_id ) select cte. product_id, product_name from cte, product where cte. product_id=product.product_id and spring>=1 and other=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 392, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with jointable as (select a.product_id, b.product_name, a.sale_date from sales as a inner join product as b on a.product_id=b.product_id ) select distinct product_id, product_name from jointable where (product_id not in (select product_id from jointable where sale_date < '2019-01-01' or sale_date > '2019-03-31')) and (sale_date >= '2019-01-01') and (sale_date <= '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 393, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with p as ( select product_id from product p join sales using(product_id) where sale_date < '2019-01-01' or sale_date > '2019-03-31' ) select product_id, product_name from product where product_id not in (select product_id from p)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 394, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with pro as (select product_id from sales where sale_date<'2019-01-01' or sale_date>'2019-03-31') select product_id,product_name from product where product_id not in (select product_id from pro)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 395, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with product as( select s.product_id, product_name, sale_date from sales as s left join product as p on s.product_id = p.product_id) select distinct p.product_id , product_name from product as p where product_id in (select product_id from product where sale_date between '2019-01-01' and '2019-03-31') and product_id not in (select product_id from product where sale_date < '2019-01-01' or sale_date > '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 396, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with product_sold_spring as( select product_id,min(sale_date) as start_date,max(sale_date) as end_date from sales group by product_id) select s.product_id,p.product_name from product_sold_spring s join product p on s.product_id=p.product_id where start_date between '2019-01-01' and '2019-03-31' and end_date between '2019-01-01' and '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 397, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with products_sold_on_period as ( select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31' ), products_not_sold_on_period as ( select distinct product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' ) select product_id, product_name from product where product_id not in (select product_id from products_not_sold_on_period) and product_id in (select product_id from products_sold_on_period)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 398, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with result as (select distinct product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') select distinct product_id, product_name from product where product_id not in (select product_id from result)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 399, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with s1 as (select distinct product.product_id, product.product_name from sales inner join product on sales.product_id = product.product_id where sale_date >= '2019-01-01' and sale_date <= '2019-03-31') select product_id, product_name from s1 where product_id not in (select distinct product.product_id from sales inner join product on sales.product_id = product.product_id where sale_date < '2019-01-01' or sale_date > '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 400, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sales_cte as( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' group by seller_id,product_id,buyer_id,sale_date ) select product_id,product_name from product where product_id not in ( select * from sales_cte )"]}
