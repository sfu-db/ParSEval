{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 322, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct(buyer_id) from sales s where exists (select * from (select distinct(buyer_id) from sales join product using (product_id) where product_name = 's8') s1 where s1.buyer_id = s.buyer_id) and not exists (select * from (select distinct(buyer_id) from sales join product using (product_id) where product_name = 'iphone') s2 where s2.buyer_id = s.buyer_id)"]}
