{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 636, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select m.left_operand, m.operator, m.right_operand, case when m.operator='<' and (l < v2.value) then true when m.operator='=' and (l = v2.value) then true when m.operator='>' and (l>v2.value) then true else false end as value from (select e.left_operand, e.operator, e.right_operand, v1.value as l from expressions as e left join variables as v1 on e.left_operand=v1.name) as m left join variables as v2 on m.right_operand=v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 637, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '=' then if(left_value = right_value, 'true', 'false') when operator = '<' then if(left_value < right_value, 'true', 'false') when operator = '>' then if(left_value > right_value, 'true', 'false') end as value from (select e.*, v1.value as left_value, v2.value as right_value from expressions as e join variables as v1 on e.left_operand = v1.name join variables as v2 on e.right_operand = v2.name) as t"]}
