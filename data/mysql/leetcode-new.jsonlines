{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 354, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select player_id,device_id from ( select player_id,device_id,rank() over(partition by player_id order by event_date asc) as rnk from activity )a where rnk=1"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 355, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select distinct player_id, nth_value(device_id, 1) over(partition by player_id order by event_date asc) as device_id from activity"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 356, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select player_id, device_id from ( select player_id, device_id, event_date, rank()over(partition by player_id order by event_date asc) as rnk from activity ) t1 where rnk =1"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 357, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id, a.device_id from activity a, (select min(event_date) as event_date, player_id from activity a group by player_id) b where (a.player_id = b.player_id and a.event_date = b.event_date)"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 358, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select player_id, device_id from ( select *, min(event_date) over(partition by player_id) as min_event_date from activity ) as b where event_date = min_event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 359, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with act as ( select player_id, min(event_date) as min_date from activity group by player_id) select activity.player_id, device_id from activity inner join act on act.player_id = activity.player_id where activity.event_date = act.min_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 360, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with firstlogin as (select player_id, min(event_date) as first_login from activity group by player_id) select a.player_id, a.device_id from activity as a inner join firstlogin as b on a.player_id=b.player_id where a.event_date=b.first_login"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 361, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with cte as (select *, rank() over(partition by player_id order by event_date) as rnk from activity) select player_id, device_id from cte where rnk =1"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 362, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with a as ( select player_id, min(event_date) as event_date from activity group by 1 ) select a.player_id, b.device_id from a, activity as b where a.player_id = b.player_id and a.event_date = b.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 363, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with min_dates as ( select player_id, min(event_date) as min_date from activity group by player_id) select a.player_id, a.device_id from activity a inner join min_dates m on a.player_id = m.player_id where a.event_date = m.min_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 364, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id, a.device_id from activity as a inner join ( select player_id, min(event_date) as min_event_date from activity group by player_id ) as b on a.player_id = b.player_id and a.event_date = b.min_event_date"]}
