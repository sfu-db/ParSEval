{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 529, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with register_day as ( select player_id, min(event_date) as r_day from activity group by player_id ) select register_day.player_id, activity.device_id from register_day left join activity on register_day.player_id = activity.player_id and register_day.r_day = activity.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 530, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "with df1 as ( select player_id, min(event_date) as first_logged_in from activity group by 1 ) select df1.player_id as player_id, df2.device_id from df1 left join (select player_id, device_id, event_date from activity) df2 on df1.player_id = df2.player_id and df1.first_logged_in = df2.event_date"]}
