{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 76, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(tot) as grand_slams_count from (select s2.player_id, s2.player_name, count(s1.wimbledon) as tot from championships s1, players s2 where s2.player_id=s1.wimbledon group by 1, 2 union all select s2.player_id, s2.player_name, count(s1.fr_open) as tot from championships s1, players s2 where s2.player_id=s1.fr_open group by 1, 2 union all select s2.player_id, s2.player_name, count(s1.us_open) as tot from championships s1, players s2 where s2.player_id=s1.us_open group by 1, 2 union all select s2.player_id, s2.player_name, count(s1.au_open) as tot from championships s1, players s2 where s2.player_id=s1.au_open group by 1, 2) open group by 1,2"]}
