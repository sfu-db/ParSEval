{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 483, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player as player_id, p.player_name, count(*) as grand_slams_count from ( select year, 'wimbledon' as game, wimbledon as player from championships union all select year, 'fr_open' as game, fr_open as player from championships union all select year, 'us_open' as game, us_open as player from championships union all select year, 'au_open' as game, au_open as player from championships ) c left join players p on c.player = p.player_id group by c.player, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 484, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, grand_slams_count from (select player_id, player_name, (select sum(case when wimbledon = player_id then 1 else 0 end) + sum(case when fr_open = player_id then 1 else 0 end) + sum(case when us_open = player_id then 1 else 0 end) + sum(case when au_open = player_id then 1 else 0 end) from championships) as grand_slams_count from players) t where t.grand_slams_count <> 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 485, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as( select wimbledon as w_champion, count(*) as w_count from championships group by wimbledon), t2 as( select fr_open as f_champion, count(*) as f_count from championships group by fr_open), t3 as( select us_open as u_champion, count(*) as u_count from championships group by us_open), t4 as( select au_open as a_champion, count(*) as a_count from championships group by au_open), t5 as( select p.player_id, p.player_name, ifnull(t1.w_count,0)+ifnull(t2.f_count,0)+ifnull(t3.u_count,0)+ifnull(t4.a_count,0) as grand_slams_count from players p left outer join t1 on (p.player_id=t1.w_champion) left outer join t2 on (p.player_id=t2.f_champion) left outer join t3 on (p.player_id=t3.u_champion) left outer join t4 on (p.player_id=t4.a_champion)) select player_id, player_name,grand_slams_count from t5 where grand_slams_count<>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 486, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(if(c.wimbledon = p.player_id,1,0)) + sum(if(c.fr_open = p.player_id,1,0)) + sum(if(c.us_open = p.player_id,1,0)) + sum(if(c.au_open = p.player_id,1,0))) as grand_slams_count from players p, championships c group by 1 having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 487, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with new as ( select player_id,sum(grand_slams_count) as grand_slams_count from ( select wimbledon as player_id, count(wimbledon) as grand_slams_count from championships group by 1 union all select fr_open as player_id, count(fr_open) as grand_slams_count from championships group by 1 union all select us_open as player_id, count(us_open) as grand_slams_count from championships group by 1 union all select au_open as player_id, count(au_open) as grand_slams_count from championships group by 1 ) a group by 1 ) select a.player_id,b.player_name,grand_slams_count from new a join players b on a.player_id=b.player_id where grand_slams_count>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 488, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(player_id = wimbledon) + sum(player_id = fr_open) + sum(player_id = us_open) + sum(player_id = au_open) as grand_slams_count from championships c join players p on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 489, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as (select wimbledon as player_id , player_name from championships c left join players p on c.wimbledon = p.player_id union all select fr_open as player_id, player_name from championships c left join players p on c.fr_open = p.player_id union all select us_open as player_id, player_name from championships c left join players p on c.us_open = p.player_id union all select au_open as player_id, player_name from championships c left join players p on c.au_open = p.player_id) select player_id, player_name, count(*) as grand_slams_count from cte1 group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 490, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from (select p.player_id, p.player_name, sum(if(p.player_id = c.wimbledon, 1, 0) + if(p.player_id = c.fr_open, 1, 0) + if(p.player_id = c.us_open, 1, 0) + if(p.player_id = c.au_open, 1, 0)) as grand_slams_count from players as p, championships as c group by player_id, player_name) as a where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 491, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select player_id, player_name, count(id) as grand_slams_count from players as p inner join cte as c on p.player_id = c.id group by c.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 492, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(winner) as grand_slams_count from (select p.player_id, player_name, count(wimbledon) as winner from championships c left join players p on p.player_id = c.wimbledon group by p.player_id union all select p.player_id, player_name, count(fr_open) as winner from championships c left join players p on p.player_id = c.fr_open group by p.player_id union all select p.player_id, player_name, count(us_open) as winner from championships c left join players p on p.player_id = c.us_open group by p.player_id union all select p.player_id, player_name, count(au_open) as winner from championships c left join players p on p.player_id = c.au_open group by p.player_id) a group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 493, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_record as ( select year, wimbledon winner_id from championships union all select year, fr_open winner_id from championships union all select year, us_open winner_id from championships union all select year, au_open winner_id from championships ) select player_id, player_name, count(winner_id) grand_slams_count from players p join all_record a on p.player_id = a.winner_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 494, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(p.player_id=wimbledon)+sum(p.player_id=fr_open)+sum(p.player_id=us_open)+sum(p.player_id=au_open) as grand_slams_count from players p join championships c on p.player_id=c.wimbledon or p.player_id=c.fr_open or p.player_id=c.us_open or p.player_id=c.au_open group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 495, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t as (select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships) select t.player_id, player_name, count(*) as grand_slams_count from t join players p on t.player_id = p.player_id group by t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 496, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name,grand_slams_count from (select player_id, player_name, (select sum(case when wimbledon = player_id then 1 else 0 end)+ sum(case when fr_open = player_id then 1 else 0 end)+ sum(case when us_open = player_id then 1 else 0 end)+ sum(case when au_open = player_id then 1 else 0 end) grand_slams_count from championships) grand_slams_count from players) a where a.grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 497, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with union_cte as( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships), player_win_count_cte as( select player_id, count(player_id) as grand_slams_count from union_cte group by player_id) select p.player_id, player_name , grand_slams_count from players p join player_win_count_cte pc on p.player_id = pc.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 498, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player from championships union all select fr_open as player from championships union all select us_open as player from championships union all select au_open as player from championships ) select p.player_id, p.player_name, t.grand_slams_count from players p inner join (select player, count(*) as grand_slams_count from cte group by player) as t on p.player_id = t.player"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 499, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winnings as ( select year, wimbledon as win from championships union all select year, fr_open as win from championships union all select year, us_open as win from championships union all select year, au_open as win from championships ) select p.player_id, p.player_name, count(*) as grand_slams_count from players p join winnings w on w.win = p.player_id group by player_id, player_name"]}
