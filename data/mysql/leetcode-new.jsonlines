{"benchmark": "benchmark/leetcode/raw_data/1045.csv", "index": 0, "schema": "create table customer (customer_id integer not null, product_key integer, constraint pk_customer primary key (customer_id), foreign key (product_key) references product (product_key)); create table product (product_key integer not null, constraint pk_product primary key (product_key));", "pair": ["select customer_id from customer group by 1 having count(distinct product_key) = (select count(distinct product_key) from product)", "select customer_id from (select customer_id, sum(product_key) as tot from (select distinct customer_id, product_key from customer order by product_key) a group by customer_id having sum(product_key) = (select sum(product_key) from product)) a"]}
