{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 414, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with t as (select customer_id, count(transaction_id) cnt from visits left join transactions using(visit_id) group by 1, visit_id having count(transaction_id)=0) select customer_id, count(cnt) count_no_trans from t group by 1"]}
