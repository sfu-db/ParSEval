{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 386, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' and a.value > b.value then true when operator = '<' and a.value < b.value then true when operator = '=' and a.value = b.value then true else false end as value from expressions c left join variables a on c.left_operand = a.name left join variables b on c.right_operand = b.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 387, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, ( case when a.operator = '=' and a.left_val = a.right_val then true when a.operator = '<' and a.left_val < a.right_val then true when a.operator = '>' and a.left_val > a.right_val then true else false end ) as value from ( select a.left_operand, a.operator, a.right_operand, b.value as left_val, c.value as right_val from expressions as a left join variables as b on a.left_operand = b.name left join variables as c on a.right_operand = c.name ) as a"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 388, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator,right_operand, case when operator = '>' and a.value > b.value then true when operator = '>' and a.value <= b.value then false when operator = '=' and a.value = b.value then true when operator = '=' and a.value != b.value then false when operator = '<' and a.value < b.value then true when operator = '<' and a.value >= b.value then false else null end as value from expressions join variables a on expressions.left_operand = a.name join variables b on expressions.right_operand = b.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 389, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when operator = '>' then if(v1.value > v2.value,'true','false') when operator = '=' then if(v1.value = v2.value,'true','false') else if(v1.value < v2.value,'true','false') end as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 390, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '=' then if(left_v.value = right_v.value, 'true', 'false') when e.operator = '<' then if(left_v.value < right_v.value, 'true', 'false') when e.operator = '>' then if(left_v.value > right_v.value, 'true', 'false') end value from expressions e join variables left_v on e.left_operand = left_v.name join variables right_v on e.right_operand = right_v.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 391, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t as (select left_operand, operator, right_operand, vl.value as left_operand_value , vr.value as right_operand_value from expressions e left join variables vl on e.left_operand = vl.name left join variables vr on e.right_operand = vr.name) select left_operand, operator, right_operand, (case when operator = '>' and left_operand_value > right_operand_value then true when operator = '<' and left_operand_value < right_operand_value then true when operator = '=' and left_operand_value = right_operand_value then true else false end) as value from t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 392, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with temp as ( select left_operand, coalesce(l.value,0) as left_val, operator, right_operand, coalesce(r.value,0) as right_val from expressions e left join variables l on e.left_operand = l.name left join variables r on e.right_operand = r.name ) select left_operand, operator, right_operand, case when operator = '>' then (case when left_val > right_val then true else false end) when operator = '<' then (case when left_val < right_val then true else false end) when operator = '=' then (case when left_val = right_val then true else false end) end as value from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 393, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t1 as( select e.*, v1.value l, v2.value r from expressions e left join variables v1 on e.left_operand=v1.name left join variables v2 on e.right_operand=v2.name ), t2 as( select left_operand, operator, right_operand, (case when operator='>' then l>r when operator='=' then l=r when operator='<' then l<r end) value from t1 ) select left_operand, operator, right_operand, (case when value=0 then false else true end) value from t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 394, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte1 as (select left_operand, operator, right_operand, v.value l from expressions e left join variables v on e.left_operand=v.name), cte2 as (select left_operand, operator, right_operand, l, v.value r from cte1 c left join variables v on c.right_operand=v.name) select left_operand, operator, right_operand, case when operator='<' and l<r then true when operator='=' and l=r then true when operator='>' and l>r then true else false end value from cte2"]}
