{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 72, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select d1.date_id,d1.make_name,(select count(distinct d2.lead_id) from dailysales d2 where d2.date_id=d1.date_id and d2.make_name=d1.make_name) as unique_leads,(select count(distinct d2.partner_id) from dailysales d2 where d2.date_id=d1.date_id and d2.make_name=d1.make_name) as unique_partners from dailysales d1 group by date_id,make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 73, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select dailysales.date_id, dailysales.make_name, count(distinct dailysales.lead_id) as unique_leads , count(distinct dailysales.partner_id) as unique_partners from dailysales group by dailysales.date_id, dailysales.make_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 74, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name order by date_id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 75, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select d.date_id, d.make_name, count(distinct d.lead_id) as unique_leads , count(distinct d.partner_id) as unique_partners from dailysales d group by 1,2"]}
