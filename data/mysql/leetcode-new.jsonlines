{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 333, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with tempcte as ( select distinct p.session_id, a.customer_id, a.timestamp, p.start_time, p.end_time, case when a.timestamp between p.start_time and p.end_time then 'yes' else 'no' end as status from playback p, ads a where p.customer_id = a.customer_id ) select distinct session_id from tempcte where status = 'no' and session_id not in (select distinct session_id from tempcte where status= 'yes') union all select distinct session_id from playback where customer_id not in (select distinct customer_id from ads) order by session_id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 334, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with w1 as ( select distinct p.session_id from playback p inner join ads a on p.customer_id = a.customer_id and a.timestamp between p.start_time and p.end_time ) select distinct p1.session_id from playback p1 where p1.session_id not in (select session_id from w1) order by p1.session_id"]}
