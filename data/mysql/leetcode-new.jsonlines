{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 293, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "select distinct name, ifnull(sum(rest)over(partition by i.product_id),0) as rest, ifnull(sum(paid)over(partition by i.product_id),0) as paid, ifnull(sum(canceled)over(partition by i.product_id),0) as canceled, ifnull(sum(refunded)over(partition by i.product_id),0) as refunded from product p left join invoice i using(product_id) order by 1"]}
