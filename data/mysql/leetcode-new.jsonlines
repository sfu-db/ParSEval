{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 218, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as ( select count(distinct delivery_id) count1 from delivery), temp2 as (select count(distinct delivery_id) count2 from delivery where order_date=customer_pref_delivery_date) select round((temp2.count2/temp.count1)*100,2) as immediate_percentage from temp2,temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 219, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as ( select delivery_id, customer_id, order_date, customer_pref_delivery_date, case when order_date = customer_pref_delivery_date then 1 else 0 end as immediate from delivery) select round(avg(immediate)*100, 2) as immediate_percentage from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 220, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as (select *, (case when order_date = customer_pref_delivery_date then 'immediate' when order_date != customer_pref_delivery_date then 'scheduled' else null end) as status from delivery) select round(count(temp.status)/( select count(delivery_id) from delivery) * 100,2) as immediate_percentage from temp where temp.status = 'immediate'"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 221, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with temp as (select delivery_id from delivery where customer_pref_delivery_date=order_date) select round((count(delivery_id)/(select count(delivery_id) from delivery))*100,2) as immediate_percentage from temp"]}
