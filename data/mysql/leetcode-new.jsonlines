{"benchmark": "benchmark/leetcode/raw_data/511.csv", "index": 171, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id,min(event_date) as first_login from activity group by player_id", "with cte as ( select *, row_number() over(partition by player_id order by event_date asc) as rk from activity ) select player_id, event_date as first_login from cte where rk = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/511.csv", "index": 172, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id,min(event_date) as first_login from activity group by player_id", "with cte as (select player_id,event_date,dense_rank() over(partition by player_id order by event_date) as dr from activity) select player_id,event_date as first_login from cte where dr=1"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 0, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id, a.device_id from activity a join (select player_id, min(event_date) as event_date from activity group by player_id) b on a.player_id = b.player_id where a.event_date = b.event_date"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 1, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a.player_id, a.device_id from activity a where (a.player_id, a.event_date) in (select player_id, min(event_date) from activity group by player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/512.csv", "index": 2, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select player_id, device_id from activity where (player_id, event_date) in ( select player_id, min(event_date) from activity group by player_id )", "select a1.player_id, a1.device_id from activity a1 inner join (select a.player_id, min(a.event_date)as first_date from activity a group by 1) as a2 on a1.player_id = a2.player_id and a1.event_date = a2.first_date"]}
