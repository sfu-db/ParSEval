{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 440, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with t as (select distinct visit_id from transactions), t1 as (select *, case when visit_id in (select visit_id from t) then 0 else 1 end as if_no_trans from visits) select customer_id,sum(if_no_trans) as count_no_trans from t1 group by 1 having sum(if_no_trans)>0"]}
