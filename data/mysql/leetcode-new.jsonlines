{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 603, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, if((case when operator ='>' then v1.value>v2.value when operator='=' then v1.value=v2.value else v1.value<v2.value end)=0,'false','true') as value from expressions e left join variables v1 on v1.name = e.left_operand left join variables v2 on v2.name = e.right_operand"]}
