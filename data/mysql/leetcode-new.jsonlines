{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 417, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select distinct(project_id), round(avg(experience_years) over (partition by project_id),2) as average_years from project p inner join employee e on p.employee_id = e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 418, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with sub as (select p.project_id project_id1,e.employee_id,e.experience_years ey from project p join employee e on p.employee_id= e.employee_id) select project_id1 project_id,round(sum(ey)/count(project_id1),2) average_years from sub group by project_id1 order by project_id1"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 419, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select project_id, round(avg(experience_years),2) as average_years from project prj left join employee emp on emp.employee_id = prj.employee_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 420, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select project_id, ifnull(round(ex / em, 2), 0.00) as average_years from ( select p.project_id, sum(e.experience_years) as ex, count(p.employee_id) as em from project p join employee e using (employee_id) group by p.project_id ) as t"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 421, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with proj_enhcd as ( select p.project_id,p.employee_id, e.experience_years from project p left join employee e on p.employee_id=e.employee_id ) select pe.project_id, round(avg(pe.experience_years),2) average_years from proj_enhcd pe group by 1"]}
