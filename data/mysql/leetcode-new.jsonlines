{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 114, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followee_num_follower as ( select followee, count(distinct follower) as num from follow group by followee) select followee as follower, num from followee_num_follower where followee in (select follower from follow) order by followee"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 115, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with follower_count as ( select ff.followee, count(distinct ff.follower) as follower_count from (select followee, follower from follow order by followee) ff group by ff.followee order by ff.followee ) select distinct f.follower, fc.follower_count as num from follow f left join follower_count fc on f.follower = fc.followee where isnull(fc.follower_count) = false order by f.follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 116, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with follower_list as ( select follower from follow ) select followee as follower, count(distinct(follower)) as num from follow where followee in (select * from follower_list) group by followee order by followee"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 117, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with self_joined as( select distinct a.follower as follower, b.follower as follower_fol from follow a inner join follow b on a.follower = b.followee ) select follower, count(*) as num from self_joined group by follower order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 118, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with t1 as ( select f1.followee, f1.follower as follower1, f2.follower as follower2 from follow f1 left join follow f2 on f1.follower = f2.followee ) select follower1 as follower, count(distinct follower2) as num from t1 group by follower1 having num > 0"]}
