{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 685, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator,right_operand, case when operator='<' and vl<vr then true when operator='>' and vl>vr then true when operator = '=' and vl=vr then true else false end as value from (select e.left_operand, v.value as vl,e.right_operand, v2.value as vr, e.operator from expressions as e join variables as v on v.name=e.left_operand join variables as v2 on v2.name=e.right_operand) as cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 686, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with full_table as( select tmp1.*,tmp2.right_value from ( select a.*,b.value as left_value from expressions as a left join variables as b on a.left_operand=b.name ) as tmp1 left join ( select a.*,b.value as right_value from expressions as a left join variables as b on a.right_operand=b.name) as tmp2 on tmp1.left_operand=tmp2.left_operand and tmp1.operator=tmp2.operator and tmp1.right_operand=tmp2.right_operand) select left_operand, operator, right_operand, case when operator='>' and left_value > right_value then true when operator='<' and left_value < right_value then true when operator='=' and left_value = right_value then true else false end as value from full_table"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 687, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as( select left_operand, operator, value as left_value from expressions a left join variables b on a.left_operand=b.name), cte2 as (select left_operand,right_operand, operator, value as right_value from expressions a left join variables b on a.right_operand=b.name) select distinct cte.left_operand, cte.operator, cte2.right_operand, case when left_value>right_value and cte.operator='>' then true when left_value=right_value and cte.operator='=' then true when left_value<right_value and cte.operator='<' then true else false end as value from cte join cte2 on cte.left_operand=cte2.left_operand and cte.operator=cte2.operator"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 688, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' then if(left_value > right_value, 'true', 'false') when operator = '=' then if(left_value = right_value, 'true', 'false') else if(left_value < right_value, 'true', 'false') end as value from( select left_operand, v1.value as left_value, operator, right_operand, v2.value as right_value from expressions join variables v1 on expressions.left_operand = v1.name join variables v2 on expressions.right_operand = v2.name )t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 689, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand,e.operator,e.right_operand, case when operator='=' then if(t1.value=t2.value,'true','false') when operator='>' then if(t1.value>t2.value,'true','false') when operator='<' then if(t1.value<t2.value,'true','false') end as value from expressions e join variables t1 on t1.name=e.left_operand join variables t2 on t2.name=e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 690, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when (e.operator = '>' and vl.value > vr.value) then true when (e.operator = '<' and vl.value < vr.value) then true when (e.operator = '=' and vl.value= vr.value) then true else false end as value from expressions e , variables vr , variables vl where e.left_operand = vl.name and e.right_operand = vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 691, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, (case when operator = '>' and v1.value > v2.value then true when operator = '<' and v1.value < v2.value then true when operator = '=' and v1.value = v2.value then true else false end) as value from variables v1, variables v2, expressions e where v1.name = e.left_operand and v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 692, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as ( select left_operand, operator, right_operand, v1.value as left_value, v2.value as right_value from expressions e left join variables v1 on e.left_operand= v1.name inner join variables v2 on e.right_operand=v2.name ) select left_operand, operator, right_operand, case when operator = '<' and left_value<right_value then true when operator = '>' and left_value>right_value then true when operator = '=' and left_value=right_value then true else false end as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 693, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t1 as( select left_operand, right_operand, t11.value as left_num, t12.value as right_num, operator from expressions join variables t11 on t11.name = expressions.left_operand join variables t12 on t12.name = expressions.right_operand ) select left_operand, operator, right_operand, case when (operator = '=' and left_num = right_num) or (operator = '>' and left_num > right_num) or (operator = '<' and left_num < right_num) then true else false end as value from t1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 694, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = '=' then if(a.value = b.value,'true','false') when operator = '>' then if(a.value > b.value,'true','false') when operator = '<' then if(a.value < b.value,'true','false') end) as value from expressions x left join variables a on x.left_operand = a.name left join variables b on x.right_operand = b.name"]}
