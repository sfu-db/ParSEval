{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 788, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with gs as (select wimbledon as title from championships union all select fr_open as title from championships union all select us_open as title from championships union all select au_open as title from championships) select g.title as player_id, p.player_name, count(*) as grand_slams_count from gs g left join players p on g.title=p.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 789, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champs as ( select wimbledon as champ, count(year) times from championships group by 1 union all select fr_open as champ, count(year) times from championships group by 1 union all select us_open as champ, count(year) times from championships group by 1 union all select au_open as champ, count(year) times from championships group by 1 ) select player_id, player_name, sum(times) grand_slams_count from champs c left join players p on p.player_id = c.champ group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 790, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select p.player_id, p.player_name, (select count(*) from championships where wimbledon = p.player_id) + (select count(*) from championships where fr_open = p.player_id) + (select count(*) from championships where us_open = p.player_id) + (select count(*) from championships where au_open = p.player_id) as grand_slams_count from players p ) t where t.grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 791, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum( (select count(*) from championships where player_id=wimbledon) + (select count(*) from championships where player_id=fr_open)+ (select count(*) from championships where player_id=us_open)+ (select count(*) from championships where player_id=au_open) ) as grand_slams_count from players group by player_id having grand_slams_count >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 792, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with pc as( select p.player_id, p.player_name, if(c.wimbledon is null,0,1) as gsw from players p left join championships c on p.player_id = c.wimbledon union all select p.player_id, p.player_name, if(c.fr_open is null,0,1) as gsw from players p left join championships c on p.player_id = c.fr_open union all select p.player_id, p.player_name, if(c.us_open is null,0,1) as gsw from players p left join championships c on p.player_id = c.us_open union all select p.player_id, p.player_name, if(c.au_open is null,0,1) as gsw from players p left join championships c on p.player_id = c.au_open ) select pc.player_id, pc.player_name, sum(pc.gsw) as grand_slams_count from pc group by pc.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 793, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as win from championships union all select fr_open as win from championships union all select us_open as win from championships union all select au_open as win from championships ) select p.player_id,p.player_name, count(*) as grand_slams_count from cte left join players p on win = p.player_id group by player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 794, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select a.player_id, player_name, count(*) as grand_slams_count from temp a left join players b on a.player_id = b.player_id group by player_id order by count(*)"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 795, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, count(*) grand_slams_count from (select year, wimbledon tournament from championships union all select year, fr_open tournament from championships union all select year, us_open tournament from championships union all select year, au_open tournament from championships) temp left join players p on p.player_id = temp.tournament group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 796, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year, wimbledon as tnt from championships union all select year, fr_open as tnt from championships union all select year, us_open as tnt from championships union all select year, au_open as tnt from championships ) select player_id,player_name,count(player_id)grand_slams_count from cte c inner join players p on p.player_id = c.tnt group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 797, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select p.player_id,p.player_name from players p join championships c1 on p.player_id=c1.wimbledon union all select p.player_id,p.player_name from players p join championships c1 on p.player_id=c1.fr_open union all select p.player_id,p.player_name from players p join championships c1 on p.player_id=c1.us_open union all select p.player_id,p.player_name from players p join championships c1 on p.player_id=c1.au_open ) select player_id,player_name, count(*) as grand_slams_count from cte group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 798, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) select a.player_id, b.player_name, count(a.player_id) as grand_slams_count from cte a join players b on a.player_id = b.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 799, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as tournament, 'w' as label from championships union select year, fr_open as tournament, 'fr' as label from championships union select year, us_open as tournament, 'us' as label from championships union select year, au_open as tournament, 'au' as label from championships) select tournament as player_id, player_name, count(*) as grand_slams_count from cte c join players p on c.tournament = p.player_id group by 1 having count(label) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 800, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with player_slam_cnt as ( select wimbledon as player_id,count(wimbledon) as grand_slams_count from championships group by wimbledon union all select fr_open as player_id,count(fr_open) as grand_slams_count from championships group by fr_open union all select us_open as player_id,count(us_open) as grand_slams_count from championships group by us_open union all select au_open as player_id,count(au_open) as grand_slams_count from championships group by au_open ) select plyr_cnt.player_id, plyr.player_name,sum(plyr_cnt.grand_slams_count) as grand_slams_count from player_slam_cnt as plyr_cnt join players as plyr on plyr.player_id = plyr_cnt.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 801, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with player_win_cnt as ( select player_id, count(*) grand_slams_count from ( select wimbledon player_id from championships union all select fr_open player_id from championships union all select us_open player_id from championships union all select au_open player_id from championships ) x group by player_id ) select pl.player_id, pl.player_name, pc.grand_slams_count from players pl inner join player_win_cnt pc on (pl.player_id = pc.player_id)"]}
