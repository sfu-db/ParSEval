{"benchmark": "benchmark/leetcode/raw_data/1661.csv", "index": 31, "schema": "create table activity (machine_id integer not null, process_id integer not null, activity_type varchar(30) not null, timestamp integer, constraint pk_activity primary key (machine_id, process_id, activity_type), constraint check_activity check (activity_type in (\"start\", \"end\")));", "pair": ["select s.machine_id, round(avg(e.timestamp-s.timestamp), 3) as processing_time from activity s join activity e on s.machine_id = e.machine_id and s.process_id = e.process_id and s.activity_type = 'start' and e.activity_type = 'end' group by s.machine_id", "select machine_id, round(sum(case when activity_type = 'end' then timestamp else 0 end - case when activity_type = 'start' then timestamp else 0 end)/count(distinct process_id), 3) as processing_time from activity group by machine_id"]}
