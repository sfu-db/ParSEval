{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 513, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select t.company_id, t.employee_id, t.employee_name, case when t.max_salary < 1000 then salary when t.max_salary > 10000 then round((1-0.49)*salary) else round((1-0.24)*salary) end as salary from ( select company_id, employee_id, employee_name, salary, max(salary) over (partition by company_id) as max_salary from salaries ) t"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 514, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with temp as ( select *, case when max(salary) over(partition by company_id) <1000 then 0 when max(salary) over(partition by company_id) between 1000 and 10000 then 0.24 else 0.49 end as tax_rate from salaries ) select company_id,employee_id ,employee_name, round(salary*(1-tax_rate)) as salary from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 515, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, case when max(salary) over(partition by company_id)<1000 then salary when max(salary) over(partition by company_id)>=1000 and max(salary) over(partition by company_id)<=10000 then round((salary - salary*0.24)) when max(salary) over(partition by company_id) > 10000 then round((salary - salary*0.49)) else salary end as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 516, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(case when max(salary) over(partition by company_id) < 1000 then salary when max(salary) over(partition by company_id) > 10000 then salary-(salary*0.49) else salary -(salary*0.24) end,0) as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 517, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with cte as (select distinct company_id, (case when (max(salary) over (partition by company_id))<1000 then 0 when (max(salary) over (partition by company_id))>10000 then 0.49 else 0.24 end) as perc from salaries ) select cte.company_id, employee_id, employee_name, round(salary*(1-perc)) as salary from cte join salaries on cte.company_id=salaries.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 518, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(case when max(salary)over(partition by company_id) < 1000 then salary when max(salary)over(partition by company_id) <=10000 then salary*(1-0.24) else salary*(1-0.49) end,0) as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 519, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, case when max(salary) over(partition by company_id) > 10000 then round((salary-salary*0.49),0) when max(salary) over (partition by company_id) between 1000 and 10000 then round((salary-salary*0.24),0) when max(salary) over (partition by company_id) < 1000 then round((salary),0) end as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 520, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with cte1 as ( select company_id,max(salary) as max_sal from salaries group by company_id ), cte2 as( select company_id as cid, case when max_sal<1000 then 0 when max_sal>=1000 and max_sal<=10000 then 24 else 49 end as intrest from cte1 ) select company_id, employee_id,employee_name,round(salary-((salary*intrest)/100)) as salary from salaries left join cte2 on cte2.cid=company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 521, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with company_tax_rate as ( select a.company_id, case when a.max_salary < 1000 then 0 when a.max_salary between 1000 and 10000 then 0.24 else 0.49 end as tax_rate from ( select company_id, max(salary) as max_salary from salaries group by 1 ) a ) select a.company_id, a.employee_id, a.employee_name, round(a.salary - a.salary * b.tax_rate,0) as salary from salaries a left join company_tax_rate b on a.company_id = b.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 522, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t1 as ( select company_id, max(salary) as max_salary, case when max(salary) <1000 then 0 when max(salary)>=1000 and max(salary)<=10000 then 0.24 else 0.49 end as tax_rate from salaries group by company_id ) select s.company_id, s.employee_id, s.employee_name, round(s.salary * (1-t1.tax_rate),0) as salary from t1 inner join salaries s on s.company_id = t1.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 523, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select s.company_id, s.employee_id, s.employee_name, round(s.salary - (s.salary*tax),0) as salary from salaries s join( select salaries.*, case when max(salary) < 1000 then 0 when max(salary) >1000 and max(salary) < 10000 then 0.24 else 0.49 end as tax from salaries group by company_id)sub on s.company_id = sub.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 524, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with t1 as ( select *, max(salary) over(partition by company_id order by company_id) mx from salaries ) select company_id, employee_id, employee_name, round(case when mx < 1000 then salary when mx between 1000 and 9999 then salary - (salary*0.24) when mx > 10000 then salary - (salary*0.49) end) as salary from t1 order by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 525, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(case when sum_company < 1000 then salary when sum_company between 1000 and 10000 then salary * 0.76 when sum_company > 10000 then salary * 0.51 end,0) salary from( select company_id, employee_id, employee_name, salary, max(salary) over(partition by company_id) sum_company from salaries) asd"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 526, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(salary - salary*rate, 0) as salary from (select *, case when max(salary) over (partition by company_id) <1000 then 0 when max(salary) over (partition by company_id) between 1000 and 10000 then 0.24 else 0.49 end as rate from salaries)t"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 527, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round( case when max(salary) over ( partition by company_id) <1000 then salary when max(salary) over (partition by company_id) >10000 then salary*(1-.49) else salary*(1-.24) end,0) as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 528, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(case when max_salary < 1000 then salary when max_salary >=1000 and max_salary < 10000 then (salary*0.76) when max_salary > 10000 then (salary*0.51) end) as salary from (select company_id, employee_id, employee_name, salary, max(salary) over(partition by company_id) as max_salary from salaries) a"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 529, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, (case when max(salary) over (partition by company_id) < 1000 then salary when max(salary) over (partition by company_id) >= 1000 and max(salary) over (partition by company_id) <= 10000 then round(salary * (1-0.24), 0) else round(salary * (1-0.49), 0) end) as salary from salaries"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 530, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select salaries.company_id as company_id, employee_id, employee_name, round(salary*(1-tax_rate),0) as salary from salaries left join (select company_id, case when max(salary)<1000 then 0 when max(salary)>10000 then 0.49 else 0.24 end as tax_rate from salaries group by company_id) tax_rates on salaries.company_id=tax_rates.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 531, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(salary * a.ratio, 0) salary from salaries join (select company_id, (case when max(salary) < 1000 then 1 when max(salary) <= 10000 and max(salary) >= 1000 then .76 else .51 end) ratio from salaries group by 1 ) a using(company_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 532, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "select company_id, employee_id, employee_name, round(case when max(salary) over (partition by company_id) < 1000 then salary when max(salary) over (partition by company_id) >= 1000 and max(salary) over (partition by company_id) <= 10000 then 0.76*salary when max(salary) over (partition by company_id) > 10000 then 0.51*max(salary) end) salary from salaries group by 1,2,3"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 533, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with cte as ( select company_id, employee_id, employee_name, salary, max(salary)over(partition by company_id) as max_salary_company from salaries ) select company_id, employee_id, employee_name, round(case when max_salary_company < 1000 then salary when max_salary_company between 1000 and 10000 then 0.76*salary when max_salary_company > 10000 then 0.51*salary end) as salary from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 534, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with max_s as ( select company_id, employee_id, employee_name, salary, max(salary)over(partition by company_id) as max_salary from salaries ), tax as ( select *, case when max_salary < 1000 then 0 when max_salary between 1000 and 10000 then 0.24 else 0.49 end as tax_rate from max_s ) select company_id, employee_id, employee_name, round(salary * (1-tax_rate),0) as salary from tax"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 535, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with cte as ( select distinct company_id, max(salary) over (partition by company_id) as max_salary from salaries ) select salaries.company_id,employee_id,employee_name, round(case when max_salary < 1000 then salary when max_salary >= 1000 and max_salary <= 10000 then salary - (0.24*salary) else salary - (0.49*salary) end,0) as salary from salaries left join cte on cte.company_id = salaries.company_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1468.csv", "index": 536, "schema": "create table salaries (company_id integer not null, employee_id integer not null, employee_name varchar(30), salary integer, constraint pk_salaries primary key (company_id, employee_id), constraint check_salaries check (salary > 0));", "pair": ["select s.company_id, s.employee_id, s.employee_name, round(case when x.max_sal between 1000 and 10000 then salary * 0.76 when x.max_sal > 10000 then salary * 0.51 else salary end, 0) as salary from salaries s inner join (select company_id, max(salary) max_sal from salaries group by company_id) x on s.company_id = x.company_id", "with temp as ( select *, case when max_sal <1000 then 1.0 when max_sal >=1000 and max_sal <= 10000 then 0.76 else 0.51 end as rate from (select company_id, max(salary) as max_sal from salaries group by company_id)t) select s.company_id, s.employee_id, s.employee_name,round(s.salary*temp.rate,0) as salary from salaries s join temp on s.company_id = temp.company_id"]}
