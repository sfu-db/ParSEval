{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 622, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with tmp as (select left_value, left_operand, operator, value as right_value, right_operand from (select value as left_value, left_operand, operator, right_operand from expressions join variables where expressions.left_operand = variables.name) a join variables where a.right_operand = variables.name) select left_operand, operator, right_operand, if((operator = '=') and (left_value=right_value), 'true', if ((operator = '>') and (left_value>right_value), 'true', if ((operator = '<') and (left_value<right_value), 'true', 'false'))) as value from tmp"]}
