{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 555, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select x.product_id,product_name from ( select product_id,min(sale_date) as sd,max(sale_date) as ed from sales group by product_id having sd between '2019-01-01' and '2019-03-31' and ed between '2019-01-01' and '2019-03-31' )x left join (select product_id,product_name from product group by product_id,product_name)y on x.product_id=y.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 556, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with ta1 as( select t1.product_id, product.product_name from ( select s1.product_id from sales s1 where s1.sale_date between '2019-01-01' and '2019-03-31') t1 join product on product.product_id = t1.product_id ), ta2 as( select t2.product_id, product.product_name from ( select s2.product_id from sales s2 where s2.sale_date < '2019-01-01' or s2.sale_date>'2019-03-31') t2 join product on product.product_id = t2.product_id ) select distinct ta1.product_id, ta1.product_name from ta1 where (ta1.product_id) not in (select ta2.product_id from ta2)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 557, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from sales s left join product p on s.product_id = p.product_id group by p.product_id having min(s.sale_date) between '2019-01-01' and '2019-03-31' and max(s.sale_date) between '2019-01-01' and '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 558, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with products_in_first (product_id, is_in_first) as ( select distinct sales.product_id, true as is_in_first from sales left join product on sales.product_id = product.product_id where sales.sale_date >= date('2019-01-01') and sales.sale_date <= date('2019-03-31') ), products_in_rest (product_id, is_in_rest) as ( select distinct sales.product_id, true as is_in_rest from sales left join product on sales.product_id = product.product_id where sales.sale_date > date('2019-03-31') or sales.sale_date < date('2019-01-01') ) select distinct sales.product_id, product.product_name from sales left join product on sales.product_id = product.product_id left join products_in_first on sales.product_id = products_in_first.product_id left join products_in_rest on sales.product_id = products_in_rest.product_id where products_in_first.is_in_first is true and products_in_rest.is_in_rest is not true"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 559, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct product_id, product_name from product where product_id not in (select distinct product.product_id from product join sales on product.product_id = sales.product_id where sale_date > '2019-03-31' or sale_date < '2019-01-01')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 560, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select a.product_id, product_name from sales a left join product b on a.product_id = b.product_id group by a.product_id having min(sale_date)>= '2019-01-01' and max(sale_date)<='2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 561, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct a.product_id, product_name from product a inner join (select product_id from sales where left(sale_date,7) between '2019-01' and '2019-03' and product_id not in (select product_id from sales where left(sale_date,7) not between '2019-01' and '2019-03')) b on a.product_id=b.product_id order by 1"]}
