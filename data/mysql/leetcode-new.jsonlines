{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 326, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select y.name, x.balance from (select account, sum(amount) as balance from transactions group by account) as x inner join (select account, name from users) as y on y.account = x.account where x.balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 327, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with a as( select account, sum(amount) as balance from transactions group by account) select name, balance from users join a on users.account=a.account where balance>10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 328, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with balance as ( select account, sum(amount) as balance from transactions group by account having balance > 10000 ) select a.name, b.balance from users as a inner join balance as b on a.account = b.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 329, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as ( select u.name, sum( t.amount ) balance from users u inner join transactions t on u.account = t.account group by u.account ) select name, balance from cte where balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 330, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as (select name ,t.account , sum(amount)over (partition by account ) as balance from transactions t join users on t.account = users.account ) select name , balance from cte where balance > 10000 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 331, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as (select account, sum(amount) balance from transactions group by account) select u.name name, c.balance balance from cte c, users u where c.account = u.account and c.balance>10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 332, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as( select account, sum(amount) as balance from transactions group by account ) select u.name, c.balance from users u join cte c on u.account = c.account having c.balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 333, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with filtered as ( select sum(amount) total, account from transactions group by account having total > 10000 ) select u.name, f.total as balance from filtered f join users u on f.account = u.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 334, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with step1 as( select a.amount, b.name from transactions a left join users b on a.account=b.account) select name, sum(amount) as balance from step1 group by name having sum(amount) >10000"]}
