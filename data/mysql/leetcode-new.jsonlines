{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 24, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id,b.player_name,sum(gs_cnt) as grand_slams_count from ( select wimbledon as player_id, count(wimbledon) as gs_cnt from championships group by 1 union all select fr_open as player_id, count(fr_open) as gs_cnt from championships group by 1 union all select us_open as player_id, count(us_open) as gs_cnt from championships group by 1 union all select au_open as player_id, count(au_open) as gs_cnt from championships group by 1 ) a inner join players b on a.player_id=b.player_id group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 25, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id,p.player_name,count(a.player_id) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) as a left join players as p on p.player_id = a.player_id group by a.player_id,p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 26, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, b.player_name, c.ct as grand_slams_count from players b inner join ( select id, count(*) as ct from ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) a group by id ) c on b.player_id = c.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 27, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player as player_id, player_name, count(*) as grand_slams_count from (select wimbledon as player from championships union all select fr_open as player from championships union all select us_open as player from championships union all select au_open as player from championships) c join players p on c.player=p.player_id group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 28, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player_id player_id, p.player_name player_name, count(*) grand_slams_count from ( select wimbledon player_id from championships union all select fr_open player_id from championships union all select us_open player_id from championships union all select au_open player_id from championships ) c join players p on c.player_id=p.player_id group by c.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 29, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select d.player_id, p.player_name, sum(d.grand_slams_count) as grand_slams_count from (select c.wimbledon as player_id , count(c.wimbledon) as grand_slams_count from championships c group by c.wimbledon union all select c.fr_open, count(c.fr_open) from championships c group by c.fr_open union all select c.us_open, count(c.us_open) from championships c group by c.us_open union all select c.au_open, count(c.au_open) from championships c group by c.au_open) as d join players p on d.player_id = p.player_id group by d.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 30, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select mat as player_id, player_name, count(*) as grand_slams_count from ( select wimbledon as mat from championships c union all select fr_open as mat from championships c union all select us_open as mat from championships c union all select au_open as mat from championships c )a join players p on a.mat = p.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 31, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id , p.player_name , sum(p.player_id = c.wimbledon) + sum(p.player_id = c.fr_open) + sum(p.player_id = c.us_open)+ sum(p.player_id = c.au_open) grand_slams_count from players p, championships c group by p.player_id, p.player_name having grand_slams_count != 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 32, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id ,p.player_name ,sum( case when p.player_id = c.wimbledon then 1 else 0 end + case when p.player_id = c.fr_open then 1 else 0 end + case when p.player_id = c.us_open then 1 else 0 end + case when p.player_id = c.au_open then 1 else 0 end ) as grand_slams_count from players p inner join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by p.player_id, p.player_name"]}
