{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 317, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "select t.bin, ifnull(t1.total,0) as total from ( select '[0-5>' as bin union select '[5-10>' as bin union select '[10-15>' as bin union select '15 or more' as bin ) as t left join lateral (select case when duration/60 >= 0 and duration/60< 5 then '[0-5>' when round(duration/60,2)>= 5 and duration/60 <10 then '[5-10>' when round(duration/60,2)>= 10 and duration/60 < 15 then '[10-15>' when round(duration/60,2) > 15 then '15 or more' end as bin, count(duration) as total from sessions group by case when duration/60 >= 0 and duration/60< 5 then '[0-5>' when round(duration/60,2)>= 5 and duration/60 <10 then '[5-10>' when round(duration/60,2)>= 10 and duration/60 < 15 then '[10-15>' when round(duration/60,2) > 15 then '15 or more' end ) as t1 on t1.bin = t.bin"]}
{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 318, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "(select '[0-5>' as bin, count(session_id) as total from sessions where duration<300) union (select '[5-10>' as bin, count(session_id) as total from sessions where duration>=300 and duration<600) union (select '[10-15>' as bin, count(session_id) as total from sessions where duration>=600 and duration<900) union (select '15 or more' as bin, count(session_id) as total from sessions where duration>=900)"]}
