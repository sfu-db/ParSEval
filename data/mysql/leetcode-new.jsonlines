{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 760, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as ( select s.*, year(s.sale_date) as year, quarter(sale_date) as quarter, p.product_name from sales s left join product p on s.product_id = p.product_id) , t2 as ( select product_id, product_name from t1 group by 1,2 having count(distinct year) = 1 and count(distinct quarter) = 1) select distinct product_id, product_name from t1 where (product_id, product_name) in (select * from t2) and year = 2019 and quarter = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 761, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id, p.product_name from product p join (select product_id, max(sale_date) mx_sldt, min(sale_date) mn_sldt from sales group by product_id having mx_sldt between '2019-01-01' and '2019-03-31' and mn_sldt between '2019-01-01' and '2019-03-31') a on p.product_id=a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 762, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p where (product_id, product_name) not in ( select p.product_id, p.product_name from sales s join product p on p.product_id = s.product_id where s.sale_date < '2019-01-01' or s.sale_date > '2019-03-31' )"]}
