{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 156, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, max((case when store = 'store1' then price end)) as store1, max(case when store = 'store2' then price end) as store2, max(case when store = 'store3' then price end) as store3 from products group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 157, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select products_table.product_id, store1, store2, store3 from (select product_id from products group by(product_id)) as products_table left join (select product_id , price as store1 from products where store='store1') as a on products_table.product_id=a.product_id left join (select product_id , price as store2 from products where store='store2') as b on products_table.product_id=b.product_id left join (select product_id , price as store3 from products where store='store3') as c on products_table.product_id=c.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 158, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with cte as (select distinct product_id, case when store = 'store1' then price else null end as store1, case when store = 'store2' then price else null end as store2, case when store = 'store3' then price else null end as store3 from products ) select product_id, sum(store1) as store1, sum(store2) as store2, sum(store3) as store3 from cte group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 159, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with t as( select product_id, case when store='store1' then price else null end as store1, case when store='store2' then price else null end as store2, case when store='store3' then price else null end as store3 from products ) select product_id, sum(store1) as store1, sum(store2) as store2, sum(store3) as store3 from t group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 160, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select t.product_id, t1.store1, t2.store2, t3.store3 from (select distinct product_id from products) t left join (select product_id, price as store1 from products where store = 'store1') t1 on t.product_id = t1.product_id left join (select product_id, price as store2 from products where store = 'store2') t2 on t.product_id = t2.product_id left join (select product_id, price as store3 from products where store = 'store3') t3 on t.product_id = t3.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 161, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, max(distinct case when store = 'store1' then price else null end) as store1, max(case when store = 'store2' then price else null end) as store2, max(case when store = 'store3' then price else null end) as store3 from products group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 162, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with cte1 as ( select p1.product_id, p1.price as store1 from products p1 where p1.store = 'store1'), cte2 as ( select p2.product_id, p2.price as store2 from products p2 where p2.store = 'store2'), cte3 as ( select p3.product_id, p3.price as store3 from products p3 where p3.store = 'store3') select distinct p.product_id, cte1.store1, cte2.store2, cte3.store3 from products p left outer join cte1 on p.product_id = cte1.product_id left outer join cte2 on p.product_id = cte2.product_id left outer join cte3 on p.product_id = cte3.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 163, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "with ids as ( select distinct product_id from products ), store1 as (select product_id, price as store1 from products where store = 'store1'), store2 as (select product_id, price as store2 from products where store = 'store2'), store3 as ( select product_id, price as store3 from products where store = 'store3' ) select ids.product_id, store1.store1, store2.store2, store3.store3 from ids left join store1 on ids.product_id = store1.product_id left join store2 on ids.product_id = store2.product_id left join store3 on ids.product_id = store3.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 164, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by product_id order by product_id asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1777.csv", "index": 165, "schema": "create table products (product_id integer not null, store varchar(30) not null, price integer, constraint pk_products primary key (product_id, store), constraint check_products check (price > 0 and store in (\"store1\", \"store2\", \"store3\")));", "pair": ["select product_id, sum(case when store = 'store1' then price else null end) as store1, sum(case when store = 'store2' then price else null end) as store2, sum(case when store = 'store3' then price else null end) as store3 from products group by 1", "select product_id, sum(case when store = 'store1' then price end ) as store1, sum(case when store = 'store2' then price end) as store2, sum(case when store = 'store3' then price end) as store3 from products p group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 0, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select p.player_id, p.player_name, (ifnull(ctw,0) + ifnull(ctf,0) + ifnull(ctu,0) + ifnull(cta,0)) as grand_slams_count from players p left join (select wimbledon as id, count(*) as ctw from championships group by wimbledon) a on p.player_id = a.id left join (select fr_open as id, count(*) as ctf from championships group by fr_open) b on p.player_id = b.id left join (select us_open as id, count(*) as ctu from championships group by us_open) c on p.player_id = c.id left join (select au_open as id, count(*) as cta from championships group by 1) d on p.player_id = d.id) h where grand_slams_count!= 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 1, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, sum( case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end ) as grand_slams_count from players cross join championships group by player_id, player_name ) t where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 2, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, sum(if(player_id = wimbledon, 1, 0) + if(player_id = fr_open, 1, 0) + if(player_id = us_open, 1, 0) + if(player_id = au_open, 1, 0)) as grand_slams_count from championships cross join players group by player_id ) t where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 3, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from ( select player_id, player_name, sum(case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end ) as grand_slams_count from players cross join championships group by player_id ) as z where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 4, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from (select player_id,player_name, (sum(if(wimbledon=player_id,1,0))+sum(if(fr_open=player_id,1,0))+sum(if(us_open=player_id,1,0))+sum(if(au_open=player_id,1,0))) as grand_slams_count from players join championships group by player_id) as temp where grand_slams_count"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 5, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select * from( select player_id, player_name, sum( case when player_id=wimbledon then 1 else 0 end + case when player_id=fr_open then 1 else 0 end + case when player_id=us_open then 1 else 0 end + case when player_id=au_open then 1 else 0 end ) as grand_slams_count from championships cross join players group by player_id) temp where grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 6, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, player_name, sum(player_cnt) as grand_slams_count from ( select wimbledon as player_id, count(wimbledon) as player_cnt from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as player_cnt from championships group by fr_open union all select us_open as player_id, count(us_open) as player_cnt from championships group by us_open union all select au_open as player_id, count(au_open) as player_cnt from championships group by au_open ) a join players b on a.player_id = b.player_id group by a.player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 7, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id , a.player_name , sum(a.player_id=b.wimbledon) + sum(a.player_id=b.fr_open) + sum(a.player_id=b.us_open) + sum(a.player_id=b.au_open) as grand_slams_count from players as a join championships as b on a.player_id=b.wimbledon or a.player_id=b.fr_open or a.player_id=b.us_open or a.player_id=b.au_open group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 8, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id, player_name, count(*) as grand_slams_count from ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) as a inner join players on players.player_id = a.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 9, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player player_id, p.player_name, b.grand_slams_count from (select a.player, count(a.player) grand_slams_count from (select wimbledon player from championships union all select fr_open player from championships union all select us_open player from championships union all select au_open player from championships) a group by a.player) b left join players p on b.player = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 10, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select b.player_id, player_name, grand_slams_count from (select player_id, count(*) as grand_slams_count from (select year, wimbledon as player_id from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships) a group by player_id) b inner join players on b.player_id = players.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 11, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select c.player_id, p.player_name, count(*) as grand_slams_count from (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) c inner join players p on c.player_id=p.player_id group by c.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 12, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select distinct p.player_id, p.player_name, count(case when p.player_id = c.wimbledon then 1 end) + count(case when p.player_id = c.fr_open then 1 end) + count(case when p.player_id = c.us_open then 1 end) + count(case when p.player_id = c.au_open then 1 end) as grand_slams_count from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by player_id , player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 13, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(c.wimbledon = p.player_id)+ sum(c.fr_open = p.player_id)+ sum(c.us_open = p.player_id)+ sum(c.au_open = p.player_id)) as grand_slams_count from players p, championships c group by p.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 14, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, (sum(if(c.wimbledon = p.player_id, 1, 0)) + sum(if(c.fr_open = p.player_id, 1, 0)) + sum(if(c.us_open = p.player_id, 1, 0)) + sum(if(c.au_open = p.player_id, 1, 0))) as grand_slams_count from players p, championships c group by p.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 15, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(*) grand_slams_count from( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) as t join players as p on t.id = p.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 16, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(t.player_id) as grand_slams_count from( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) as t, players as p where p.player_id = t.player_id group by p.player_id, p.player_name"]}
