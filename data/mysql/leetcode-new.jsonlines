{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 708, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id,p.product_name from product p inner join sales s on s.product_id=p.product_id group by s.product_id having min(sale_date)>= '2019-01-01'and max(sale_date)<='2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 709, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, product_name from product p inner join ( select a.product_id from ( select distinct product_id from sales where sale_date >= '2019-01-01' and sale_date<= '2019-03-31' ) a left outer join ( select distinct product_id from sales where sale_date < '2019-01-01' or sale_date > '2019-03-31' ) b on a.product_id = b.product_id where b.product_id is null ) s on p.product_id = s.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 710, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product where product_id in( select product_id from sales group by product_id having count(case when sale_date between '2019-01-01' and '2019-03-31' then product_id end) = count(1) )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 711, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte1 as (select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31'), cte2 as (select distinct product_id from sales where sale_date<'2019-01-01' or sale_date>'2019-03-31') select cte1.product_id, product_name from cte1 join product p on p.product_id=cte1.product_id left join cte2 on cte2.product_id=cte1.product_id where cte2.product_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 712, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct s.product_id , product_name from sales s left join product p using(product_id) where product_id not in (select product_id from sales where sale_date < '2019-01-01' or sale_date >'2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 713, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p, sales s where p.product_id = s.product_id and (p.product_id,p.product_name) not in (select distinct p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date not between '2019-01-01' and '2019-03-31') group by p.product_id order by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 714, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s.product_id, p.product_name from sales s left join product p on s.product_id = p.product_id group by 1 having min(s.sale_date) >= '2019-01-01' and max(s.sale_date) <= '2019-03-31'"]}
