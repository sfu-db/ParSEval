{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 27, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id , sum(case when t.visit_id is null then 1 else 0 end) as count_no_trans from visits v left join transactions t on v.visit_id = t.visit_id group by customer_id having count_no_trans > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 28, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id ,sum(case when ct_trans=0 then 1 else 0 end) as count_no_trans from (select v.visit_id ,v.customer_id ,count(t.transaction_id) as ct_trans from visits v left join transactions t on v.visit_id = t.visit_id group by 1,2) a group by 1 having count_no_trans > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 29, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id ,sum(case when transaction_ct=0 then 1 else 0 end) as count_no_trans from (select v.customer_id ,v.visit_id ,count(t.transaction_id) as transaction_ct from visits v left join transactions t on v.visit_id = t.visit_id group by 1,2) a group by 1 having count_no_trans > 0"]}
