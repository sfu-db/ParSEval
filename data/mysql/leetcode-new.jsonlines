{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 255, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating / position), 2) as quality, round(count(case when rating < 3 then 1 else null end) / count(*) * 100, 2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 256, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(sum(rating/position)/count(*),2) quality, round(avg(if(rating<3,1,0))*100,2) poor_query_percentage from queries group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 257, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with cte as (select *, rating/position as qual, case when rating < 3 then 1 else 0 end as poor from queries) select query_name, round(avg(qual),2) as quality, round(100*sum(poor)/count(*), 2) as poor_query_percentage from cte group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 258, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select distinct sub.query_name, round(avg(sub.quality),2) as quality, round((count(sub.bad)/(count(sub.quality)))*100,2) as poor_query_percentage from (select query_name, rating/position as quality, case when rating < 3 then 1 else null end as bad from queries) sub group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 259, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select distinct query_name, round((sum(rating/position) / count(rating)),2) as quality, round(sum(case when rating<3 then 1 else 0 end)*100/ count(query_name),2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 260, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select distinct query_name, round(avg(rating/position),2) as quality, round(sum(case when rating<3 then 1 else 0 end)/count(*)*100,2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 261, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name , cast( avg( rating /position ) as decimal(5, 2) ) as quality , cast( sum(case when rating < 3 then 1 else 0 end ) / count(*) as decimal(10, 4) ) * 100 as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 262, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality,round(sum(rating <3)*100/count(query_name),2) as poor_query_percentage from queries group by query_name"]}
