{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 148, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, store, price from ( select product_id, 'store1' as store, store1 as price from products union all select product_id, 'store2', store2 from products union all select product_id, 'store3', store3 from products ) as temp where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 149, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select p1.product_id, p2.store, p2.price from products p1 left join (select store1 as store, store1 as price, product_id from products where store1 is not null union select store2 as store, store2 as price, product_id from products where store2 is not null union select store3 as store, store3 as price, product_id from products where store3 is not null) p2 on p1.product_id = p2.product_id"]}
