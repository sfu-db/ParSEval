{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 392, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with log_info as ( select account_id, ip_address, login, logout, (lead(login, 1) over (partition by account_id order by login) <= logout) and (lead(ip_address, 1) over (partition by account_id order by login) != ip_address) as violation from loginfo ) select distinct account_id from log_info where violation = true"]}
