{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 534, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select followee as follower, count(follower) as num from follow where followee in ( select followee from follow where followee in (select follower from follow)) group by followee order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 535, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select distinct lvl2 as follower, count(distinct lvl3) as num from ( select f1.followee as lvl1, f2.followee as lvl2, f2.follower as lvl3 from follow f1 left join follow f2 on f1.follower = f2.followee union select f1.followee as lvl1, f2.followee as lvl2, f2.follower as lvl3 from follow f1 right join follow f2 on f1.follower = f2.followee ) tab where lvl1 is not null and lvl2 is not null group by 1 having count(distinct lvl3) >=1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 536, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select followee as follower , count(*) as num from follow where followee in ( select a.followee from( select distinct followee from follow) a join( select distinct follower from follow) b on a.followee = b.follower) group by followee order by followee"]}
