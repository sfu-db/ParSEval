{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 427, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with quality_results as (select query_name,round(avg(rating/position),2) as quality from queries group by query_name), poor_query_perc as (select query_name,round((sum(case when rating < 3 then 1 else 0 end)/count(rating))*100,2) as poor_query_percentage from queries group by query_name) select r.query_name,quality,poor_query_percentage from quality_results r, poor_query_perc p where r.query_name=p.query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 428, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with cte as( select distinct query_name, result, position, rating from queries) select query_name, round(avg(rating/position),2) as quality, round(sum(case when rating<3 then 1 else 0 end)/count(*)*100,2) as poor_query_percentage from cte group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 429, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select s1.query_name,s1.quality,s2.poor_query_percentage from (select a.query_name,round((a.sum1/b.cnt),2) as quality from (select query_name, sum(rating/position) as sum1 from queries group by 1)a inner join (select query_name ,count(query_name) as cnt from queries group by 1)b on a.query_name=b.query_name) s1 inner join (select a.query_name, round(((coalesce(b.cnt1,0)/a.cnt)*100),2) as poor_query_percentage from (select query_name, count(query_name) as cnt from queries group by 1) a left join (select query_name, count(query_name) as cnt1 from queries where rating < 3 group by 1) b on a.query_name=b.query_name) s2 on s1.query_name=s2.query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 430, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality, round(avg((rating < 3) * 100), 2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 0, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round(sum(units * price) / sum(units), 2) as average_price from prices a inner join unitssold b on a.product_id=b.product_id and b.purchase_date between a.start_date and a.end_date group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 1, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round(sum(a.price * b.units) / sum(b.units), 2 ) as average_price from prices as a left join unitssold as b on a.product_id = b.product_id where b.purchase_date >= a.start_date and b.purchase_date <= a.end_date group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 2, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select a.product_id, round(sum(a.price * b.units) / sum(b.units), 2 ) as average_price from prices as a left join unitssold as b on a.product_id = b.product_id where b.purchase_date between a.start_date and a.end_date group by a.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 3, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select b.product_id, round(sum(b.units*a.price)/sum(b.units), 2) as average_price from unitssold b left join prices a on a.product_id = b.product_id and a.start_date <= b.purchase_date and b.purchase_date <= a.end_date group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 4, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select distinct p.product_id, round((sum(p.price * us.units) / sum(us.units)), 2) average_price from prices p join unitssold us on p.product_id = us.product_id and us.purchase_date between p.start_date and p.end_date group by p.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1251.csv", "index": 5, "schema": "create table prices (product_id integer not null, start_date date not null, end_date date not null, price integer, constraint pk_prices primary key (product_id, start_date, end_date), constraint check_prices check (start_date <= end_date and price > 0)); create table unitssold (product_id integer, purchase_date date, units integer, foreign key (product_id) references prices (product_id), constraint check_unitssold check (units > 0));", "pair": ["select a.product_id, round((sum((units * price)) / sum(units)), 2) as average_price from prices as a join unitssold as b on (a.product_id = b.product_id and b.purchase_date between a.start_date and a.end_date) group by a.product_id", "select distinct p.product_id, round(sum(price*units)/sum(units),2) average_price from prices p join unitssold u on p.product_id = u.product_id and purchase_date between start_date and end_date group by 1"]}
