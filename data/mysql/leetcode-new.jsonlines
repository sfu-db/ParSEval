{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 118, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ((select wimbledon player_id from championships) union all (select fr_open player_id from championships) union all (select us_open player_id from championships) union all (select au_open player_id from championships)) select c.player_id, player_name, count(c.player_id) grand_slams_count from cte c left join players p on c.player_id = p.player_id group by c.player_id order by grand_slams_count desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 119, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select year, wimbledon as player_id from championships union all select year, fr_open from championships union all select year, us_open from championships union all select year, au_open from championships ) select c.player_id, p.player_name, count(c.player_id) as grand_slams_count from cte c left join players p using(player_id) group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 120, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte1 as ( select wimbledon as grand_slam_winner from championships union all select fr_open as grand_slam_winner from championships union all select us_open as grand_slam_winner from championships union all select au_open as grand_slam_winner from championships ) select player_id, player_name, count(grand_slam_winner) as grand_slams_count from players p join cte1 on p.player_id = cte1.grand_slam_winner group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 121, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with championshipsdetails as (select year,wimbledon as player_id from championships union all select year,fr_open as player_id from championships union all select year,us_open as player_id from championships union all select year,au_open as player_id from championships), championshipssummary as (select player_id ,count(year) as grand_slams_count from championshipsdetails group by player_id) select p.player_id ,p.player_name ,cs.grand_slams_count from players p inner join championshipssummary cs on cs.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 122, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with championships_transposed as( select year, wimbledon as player_id, 'wimbledon' as tournament from championships union select year, fr_open as player_id, 'french open' as tournament from championships union select year, us_open as player_id, 'us open' as tournament from championships union select year, au_open as player_id, 'australian open' as tournament from championships ) select p.player_id , p.player_name , count(tournament) grand_slams_count from championships_transposed c left join players p on p.player_id = c.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 123, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( (select year , wimbledon as game from championships) union all (select year , fr_open as game from championships) union all (select year , us_open as game from championships) union all (select year , au_open as game from championships) ), t2 as ( select game, count(*) as grand_slams_count from t1 group by game) select t2.game as player_id, p.player_name, t2.grand_slams_count from t2 left join players p on t2.game = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 124, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as ( select wimbledon as player_id from championships union all select fr_open as tournaments from championships union all select us_open as tournaments from championships union all select au_open as tournaments from championships ) select t1.player_id, player_name, count(*) grand_slams_count from players join t1 using(player_id) group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 125, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with t1 as (select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships), t2 as (select *, winner as player_id from t1) select a.player_id, b. player_name, count(a.winner) as grand_slams_count from t2 a inner join players b on a.player_id = b.player_id group by a.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 126, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as (select wimbledon tournament from championships union all select fr_open tournament from championships union all select us_open tournament from championships union all select au_open tournament from championships) select temp.tournament as player_id, player_name, count(*) as grand_slams_count from temp join players on temp.tournament = players.player_id group by tournament"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 127, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tst as( select id, sum(grand_slams_count) as grand_slams_count from ( select wimbledon as id, count(*) as grand_slams_count from championships group by wimbledon union all select fr_open as id, count(*) as grand_slams_count from championships group by fr_open union all select us_open as id, count(*) as grand_slams_count from championships group by us_open union all select au_open as id, count(*) as grand_slams_count from championships group by au_open) as t1 group by id ) select player_id, player_name, grand_slams_count from tst left join players on id=player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 128, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with titles as ( select wimbledon as champion from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select player_id, player_name, count(1) as grand_slams_count from players as p right join titles as t on p.player_id = t.champion group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 129, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as( select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select w.player_id,p.player_name, count(*) as grand_slams_count from wins w inner join players p on p.player_id=w.player_id group by w.player_id,p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 130, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with winners as ( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships ) select p.player_id, p.player_name, count(w.winner) as grand_slams_count from winners w left join players p on w.winner = p.player_id group by w.winner"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 131, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with allwins as ( select wimbledon as wins from championships union all select fr_open as wins from championships union all select us_open as wins from championships union all select au_open as wins from championships ) select p.player_id, p.player_name, count(a.wins) as grand_slams_count from players p cross join allwins a where p.player_id = a.wins group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 132, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as (select wimbledon as id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships), summary as (select id, count(*) as grand_slams_count from c group by id) select p.player_id, p.player_name, s.grand_slams_count from players p join summary s on p.player_id = s.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 133, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c1 as (select p.* ,c.wimbledon ,c.fr_open ,c.us_open ,c.au_open from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open) select player_id ,player_name ,sum(if(player_id = wimbledon,1,0) + if(player_id = fr_open,1,0) + if(player_id = us_open,1,0) + if(player_id = au_open,1,0)) as grand_slams_count from c1 group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 134, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champ_long as ( select year, 'wimbledon' as game, wimbledon as champ_id from championships union select year, 'fr_open' as game, fr_open as champ_id from championships union select year, 'us_open' as game, us_open as champ_id from championships union select year, 'au_open' as game, au_open as champ_id from championships ) select p.player_id, p.player_name, count(*) as grand_slams_count from players as p join champ_long as cl on cl.champ_id = p.player_id group by p.player_id, p.player_name having grand_slams_count >= 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 135, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with core as ( select player_id, player_name from players t1 inner join championships t2 on t1.player_id = t2.wimbledon union all select player_id, player_name from players t1 inner join championships t2 on t1.player_id = t2.fr_open union all select player_id, player_name from players t1 inner join championships t2 on t1.player_id = t2.us_open union all select player_id, player_name from players t1 inner join championships t2 on t1.player_id = t2.au_open ) select player_id, player_name, count(*) as grand_slams_count from core group by player_id, player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 136, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select wimbledon as id, count(*) as games from championships group by wimbledon union all select fr_open as id, count(*) as games from championships group by fr_open union all select us_open as id, count(*) as games from championships group by us_open union all select au_open as id, count(*) as games from championships group by au_open) select p.player_id, p.player_name, sum(c.games) as grand_slams_count from players as p join cte as c on p.player_id = c.id group by p.player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 137, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) select player_id, player_name, count(*) as grand_slams_count from cte join players using(player_id) group by player_id"]}
