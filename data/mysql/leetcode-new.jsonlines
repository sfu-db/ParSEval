{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 370, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with t as (select product_id, sum(rest) as rest_sum, sum(paid) as paid_sum, sum(canceled) as canceld_sum, sum(refunded) as refunded_sum from invoice group by product_id) select product.name, coalesce (t.rest_sum,0) as rest, coalesce (t.paid_sum,0) as paid, coalesce (t.canceld_sum,0) as canceled, coalesce (t.refunded_sum,0) as refunded from product left outer join t on product.product_id = t.product_id order by name"]}
