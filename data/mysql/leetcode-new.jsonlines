{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 575, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(distinct e2.employee_id) as reports_count, round(avg(e2.age)) as average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by e1.employee_id order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 576, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id,name,reports_count,average_age from employees e join (select reports_to,count(reports_to) reports_count,round(avg(age)) average_age from employees where reports_to is not null group by 1)es on (e.employee_id=es.reports_to) order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 577, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id,e1.name,count(e2.reports_to) reports_count,round(avg(e2.age)) average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 578, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id, m.name, count(e.employee_id) as reports_count, round(avg(e.age),0) as average_age from employees m inner join employees e on e.reports_to = m.employee_id group by 1,2 order by m.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 579, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id, name, reports_count, average_age from employees e join (select reports_to, count(*) reports_count, round(avg(age), 0) as average_age from employees group by 1) r on e.employee_id = r.reports_to order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 580, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id,e1.name,count(e2.name) as reports_count,round(avg(e2.age)) as average_age from employees e1 join employees e2 on e1.employee_id=e2.reports_to group by employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 581, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with manager as ( select employee_id, name, age from employees where employee_id in ( select reports_to from employees ) ) select distinct m.employee_id, m.name, count(*) over (partition by m.employee_id) as reports_count, round(avg(e.age) over (partition by m.employee_id), 0) as average_age from employees e inner join manager m on m.employee_id = e.reports_to order by m.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 582, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to as employee_id , e2.name, count(*) as reports_count, round(avg(e1.age),0) as average_age from employees e1 left join employees e2 on e1.reports_to =e2.employee_id where e1.reports_to is not null group by e1.reports_to order by e2.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 583, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id, b.name, count(a.employee_id) as reports_count, round(avg(a.age), 0) as average_age from employees a join employees b on a.reports_to = b.employee_id group by a.reports_to order by a.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 584, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(*) as reports_count, round(avg(e1.age)) as average_age from employees e1 inner join employees e2 on e1.reports_to = e2.employee_id group by e1.reports_to order by e2.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 585, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with temp as ( select e1.employee_id, e1.reports_to, e1.age, e2.name from employees as e1 join employees as e2 on e1.reports_to = e2.employee_id ) select reports_to as employee_id, name, count(*) as reports_count, round(avg(age),0) as average_age from temp group by reports_to order by reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 586, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to as employee_id, e2.name as name, count(e1.name) as reports_count, round(avg(e1.age),0) as average_age from employees as e1 join employees as e2 on e1.reports_to = e2.employee_id group by e1.reports_to order by e1.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 587, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id as employee_id,b.name as name, count(a.employee_id) as reports_count,round(avg(a.age)) as average_age from employees a join employees b on a.reports_to = b.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 588, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select t2.employee_id, t2.name, round(count(t1.employee_id)) as reports_count, round(avg(t1.age)) as average_age from employees t1 left join employees t2 on t1.reports_to = t2.employee_id where t2.employee_id is not null group by t2.employee_id, t2.name order by t2.employee_id"]}
