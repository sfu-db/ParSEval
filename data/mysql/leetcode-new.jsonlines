{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 542, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = '>' then if(t.l_value > t.r_value, 'true','false') when operator = '<' then if (t.l_value < t.r_value, 'true','false') when operator = '=' then if (t.l_value = t.r_value, 'true','false') end) as value from (select left_operand, v1.value as l_value, operator, right_operand, v2.value as r_value from expressions e left join variables v1 on v1.name = e.left_operand left join variables v2 on v2.name = e.right_operand)t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 543, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand , e.operator , e.right_operand , case when e.operator = '>' and t1.value > t2.value then true when e.operator = '=' and t1.value = t2.value then true when e.operator = '<' and t1.value < t2.value then true else false end as value from expressions e left join variables t1 on e.left_operand = t1.name left join variables t2 on e.right_operand = t2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 544, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case operator when '>' then case when vl.value > vr.value then true else false end when '<' then case when vl.value < vr.value then true else false end when '=' then case when vl.value = vr.value then true else false end end ) as value from expressions e,variables vl , variables vr where e.left_operand = vl.name and e.right_operand = vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 545, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when (v1.value > v2.value) and (e.operator = '>') then true when (v1.value < v2.value) and (e.operator = '<') then true when (v1.value = v2.value) and (e.operator = '=') then true else false end as value from expressions e left join variables v1 on e.left_operand = v1.name left join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 546, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with var_expanded as ( select a.name as left_operand, '>' as operator, b.name as right_operand, case when a.value > b.value then true else false end as evaluated_value from variables a join variables b union select a.name as left_operand, '<' as operator, b.name as right_operand, case when a.value < b.value then true else false end as evaluated_value from variables a join variables b union select a.name as left_operand, '=' as operator, b.name as right_operand, case when a.value = b.value then true else false end as evaluated_value from variables a join variables b ) select e.*, v.evaluated_value as value from expressions e join var_expanded v on e.left_operand = v.left_operand and e.operator = v.operator and e.right_operand = v.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 547, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, if( case when operator = '=' then l.value = r.value when operator = '>' then l.value > r.value else l.value < r.value end, 'true', 'false') as value from expressions e left join variables l on e.left_operand = l.name left join variables r on e.right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 548, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand,operator,right_operand, case when operator='>' then if(left_value>right_value,'true','false') when operator='=' then if(left_value=right_value,'true','false') when operator='<' then if(left_value<right_value,'true','false') end as value from (select left_operand,operator,right_operand,v1.value as left_value,v2.value as right_value from expressions join variables v1 on expressions.left_operand = v1.name join variables v2 on expressions.right_operand = v2.name) as tmp"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 549, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '<' and lv.value < rv.value then true when operator = '>' and lv.value > rv.value then true when operator = '=' and lv.value = rv.value then true else false end as value from expressions join variables lv on left_operand = lv.name join variables rv on right_operand = rv.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 550, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select t2.left_operand, t2.operator ,t2.right_operand, case when operator = '=' and valuediff = 0 then true when operator = '>' and valuediff > 0 then true when operator = '<' and valuediff < 0 then true else false end as value from (select t.*, c.value as right_value, left_value-c.value as valuediff from (select a.left_operand,b.value as left_value, a.operator,a.right_operand from expressions a inner join variables b on a.left_operand = b.name ) t inner join variables c on t.right_operand = c.name) t2"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 551, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when a.operator = '>' and b.value > c.value then true when a.operator = '<' and b.value < c.value then true when a.operator = '=' and b.value = c.value then true else false end as value from expressions a join variables b on a.left_operand = b.name join variables c on c.name = a.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 552, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as (select e.*, v.value l, v2.value r from expressions e join variables v on e.left_operand = v.name join variables v2 on e.right_operand=v2.name) select left_operand, operator, right_operand, (case when l<r and operator='<' then true when l=r and operator='=' then true when l>r and operator='>' then true else false end) value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 553, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.* , case when e.operator = '>' and v1.value > v2.value then true when e.operator = '=' and v1.value = v2.value then true when e.operator = '<' and v1.value < v2.value then true else false end as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 554, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with temp as(select e.left_operand,v1.value as lv ,e.operator,e.right_operand,v2.value as rv from expressions e left outer join variables v1 on e.left_operand = v1.name left outer join variables v2 on e.right_operand=v2.name) select left_operand, operator, right_operand, case when operator = '>' and lv>rv then true when operator = '<' and lv<rv then true when operator = '=' and lv=rv then true else false end as value from temp"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 555, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.* , (case when e.operator = '>' and v1.value > v2.value then true when e.operator = '=' and v1.value = v2.value then true when e.operator = '<' and v1.value < v2.value then true else false end ) as value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 556, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' then if(v1.value > v2.value, 'true', 'false') when operator = '=' then if(v1.value = v2.value, 'true', 'false') else if(v1.value < v2.value, 'true', 'false') end as value from expressions join variables v1 on v1.name = left_operand join variables v2 on v2.name = right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 557, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '=' then if(v.value = v1.value, 'true', 'false') when e.operator = '>' then if(v.value > v1.value, 'true', 'false') when e.operator = '<' then if(v.value < v1.value, 'true', 'false') end value from expressions e left join variables v on v.name = e.left_operand left join variables v1 on v1.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 558, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' then if(l.value > r.value, 'true', 'false') when operator = '<' then if(l.value < r.value, 'true', 'false') else if(l.value = r.value, 'true', 'false') end value from expressions inner join variables l on left_operand = l.name inner join variables r on right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 559, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '=' then if(v1.value = v2.value, 'true', 'false') when operator = '<' then if(v1.value < v2.value, 'true', 'false') when operator = '>' then if(v1.value > v2.value, 'true', 'false') end as value from expressions join variables v1 on left_operand = v1.name join variables v2 on right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 560, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select g.left_operand, g.operator, g.right_operand, case when g.operator = '=' then if(g.left_value = g.right_value, 'true', 'false') when g.operator = '>' then if(g.left_value > g.right_value, 'true', 'false') when g.operator = '<' then if(g.left_value < g.right_value, 'true', 'false') end as value from ( select e.*, v.value as left_value, v2.value as right_value from expressions as e join variables as v on e.left_operand = v.name join variables as v2 on e.right_operand = v2.name ) as g"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 561, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with tmp as ( select e.left_operand, v1.value as left_value, e.operator, e.right_operand, v2.value as right_value from expressions as e left join variables as v1 on e.left_operand = v1.name left join variables as v2 on e.right_operand = v2.name ) select t.left_operand, t.operator, t.right_operand, ( case when t.operator = '<' and t.left_value < t.right_value then true when t.operator = '=' and t.left_value = t.right_value then true when t.operator = '>' and t.left_value > t.right_value then true else false end ) as value from tmp as t"]}
