{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 398, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select distinct followee as follower, count(*) as num from follow where followee in (select distinct follower from follow) group by followee order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 399, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with a as (select followee,count(*) as follower_num from follow group by followee) select distinct f.followee as follower,follower_num as num from follow f inner join a on f.followee=a.followee where follower_num>=1 and f.followee in (select follower from follow) order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 400, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select distinct follower, follow_num as num from follow f join (select followee, count(follower) as follow_num from follow group by followee) t on f.follower = t.followee order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 401, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with follower_count as (select follower as user_name, count(followee) as followers from follow group by 1), following as (select followee as user_name, count(follower) as following from follow group by 1) select distinct f1.user_name as follower, f2.following as num from follower_count f1 join following f2 on f1.user_name = f2.user_name order by f1.user_name asc"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 402, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as (select followee as name from follow union select follower as name from follow) select cte.name as follower, sum(case when a.followee = cte.name then 1 else 0 end) as num from cte join follow a on cte.name = a.followee where cte.name in (select follower from follow group by 1) group by 1 order by 1"]}
