{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 493, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(e1.employee_id) as reports_count, round(sum(e1.age)/count(*),0) as average_age from employees e1, employees e2 where e1.reports_to = e2.employee_id group by 1 order by 1"]}
