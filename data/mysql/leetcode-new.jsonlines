{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 754, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, sum(amount) as balance from users right join transactions on users.account=transactions.account group by transactions.account having balance >=10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 755, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, a.balance from users join (select account, sum(amount) as balance from transactions group by account) as a using (account) where a.balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 756, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name as name, sum(amount) as balance from transactions t join users u on t.account = u.account group by 1 having balance >10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 757, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name, sum(amount) as balance from users as u join transactions as t on u.account = t.account group by 1 having sum(amount)>10000 order by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 758, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name, sum(t.amount) as balance from users as u left join transactions as t on (u.account = t.account) group by t.account having sum(t.amount) > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 759, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select u.name as name, sum(t.amount) as balance from users u inner join transactions t on u.account = t.account group by u.account, u.name having balance >= 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 760, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, balance from (select a.name, sum(b.amount) as balance from users a right join transactions b using(account) group by name ) t where balance > 10000"]}
