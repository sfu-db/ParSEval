{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 497, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select t1.product_id, t1.product_name from product t1 inner join (select product_id, max(sale_date) d1, min(sale_date) d2 from sales group by 1 ) t2 on t1.product_id = t2.product_id where t2.d2 >= '2019-01-01' and t2.d1 <= '2019-03-31'"]}
