{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 348, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "select activity_date as day , count(distinct user_id) as active_users from activity where activity_date between date_add('2019-07-27', interval -29 day) and '2019-07-27' or activity_date >= '2019-07-27' group by activity_date"]}
{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 349, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "select x.day, count(distinct x.user_id) as active_users from (select distinct activity_date as day, user_id from activity where datediff('2019-07-27', activity_date) < 30) x group by(day)"]}
