{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 656, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id ,e1.name, count(e2.employee_id) as reports_count , round(avg(e2.age)) as average_age from employees e1 inner join employees e2 on e1.employee_id=e2.reports_to group by e1.name, e1.employee_id order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 657, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, b.reports_count, round(b.average_age) as average_age from employees a inner join (select reports_to, count(distinct employee_id) as reports_count, avg(age) as average_age from employees where reports_to is not null group by reports_to) b on a.employee_id = b.reports_to order by a.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 658, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with a as (select reports_to, count(employee_id) as reports_count, round(avg(age)) as average_age from employees group by reports_to) select e.employee_id, e.name, a.reports_count, a.average_age from employees as e inner join a on e.employee_id = a.reports_to order by e.employee_id"]}
