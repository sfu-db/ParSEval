{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 586, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct product_id, product_name from ( select s.product_id, p.product_name from sales as s join product as p on s.product_id = p.product_id ) x where product_id not in ( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 587, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product join sales using(product_id) group by product_id having max(quarter(sale_date)) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 588, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with non_spring as ( select p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date < date('2019-01-01') or s.sale_date > date('2019-03-31') ) select distinct p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where (s.sale_date between date('2019-01-01') and date('2019-03-31')) and p.product_id not in (select product_id from non_spring)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 589, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from sales join product using (product_id) group by product_id having max(sale_date)<='2019-03-31' and min(sale_date)>='2019-01-01'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 590, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from( select s.product_id, p.product_name,sum(if(s.sale_date not between '2019-01-01' and '2019-03-31', 1, 0)) as cnt from sales s join product p using(product_id) group by s.product_id) sold_times_out_of_range where cnt = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 591, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id, p.product_name from sales s, product p where s.product_id = p.product_id and p.product_id in (select product_id from sales where sale_date between '2019-01-01' and '2019-03-31') and p.product_id not in (select product_id from sales where sale_date < '2019-01-01' or sale_date > '2019-03-31') order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 592, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product_name from product left join sales on product.product_id = sales.product_id group by product_id having sum(sale_date >= '2019-01-01' and sale_date <= '2019-03-31') > 0 and sum(sale_date < '2019-01-01' or sale_date > '2019-03-31') = 0"]}
