{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 136, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "select temp.bin, count(x.session_id) as total from (select '[0-5>' as bin union all select '[5-10>' as bin union all select '[10-15>' as bin union all select '15 or more' as bin) as temp left join (select session_id, duration, case when duration/60 < 5 then '[0-5>' when (5 <= duration/60 and duration/60 < 10) then '[5-10>' when (10 <= duration/60 and duration/60 < 15) then '[10-15>' else '15 or more' end as bin from sessions) as x on temp.bin = x.bin group by temp.bin"]}
