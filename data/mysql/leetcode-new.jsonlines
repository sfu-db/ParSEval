{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 16, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance a where (select count(*) from insurance b where a.tiv_2015 = b.tiv_2015) >1 and (select count(*) from insurance c where (a.lat,a.lon) = (c.lat,c.lon)) =1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 17, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance i1 where exists (select * from insurance i2 where i1.pid <> i2.pid and i1.tiv_2015 = i2.tiv_2015) and not exists (select * from insurance i3 where i1.pid <> i3.pid and i1.lat = i3.lat and i1.lon = i3.lon)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 18, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by 1 having count(*)>1) and concat(lat,lon) in (select concat(lat,lon) from insurance group by 1 having count(*)=1)"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 19, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance where pid in (select distinct(a.pid) from insurance a join insurance b on a.pid <> b.pid where (a.tiv_2015) = (b.tiv_2015) and a.pid not in ( select distinct(a.pid) from insurance a join insurance b on a.pid <> b.pid where (a.lat, a.lon) = (b.lat, b.lon) ) )"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 20, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from insurance where (lat, lon) not in ( select lat, lon from insurance group by lat, lon having count(*) > 1 ) and tiv_2015 in ( select tiv_2015 from insurance group by tiv_2015 having count(*) > 1 )"]}
