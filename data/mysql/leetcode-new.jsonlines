{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 567, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with t as (select distinct p.session_id from playback p inner join ads a on p.customer_id = a.customer_id and a.timestamp >=p.start_time and a.timestamp <= p.end_time) select session_id from playback where session_id not in (select session_id from t)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 568, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select p.session_id from playback as p where p.session_id not in ( select p1.session_id from ads as a1 inner join playback as p1 on a1.customer_id = p1.customer_id where a1.timestamp between p1.start_time and p1.end_time )"]}
