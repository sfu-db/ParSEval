{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 478, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select b.employee_id, b.name, count(*) reports_count, round(avg(a.age)) average_age from employees a join employees b on a.reports_to = b.employee_id group by 1 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 479, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(1) as reports_count, round(avg(e2.age), 0) as average_age from employees e1, employees e2 where e2.reports_to= e1.employee_id group by e1.employee_id, e1.name order by e1.employee_id"]}
