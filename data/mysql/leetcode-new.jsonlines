{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 571, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, ( sum(c.wimbledon = p.player_id) + sum(c.fr_open = p.player_id) + sum(c.us_open = p.player_id) + sum(c.au_open = p.player_id)) as grand_slams_count from players p join championships c on (c.wimbledon = p.player_id or c.fr_open = p.player_id or c.us_open = p.player_id or c.au_open = p.player_id) group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 572, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with pc as( select p.player_id, p.player_name, (if(p.player_id = c.wimbledon, 1, 0) + if(p.player_id = c.fr_open, 1, 0) + if(p.player_id = c.us_open, 1, 0) + if(p.player_id = c.au_open, 1, 0)) as gsw from players p, championships c ) select player_id, player_name, sum(gsw) as grand_slams_count from pc group by player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 573, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select g.player_id, p.player_name , count(g.player_id) as grand_slams_count from(select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) as g join players p on p.player_id = g.player_id group by g.player_id, p.player_name"]}
