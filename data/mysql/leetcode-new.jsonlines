{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 316, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with ads_session as( select distinct session_id from playback p, ads a where p.customer_id = a.customer_id and timestamp between start_time and end_time ) select session_id from playback where session_id not in (select session_id from ads_session)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 317, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with ads_session_id as ( select distinct session_id from (select session_id, start_time, end_time, timestamp from playback t1 join ads t2 on t1.customer_id = t2.customer_id) t where timestamp between start_time and end_time ) select session_id from playback where session_id not in (select session_id from ads_session_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 318, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select p.session_id from playback p join ads a on p.customer_id= a.customer_id and a.timestamp between start_time and end_time) select session_id from playback where session_id not in (select session_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 319, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select p.session_id as session_id from playback p left join ads a on p.customer_id=a.customer_id where a.timestamp between p.start_time and p.end_time) select session_id from playback where session_id not in (select *from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 320, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select distinct session_id from playback as p join ads as a on p.customer_id=a.customer_id and a.timestamp>=p.start_time and a.timestamp<=p.end_time ) select p.session_id from playback as p left join cte on p.session_id=cte.session_id where cte.session_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 321, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select distinct session_id from playback p, ads a where p.customer_id = a.customer_id and a.timestamp between p.start_time and p.end_time ) select session_id from playback where session_id not in (select session_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 322, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as (select a.*, b.ad_id, b.timestamp from playback a inner join ads b on a.customer_id = b.customer_id and a.start_time <= b.timestamp and a.end_time >= b.timestamp) select session_id from playback where session_id not in (select session_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 323, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as( select p.session_id from playback p join ads a on p.customer_id=a.customer_id where p.start_time<=a.timestamp and p.end_time>=a.timestamp ) select session_id from playback where session_id not in (select * from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 324, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with data as ( select pb.session_id, pb.customer_id, pb.start_time, pb.end_time, ad.ad_id, ad.timestamp, ad.timestamp >= pb.start_time and ad.timestamp <= pb.end_time as shown from playback pb inner join ads ad on pb.customer_id = ad.customer_id) select session_id from playback where session_id not in (select distinct(session_id) from data where shown = 1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 325, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with sessions as ( select a.*, b.ad_id, b.timestamp from playback as a left join ads as b on a.customer_id = b.customer_id and b.timestamp >= a.start_time and b.timestamp <= a.end_time ) select session_id from sessions where ad_id is null order by session_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 326, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with sessions_with_ads as (select a.session_id from playback a left join ads b on a.customer_id = b.customer_id where b.timestamp >= a.start_time and b.timestamp <= a.end_time ) select distinct session_id from playback where session_id not in ( select distinct session_id from sessions_with_ads)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 327, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with t1 as ( select a.*, b.ad_id from playback a left join ads b on b.timestamp between a.start_time and a.end_time and a.customer_id = b.customer_id ) select distinct session_id from t1 where ad_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 328, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with t1 as (select p.session_id, p.start_time, p.end_time, a.timestamp timee from playback p left join ads a on p.customer_id=a.customer_id and a.timestamp between p.start_time and p.end_time) select t1.session_id from t1 where timee is null"]}
