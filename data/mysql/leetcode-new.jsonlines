{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 183, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "with cte as ( select user1_friend from (select distinct case when user1_id = 1 then user2_id when user2_id = 1 then user1_id end as user1_friend from friendship ) a where user1_friend is not null ) select distinct page_id as recommended_page from likes where user_id in (select * from cte) and page_id not in (select page_id from likes where user_id = 1)"]}
