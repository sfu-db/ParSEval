{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 568, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator='>' then if(vl.value>vr.value, 'true','false') when operator='<' then if(vl.value<vr.value, 'true','false') when operator='=' then if(vl.value=vr.value, 'true','false') end as value from expressions e join variables vl on e.left_operand=vl.name join variables vr on e.right_operand=vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 569, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as ( select left_operand, t2.value as left_value, operator, right_operand, t3.value as right_value from expressions t1 left join variables t2 on t1.left_operand = t2.name left join variables t3 on t1.right_operand = t3.name ) select left_operand, operator, right_operand, case when operator = '>' and left_value > right_value then true when operator = '=' and left_value = right_value then true when operator = '<' and left_value < right_value then true else false end as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 570, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with tb as ( select e.*, v.value as left_v, v1.value as right_v from expressions e left join variables v on e.left_operand = v.name left join variables v1 on e.right_operand = v1.name) select left_operand, operator, right_operand, (case when operator = '>' then if(left_v>right_v, 'true', 'false') when operator = '=' then if(left_v = right_v, 'true','false') else if(left_v < right_v, 'true', 'false') end) as value from tb"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 571, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '>' then if(v1.value > v2.value,'true','false') when e.operator = '<' then if(v1.value < v2.value,'true','false') when e.operator = '=' then if(v1.value = v2.value,'true','false') end value from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 572, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator='>' then if(vl.value>vr.value,'true','false') when e.operator='<' then if(vl.value<vr.value,'true','false') else if(vl.value=vr.value,'true','false') end as value from expressions e join variables vl join variables vr on e.left_operand=vl.name and e.right_operand=vr.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 573, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = '=' then if(vl.value = vr.value, 'true', 'false') when operator = '>' then if(vl.value > vr.value, 'true', 'false') when operator = '<' then if(vl.value < vr.value, 'true', 'false') end) as value from expressions left join variables vl on vl.name = left_operand left join variables vr on vr.name = right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 574, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand,operator, right_operand, (case when operator ='>' and v1.value>v2.value then true when operator = '<' and v1.value<v2.value then true when operator ='=' and v1.value=v2.value then true else false end ) as value from expressions e1 left join variables v1 on v1.name=e1.left_operand left join variables v2 on v2.name=e1.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 575, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand ,operator ,right_operand ,case when b.value > c.value and operator = '>' then true when b.value < c.value and operator = '<' then true when b.value = c.value and operator = '=' then true else false end as value from expressions a join variables b on a.left_operand = b.name join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 576, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with step1 as ( select left_operand, e.operator, right_operand, case when operator = '>' then var1.value > var2.value when operator = '<' then var1.value > var2.value when operator = '=' then var1.value = var2.value end as case_ from expressions e left join variables var1 on e.left_operand = var1.name left join variables var2 on e.right_operand=var2.name ) select left_operand, operator, right_operand, case when case_ = 0 then false else true end as value from step1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 577, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with relation as ( select left_operand, a.value as v1, operator, right_operand, b.value as v2 from expressions e, variables a, variables b where left_operand = a.name and right_operand = b.name ) select left_operand, operator, right_operand, case when operator = '>' and v1 > v2 then true when operator = '<' and v1 < v2 then true when operator = '=' and v1 = v2 then true else false end as value from relation"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 578, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator,a.right_operand,(case when operator='>' then (case when (b.value>c.value) then true else false end) when operator='=' then (case when (b.value=c.value) then true else false end) when operator='<' then (case when (b.value<c.value) then true else false end) end) as value from expressions a inner join variables b on a.left_operand = b.name inner join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 579, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select v1.name as left_operand, operator, v2.name as right_operand, case when operator = '>' and v1.value > v2.value then true when operator = '=' and v1.value = v2.value then true when operator = '<' and v1.value < v2.value then true else false end as value from expressions as e left join variables as v1 on e.left_operand = v1.name left join variables as v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 580, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select v.left_operand, v.operator, v.right_operand, case when v.operator = '>' then if(v.lvalue>v.rvalue, 'true', 'false') when v.operator = '<' then if(v.lvalue<v.rvalue, 'true', 'false') else if(v.lvalue=v.rvalue, 'true', 'false') end as value from (select e.left_operand, e.operator, e.right_operand, v1.value as lvalue , v2.value as rvalue from expressions as e left join variables as v1 on e.left_operand = v1.name left join variables as v2 on e.right_operand = v2.name) as v"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 581, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator,right_operand, case when operator = '=' and v.value = v2.value then true when operator = '>' and v.value > v2.value then true when operator = '<' and v.value < v2.value then true else false end as value from expressions e inner join variables v on v.name=e.left_operand inner join variables v2 on v2.name=e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 582, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand ,(case when operator = '>' and (l.value > r.value) then true when operator = '<' and (l.value < r.value) then true when operator = '=' and (l.value = r.value) then true else false end ) value from expressions e left join variables l on e.left_operand = l.name left join variables r on e.right_operand = r.name"]}
