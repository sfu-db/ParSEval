{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 721, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales where buyer_id in ( select buyer_id from sales s left join product p on s.product_id = p.product_id where p.product_name = 's8') and buyer_id not in (select buyer_id from sales s left join product p on s.product_id = p.product_id where p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 722, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with s8_buyers as ( select distinct(s.buyer_id) from sales as s join product as p on s.product_id = p.product_id where p.product_name = 's8' ), iphone_buyers as ( select distinct(s.buyer_id) from sales as s join product as p on s.product_id = p.product_id where p.product_name = 'iphone' ) select x.buyer_id from s8_buyers as x left join iphone_buyers as y on x.buyer_id = y.buyer_id where y.buyer_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 723, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with iphone as( select buyer_id from sales a left join product b on a.product_id = b.product_id where b.product_name = 'iphone' ) select distinct buyer_id from sales a left join product b on a.product_id = b.product_id where b.product_name = 's8' and buyer_id not in (select buyer_id from iphone)"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 724, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product a join sales b on a.product_id = b.product_id where product_name like 's8' and buyer_id not in (select buyer_id from sales a join product b using (product_id) where product_name like 'iphone' ) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 725, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product p, sales s where p.product_id = s.product_id group by buyer_id having sum(product_name = 's8') > 0 and sum(product_name = 'iphone')=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 726, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select a.buyer_id from sales as a inner join product as b on a.product_id = b.product_id group by a.buyer_id having sum(if(b.product_name='s8', 1, 0)) > 0 and sum(if(b.product_name='iphone', 1, 0)) = 0"]}
