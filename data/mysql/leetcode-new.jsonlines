{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 117, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select distinct a.session_id as session_id from playback a inner join ads b using(customer_id) where b.timestamp between a.start_time and a.end_time ) select session_id from playback where session_id not in (select session_id from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 118, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select session_id from playback join ads on playback.customer_id = ads.customer_id where start_time <= timestamp and end_time >= timestamp ) select session_id from playback where session_id not in (select * from cte)"]}
