{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 651, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id ,count(customer_id) as count_no_trans from ( select customer_id ,transaction_id from ( select visit_id ,customer_id from visits ) v left join ( select transaction_id ,visit_id from transactions ) t on v.visit_id = t.visit_id ) a where transaction_id is null group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 652, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with base as ( select customer_id, v.visit_id as v1, t.visit_id as v2, amount from visits v left join transactions t on v.visit_id = t.visit_id where t.visit_id is null ) select customer_id, count(customer_id) as count_no_trans from base group by customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 653, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select customer_id, count(trans_count) as count_no_trans from ( select v.customer_id, count(t.transaction_id) as trans_count from visits as v left join transactions as t on t.visit_id = v.visit_id group by v.visit_id having trans_count = 0 ) as t group by customer_id"]}
