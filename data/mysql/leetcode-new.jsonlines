{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 123, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.*, case when a.operator='>' and b.value > c.value then true when a.operator='<' and b.value < c.value then true when a.operator = '=' and b.value=c.value then true else false end as value from expressions as a left join variables as b on a.left_operand=b.name left join variables as c on a.right_operand=c.name"]}
