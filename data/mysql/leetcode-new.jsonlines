{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 309, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "with cte as( select product_id, sum(rest) as rest , sum(paid) as paid , sum(canceled) as canceled , sum(refunded) as refunded from invoice group by product_id) select product.name, ifnull(cte.rest,0) as rest , ifnull(cte.paid,0) as paid , ifnull(cte.canceled,0) as canceled , ifnull(cte.refunded,0) as refunded from product left join cte on product.product_id=cte.product_id order by product.name"]}
