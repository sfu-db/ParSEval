{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 700, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' then if(v1.value > v2.value, 'true', 'false') when operator = '=' then if(v1.value = v2.value, 'true', 'false') else if(v1.value < v2.value, 'true', 'false') end as value from expressions e inner join variables v1 on e.left_operand = v1.name inner join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 701, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, (case when e.operator = '<' and tb1.value < tb2.value then true when e.operator = '>' and tb1.value > tb2.value then true when e.operator = '=' and tb1.value = tb2.value then true else false end) as value from expressions e join variables as tb1 on tb1.name = e.left_operand join variables as tb2 on tb2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 702, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case operator when '<' then if(lv.value < rv.value, 'true', 'false') when '>' then if(lv.value > rv.value, 'true', 'false') else if(lv.value = rv.value, 'true', 'false') end as value from expressions join variables lv on left_operand = lv.name join variables rv on right_operand = rv.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 703, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with c1 as ( select e.*, v.value as left_v from expressions e left join variables v on e.left_operand = v.name ), c2 as ( select e.*, v.value as right_v from expressions e left join variables v on e.right_operand = v.name ) select c1.left_operand, c1.operator, c1.right_operand, (case when c1.operator = '>' and c1.left_v > c2.right_v then true when c1.operator = '>' and c1.left_v < c2.right_v then false when c1.operator = '<' and c1.left_v < c2.right_v then true when c1.operator = '<' and c1.left_v > c2.right_v then false when c1.operator = '=' and c1.left_v = c2.right_v then true else false end) as value from c1 left join c2 on c1.left_operand = c2.left_operand and c1.operator = c2.operator and c1.right_operand = c2.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 704, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with vals as ( select left_operand, v.value l_value, operator, right_operand, v1.value r_value from expressions e join variables v on v.name=e.left_operand left join variables v1 on v1.name = e.right_operand ) select left_operand, operator, right_operand, case when operator='>' and l_value>r_value then true when operator='<' and l_value<r_value then true when operator='=' and l_value=r_value then true else false end as value from vals"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 705, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand , case when e.operator = '<' and e.left_operand = l.name and e.right_operand = r.name then case when l.value < r.value then true else false end when e.operator = '<' and e.left_operand = l.name and e.right_operand = r.name then case when r.value < l.value then true else false end when e.operator = '>' and e.left_operand = l.name and e.right_operand = r.name then case when l.value > r.value then true else false end when e.operator = '>' and e.left_operand = l.name and e.right_operand = r.name then case when r.value > l.value then true else false end when e.operator = '=' then case when e.left_operand = e.right_operand and l.value = l.value then true when e.left_operand <> e.right_operand and l.value = r.value then true else false end else false end as value from expressions e left outer join variables l on e.left_operand = l.name left outer join variables r on e.right_operand = r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 706, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as (select *, (case when operator='>' then ((select value from variables where name=a.left_operand)> (select value from variables where name=a.right_operand)) when operator='<' then ((select value from variables where name=a.left_operand)< (select value from variables where name=a.right_operand)) when operator='=' then ((select value from variables where name=a.left_operand)= (select value from variables where name=a.right_operand)) end) as value from expressions a) select left_operand, operator, right_operand, (case when value=0 then false else true end) as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 707, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as (select left_operand, v1.value as lef, operator, right_operand, v2.value as rig from expressions e inner join variables v1 on v1.name = e.left_operand inner join variables v2 on v2.name = e.right_operand) select left_operand, operator, right_operand, case when lef>rig and operator = '>' then true when lef<rig and operator = '<' then true when lef=rig and operator = '=' then true else false end as value from cte"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 708, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select ex.left_operand ,ex.operator ,ex.right_operand ,case when operator='<' and var1.value < var2.value then true when operator='>' and var1.value > var2.value then true when operator='=' and var1.value=var2.value then true else false end as value from expressions ex left join variables var1 on ex.left_operand=var1.name left join variables var2 on ex.right_operand=var2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 709, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' and v1.value > v2.value then true when operator = '<' and v1.value < v2.value then true when operator = '=' and v1.value = v2.value then true else false end as value from expressions e join variables v1 on v1.name = e.left_operand join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 710, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when operator = '=' then if(b.value = c.value, 'true','false') when operator = '<' then if(b.value < c.value, 'true','false') when operator = '>' then if (b.value > c.value, 'true', 'false') end as value from expressions a join variables b on a.left_operand = b.name join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 711, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand , e.operator , e.right_operand, case when e.operator ='>' then case when (v1.value > v2.value ) then true else false end when e.operator ='<' then case when (v1.value < v2.value ) then true else false end when e.operator ='=' then case when (v1.value = v2.value ) then true else false end end as value from expressions e join variables v1 on (e.left_operand =v1.name) join variables v2 on (e.right_operand =v2.name)"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 712, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '=' then if(v.value = vr.value ,'true','false') when e.operator = '>' then if(v.value > vr.value ,'true','false') when e.operator = '<' then if(v.value < vr.value ,'true','false') end value from expressions e left join variables v on v.name = e.left_operand left join variables vr on vr.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 713, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when (operator='=' and v1.value=v2.value) or (operator='>' and v1.value>v2.value) or (operator='<' and v1.value<v2.value) then true else false end) as value from expressions join variables v1 on left_operand=v1.name join variables v2 on right_operand=v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 714, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with t as( select e.*, v1.value - v2.value as delta from expressions e join variables v1 on e.left_operand = v1.name join variables v2 on e.right_operand = v2.name order by right_operand desc, operator ) select left_operand, operator, right_operand, case when (operator = '>' and delta > 0) then true when (operator = '>' and delta <= 0) then false when (operator = '<' and delta >= 0) then false when (operator = '<' and delta < 0) then true when (operator = '=' and delta = 0) then true when (operator = '=' and delta <> 0) then false else null end as value from t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 715, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when a.left_value = a.right_value and a.operator = '=' then true when a.left_value > a.right_value and a.operator = '>' then true when a.left_value < a.right_value and a.operator = '<' then true else false end as value from (select e.left_operand, va.value as left_value, e.operator, e.right_operand, vb.value as right_value from expressions e join variables va on e.left_operand = va.name join variables vb on e.right_operand = vb.name) a"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 716, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand ,e.operator ,e.right_operand ,case when e.operator ='<' then if(v.value <v1.value ,'true','false') when e.operator ='>' then if(v.value >v1.value ,'true','false') when e.operator ='=' then if(v.value =v1.value ,'true','false') end as value from expressions as e left join variables as v on (v.name=e.left_operand) left join variables as v1 on (v1.name=e.right_operand)"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 717, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator='>' then if(v1.value > v2.value, 'true', 'false') when operator='<' then if(v1.value < v2.value, 'true', 'false') when operator='=' then if(v1.value = v2.value, 'true', 'false') end) as value from variables v1 inner join expressions e on v1.name=e.left_operand inner join variables v2 on e.right_operand=v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 718, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '>' and v1.value > v2.value then true when operator = '<' and v1.value < v2.value then true when operator = '=' and v1.value = v2.value then true else false end as value from expressions exp left join variables v1 on v1.name = exp.left_operand left join variables v2 on v2.name = exp.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 719, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator='>' then if(a.value>b.value, 'true', 'false') when operator='<' then if(a.value<b.value, 'true', 'false') when operator='=' then if(a.value=b.value, 'true', 'false') end as value from expressions inner join variables a on a.name=expressions.left_operand inner join variables b on b.name=expressions.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 720, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when operator = '=' and b.value = c.value then true when operator = '>' and b.value > c.value then true when operator = '<' and b.value < c.value then true else false end as value from expressions a left join variables b on a.left_operand = b.name left join variables c on a.right_operand = c.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 721, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select l.left_operand, l.operator, r.right_operand, case when l.operator='>' and (l.value>r.value) then true when l.operator='<' and (l.value<r.value) then true when l.operator='=' and (l.value=r.value) then true else false end as value from (select e.left_operand, v.value, e.operator, e.right_operand from variables v, expressions e where 1=1 and v.name=e.left_operand) l, (select e.right_operand, v.value, e.operator, e.left_operand from variables v, expressions e where 1=1 and v.name=e.right_operand) r where 1=1 and l.left_operand=r.left_operand and l.right_operand=r.right_operand and l.operator=r.operator"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 722, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand,operator,right_operand ,case when a.value < b.value and operator='<' then true when a.value > b.value and operator='>' then true when a.value = b.value and operator='=' then true else false end as value from expressions inner join variables a on left_operand=a.name inner join variables b on right_operand=b.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 723, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when (case when operator = '<' then left_value < right_value when operator = '>' then left_value > right_value else left_value = right_value end) = 1 then true else false end as value from ( select left_operand, t2.value as left_value, operator, right_operand, t3.value as right_value from expressions t1 left join variables t2 on t1.left_operand = t2.name left join variables t3 on t1.right_operand = t3.name) subq1"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 724, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, ( case when e.operator = '>' then case when v1.value > v2.value then true else false end when e.operator = '<' then case when v1.value < v2.value then true else false end else case when v1.value = v2.value then true else false end end ) as value from expressions e inner join variables v1 on e.left_operand = v1.name inner join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 725, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator like '=' and left_operand_value = right_operand_value then true when operator like '>' and left_operand_value > right_operand_value then true when operator like '<' and left_operand_value < right_operand_value then true else false end as value from ( select a.left_operand, a.operator, a.right_operand, a.value as left_operand_value, b.value as right_operand_value from ( select * from expressions e left join variables v on left_operand = name ) a join ( select * from expressions e left join variables v on right_operand = name ) b on a.left_operand = b.left_operand and a.operator = b.operator and a.right_operand = b.right_operand ) c"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 726, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with cte as (select *, (select v.value from variables v where v.name = e.left_operand) as left_value, (select v.value from variables v where v.name = e.right_operand) as right_value from expressions e) select cte.left_operand, cte.operator, cte.right_operand, case when operator = '>' then case when left_value > right_value then true else false end when operator = '<' then case when left_value < right_value then true else false end when operator = '=' then case when left_value = right_value then true else false end end as value from cte"]}
