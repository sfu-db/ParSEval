{"benchmark": "benchmark/leetcode/raw_data/1364.csv", "index": 167, "schema": "create table customers (customer_id integer not null, customer_name varchar(30), email varchar(30), constraint pk_customers primary key (customer_id)); create table contacts (user_id integer not null, contact_email varchar(30) not null, contact_name varchar(30), constraint pk_contacts primary key (user_id, contact_email), foreign key (user_id) references customers (customer_id)); create table invoices (invoice_id integer not null, user_id integer, price integer, constraint pk_invoices primary key (invoice_id), foreign key (user_id) references customers (customer_id), constraint check_invoices check (price > 0));", "pair": ["select invoice_id, t.customer_name, price, contacts_cnt, trusted_contacts_cnt from invoices i left join ( select a.customer_id, customer_name, count(contact_name) as contacts_cnt, sum(case when contact_email in (select email from customers) then 1 else 0 end) as trusted_contacts_cnt from customers a left join contacts b on a.customer_id = b.user_id group by a.customer_id, customer_name ) t on i.user_id = t.customer_id order by 1", "select i.invoice_id, c.customer_name, i.price,count(ct.user_id) as contacts_cnt, sum(case when ct.contact_name in (select distinct customer_name from customers) then 1 else 0 end) as trusted_contacts_cnt from invoices i left join customers c on c.customer_id = i.user_id left join contacts ct on i.user_id = ct.user_id group by i.invoice_id, c.customer_name, i.price order by i.invoice_id asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1364.csv", "index": 168, "schema": "create table customers (customer_id integer not null, customer_name varchar(30), email varchar(30), constraint pk_customers primary key (customer_id)); create table contacts (user_id integer not null, contact_email varchar(30) not null, contact_name varchar(30), constraint pk_contacts primary key (user_id, contact_email), foreign key (user_id) references customers (customer_id)); create table invoices (invoice_id integer not null, user_id integer, price integer, constraint pk_invoices primary key (invoice_id), foreign key (user_id) references customers (customer_id), constraint check_invoices check (price > 0));", "pair": ["select invoice_id, t.customer_name, price, contacts_cnt, trusted_contacts_cnt from invoices i left join ( select a.customer_id, customer_name, count(contact_name) as contacts_cnt, sum(case when contact_email in (select email from customers) then 1 else 0 end) as trusted_contacts_cnt from customers a left join contacts b on a.customer_id = b.user_id group by a.customer_id, customer_name ) t on i.user_id = t.customer_id order by 1", "select i.invoice_id, c.customer_name, price, count(t.user_id) contacts_cnt, count(distinct e.email) trusted_contacts_cnt from invoices i join customers c on i.user_id = c.customer_id left join contacts t on t.user_id = c.customer_id left join customers e on e.email = t.contact_email group by 1,2,3 order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1364.csv", "index": 169, "schema": "create table customers (customer_id integer not null, customer_name varchar(30), email varchar(30), constraint pk_customers primary key (customer_id)); create table contacts (user_id integer not null, contact_email varchar(30) not null, contact_name varchar(30), constraint pk_contacts primary key (user_id, contact_email), foreign key (user_id) references customers (customer_id)); create table invoices (invoice_id integer not null, user_id integer, price integer, constraint pk_invoices primary key (invoice_id), foreign key (user_id) references customers (customer_id), constraint check_invoices check (price > 0));", "pair": ["select invoice_id, t.customer_name, price, contacts_cnt, trusted_contacts_cnt from invoices i left join ( select a.customer_id, customer_name, count(contact_name) as contacts_cnt, sum(case when contact_email in (select email from customers) then 1 else 0 end) as trusted_contacts_cnt from customers a left join contacts b on a.customer_id = b.user_id group by a.customer_id, customer_name ) t on i.user_id = t.customer_id order by 1", "select i.invoice_id, c.customer_name, price, ifnull(c3.cnt1,0) as contacts_cnt, ifnull(c3.cnt2,0) as trusted_contacts_cnt from invoices i left join customers c on i.user_id = c.customer_id left join (select c1.user_id, c1.cnt1, c2.cnt2 from (select user_id, count(user_id) as cnt1 from contacts group by user_id) c1 left join (select user_id, count(user_id) as cnt2 from contacts where contact_name in (select customer_name from customers) group by user_id) c2 on c1.user_id = c2.user_id) c3 on i.user_id = c3.user_id order by invoice_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1364.csv", "index": 170, "schema": "create table customers (customer_id integer not null, customer_name varchar(30), email varchar(30), constraint pk_customers primary key (customer_id)); create table contacts (user_id integer not null, contact_email varchar(30) not null, contact_name varchar(30), constraint pk_contacts primary key (user_id, contact_email), foreign key (user_id) references customers (customer_id)); create table invoices (invoice_id integer not null, user_id integer, price integer, constraint pk_invoices primary key (invoice_id), foreign key (user_id) references customers (customer_id), constraint check_invoices check (price > 0));", "pair": ["select invoice_id, t.customer_name, price, contacts_cnt, trusted_contacts_cnt from invoices i left join ( select a.customer_id, customer_name, count(contact_name) as contacts_cnt, sum(case when contact_email in (select email from customers) then 1 else 0 end) as trusted_contacts_cnt from customers a left join contacts b on a.customer_id = b.user_id group by a.customer_id, customer_name ) t on i.user_id = t.customer_id order by 1", "select i.invoice_id, c.customer_name, sum(i.price) as price, ifnull(fcnt,0) as contacts_cnt, ifnull(cfcnt,0) as trusted_contacts_cnt from customers c join invoices i on i.user_id = c.customer_id left join (select user_id, count(contact_email) as fcnt from contacts group by user_id) co on i.user_id = co.user_id left join ( select user_id, count(contact_email) as cfcnt from contacts where contact_email in (select email from customers) group by user_id ) sq on sq.user_id = i.user_id group by i.invoice_id, c.customer_name order by i.invoice_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1364.csv", "index": 171, "schema": "create table customers (customer_id integer not null, customer_name varchar(30), email varchar(30), constraint pk_customers primary key (customer_id)); create table contacts (user_id integer not null, contact_email varchar(30) not null, contact_name varchar(30), constraint pk_contacts primary key (user_id, contact_email), foreign key (user_id) references customers (customer_id)); create table invoices (invoice_id integer not null, user_id integer, price integer, constraint pk_invoices primary key (invoice_id), foreign key (user_id) references customers (customer_id), constraint check_invoices check (price > 0));", "pair": ["select invoice_id, t.customer_name, price, contacts_cnt, trusted_contacts_cnt from invoices i left join ( select a.customer_id, customer_name, count(contact_name) as contacts_cnt, sum(case when contact_email in (select email from customers) then 1 else 0 end) as trusted_contacts_cnt from customers a left join contacts b on a.customer_id = b.user_id group by a.customer_id, customer_name ) t on i.user_id = t.customer_id order by 1", "select i.invoice_id, c1.customer_name, i.price, coalesce(abc.ct,0) as contacts_cnt, coalesce(abc.tct,0) as trusted_contacts_cnt from invoices i left join ( select user_id, count(contact_name) as ct ,sum(trust) as tct from ( select user_id, (contact_name), case when contact_name in (select customer_name from customers) then 1 else 0 end as trust from customers c inner join contacts ct on c.customer_id = ct.user_id) a group by 1) abc on i.user_id = abc.user_id inner join customers c1 on c1.customer_id = i.user_id order by 1"]}
