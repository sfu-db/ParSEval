{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 482, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with tb1 as (select followee,count(follower) as num from follow group by followee having num>=1) select followee as follower, num from tb1 where followee in (select follower from follow) order by follower"]}
