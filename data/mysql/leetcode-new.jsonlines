{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 420, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as (select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select temp.id as player_id, player_name, count(temp.id) as grand_slams_count from temp left join players on temp.id = players.player_id group by temp.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 421, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as (select wimbledon from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships) select wimbledon as player_id, player_name, count(wimbledon) as grand_slams_count from temp , players where temp.wimbledon=player_id group by wimbledon"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 422, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as( select winner, count(game) as grand_slams_count from( select year, 'wimbledon as game', wimbledon as winner from championships union select year, 'fr_open as game', fr_open as winner from championships union select year, 'us_open as game', us_open as winner from championships union select year, 'au_open as game', au_open as winner from championships ) as k group by winner ) select p.player_id, p.player_name, t.grand_slams_count from players as p join temp as t on p.player_id = t.winner"]}
