{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 120, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as (select session_id, p.customer_id, start_time, end_time, timestamp from playback p left join ads a on a.customer_id = p.customer_id and (timestamp >= start_time and timestamp <= end_time)) select session_id from cte where timestamp is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 121, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as( select distinct a.session_id from playback a join ads b on a.customer_id = b.customer_id where b.timestamp between a.start_time and a.end_time ) select distinct session_id from playback where session_id not in (select * from cte)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 122, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with tmp as ( select distinct session_id from playback p join ads a on p.customer_id = a.customer_id and timestamp <= end_time and timestamp >= start_time ) select distinct session_id from playback p left join ads a on p.customer_id = a.customer_id where session_id not in (select session_id from tmp)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 123, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with a as ( select playback.session_id, playback.start_time, playback.end_time, ads.timestamp from playback left join ads on playback.customer_id = ads.customer_id), b as ( select session_id, sum(case when timestamp<=end_time and timestamp>=start_time then 1 else 0 end) as ct from a group by session_id) select session_id from b where ct = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 124, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with base_data as ( select playback.*,ads.ad_id,ads.timestamp from playback left join ads on ads.customer_id = playback.customer_id and ads.timestamp between playback.start_time and playback.end_time where ads.ad_id is null ) select distinct session_id from base_data"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 125, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with customers_who_saw_ads as ( select customer_id, timestamp from ads ) select distinct p.session_id from playback p left join customers_who_saw_ads c on c.customer_id = p.customer_id and c.timestamp between p.start_time and p.end_time where c.customer_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 126, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with fulltable as( select p.session_id, p.start_time, p.end_time, a.timestamp from playback p left join ads a on p.customer_id = a.customer_id) select session_id from( select session_id, sum(case when timestamp between start_time and end_time then 1 else 0 end) as adsdisplay from fulltable group by 1) i where adsdisplay = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 127, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with getvalidads as( select distinct session_id from playback p inner join ads a on p.customer_id = a.customer_id and a.timestamp between p.start_time and p.end_time ) select session_id from playback where playback.session_id not in (select session_id from getvalidads)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 128, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with has_ads as ( select distinct p.session_id from playback p join ads a on a.customer_id=p.customer_id where a.timestamp between p.start_time and p.end_time) select distinct session_id from playback where session_id not in (select * from has_ads)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 129, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with joinedtable as ( select session_id, ad_id from playback p left outer join ads a on a.timestamp between p.start_time and p.end_time and a.customer_id = p.customer_id having ad_id is null ) select session_id from joinedtable"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 130, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with playback_with_ads as ( select distinct p.session_id from playback as p join ads as a on p.customer_id = a.customer_id where a.timestamp between p.start_time and p.end_time ) select session_id from playback where session_id not in(select session_id from playback_with_ads)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 131, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with shown_ads as (select distinct p.session_id from playback as p inner join ads as a on p.customer_id = a.customer_id where (a.timestamp >= p.start_time and a.timestamp <= p.end_time) ) select distinct session_id from playback where playback.session_id not in (select shown_ads.session_id from shown_ads)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 132, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with t as ( select distinct p.session_id, case when a.timestamp < p.start_time or a.timestamp > p.end_time or a.timestamp is null then 0 else 1 end as is_ad_shown from playback p left join ads a on p.customer_id = a.customer_id ) select session_id from t group by session_id having sum(is_ad_shown) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 133, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with tmp as ( select p.session_id from playback as p left join ads as a on p.customer_id = a.customer_id where a.timestamp >= p.start_time and a.timestamp <= p.end_time group by p.session_id ) select session_id from playback where session_id not in (select session_id from tmp)"]}
{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 134, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select p.session_id from playback p inner join ads a on p.customer_id = a.customer_id and a.timestamp between p.start_time and p.end_time ) select session_id from playback where session_id not in (select * from cte)"]}
