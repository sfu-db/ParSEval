{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 78, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select a.buyer_id from sales a inner join product p on a.product_id = p.product_id where 1=1 and p.product_name = 's8' and a.buyer_id not in ( select buyer_id from sales s inner join product b on b.product_id = s.product_id where b.product_name = 'iphone' ) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 79, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select b.buyer_id from product as a join sales as b on a.product_id = b.product_id group by b.buyer_id having sum(a.product_name = 's8') > 0 and sum(a.product_name = 'iphone') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 80, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select b.buyer_id from product as a join sales as b on b.product_id = a.product_id group by b.buyer_id having sum(a.product_name = 's8') > 0 and sum(a.product_name = 'iphone') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 81, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from ( select buyer_id, case when product.product_name = 's8' then 1 when product.product_name = 'iphone' then -1 end as coeff from product join sales on product.product_id = sales.product_id and ( product.product_name = 's8' or product.product_name = 'iphone' ) group by buyer_id, product.product_name ) as sales_info group by buyer_id having sum(coeff) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 82, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from ( select buyer_id, group_concat(product_name) as product_names from sales s join product p on s.product_id = p.product_id group by buyer_id having product_names like '%s8%' and product_names not like '%iphone%') a"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 83, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product as p join sales as s on p.product_id = s.product_id group by buyer_id having sum(if(product_name = 's8', 1, 0)) > 0 and sum(if(product_name = 'iphone', 1, 0)) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 84, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales join product on sales.product_id = product.product_id where sales.product_id in (select product_id from product where product_name = 's8' or product_name = 'iphone') group by buyer_id having sum(case when product_name = 'iphone' then 1 else 0 end) = 0"]}
