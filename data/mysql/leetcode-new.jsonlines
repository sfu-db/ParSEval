{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 413, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select p.project_id as project_id, cast(avg(experience_years) as decimal(10,2)) as average_years from project p join employee e on p.employee_id = e.employee_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 414, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select a.project_id, round(avg(b.experience_years),2) as average_years from project a inner join employee b using (employee_id) group by a.project_id"]}
