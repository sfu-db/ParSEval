{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 134, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, 'store1' as store, store1 as price from products where store1 is not null union select product_id, 'store2' as store, store2 as price from products where store2 is not null union select product_id, 'store3' as store, store3 as store from products where store3 is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 135, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with recursive cte as ( select 1 as num union all select num+1 as num from cte where num+1<=3) , cj as ( select product_id, case when num = 1 then store1 when num = 2 then store2 when num = 3 then store3 end as store, case when num = 1 then store1 when num =2 then store2 when num=3 then store3 end as price from products cross join cte) select * from cj where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 136, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select * from (select product_id, 'store1' as store, store1 as price from products union all select product_id, 'store2' as store, store2 as price from products union all select product_id, 'store3' as store, store3 as price from products) as cte where price is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 137, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id,'store1' as store,max(store1) as price from products where store1 is not null group by 1 union all select product_id,'store2' as store,max(store2) as price from products where store2 is not null group by 1 union all select product_id,'store3' as store,max(store3) as price from products where store3 is not null group by 1"]}
