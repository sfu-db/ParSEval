{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 355, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with cte as ( select p.session_id, sum(if(a.timestamp < p.start_time or a.timestamp > p.end_time, 1, 0)) as qualified_cnt, count(ad_id) as total_cnt from playback as p inner join ads as a on p.customer_id = a.customer_id group by p.session_id ) select session_id from cte where qualified_cnt = total_cnt union select session_id from playback where customer_id not in (select customer_id from ads)"]}
