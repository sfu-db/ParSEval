{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 142, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with accountendingbalance as (select account ,sum(amount) as balance from transactions group by account having sum(amount) > 10000) select u.name ,aeb.balance from users u inner join accountendingbalance aeb on aeb.account = u.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 143, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte as ( select transactions.*, users.name from transactions left join users on transactions.account = users.account ) select name, sum(amount) as balance from cte group by name having(balance > 10000)"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 144, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with cte1 as ( select account, sum(amount) as balance from transactions group by account having balance>10000) select name, balance from users join cte1 on users.account = cte1.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 145, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with summary as (select account, sum(amount) as balance from transactions group by account having balance > 10000) select u.name, s.balance from users as u join summary as s on u.account = s.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 146, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with summed_accounts as ( select account, sum(amount) as balance from transactions group by account ) select a.name, b.balance from users a inner join summed_accounts b on a.account=b.account where b.balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 147, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with answer as( select u.account,name, sum(t.amount) as balance from users u join transactions t on u.account=t.account group by u.account ) select name, balance from answer where balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 148, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with balances_above_10000 as ( select account, sum(amount) balance from transactions group by account having balance > 10000 ) select u.name, b.balance from users u inner join balances_above_10000 b on u.account = b.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 149, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with prep as ( select account, sum(amount) as balance from transactions group by account ) select name, balance from prep join users on prep.account = users.account where balance > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 150, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with temp_table as ( select u.name, t.amount from users u left join transactions t on u.account = t.account ) select name, sum(amount) as balance from temp_table group by name having balance > 10000"]}
