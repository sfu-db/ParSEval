{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 161, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select distinct e.employee_id,e.name, count(e.employee_id) as reports_count, round(avg(e1.age),0) as average_age from employees e, employees e1 where e.employee_id=e1.reports_to group by e.employee_id order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 162, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select distinct a.reports_to as employee_id, b.name, count(a.employee_id) as reports_count, round(avg(a.age),0) as average_age from employees a join employees b on a.reports_to = b. employee_id where a.reports_to is not null group by a.reports_to order by a.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 163, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select distinct e.reports_to as employee_id,e1.name,count(e1.employee_id) as reports_count,round(avg(e.age),0) as average_age from employees e1 join employees e on e1.employee_id=e.reports_to group by e.reports_to having count(e.reports_to)>=1 order by e1.employee_id"]}
