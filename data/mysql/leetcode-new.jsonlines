{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 335, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with wls as( select query_name, round(sum(rating/position)/count(distinct result),2) as quality, round(sum(case when rating < 3 then 1 else 0 end)/count(distinct result)*100,2) as poor_query_percentage from queries group by query_name ) select * from wls"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 336, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality, round(sum(case when rating<3 then 1 else 0 end)/count(q.rating)*100,2) as poor_query_percentage from queries q group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 337, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select query_name, round(avg(rating/position),2) as quality, round(100* avg(if(rating < '3',1,0)),2) as poor_query_percentage from queries group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 338, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with t1(query_name,result,position,rating,lowq) as (select query_name,result,position,rating, case when rating < 3 then 1 else 0 end as lowq from queries) select query_name, round(avg(rating/position),2) as quality,round(avg(lowq*100),2)as poor_query_percentage from t1 group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 339, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with poor_qp as(select * , case when rating < 3 then 1 else 0 end as poor_qp_count from queries) select query_name , round(avg(rating / position), 2) as quality , round(avg(poor_qp_count) * 100, 2) as poor_query_percentage from poor_qp group by query_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 340, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "select q.query_name, q.quality, round(100*ifnull(q.pr,0)/q.nr, 2) as poor_query_percentage from (select query_name, round(avg(rating/position),2) as quality, count(rating) as nr, sum(case when rating<3 then 1 else 0 end) as pr from queries group by query_name ) as q"]}
