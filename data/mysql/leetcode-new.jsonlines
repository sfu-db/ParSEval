{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 352, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "select distinct l.page_id as recommended_page from likes as l left join friendship as f on l.user_id = f.user2_id or l.user_id = f.user1_id where f.user1_id = 1 or f.user2_id = 1 having l.page_id not in (select l2.page_id from likes as l2 where l2.user_id = 1)"]}
