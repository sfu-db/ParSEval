{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 448, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wins as ( select distinct wimbledon as player, count(*) over (partition by wimbledon) as wins from championships union all select distinct fr_open as player, count(*) over (partition by fr_open) as wins from championships union all select distinct us_open as player, count(*) over (partition by us_open) as wins from championships union all select distinct au_open as player, count(*) over (partition by au_open) as wins from championships) select w.player as player_id, p.player_name, sum(w.wins) as grand_slams_count from wins w, players p where w.player = p.player_id group by w.player, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 449, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with wintable as( (select wimbledon as id, count(*) as win from championships group by wimbledon) union all (select fr_open as id, count(*) as win from championships group by fr_open) union all (select us_open as id, count(*) as win from championships group by us_open) union all (select au_open as id, count(*) as win from championships group by au_open) ) select player_id, player_name, sum(win) as grand_slams_count from players join wintable on player_id = id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 450, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_wins as (select year,wimbledon as champ_id from championships union all select year,fr_open as champ_id from championships union all select year,us_open as champ_id from championships union all select year,au_open as champ_id from championships ) select player_id, player_name, count(*) as grand_slams_count from players join all_wins on players.player_id = all_wins.champ_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 451, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as( select wimbledon as win from championships union all select fr_open as win from championships union all select us_open as win from championships union all select au_open as win from championships) select cte.win as player_id, p.player_name, count(*) as grand_slams_count from cte join players p on p.player_id=cte.win group by cte.win"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 452, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as tournament, 'w' as label from championships union select year, fr_open as tournament, 'fr' as label from championships union select year, us_open as tournament, 'us' as label from championships union select year, au_open as tournament, 'au' as label from championships) select tournament as player_id, player_name, count(label) as grand_slams_count from cte c join players p on c.tournament = p.player_id group by 1 having count(label) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 453, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(won_that_year) as grand_slams_count from ( select player_id, player_name, (player_id = wimbledon) + (player_id = fr_open) + (player_id = us_open) + (player_id = au_open) as won_that_year from players, championships where (player_id = wimbledon) + (player_id = fr_open) + (player_id = us_open) + (player_id = au_open) > 0 ) as tally group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 454, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with temp as ((select wimbledon as id from championships) union all (select fr_open as id from championships) union all (select us_open as id from championships) union all (select au_open as id from championships)) select p.player_id, p.player_name, count(*) as grand_slams_count from players p join temp t on p.player_id = t.id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 455, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select player_id, count(*) as grand_slams_count from ( select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) sub group by player_id ) select cte.player_id, p.player_name, cte.grand_slams_count from cte inner join players p on cte.player_id = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 456, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select players.player_id, players.player_name, new_t.grand_slams_count from players inner join ( select player_id, sum(wins) as grand_slams_count from ( select wimbledon as player_id, count(wimbledon) as wins from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as wins from championships group by fr_open union all select us_open as player_id, count(us_open) as wins from championships group by us_open union all select au_open as player_id, count(au_open) as wins from championships group by au_open ) as w group by player_id ) as new_t on players.player_id = new_t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 457, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as ( select wimbledon id, count(wimbledon) c from championships group by wimbledon union all select fr_open id, count(fr_open) c from championships group by fr_open union all select us_open id, count(us_open) c from championships group by us_open union all select au_open id, count(au_open) c from championships group by au_open ) select id player_id , player_name ,sum(c) grand_slams_count from tmp join players on tmp.id = players.player_id group by id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 458, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select temp.player_id, player_name, count(*) as grand_slams_count from (select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships) temp join players on temp.player_id = players.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 459, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as grandslam from championships union all select fr_open as grandslam from championships union all select us_open as grandslam from championships union all select au_open as grandslam from championships ) select player_id , player_name , title_count as grand_slams_count from (select grandslam , count(*) as title_count from cte group by 1) x left join players p on x.grandslam = p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 460, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as ( select year, wimbledon as id from championships union all select year, fr_open as id from championships union all select year, us_open as id from championships union all select year, au_open as id from championships ) select id as player_id, player_name, count(1) as grand_slams_count from c join players p on c.id=p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 461, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(wimbledon=player_id) + sum(fr_open=player_id) + sum(us_open=player_id) + sum(au_open=player_id) as grand_slams_count from players p join championships c on p.player_id in (c.wimbledon, c.fr_open, c.us_open, c.au_open) group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 462, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.player_id,a.player_name,b.grand_slams_count from players a inner join ( select id,count(*) as grand_slams_count from ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) as b group by id ) as b on a.player_id=b.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 463, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tb1 as (select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships) select tb1.player_id, player_name, count(tb1.player_id) as grand_slams_count from tb1 left join players using(player_id) group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 464, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(c.tournament) as grand_slams_count from (select wimbledon as tournament from championships union all select fr_open as tournament from championships union all select us_open as tournament from championships union all select au_open as tournament from championships) as c join players as p on c.tournament = p.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 465, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(if(wimbledon = player_id, 1, 0)) + sum(if(fr_open = player_id, 1, 0)) + sum(if(us_open = player_id, 1, 0)) + sum(if(au_open = player_id, 1, 0)) as grand_slams_count from players cross join championships group by player_id having grand_slams_count > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 466, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with win as (select year,wimbledon as player from championships union all select year,fr_open as player from championships union all select year,us_open as player from championships union all select year,au_open as player from championships) select p.player_id, p.player_name, count(*) as grand_slams_count from players p join win w on p.player_id = w.player group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 467, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as (select championships.year, wimbledon as champ_id from championships union all select championships.year, fr_open as champ_id from championships union all select championships.year, us_open as champ_id from championships union all select championships.year, au_open as champ_id from championships) select p.player_id, p.player_name, count(c.champ_id) as grand_slams_count from players p join cte as c on p.player_id = c.champ_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 468, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with all_winner as( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships ) select winner as player_id, player_name, count(*) as grand_slams_count from players p join all_winner a on p.player_id = a.winner group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 469, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id,p.player_name, sum(if(p.player_id=c.wimbledon,1,0) + if(p.player_id=c.fr_open,1,0) + if(p.player_id=c.us_open,1,0) +if(p.player_id=c.au_open,1,0)) as grand_slams_count from players p cross join championships c group by player_id having grand_slams_count>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 470, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select player_id, player_name from championships a join players b on a.wimbledon=b.player_id union all select player_id, player_name from championships a join players b on a.fr_open=b.player_id union all select player_id, player_name from championships a join players b on a.us_open=b.player_id union all select player_id, player_name from championships a join players b on a.au_open=b.player_id ) select player_id, player_name, count(player_id) grand_slams_count from cte group by 1, 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 471, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(p.player_id=c.wimbledon)+sum(p.player_id=c.fr_open) + sum(p.player_id=c.us_open) + sum(p.player_id=c.au_open) as grand_slams_count from players p join championships c on p.player_id=c.wimbledon or p.player_id=c.fr_open or p.player_id=c.us_open or p.player_id=c.au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 472, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select champions as player_id, p.player_name, count(champions) as grand_slams_count from (select year, wimbledon as champions from championships union all select year, fr_open as champions from championships union all select year, us_open as champions from championships union all select year, au_open as champions from championships) d join players p on p.player_id = d.champions group by champions"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 473, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(wimbledon = player_id) + sum(fr_open = player_id) + sum(us_open = player_id) + sum(au_open = player_id) as grand_slams_count from players p join championships c on p.player_id = c.wimbledon or p.player_id = c.fr_open or p.player_id = c.us_open or p.player_id = c.au_open group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 474, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, c.grand_slams_count from players p join (select t.id, count(1) grand_slams_count from ( select wimbledon id from championships union all select fr_open id from championships union all select us_open id from championships union all select au_open id from championships ) t group by t.id) c on p.player_id = c.id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 475, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, count(tournament) as grand_slams_count from players p join ( select year, 'wimbledon' as tournament, wimbledon as player_id from championships union all select year, 'fr_open' as tournament, fr_open as player_id from championships union all select year, 'us_open' as tournament, us_open as player_id from championships union all select year, 'au_open' as tournament, au_open as player_id from championships ) c_unpivot on p.player_id = c_unpivot.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 476, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select a.pid as player_id, b.player_name as player_name, a.cnt as grand_slams_count from (select pid, sum(cnt) as cnt from (select wimbledon as pid, count(1) as cnt from championships group by wimbledon union all select fr_open as pid, count(1) as cnt from championships group by fr_open union all select us_open as pid, count(1) as cnt from championships group by us_open union all select au_open as pid, count(1) as cnt from championships group by au_open) as a group by pid) as a inner join players as b on a.pid = b.player_id"]}
