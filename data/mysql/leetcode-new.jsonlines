{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 209, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "with prep as ( select *, min(event_date)over(partition by player_id order by event_date) install_dt, lead(event_date, 1)over(partition by player_id order by event_date) nextday, row_number()over(partition by player_id order by event_date)rn from activity ) select install_dt, count(*) as installs, round(sum(case when nextday is not null and datediff(nextday,install_dt)=1 then 1 else 0 end )/count(*),2) as day1_retention from prep where rn=1 group by install_dt"]}
{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 210, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "with prep as( select *, row_number() over(partition by player_id order by event_date) rnk, if( datediff(lead(event_date,1) over(partition by player_id order by event_date), event_date)=1,1,0 ) nextdaylogin from activity ) select event_date install_dt, count(distinct player_id) installs, round(sum(nextdaylogin)/count(distinct player_id),2) day1_retention from prep where rnk =1 group by install_dt"]}
{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 211, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "with ranked_event_date as( select player_id, event_date, rank() over(partition by player_id order by event_date) as event_date_rank from activity ) select date1 as install_dt, count(day_one.player_id) as installs, round(sum(case when datediff(date2,date1)=1 then 1 else 0 end)/count(day_one.player_id),2) as day1_retention from( select event_date as date1, player_id from ranked_event_date where event_date_rank = 1 ) as day_one left join ( select event_date as date2, player_id from ranked_event_date where event_date_rank = 2 ) as day_two on day_one.player_id = day_two.player_id group by date1"]}
{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 212, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "with retention as ( select player_id, event_date, lead(event_date, 1) over(partition by player_id order by event_date) next_date, row_number() over(partition by player_id order by event_date) rownum from activity ) select event_date as install_dt, count(distinct player_id) as installs, round((sum(case when (next_date - event_date = 1) then 1 else 0 end) / count(distinct player_id)), 2) as day1_retention from retention where rownum = 1 group by install_dt"]}
{"benchmark": "benchmark/leetcode/raw_data/1097.csv", "index": 213, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select a1.first_login as install_dt, count(distinct a1.player_id) as installs, round((sum(case when (a1.first_login + 1) = a2.event_date then 1 else 0 end)/ count(distinct a1.player_id)), 2) as day1_retention from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 join activity as a2 on a1.player_id = a2.player_id group by a1.first_login", "with retention as( select player_id, install_dt from (select player_id, event_date, min(event_date) over(partition by player_id) as install_dt from activity) t where event_date - install_dt = 1 ), install_date as( select player_id, min(event_date) as install_dt from activity group by player_id ) select a.install_dt, count(a.player_id) as installs, round(count(b.player_id) / count(a.player_id), 2) as day1_retention from install_date a left join retention b on a.install_dt = b.install_dt and a.player_id = b.player_id group by a.install_dt"]}
