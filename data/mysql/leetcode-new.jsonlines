{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 428, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '<' then if(v1.value<v2.value, 'true', 'false') when operator = '>' then if(v1.value<v2.value, 'true', 'false') else if(v1.value=v2.value, 'true', 'false') end as value from expressions e join variables v1 on v1.name = e.left_operand join variables v2 on v2.name = e.right_operand"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 429, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "with c1 as ( select e.* ,v1.value as x, v2.value as y from expressions e left join variables v1 on e.left_operand = v1.name left join variables v2 on e.right_operand = v2.name ), c2 as ( select *, case when x > y then '>' when x < y then '<' else '=' end as relation from c1 ) select left_operand,operator,right_operand, case when relation = operator then true else false end as value from c2"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 430, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, case when e.operator='<' then if(l.value<r.value,'true','false') when e.operator='>' then if(l.value>r.value,'true','false') else if(l.value=r.value,'true','false') end as value from expressions e join variables l on e.left_operand=l.name join variables r on e.right_operand=r.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 431, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.*, (case when e.operator='>' and v.value>v1.value then true when e.operator='>' and v.value<=v1.value then false when e.operator='<' and v.value<v1.value then true when e.operator='<' and v.value>=v1.value then false when e.operator='=' and v.value=v1.value then true when e.operator='=' and v.value<>v1.value then false end) as value from expressions e left join variables v on e.left_operand = v.name left join variables v1 on e.right_operand = v1.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 432, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator, e.right_operand, case when e.operator = '=' and v.value = v2.value then true when e.operator = '>' and v.value > v2.value then true when e.operator = '<' and v.value < v2.value then true else false end as value from expressions e inner join variables v on e.left_operand = v.name inner join variables v2 on e.right_operand = v2.name"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 433, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select e.left_operand, e.operator,e.right_operand,(case when e.operator='>' then if(v1.value>v2.value, 'true', 'false') when e.operator='<' then if (v1.value<v2.value, 'true','false') else if(v1.value=v2.value,'true', 'false') end) as value from expressions as e join variables as v1 on e.left_operand=v1.name join variables as v2 on e.right_operand=v2.name"]}
