{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 115, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "with a as ( select session_id, start_time, end_time, timestamp from playback join ads on playback.customer_id = ads.customer_id), b as ( select distinct session_id from a where timestamp>=start_time and timestamp<=end_time) select distinct session_id from playback where session_id not in (select * from b)"]}
