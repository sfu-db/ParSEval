{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 376, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, case when operator = '=' then if(right_value = left_value, 'true', 'false') when operator = '>' then if(right_value > left_value, 'true', 'false') when operator = '<' then if(right_value < left_value, 'true', 'false') end as value from ( select left_operand, left_value, operator, right_operand , value as right_value from ( select t1.left_operand, value as left_value, operator, right_operand from ( select * from expressions )t1 left join ( select * from variables )t2 on t1.left_operand = t2.name )tt1 left join ( select * from variables )tt2 on tt1.right_operand = tt2.name )t"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 377, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select left_operand, operator, right_operand, (case when operator = r then true else false end) as value from (select left_operand, operator, right_operand, (case when v1.value > v2.value then '>' when v1.value = v2.value then '=' else '<' end) as r from expressions e join variables v1 on v1.name = left_operand join variables v2 on v2.name = right_operand) temp"]}
