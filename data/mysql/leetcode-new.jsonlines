{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 191, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct a.product_id,b.product_name from sales a left join product b on a.product_id=b.product_id where a.sale_date between '2019-01-01' and '2019-03-31' and a.product_id not in ( select a.product_id from sales a where a.sale_date not between '2019-01-01' and '2019-03-31' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 192, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct b.product_id, product_name from sales a inner join product b on a.product_id = b.product_id left join (select d.product_id from sales d inner join product e on d.product_id = e.product_id where sale_date not between '2019-01-01' and '2019-03-31')c on a.product_id = c.product_id where sale_date between '2019-01-01' and '2019-03-31' and c.product_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 193, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id , p.product_name from ( select product_id, min(sale_date) min_date, max(sale_date) as max_date from sales group by product_id ) ns join product p on ns.product_id = p.product_id where ns.min_date >= date('2019-01-01') and ns.max_date <= date('2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 194, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where sale_date >= '2019-01-01' and sale_date <= '2019-03-31' and p.product_id not in( select distinct product_id from sales where sale_date < '2019-01-01' or sale_date > '2019-03-31' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 195, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id, p.product_name from product as p join sales as s on p.product_id = s.product_id where p.product_id not in ( select product_id from sales where sale_date < '2019-01-01' ) and p.product_id not in ( select product_id from sales where sale_date > '2019-03-31' )"]}
