{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 865, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from sales s join product p on s.product_id = p.product_id group by s.buyer_id having sum(p.product_name = 's8') > 0 and sum(p.product_name = 'iphone') = 0 and sum(p.product_name='g4') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 866, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as (select s.buyer_id as buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 's8') select distinct buyer_id from cte where buyer_id not in (select s.buyer_id as buyer_id from sales s join product p on s.product_id = p.product_id where p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 867, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from ( select s.buyer_id, sum(case when p.product_name = 's8' then 0 when p.product_name = 'iphone' then 1 else null end) as flag from sales s inner join product p on p.product_id = s.product_id group by 1 )t where flag = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 868, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as ( select sales.buyer_id,product.* from sales join product on sales.product_id = product.product_id) select distinct buyer_id from sales where buyer_id in (select buyer_id from cte where product_name = 's8') and buyer_id not in (select buyer_id from cte where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 869, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales as s inner join product as p on s.product_id=p.product_id group by buyer_id having sum(p.product_name = 's8') > 0 and sum(p.product_name = 'iphone') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 870, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales s join product p on s.product_id = p.product_id group by 1 having sum(case when product_name = 's8' then 1 else 0 end) > 0 and sum(case when product_name = 'iphone' then 1 else 0 end) = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 871, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as( select s.buyer_id, p.product_name from product as p join sales as s on p.product_id = s.product_id) select distinct buyer_id from cte where buyer_id in (select buyer_id from cte where product_name = 's8') and buyer_id not in (select buyer_id from cte where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 872, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte as ( select s.buyer_id,p.product_name from sales s left outer join product p on (s.product_id=p.product_id) ) select distinct buyer_id from cte where buyer_id in (select buyer_id from cte where product_name = 's8') and buyer_id not in (select buyer_id from cte where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 873, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with t as( select s.*, p.product_name from sales s left join product p on s.product_id = p.product_id) select distinct buyer_id from t where product_name = 's8' and buyer_id not in (select buyer_id from t where product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 0, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct p.product_id, p.product_name from product p inner join sales s on p.product_id = s.product_id where s.sale_date between '2019-01-01' and '2019-03-31' and p.product_id not in ( select p.product_id from product p inner join sales s on p.product_id = s.product_id where s.sale_date > '2019-03-31' or s.sale_date < '2019-01-01' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 1, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct sales.product_id, product_name from product inner join sales on product.product_id = sales.product_id where sale_date between '2019-01-01' and '2019-03-31' and sales.product_id not in (select distinct sales.product_id from product inner join sales on product.product_id = sales.product_id where sale_date < '2019-01-01' or sale_date > '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 2, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct sales.product_id, product_name from product join sales on product.product_id = sales.product_id where sales.product_id in ( select sales.product_id from product join sales on product.product_id = sales.product_id where sale_date between '2019-01-01' and '2019-03-31' ) and sales.product_id not in ( select sales.product_id from product join sales on product.product_id = sales.product_id where not sale_date between '2019-01-01' and '2019-03-31' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 3, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct a.product_id, a.product_name from product as a left join sales as b on a.product_id = b.product_id where b.sale_date between '2019-01-01' and '2019-03-31' and a.product_id not in( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 4, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct a.product_id, b.product_name from sales as a join product as b on a.product_id = b.product_id where a.product_id not in (select product_id from sales where sale_date < '2019-01-01') and a.product_id not in (select product_id from sales where sale_date > '2019-03-31')"]}
