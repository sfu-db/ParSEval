{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 348, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with ctd1 as ( select player_id, min(event_date) as event_date from activity group by player_id) select round(count(distinct a.player_id)/(select count(distinct player_id) from activity),2) as fraction from ctd1 a join activity b on a.player_id = b.player_id and datediff(b.event_date, a.event_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 349, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round( sum( case when a.event_date + 1 = b.event_date then 1 else 0 end) /count(distinct a.player_id), 2) as fraction from (select player_id, min(event_date) as event_date from activity group by player_id) as a inner join activity as b on a.player_id = b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 350, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(a2.player_id)/count(a1.player_id), 2) as fraction from (select player_id, min(event_date) as first_login from activity group by player_id) as a1 left join activity a2 on a1.player_id = a2.player_id and datediff(a2.event_date, a1.first_login) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 351, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with players as ( select count(distinct(player_id)) as count from activity ), players_first as ( select player_id, min(event_date) as event_date from activity group by player_id ), players_next as ( select count(distinct(pf.player_id)) count from players_first as pf join activity a on a.event_date = pf.event_date + 1 and pf.player_id = a.player_id ) select round(pn. count / p. count , 2) as fraction from players_next as pn, players as p"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 352, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct a2.player_id)/count(distinct a1.player_id),2) as fraction from (select player_id, min(event_date) as event_date from activity group by player_id) a1 left join activity a2 on a1.player_id = a2.player_id and datediff(a1.event_date, a2.event_date) =-1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 353, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with cte1 as ( select player_id,min(event_date) as event_date from activity group by player_id ) select round( count(distinct a.player_id) / (select count(distinct player_id) from activity ) ,2) as fraction from cte1 a inner join activity b on a.player_id = b.player_id and datediff(b.event_date,a.event_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 354, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(b.event_date)/count(a.player_id),2) fraction from (select player_id,min(event_date) earliest from activity group by player_id) a left join activity b on a.player_id=b.player_id and datediff(b.event_date,earliest)=1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 355, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct b.player_id) / count(distinct a.player_id),2) as fraction from (select player_id, min(event_date) as event_date from activity group by player_id) a left join activity b on a.player_id = b.player_id and datediff(b.event_date,a.event_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 356, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with first_date_cte as ( select player_id, event_date, min(event_date) over (partition by player_id) min_date from activity a ) select round(b.next_day_login / b.total_players, 2) as fraction from (select sum(case when abs(datediff(min_date, event_date)) = 1 then 1 else 0 end) as next_day_login , count(distinct player_id) as total_players from first_date_cte) b"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 357, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with t as (select player_id, min(event_date) as first_login from activity group by player_id) select round(count(distinct a.player_id)/count(t.player_id),2) as fraction from activity a right join t on a.player_id = t.player_id and datediff(a.event_date, t.first_login) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 358, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(sum(case when a.player_id is null then 0 else 1 end)/count(tmp.player_id)*1.0,2)as fraction from (select player_id, min(event_date) as first_date from activity group by 1) tmp left join (select distinct player_id, event_date from activity) a on tmp.player_id=a.player_id and datediff(a.event_date,tmp.first_date)=1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 359, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with first_login as ( select player_id, min(event_date) as first_login from activity group by player_id ) , second_day as ( select distinct a.player_id from activity a left join first_login b on a.player_id=b.player_id where datediff(a.event_date, b.first_login)=1 ) select round(count(distinct a.player_id)/count(distinct b.player_id),2) as fraction from second_day a, activity b"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 360, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(distinct a2.player_id)/count(distinct a1.player_id),2) as fraction from activity a1 left join activity a2 on a1.player_id = a2.player_id and datediff(a2.event_date,a1.event_date) = 1 where (a1.player_id,a1.event_date) in (select player_id,min(event_date) from activity group by player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 361, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(1) / (select count(distinct player_id) from activity),2) as fraction from activity where (player_id, event_date) in (select player_id, date_add(min(event_date), interval 1 day) from activity group by player_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 362, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with cte as( select *, min(event_date) over(partition by player_id order by event_date) as min_date from activity ) select round((count(distinct player_id) /(select count(distinct player_id) from activity) ),2) as fraction from cte where datediff(event_date,min_date)=1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 363, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round(count(b.player_id) / count(a.player_id), 2) as fraction from ( select player_id, min(event_date) as first_login from activity group by player_id ) as a left join activity as b on a.first_login = b.event_date - 1 and a.player_id = b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 364, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "with temp as (select player_id,event_date, lead(event_date,1) over(partition by player_id order by event_date asc) as next_date, row_number() over(partition by player_id order by event_date asc) as idx from activity) select round(count(*)/(select count(distinct temp.player_id) from temp),2) as fraction from temp where temp.idx = 1 and datediff(ifnull(temp.next_date,temp.event_date), temp.event_date) = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/550.csv", "index": 365, "schema": "create table activity (player_id integer not null, event_date date not null, device_id integer, games_played integer, constraint pk_activity primary key (player_id, event_date), constraint check_activity check (games_played >= 0));", "pair": ["select round((sum(case when (temp.min_date + 1) = a.event_date then 1 else 0 end) / count(distinct temp.player_id)), 2) as fraction from (select player_id, min(event_date) as min_date from activity group by player_id) as temp join activity as a on temp.player_id = a.player_id", "select round((b2.replayer_num / (select count(distinct(player_id)) from activity) ),2) as fraction from ( select count(a1.player_id) as replayer_num from activity as a1 join ( select player_id, min(event_date) as first_login from activity group by player_id ) a2 where a1.player_id = a2.player_id and datediff(a1.event_date, a2.first_login) = 1 ) b2"]}
