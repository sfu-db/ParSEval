{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 307, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as ( select f1.followee, f1.follower, f2.follower as 2nd from follow f1 right join follow f2 on f1.follower=f2.followee ) select follower, count(distinct 2nd) as num from cte where follower is not null group by follower order by follower"]}
