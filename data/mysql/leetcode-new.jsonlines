{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 164, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select a.customer_id, count(ifnull(a.amount,1)) count_no_trans from (select a.customer_id, b.amount from visits a left join transactions b on a.visit_id=b.visit_id where b.amount is null) a group by a.customer_id order by count_no_trans desc"]}
