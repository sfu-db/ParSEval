{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 448, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e.employee_id, name, reports_count, average_age from ( select distinct(reports_to) as employee_id, count(reports_to) as reports_count, round(avg(age), 0) as average_age from employees where reports_to is not null group by reports_to ) tmp join employees as e on e.employee_id = tmp.employee_id order by e.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 449, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with cte as (select b.employee_id as employee_id, b.name as name, a.age as age from employees a, employees b where b.employee_id = a.reports_to) select employee_id, name, count(employee_id) as reports_count, round(avg(age), 0) as average_age from cte group by employee_id order by employee_id"]}
