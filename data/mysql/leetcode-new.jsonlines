{"benchmark": "benchmark/leetcode/raw_data/1211.csv", "index": 298, "schema": "create table queries (query_name varchar(30), result varchar(30), position integer, rating integer, constraint check_queries check (1 <= rating and rating <= 5 and 1 <= position and position <= 500));", "pair": ["select query_name, round(avg(rating/position), 2) as quality, round(100*sum(case when rating<3 then 1 else 0 end)/count(1), 2) as poor_query_percentage from queries group by query_name", "with part1 as ( select query_name ,position ,rating ,rating/position as pre_quality ,case when rating < 3 then 1 else 0 end as poor_query from queries ) select query_name ,round(avg(pre_quality), 2) as quality ,round(100 * avg(poor_query), 2) as poor_query_percentage from part1 group by query_name"]}
