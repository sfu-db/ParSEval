{"benchmark": "benchmark/leetcode/raw_data/1264.csv", "index": 455, "schema": "create table friendship (user1_id integer not null, user2_id integer not null, constraint pk_friendship primary key (user1_id, user2_id), constraint check_friendship check (user1_id <> user2_id)); create table likes (user_id integer not null, page_id integer not null, constraint pk_likes primary key (user_id, page_id));", "pair": ["select distinct page_id as recommended_page from (select case when user1_id=1 then user2_id when user2_id=1 then user1_id else null end as user_id from friendship) as tb1 join likes as tb2 on tb1.user_id=tb2.user_id where page_id not in (select page_id from likes where user_id=1)", "select distinct page_id as recommended_page from likes where page_id in (select page_id from likes l, friendship f where user_id = user1_id and user2_id = 1 union select page_id from likes l, friendship f where user_id = user2_id and user1_id = 1) and page_id not in (select page_id from likes where user_id = 1)"]}
