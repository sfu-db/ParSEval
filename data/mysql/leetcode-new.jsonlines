{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 730, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sales_report as ( select a.product_id , a.product_name , sum(case when sale_date between '2019-01-01' and '2019-03-31' then quantity else 0 end) as 2019_spring_sales , sum(case when sale_date between '2019-01-01' and '2019-03-31' then 0 else quantity end) as other_sales from product a inner join sales b on a.product_id = b.product_id group by 1, 2 ) select product_id , product_name from sales_report where other_sales = 0 and 2019_spring_sales > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 731, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product where product_id not in (select product_id from sales where sale_date<'2019-01-01'or sale_date>'2019_03-31')"]}
