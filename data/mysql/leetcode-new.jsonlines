{"benchmark": "benchmark/leetcode/raw_data/1693.csv", "index": 26, "schema": "create table dailysales (date_id date, make_name varchar(30), lead_id integer, partner_id integer, constraint check_dailysales check (lead_id <> partner_id));", "pair": ["select date_id, make_name, count(distinct lead_id) as unique_leads, count(distinct partner_id) as unique_partners from dailysales group by date_id, make_name", "select date_id, make_name, (select count(*) from (select lead_id from dailysales where date_id = d.date_id and make_name = d.make_name group by lead_id) t) as unique_leads, (select count(*) from (select partner_id from dailysales where date_id = d.date_id and make_name = d.make_name group by partner_id) t) as unique_partners from dailysales d group by date_id, make_name"]}
