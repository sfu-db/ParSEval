{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 130, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand, a.operator, a.right_operand, case when operator = '=' and a.lov= a.rov then true when operator = '>' and a.lov> a.rov then true when operator = '<' and a.lov< a.rov then true else false end as value from ( select a.*,b.value as lov, c.value as rov from expressions a left outer join variables b on a.left_operand = b.name left outer join variables c on a.right_operand = c.name )a"]}
{"benchmark": "benchmark/leetcode/raw_data/1440.csv", "index": 131, "schema": "create table variables (name varchar(30) not null, value integer, constraint pk_variables primary key (name)); create table expressions (left_operand varchar(30) not null, operator varchar(30) not null, right_operand varchar(30) not null, constraint pk_expressions primary key (left_operand, operator, right_operand), foreign key (left_operand) references variables (name), foreign key (right_operand) references variables (name), constraint check_expressions check (operator in (\"<\", \">\", \"=\")));", "pair": ["select a.*, case when ((b.value < c.value and a.operator = '<') or (b.value = c.value and a.operator = '=') or (b.value > c.value and a.operator = '>')) then true else false end as value from expressions as a join variables as b on a.left_operand = b.name join variables as c on a.right_operand = c.name", "select a.left_operand,a.operator,a.right_operand, if(if(a.operator='=', b.value=c.value, if(a.operator='>', b.value>c.value, b.value<c.value))=1, 'true', 'false') as value from expressions as a join variables as b on a.left_operand=b.name join variables as c on a.right_operand=c.name"]}
