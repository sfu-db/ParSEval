{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 79, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select manager as employee_id, name, count(employee) as reports_count, round(avg(age)) as average_age from (select e1.employee_id as manager, e2.employee_id as employee, e2.age as age, e1.name as name from employees as e1 inner join employees as e2 on e1.employee_id = e2.reports_to ) as abc group by employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 80, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select t1.employee_id, t1.name, count(t2.employee_id) reports_count, round(avg(t2.age), 0) average_age from employees t1 left join employees t2 on t1.employee_id = t2.reports_to where t2.reports_to is not null group by 1 order by employee_id"]}
