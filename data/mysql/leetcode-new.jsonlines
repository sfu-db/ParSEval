{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 510, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with t1 as ( select v.customer_id, count(v.visit_id)-sum(case when t.transaction_id is not null then 1 else 0 end) as count_no_trans from visits v left join transactions t on v.visit_id = t.visit_id group by v.customer_id) select * from t1 where count_no_trans != 0"]}
