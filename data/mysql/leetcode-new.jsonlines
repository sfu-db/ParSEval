{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 228, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(grand_slams_count) as grand_slams_count from players p, ( select wimbledon as player_id, count(wimbledon) as grand_slams_count from championships group by wimbledon union all select fr_open as player_id, count(fr_open) as grand_slams_count from championships group by fr_open union all select us_open as player_id, count(us_open) as grand_slams_count from championships group by us_open union all select au_open as player_id, count(au_open) as grand_slams_count from championships group by au_open) as t where p.player_id = t.player_id group by p.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 229, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(grand_slams_count) grand_slams_count from ((select c.wimbledon player_id, count(*) grand_slams_count from players p right join championships c on c.wimbledon = p.player_id group by c.wimbledon) union all (select c.fr_open player_id, count(*) grand_slams_count from players p right join championships c on c.fr_open = p.player_id group by c.fr_open) union all (select c.us_open player_id, count(*) grand_slams_count from players p right join championships c on c.us_open = p.player_id group by c.us_open) union all (select a.au_open player_id, count(*) grand_slams_count from players p right join championships a on a.au_open = p.player_id group by a.au_open)) t inner join players p on p.player_id = t.player_id group by t.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 230, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(if(c.wimbledon = p.player_id, 1, 0) + if(c.fr_open = p.player_id, 1, 0) + if(c.us_open = p.player_id, 1, 0) + if(c.au_open = p.player_id, 1, 0)) as grand_slams_count from players p, championships c group by 1, 2 having grand_slams_count > 0"]}
