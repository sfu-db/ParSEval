{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 564, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with balance as( select account ,sum(amount) over(partition by account order by transacted_on) as balance ,row_number() over(partition by account order by transacted_on desc) as num from transactions ) select distinct u.name ,balance from balance b join users u on b.account = u.account where num=1 and balance > 10000"]}
