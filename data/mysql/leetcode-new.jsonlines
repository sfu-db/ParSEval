{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 454, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s.buyer_id from sales s, product p where s.product_id = p.product_id and p.product_name = 's8' and s.buyer_id not in ( select buyer_id from sales s1, product p1 where p1.product_name = 'iphone' and s1.product_id = p1.product_id )"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 455, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from product p join sales s on p.product_id = s.product_id where p.product_name = 's8' and s.buyer_id not in (select s1.buyer_id from product p1 join sales s1 on p1.product_id = s1.product_id where p1.product_name = 'iphone' )"]}
