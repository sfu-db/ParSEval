{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 141, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "select refined_activity.day, count(*) as active_users from ( select activity_date as day , count(*) from activity group by activity_date, user_id having activity_date >= '2019-06-28' ) as refined_activity group by refined_activity.day"]}
{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 142, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "with count_a as ( select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by day) select day, active_users from count_a order by day asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 143, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "with cte as ( select activity_date, user_id, count(session_id) as active from activity group by activity_date, user_id) select activity_date as day, count(user_id) as active_users from cte where activity_date < '2019-07-28' and activity_date > '2019-06-27' group by activity_date"]}
