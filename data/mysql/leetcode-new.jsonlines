{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 655, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct a1.buyer_id from (select sales.buyer_id,product.product_name from sales join product on sales.product_id = product.product_id) a1 where a1.product_name = 's8' and a1.buyer_id not in (select distinct a1.buyer_id from (select sales.buyer_id,product.product_name from sales join product on sales.product_id = product.product_id) a1 where a1.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 656, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s.buyer_id from product p inner join sales s on p.product_id=s.product_id where p.product_name='s8' and s.buyer_id not in( select s1.buyer_id from product p1 inner join sales s1 on p1.product_id=s1.product_id where p1.product_name='iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 657, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct ss8.buyer_id from sales as ss8 inner join product as ps8 on ps8.product_id = ss8.product_id and product_name = 's8' left join (select s.buyer_id, s.product_id from sales s inner join product as piphone on piphone.product_id = s.product_id and piphone.product_name = 'iphone') as siphone on ss8.buyer_id = siphone.buyer_id where siphone.product_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 658, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with ip as (select buyer_id from product p join sales s on s.product_id = p.product_id where product_name = 'iphone' ) select s.buyer_id from product p join sales s on s.product_id = p.product_id left join ip on ip.buyer_id = s.buyer_id where p.product_name = 's8' and ip.buyer_id is null group by 1"]}
