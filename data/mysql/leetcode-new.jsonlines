{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 89, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with immediate_orders as( select count(*) as order_count from delivery where order_date=customer_pref_delivery_date ) select round((order_count/(select count(*) as total_count from delivery)*100), 2) as immediate_percentage from immediate_orders"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 90, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with immediates as ( select * from delivery where order_date = customer_pref_delivery_date ) select round(count(immediates.delivery_id) / count(delivery.delivery_id) * 100, 2) as immediate_percentage from delivery left join immediates on delivery.delivery_id = immediates.delivery_id"]}
