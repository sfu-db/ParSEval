{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 429, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from (select account_id, login, ip_address,lead(login,1,null) over(partition by account_id order by login asc) as ld_login,logout, lead(ip_address,1,null) over(partition by account_id order by login asc) as ld_ip from loginfo) a where a.ld_login is not null and a.ip_address <> a.ld_ip and a.ld_login between a.login and a.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 430, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct acc1 as account_id from(select l1.account_id as acc1,l1.ip_address as a1,l2.account_id as acc2,l2.ip_address as a2, case when (l1.login<=l2.login and l1.logout>=l2.login) then 'banned' when l1.login>=l2.login and l1.logout<=l2.logout then 'banned' when l2.login<=l1.login and l2.logout>=l1.login and l2.logout<=l1.logout then 'banned' else 'unbanned' end as ban from loginfo l1 join loginfo l2 using (account_id) where l1.ip_address<l2.ip_address )b where ban='banned'"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 431, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with tmp as ( select account_id, case when logout >= lead(login) over (partition by account_id order by login) and ip_address != lead(ip_address) over (partition by account_id order by login) then 1 else 0 end cc from loginfo li order by login) select distinct account_id from tmp where cc = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 432, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a, loginfo b where a.account_id = b.account_id and a.ip_address != b.ip_address and b.login >= a.login and b.login <= a.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 433, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address < l2.ip_address where (l2.login <= l1.login and l1.login <= l2.logout) or (l1.login <= l2.login and l2.login <= l1.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 434, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with t as (select a.account_id, a.login as login1, a.logout as logout1, b.login as login2, b.logout as logout2 from loginfo a join loginfo b on a.account_id=b.account_id where a.ip_address<>b.ip_address) select distinct (account_id) from t where login1 between login2 and logout2"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 435, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct account_id from (select account_id, ip_address, lead(ip_address,1) over (partition by account_id order by login asc) as next_ip, logout, lead(login,1) over (partition by account_id order by login asc) as next_in from loginfo) a where logout>= next_in and ip_address!=next_ip"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 436, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct(l1.account_id) account_id from loginfo l1 inner join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address > l2.ip_address and (l1.login between l2.login and l2.logout or l2.login between l1.login and l1.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 437, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select a.account_id as account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.ip_address <> b.ip_address where a.login between b.login and b.logout or b.login between a.login and a.logout group by a.account_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 438, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a, loginfo b where a.account_id = b.account_id and a.ip_address != b.ip_address and ((a.login >= b.login and a.login <= b.logout) or (a.logout >= b.login and a.logout <= b.logout))"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 439, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.login <= l2.logout and l1.account_id = l2.account_id and l1.ip_address <> l2.ip_address and l1.login >= l2.login"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 440, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo as l1 inner join loginfo as l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address where (l2.login >= l1.login and l2.login <= l1.logout) or (l2.logout >= l1.login and l2.logout <= l1.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 441, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where l1.account_id = l2.account_id and l1.login between l2.login and l2.logout and l1.ip_address !=l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 442, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct new.account_id from loginfo new, loginfo old where new.login between (old.login) and(old.logout) and new.account_id = old.account_id and new.ip_address != old.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 443, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 inner join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address where (l1.login between l2.login and l2.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 444, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where ((l1.login >= l2.login and l1.login <= l2.logout) or (l1.login <= l2.login and l1.logout >= l2.login)) and l1.account_id = l2.account_id and l1.ip_address != l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 445, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a left join loginfo b on a.account_id = b.account_id and a.ip_address != b.ip_address where (a.logout >= b.login and a.logout <= b.logout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 446, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.ip_address != b.ip_address and a.login < b.login where (a.logout- b.login) >=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 447, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.login between b.login and b.logout and a.ip_address != b.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 448, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with cte as ( select account_id, ip_address, lead(ip_address, 1) over (partition by account_id order by login asc) as next_ip_address, login, logout, lead(login, 1) over (partition by account_id order by login asc) as next_login from loginfo ) select distinct account_id from cte where logout >= next_login and ip_address != next_ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 449, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct t1.account_id from loginfo t1 join loginfo t2 on t1.account_id = t2.account_id and t1.ip_address != t2.ip_address where not (t2.logout < t1.login or t1.logout < t2.login)"]}
