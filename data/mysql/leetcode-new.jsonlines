{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 95, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t.player as player_id, p.player_name, count(*) as grand_slams_count from ( select year, wimbledon as player from championships union all select year, fr_open as player from championships union all select year, us_open as player from championships union all select year, au_open as player from championships) as t left join players p on t.player = p.player_id group by 1"]}
