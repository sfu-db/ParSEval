{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 187, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select distinct a.product_id, p.product_name from ( select distinct product_id from sales s where sale_date between '2019-01-01' and '2019-03-31' ) a left join ( select distinct product_id from sales s where sale_date not between '2019-01-01' and '2019-03-31' ) b on a.product_id=b.product_id join product p on a.product_id=p.product_id where b.product_id is null"]}
