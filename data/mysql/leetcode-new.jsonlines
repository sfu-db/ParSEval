{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 386, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with tmp as ( select *, lead(login,1) over (partition by account_id order by login) as lead_login, lead(ip_address,1) over (partition by account_id order by login) as lead_address from loginfo) select distinct account_id from tmp where lead_login <= logout and ip_address <> lead_address"]}
