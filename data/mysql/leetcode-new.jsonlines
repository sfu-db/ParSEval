{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 408, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select vis.customer_id as customer_id, count(*) as count_no_trans from visits as vis left join transactions as trx on vis.visit_id = trx.visit_id where trx.visit_id is null group by vis.customer_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 409, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "with full_table as ( select visits.visit_id, visits.customer_id, transactions.transaction_id, transactions.amount from visits left outer join transactions on visits.visit_id = transactions.visit_id union select visits.visit_id, visits.customer_id, transactions.transaction_id, transactions.amount from visits right outer join transactions on visits.visit_id = transactions.visit_id ) select customer_id, count(*) as count_no_trans from ( select customer_id from full_table where amount is null ) as subquery group by customer_id order by count(*) desc, customer_id"]}
