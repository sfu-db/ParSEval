{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 766, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "with tmp as ( select account, sum(amount) as balance from transactions group by account having sum(amount) > 10000 ) select u.name, tmp.balance from users u join tmp on u.account = tmp.account"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 767, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select name, sum(t.amount) as balance from users as u left join transactions as t on u.account = t.account group by u.account having sum(t.amount) > 10000"]}
{"benchmark": "benchmark/leetcode/raw_data/1587.csv", "index": 768, "schema": "create table users (account integer not null, name varchar(30), constraint pk_users primary key (account), constraint u_name unique (name)); create table transactions (trans_id integer not null, account integer, amount integer, transacted_on date, constraint pk_transactions primary key (trans_id), foreign key (account) references users (account));", "pair": ["select u.name,sum(t.amount) as balance from users u,transactions t where u.account = t.account group by t.account having sum(t.amount) > 10000", "select users.name, sum(transactions.amount) as balance from transactions left join users on users.account=transactions.account group by transactions.account having sum(transactions.amount)>10000"]}
