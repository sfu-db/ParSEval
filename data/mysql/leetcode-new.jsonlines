{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 143, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with bins as( select '[0-5>' as bin, 0 as min,5 as max,1 as od union all select '15 or more' as bin, 15 as min,null as max,4 as od union all select '[5-10>' as bin, 5 as min,10 as max,2 as od union all select '[10-15>' as bin, 10 as min,15 as max,3 as od ) select bin as bin,count(session_id) as total from bins b left join sessions s on s.duration/60.0 >= b.min and ( b.max is null or s.duration/60.0 < b.max ) group by 1 order by od"]}
