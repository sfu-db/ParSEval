{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 301, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t.player_id, player_name, sum(grand_slams_count) as grand_slams_count from (select wimbledon as player_id, count(wimbledon) as grand_slams_count from championships group by 1 union all select fr_open as player_id, count(fr_open) as grand_slams_count from championships group by 1 union all select us_open as player_id, count(us_open) as grand_slams_count from championships group by 1 union all select au_open as player_id, count(au_open) as grand_slams_count from championships group by 1) t inner join players p on p.player_id = t.player_id group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 302, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select t1.player_id, t1.player_name, sum(if(player_id = t2.wimbledon, 1, 0)) + sum(if(player_id = t2.fr_open, 1, 0)) + sum(if(player_id = t2.us_open, 1, 0)) + sum(if(player_id = t2.au_open, 1, 0)) as grand_slams_count from players t1 join championships t2 on t2.wimbledon = t1.player_id or t2.fr_open = t1.player_id or t2.us_open = t1.player_id or t2.au_open = t1.player_id group by t1.player_id"]}
