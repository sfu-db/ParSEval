{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 536, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with s8_buyers as (select distinct s.buyer_id, s.product_id from sales s join product p on s.product_id = p.product_id where p.product_name = 's8') select buyer_id from s8_buyers where buyer_id not in (select s.buyer_id from product p join sales s on p.product_id = s.product_id where p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 537, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select s.buyer_id from product p inner join sales s on p.product_id = s.product_id group by s.buyer_id having sum(case when p.product_name = 'iphone' then 1 else 0 end) =0 and sum(case when p.product_name = 's8' then 1 else 0 end) >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 538, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with cte1 as (select product_id from product where product_name='s8'), cte2 as (select product_id from product where product_name='iphone'), cte3 as (select distinct buyer_id from sales s join cte1 on cte1.product_id=s.product_id), cte4 as (select distinct buyer_id from sales s join cte2 on cte2.product_id=s.product_id) select cte3.buyer_id from cte3 left join cte4 on cte3.buyer_id=cte4.buyer_id where cte4.buyer_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 539, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct(buyer_id) from (select s.buyer_id from sales as s left outer join product as p using (product_id) where p.product_name = 's8' ) as samsung left outer join (select s.buyer_id from sales as s left outer join product as p using (product_id) where p.product_name = 'iphone') as apple using (buyer_id) where apple.buyer_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 540, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales a inner join product b on a.product_id=b.product_id where b.product_name = 's8' and buyer_id not in ( select e.buyer_id from sales e inner join product f on e.product_id=f.product_id where f.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 541, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with buys as ( select s.buyer_id, p.product_name from sales s inner join product p on s.product_id = p.product_id ) select distinct buyer_id from sales where buyer_id in (select buyer_id from buys where product_name = 's8' ) and buyer_id not in (select buyer_id from buys where product_name = 'iphone' )"]}
