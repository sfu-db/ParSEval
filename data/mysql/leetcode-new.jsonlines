{"benchmark": "benchmark/leetcode/raw_data/1581.csv", "index": 734, "schema": "create table visits (visit_id integer not null, customer_id integer, constraint pk_visits primary key (visit_id)); create table transactions (transaction_id integer not null, visit_id integer, amount integer, constraint pk_transactions primary key (transaction_id), foreign key (visit_id) references visits (visit_id));", "pair": ["select customer_id, count(*) as count_no_trans from visits where visit_id not in (select distinct visit_id from transactions) group by customer_id", "select v.customer_id, sum(if(t.transaction_id is null, 1, 0)) as count_no_trans from visits as v left join transactions as t on v.visit_id = t.visit_id group by v.customer_id having count_no_trans > 0"]}
