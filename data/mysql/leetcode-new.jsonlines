{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 671, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales s1 join product p1 on s1.product_id = p1.product_id group by buyer_id having sum(p1.product_name = 's8') > 0 and sum(p1.product_name = 'iphone') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 672, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with t as( select buyer_id from sales as s join product as p on s.product_id =p.product_id where product_name='s8'), t1 as( select buyer_id from sales as s join product as p on s.product_id =p.product_id where product_name='iphone') select distinct buyer_id from sales where buyer_id in (select t.buyer_id from t) and buyer_id not in (select t1.buyer_id from t1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 673, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from sales where product_id in (select product_id from product where product_name = 's8') and buyer_id not in (select buyer_id from sales where product_id in (select product_id from product where product_name = 'iphone')) group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 674, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "with product_buyer as ( select distinct product_name, buyer_id from sales s inner join product p on s.product_id = p.product_id ) select p1.buyer_id from product_buyer p1 left join product_buyer p2 on p1.buyer_id = p2.buyer_id and p2.product_name = 'iphone' where p1.product_name = 's8' and p2.buyer_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 675, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from ( select buyer_id, sum(case when p.product_name = 's8' then 1 else 0 end) s8, sum(case when p.product_name = 'iphone' then 1 else 0 end) iphone from sales s join product p on s.product_id = p.product_id group by buyer_id ) v where v.s8 > 0 and v.iphone = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 676, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales where buyer_id in (select distinct a.buyer_id from sales a left join product b on a.product_id = b.product_id where b.product_name = 's8') and buyer_id not in (select distinct a.buyer_id from sales a left join product b on a.product_id = b.product_id where b.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 677, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from product p1 join sales s1 on p1.product_id = s1.product_id group by buyer_id having sum(product_name = 's8') > 0 and sum(product_name = 'iphone') = 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 678, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct s.buyer_id from product p right join sales s on p.product_id = s.product_id group by s.buyer_id having sum(case when p.product_name = 'iphone' then 1 else 0 end) =0 and sum(case when p.product_name = 's8' then 1 else 0 end) >0"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 679, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select distinct buyer_id from sales s inner join product p on s.product_id = p.product_id where p.product_name = 's8' and buyer_id not in (select buyer_id from sales s inner join product p on s.product_id = p.product_id and p.product_name = 'iphone')"]}
{"benchmark": "benchmark/leetcode/raw_data/1083.csv", "index": 680, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0 and product_name in (\"s8\", \"iphone\"))); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select distinct sales.buyer_id as buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 's8' and sales.buyer_id not in ( select sales.buyer_id from product inner join sales on sales.product_id = product.product_id where product_name = 'iphone')", "select buyer_id from ( select buyer_id, sum(case when p1.product_name = 's8' then 1 else 0 end) as s8_cnt, sum(case when p1.product_name = 'iphone' then 1 else 0 end) as iphone_cnt from sales as s1 inner join product p1 on s1.product_id = p1.product_id group by buyer_id ) as pc where s8_cnt>0 and iphone_cnt = 0"]}
