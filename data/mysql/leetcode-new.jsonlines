{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 82, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with cte1 as ( select count(*) as imm from delivery where order_date = customer_pref_delivery_date ), cte2 as (select count(*) as total from delivery) select round(((imm/total) * 100),2) as immediate_percentage from cte1, cte2"]}
