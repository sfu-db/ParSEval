{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 200, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, e2.reports_count, e2.average_age from employees e1 join (select count(name) as reports_count,reports_to, round(avg(age)) as average_age from employees group by reports_to) e2 on e1.employee_id = e2.reports_to order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 201, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, sum(case when e2.reports_to is not null then 1 end) as reports_count, round(avg(e2.age),0) as average_age from employees e1 inner join employees e2 on e1.employee_id = e2.reports_to group by e1.employee_id, e1.name order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 202, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name,count(e2.reports_to) as reports_count, round(avg(e2.age),0) as average_age from employees e1 join employees e2 on e1.employee_id = e2.reports_to group by 1,2 order by e1.employee_id"]}
