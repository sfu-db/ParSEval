{"benchmark": "benchmark/leetcode/raw_data/1141.csv", "index": 346, "schema": "create table activity (user_id integer, session_id integer, activity_date date, activity_type varchar(30), constraint check_activity check (activity_type in (\"open_session\", \"end_session\", \"scroll_down\", \"send_message\")));", "pair": ["select activity_date as day, count(distinct user_id) as active_users from activity where activity_date between '2019-06-28' and '2019-07-27' group by activity_date", "select activity_date as day, count(distinct user_id) as active_users from activity where activity_date >= '2019-06-28' group by activity_date having count(distinct user_id) > 0"]}
