{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 485, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte as ( select followee as follower, count(follower) as num from follow group by followee union all select follower, 0 as num from follow ) select distinct follower, sum(num) as num from cte where follower in (select followee from follow group by followee having count(follower)>=1) and follower in (select follower from follow ) group by follower having sum(num)>0 order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 486, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "select follower, num from (select distinct follower, (select count(f2.followee) from follow f2 where f2.followee = f1.follower) as num from follow f1) as s where s.num > 0 order by follower asc"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 487, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with cte1 as( select followee, count(follower) as follower_counts from follow group by 1 ), cte2 as( select follower, count(followee) as followee_counts from follow group by 1 ) select followee as follower, follower_counts as num from cte1 where followee in( select distinct follower from cte2 ) order by follower"]}
{"benchmark": "benchmark/leetcode/raw_data/614.csv", "index": 488, "schema": "create table follow (followee varchar(30) not null, follower varchar(30) not null, constraint pk_follow primary key (followee, follower), constraint check_follow check (followee <> follower));", "pair": ["select followee as follower, count(followee) as num from follow where followee in (select follower from follow) group by 1 order by 1", "with followees as ( select followee, count(*) as num_followed_by from follow group by 1 ), followers as ( select follower, count(*) as num_follows from follow group by 1 ) select f1.followee as follower, f1.num_followed_by as num from followees f1 inner join followers f2 on f1.followee = f2.follower order by 1 asc"]}
