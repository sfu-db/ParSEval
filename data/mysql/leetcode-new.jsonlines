{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 254, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with cte as (select *, case when duration between 0 and 299 then '[0-5>' when duration between 300 and 599 then '[5-10>' when duration between 600 and 899 then '[10-15>' else '15 or more' end as bin from sessions), cte2 as (select '[0-5>' as bin union select '[5-10>' union select '[10-15>' union select '15 or more') select cte2.bin, ifnull(c, 0) as total from cte2 left join (select bin, count(session_id) as c from cte group by bin) w on cte2.bin=w.bin"]}
