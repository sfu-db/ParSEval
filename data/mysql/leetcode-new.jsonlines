{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 156, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "select name, sum(ifnull(rest,0)) as rest, sum(ifnull(paid,0)) as paid, sum(ifnull(canceled,0)) as canceled, sum(ifnull(refunded,0)) as refunded from invoice right join product on invoice.product_id = product.product_id group by name order by name"]}
{"benchmark": "benchmark/leetcode/raw_data/1677.csv", "index": 157, "schema": "create table product (product_id integer not null, name varchar(30), constraint pk_product primary key (product_id)); create table invoice (invoice_id integer not null, product_id integer, rest integer, paid integer, canceled integer, refunded integer, constraint pk_invoice primary key (invoice_id), foreign key (product_id) references product (product_id), constraint check_invoice check (rest >= 0 and paid >= 0 and canceled >= 0 and refunded >= 0));", "pair": ["select p.name as name, ifnull(sum(rest), 0) as rest, ifnull(sum(paid), 0) as paid, ifnull(sum(canceled),0) as canceled, ifnull(sum(refunded),0) as refunded from invoice i right join product p on p.product_id = i.product_id group by p.name order by p.name", "select name, sum(case when rest is not null then rest else 0 end) as rest, sum(case when paid is not null then paid else 0 end) as paid, sum(case when canceled is not null then canceled else 0 end) as canceled, sum(case when refunded is not null then refunded else 0 end) as refunded from product left join invoice using (product_id) group by name order by name"]}
