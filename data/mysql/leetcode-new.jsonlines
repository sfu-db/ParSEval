{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 86, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with tmp as (select p.*, e.experience_years from project p join employee e on p.employee_id = e.employee_id) select project_id, round(sum(experience_years)/count(*), 2) average_years from tmp group by project_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 87, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "with cte as (select p.project_id as project_id ,p.employee_id as employee_id, e.experience_years as experience_years from project p ,employee e where p.employee_id=e.employee_id) select project_id,round(sum(experience_years)/count(experience_years),2) as average_years from cte group by project_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 88, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select p.project_id, round((sum(e.experience_years)/count(p.employee_id)),2) as average_years from project p left join employee e on p.employee_id = e.employee_id group by project_id"]}
