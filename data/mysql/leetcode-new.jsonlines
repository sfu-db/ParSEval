{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 265, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(ifnull(ch.apple_count, 0) + bx.apple_count) as apple_count, sum(ifnull(ch.orange_count, 0) + bx.orange_count) as orange_count from boxes bx left join chests ch on bx.chest_id = ch.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 266, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "with t1 as( select b.apple_count box_apple_count, b.orange_count box_orange_count, if(c.apple_count is not null, c.apple_count, 0) chest_apple_count, if(c.orange_count is not null, c.orange_count, 0) chest_orange_count from boxes b left join chests c on b.chest_id=c.chest_id ) select sum(box_apple_count)+sum(chest_apple_count) apple_count, sum(box_orange_count)+sum(chest_orange_count) orange_count from t1"]}
