{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 645, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with first_quarter_products as ( select sales.product_id as product_id from sales where '2019-01-01' <= sales.sale_date and sales.sale_date <= '2019-03-31' ), non_first_quarter_products as ( select sales.product_id as product_id from sales where sales.sale_date < '2019-01-01' or '2019-03-31' < sales.sale_date ), only_first_quarter_products as ( select product_id as product_id from first_quarter_products where product_id not in (select * from non_first_quarter_products) ) select distinct product.product_id as product_id, product.product_name as product_name from product join only_first_quarter_products ofqp on ofqp.product_id = product.product_id"]}
