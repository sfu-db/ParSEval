{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 698, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with temp as(select p.product_id as product_id, p.product_name, s.sale_date from product p left join sales s on p.product_id = s.product_id where sale_date not between '2019-01-01' and '2019-03-31') select p2.product_id, p2.product_name from product p2 where p2.product_id not in (select product_id from temp)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 699, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with not_2019_q1 as ( select * from sales where sale_date <'2019-01-01' or sale_date >'2019-03-31' ) select distinct product_id , product_name from product where product_id not in (select product_id from not_2019_q1 )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 700, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product where (product_id, product_name) not in (select product_id, product_name from product join sales using(product_id) where sale_date not between '2019-01-01' and '2019-03-31')"]}
