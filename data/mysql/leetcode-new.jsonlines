{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 535, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id,player_name, ((select count(*) from championships where wimbledon=p.player_id) + (select count(*) from championships where fr_open=p.player_id) + (select count(*) from championships where us_open=p.player_id) + (select count(*) from championships where au_open=p.player_id)) as grand_slams_count from players p having grand_slams_count>0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 536, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select p.player_id, p.player_name, sum(p.player_id = c.wimbledon) + sum(p.player_id = c.fr_open) + sum(p.player_id = c.us_open) + + sum(p.player_id = c.au_open) as grand_slams_count from players p inner join championships c on (p.player_id = c.wimbledon) or (p.player_id = c.fr_open) or (p.player_id = c.us_open) or (p.player_id = c.au_open) group by p.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 537, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp1 as( select *, 1 as num from( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships) as tmp) select distinct b.player_id,b.player_name, sum(num) over(partition by id) as grand_slams_count from tmp1 as a left join players as b on a.id=b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 538, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champs as ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select c.player_id, p.player_name, count(*) as grand_slams_count from champs as c join players as p on c.player_id = p.player_id group by c.player_id, p.player_name"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 539, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with tmp as (select player_id, if(wimbledon = player_id, 1, 0) + if(fr_open = player_id, 1, 0) + if(us_open = player_id, 1, 0) + if(au_open = player_id, 1, 0) total from players , championships) select tmp.player_id, player_name, sum(total) grand_slams_count from tmp inner join players on tmp.player_id = players.player_id group by player_id, player_name having sum(total) > 0"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 540, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select year, wimbledon as player_id from championships union all select year, fr_open as player_id from championships union all select year, us_open as player_id from championships union all select year, au_open as player_id from championships ) select a.player_id, b.player_name, count(*) as grand_slams_count from cte a left outer join players b on a.player_id=b.player_id group by 1,2"]}
