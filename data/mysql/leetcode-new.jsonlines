{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 144, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with actor_director_pairs as ( select actor_id as actor_id, director_id as director_id, count(*) over (partition by actor_id, director_id) as pair_count from actordirector ) select distinct actor_id as actor_id, director_id as director_id from actor_director_pairs where pair_count > 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 145, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id,director_id from( select actor_id, director_id,count(1) as count from actordirector group by actor_id, director_id )sub where count >= 3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 146, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id, director_id from ( select actor_id, director_id, count(timestamp) as cnt from actordirector group by actor_id, director_id having cnt>2 ) as tab"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 147, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select distinct actor_id , director_id from actordirector group by actor_id, director_id having count(distinct timestamp) >=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 148, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select distinct actor_id, director_id from (select actor_id, director_id, count(actor_id) as cnt from actordirector group by actor_id, director_id) as temp where cnt>=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 149, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id, director_id from actordirector group by director_id, actor_id having count(actor_id) >2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 150, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with cte as ( select sub.*, count(sub.work_pair) over(partition by sub.work_pair) as count_pair from ( select *, concat(actor_id,',',director_id) as work_pair from actordirector )sub ) select distinct actor_id, director_id from cte where count_pair > 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 151, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id, director_id from actordirector group by actor_id, director_id having count(actor_id+director_id)>=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 152, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with a as ( select actor_id , director_id , count(director_id) as x , count(actor_id) as y from actordirector where case when actor_id = director_id or actor_id != director_id then 1 else 0 end group by 1,2 ) select distinct a.actor_id , a.director_id from a left join a b on a.director_id = b.director_id where a.x = a.y and a.x >= 3 and a.y>=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 153, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select ad.actor_id as actor_id, ad.director_id as director_id from actordirector ad group by ad.actor_id, ad.director_id having count(*)>=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 154, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with t1 as (select actor_id, director_id, actor_id + ',' + director_id as pair from actordirector) select actor_id, director_id from t1 group by pair,actor_id, director_id having count(*) >=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 155, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id, director_id from actordirector group by 1,2 having count(*) > 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 156, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with raw as (select actor_id, director_id, count(timestamp) as times from actordirector group by 1,2 having count(timestamp) >= 3) select distinct actor_id, director_id from raw"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 157, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id ,director_id from ( select actor_id ,director_id ,row_number() over (partition by actor_id, director_id order by timestamp ) as rw from actordirector ) d where rw >=3 group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 158, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id,director_id from actordirector group by actor_id,director_id having count(actor_id)>=3 and count(director_id) >=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 159, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select actor_id, director_id from ( select distinct actor_id, director_id, count(*) over (partition by actor_id, director_id) cnt from actordirector) a where cnt > 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 160, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select ad.actor_id,ad.director_id from actordirector ad group by ad.director_id,actor_id having count(ad.actor_id)>=3"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 161, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "with cte as( select case when (lead(director_id) over (partition by actor_id, director_id order by timestamp)=lag(director_id) over (partition by actor_id, director_id order by timestamp)) and (lead(actor_id) over(partition by actor_id, director_id order by timestamp)=lag(actor_id) over(partition by actor_id, director_id order by timestamp)) then director_id end as director_id , case when (lead(director_id) over(partition by actor_id, director_id order by timestamp))=(lag(director_id) over(partition by actor_id, director_id order by timestamp)) and (lead(actor_id) over(partition by actor_id, director_id order by timestamp))=(lag(actor_id) over(partition by actor_id, director_id order by timestamp)) then actor_id end as actor_id from actordirector ) select distinct actor_id, director_id from cte where actor_id is not null and director_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 162, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select distinct actor_id, director_id from actordirector where (actor_id,director_id) in (select actor_id,director_id from actordirector group by 1,2 having count(*) >= 3)"]}
{"benchmark": "benchmark/leetcode/raw_data/1050.csv", "index": 163, "schema": "create table actordirector (timestamp integer not null, actor_id integer, director_id integer, constraint pk_actordirector primary key (timestamp));", "pair": ["select actor_id,director_id from actordirector group by actor_id,director_id having count(*)>=3", "select sub.actor_id, sub.director_id from ( select actor_id, director_id, count(*) as coperated_count from actordirector group by 1,2) sub where coperated_count >= 3"]}
{"benchmark": "benchmark/leetcode/raw_data/1075.csv", "index": 0, "schema": "create table project (project_id integer not null, employee_id integer not null, constraint pk_project primary key (project_id, employee_id), foreign key (employee_id) references employee (employee_id)); create table employee (employee_id integer not null, name varchar(30), experience_years integer, constraint pk_employee primary key (employee_id), constraint check_employee check (experience_years >= 0));", "pair": ["select a.project_id, round(avg(b.experience_years), 2) as average_years from project as a inner join employee as b on a.employee_id = b.employee_id group by a.project_id", "select a.project_id, round(avg(b.experience_years),2) as average_years from project a left join employee b on a.employee_id = b.employee_id group by a.project_id"]}
