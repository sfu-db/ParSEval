{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 23, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select round((sum(sub.label) / count(sub.delivery_id))*100, 2) as immediate_percentage from (select delivery_id, (case when order_date = customer_pref_delivery_date then 1 else 0 end) as label from delivery) sub"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 24, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select round((a.im/count(delivery_id)*100),2) as immediate_percentage from delivery a join (select count(*) as im from delivery d join delivery dd on d.delivery_id=dd.delivery_id where d.order_date=dd.customer_pref_delivery_date) a on a.delivery_id=a.delivery_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 25, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select round((a.immediate/b.total)*100.0, 2) as immediate_percentage from (select count(*) as immediate from delivery where order_date = customer_pref_delivery_date) as a, (select count(*) as total from delivery) as b"]}
