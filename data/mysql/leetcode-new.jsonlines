{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 801, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id,p.product_name from product p where product_id not in(select product_id from sales where quarter(sale_date)!=1 )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 802, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s.product_id, product_name from sales s join product p on s.product_id = p.product_id group by product_id having (min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 803, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select s.product_id, p.product_name from sales s join product p using (product_id) group by s.product_id, p.product_name having sum(case when s.sale_date >= '2019-01-01' and s.sale_date <= '2019-03-31' then 0 else 1 end)=0"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 804, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p left join sales s on p.product_id = s.product_id group by s.product_id having max(s.sale_date) <= '2019-03-31' and min(s.sale_date) >= '2019-01-01'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 805, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product.product_name from ( select product_id from ( select product_id, sum(sale_date >= '2019-01-01' and sale_date <= '2019-03-31') as spring_cnt, count(*) as total_cnt from sales group by product_id ) as t where (spring_cnt >= 1) and (total_cnt-spring_cnt = 0) ) as l left join product on product.product_id = l.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 806, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, product_name from product p join (select product_id, sum(flag) from (select product_id, sale_date, case when sale_date < '2019-01-01' then 1 when sale_date > '2019-03-31' then 1 else 0 end as flag from sales) x group by product_id having sum(flag) = 0) y on p.product_id = y.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 807, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p, sales s where p.product_id = s.product_id group by p.product_id having max(s.sale_date)<='2019-03-31' and min(s.sale_date)>='2019-01-01'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 808, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product.product_name from product where product.product_id not in ( select p.product_id from product as p left join sales as s on p.product_id = s.product_id where s.sale_date not between '2019-01-01' and '2019-03-31' )"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 809, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product p,(select product_id,max(sale_date) as max_sale_date,min(sale_date) as min_sale_date from sales group by product_id) s where s.product_id = p.product_id and s.min_sale_date between '2019-01-01' and '2019-03-31' and s.max_sale_date between '2019-01-01' and '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 810, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product_id, product_name from product where product_id not in ( select distinct p.product_id from sales s left join product p on s.product_id = p.product_id where sale_date < '2019-01-01' or sale_date > '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 811, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select p.product_id, p.product_name from product as p left join sales as s on p.product_id=s.product_id group by p.product_id having sum(s.sale_date between '2019-01-01' and '2019-03-31')=count(s.sale_date)"]}
