{"benchmark": "benchmark/leetcode/raw_data/1809.csv", "index": 419, "schema": "create table playback (session_id integer not null, customer_id integer, start_time integer, end_time integer, constraint pk_playback primary key (session_id), constraint check_playback check (start_time <= end_time)); create table ads (ad_id integer not null, customer_id integer, timestamp integer, constraint pk_ads primary key (ad_id));", "pair": ["select session_id from playback pb left join ads ad on pb.customer_id = ad.customer_id and ad.timestamp between start_time and end_time where ad.customer_id is null", "select session_id from ( select p.session_id, sum(case when a.timestamp between p.start_time and p.end_time then 1 else 0 end ) as ct from playback p left join ads a on p.customer_id = a.customer_id group by 1 having ct = 0)t"]}
