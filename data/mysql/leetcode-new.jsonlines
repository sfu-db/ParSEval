{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 471, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address != l2.ip_address and ( (l1.login >= l2.login and l1.login <= l2.logout) or (l1.logout >= l2.login and l1.logout<= l2.logout) )"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 472, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l1.account_id=l2.account_id and l1.logout between l2.login and l2.logout and l1.ip_address <> l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 473, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 left join loginfo l2 on l1.account_id = l2.account_id and l1.ip_address <> l2.ip_address and !(l1.logout < l2.login or l2.logout < l1.login) where l2.account_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 474, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where l1.ip_address!=l2.ip_address and l1.account_id=l2.account_id and l1.login between l2.login and l2.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 475, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 on l2.account_id = l1.account_id and l2.ip_address <> l1.ip_address and l2.login between l1.login and l1.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 476, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct li.account_id from loginfo li left join loginfo di on li.account_id = di.account_id and li.ip_address != di.ip_address and li.login <= di.logout and li.logout >= di.login where di.account_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 477, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with log as ( select account_id, ip_address, login, logout, row_number()over(partition by account_id order by login) as row1 from loginfo), log_map as (select a.account_id, a.ip_address, a.login, a.logout, a.row1,b.ip_address as l_ip, b.row1 as l_row, b.login as l_login, b.logout as l_logout from log a left join log b on a.account_id=b.account_id and a.row1=b.row1-1), fial_map as ( select *, case when logout >= l_login and ip_address<>l_ip then 1 else 0 end as banned from log_map), f_s as (select account_id, sum(banned) as banned from fial_map group by account_id) select account_id from f_s where banned>=1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 478, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with base as ( select distinct l1.account_id as id1, case when l2.account_id is not null or l3.account_id is not null then 1 else 0 end as flag from loginfo as l1 left join loginfo as l2 on l2.account_id = l1.account_id and l2.login between l1.login and l1.logout and l1.ip_address != l2.ip_address left join loginfo as l3 on l3.account_id = l1.account_id and l3.logout between l1.login and l1.logout and l1.ip_address != l3.ip_address ) select id1 as account_id from base where flag = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 479, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1, loginfo l2 where l1.account_id = l2.account_id and (l2.login <= l1.logout and l1.login <= l2.logout) and l1.ip_address != l2.ip_address"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 480, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct l1.account_id from loginfo l1 join loginfo l2 where l1.account_id=l2.account_id and l1.ip_address<>l2.ip_address and l1.login>=l2.login and l1.login<=l2.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 481, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct t1.account_id from loginfo as t1 join loginfo as t2 on t1.account_id=t2.account_id and t1.ip_address != t2.ip_address where t2.login between t1.login and t1.logout or t1.login between t2.login and t2.logout"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 482, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct account_id from loginfo l where exists ( select account_id from loginfo where (account_id = l.account_id and ip_address <> l.ip_address) and ((login >= l.login and login <= l.logout) or (logout >= l.login and logout <= l.logout) or (login <= l.login and logout >= l.logout)) )"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 483, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "with cte as (select *, lead(ip_address) over (partition by account_id order by login) next_ip, lead(login) over (partition by account_id order by login) next_login, lead(logout) over (partition by account_id order by login) next_logout from loginfo) select distinct account_id from cte where next_login<=logout and ip_address!= next_ip"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 484, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct a.account_id from loginfo a join loginfo b on a.account_id = b.account_id and a.ip_address != b.ip_address and a.login between b.login and b.logout group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1747.csv", "index": 485, "schema": "create table loginfo (account_id integer, ip_address integer, login date, logout date, constraint check_loginfo check (login < logout));", "pair": ["select distinct i1.account_id from loginfo as i1 join loginfo as i2 on (i1.account_id = i2.account_id and i1.ip_address <> i2.ip_address and i2.login between i1.login and i1.logout)", "select distinct account_id from ( select a.account_id from loginfo a join loginfo b on a.account_id=b.account_id where b.login between a.login and a.logout and a.ip_address!=b.ip_address ) x"]}
