{"benchmark": "benchmark/leetcode/raw_data/1435.csv", "index": 298, "schema": "create table sessions (session_id integer not null, duration integer, constraint pk_sessions primary key (session_id), constraint check_sessions check (duration > 0));", "pair": ["select '[0-5>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 0 and (duration / 60) < 5) union select '[5-10>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 5 and (duration / 60) < 10) union select '[10-15>' as bin, count(session_id) as total from sessions where ((duration / 60) >= 10 and (duration / 60) < 15) union select '15 or more' as bin, count(session_id) as total from sessions where (duration / 60) >= 15", "with bins as ( select '[0-5>' as bin, 0 as min, 300 as max union select '[5-10>' as bin, 300 as min, 600 as max union select '[10-15>' as bin, 600 as min, 900 as max union select '15 or more' as bin, 900 as min, null as max ) select b.bin, count(s.session_id) as total from bins b left join sessions s on s.duration >= b.min and (b.max is null or s.duration <= b.max) group by 1"]}
