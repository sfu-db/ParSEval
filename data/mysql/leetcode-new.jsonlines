{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 178, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, x.* from products cross join lateral( select 'store1' , 'store1' union all select 'store2' , 'store2' union all select 'store3' , 'store3' ) as x(store,price) where x.price is not null order by product_id, x.store"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 179, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "with s1 as (select product_id, 'store1' as store, store1 price from products where store1 is not null), s2 as (select product_id, 'store2' as store, store2 price from products where store2 is not null), s3 as (select product_id, 'store3' as store, store3 price from products where store3 is not null) select * from s1 union all select *from s2 union all select * from s3 order by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 180, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select store1 as store, store1 as price, product_id from products where store1 is not null union all select store2 as store, store2 as price, product_id from products where store2 is not null union all select store3 as store, store3 as price, product_id from products where store3 is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1795.csv", "index": 181, "schema": "create table products (product_id integer not null, store1 integer, store2 integer, store3 integer, constraint pk_products primary key (product_id));", "pair": ["select * from (select product_id, 'store1' as store, store1 as price from products union select product_id, 'store2' as store, store2 as price from products union select product_id, 'store3' as store, store3 as price from products) as t where price is not null", "select product_id, store, price from ( select product_id , case when store1 is not null then store1 end as store, case when store1 is not null then store1 end as price from products union select product_id , case when store2 is not null then store2 end as store, case when store2 is not null then store2 end as price from products union select product_id , case when store3 is not null then store3 end as store, case when store3 is not null then store3 end as price from products )x where store is not null"]}
