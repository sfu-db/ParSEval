{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 402, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sales_list as (select s.product_id,s.sale_date,p.product_name from sales s left join product p on s.product_id =p.product_id) select distinct product_id,product_name from sales_list where sale_date between '2019-01-01' and '2019-03-31' and product_id not in ( select product_id from sales_list where sale_date not between '2019-01-01' and '2019-03-31')"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 403, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with salesinfo as (select product_id , sum(case when sale_date < '2019-01-01' or sale_date > '2019-03-31' then 1 else 0 end) as flag from sales group by product_id) select product_id , product_name from product where product_id in (select product_id from salesinfo where flag = 0)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 404, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with sold as ( select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31' ), not_sold as ( select distinct product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' ) select product_id, product_name from product where product_id not in (select product_id from not_sold) and product_id in (select product_id from sold)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 405, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with spring as (select p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date between '2019-01-01' and '2019-03-31'), not_spring as (select p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date not between '2019-01-01' and '2019-03-31') select distinct(sp.product_id), sp.product_name from spring as sp where sp.product_id not in (select product_id from not_spring)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 406, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with springin as ( select product_id from sales where sale_date between '2019-01-01' and '2019-03-31' ), springout as ( select product_id from sales where sale_date<'2019-01-01' or sale_date>'2019-03-31' ) select product_id, product_name from product where product_id in (select product_id from springin) and product_id not in (select product_id from springout)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 407, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t(product_id) as ( select distinct p.product_id from product p inner join sales s on p.product_id=s.product_id where sale_date<'2019-01-01' or sale_date>'2019-03-31' ) select distinct p.product_id,p.product_name from product p inner join sales s on s.product_id=p.product_id left join t on t.product_id=s.product_id where s.sale_date between '2019-01-01' and '2019-03-31' and t.product_id is null"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 408, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as ( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') select distinct product_id, product_name from product where product_id not in (select product_id from t1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 409, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with t1 as (select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') select distinct p.product_id, p.product_name from product as p where p.product_id not in (select product_id from t1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 410, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with tab as ( select p.product_id, p.product_name, s.sale_date from product as p join sales as s on p.product_id = s.product_id ) select product_id, product_name from tab group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 411, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with temp as (select product_id from sales where sale_date< '2019-01-01' or sale_date > '2019-03-31') select distinct p.product_id, product_name from sales s join product p on s.product_id = p.product_id where sale_date>= '2019-01-01' and sale_date <= '2019-03-31' and p.product_id not in (select *from temp) order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 412, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with temp as (select product_id from sales where sale_date between '2019-01-01' and '2019-03-31' and product_id not in ( select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31' )) select distinct temp.product_id, product_name from temp join product pro on pro.product_id=temp.product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 413, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with temp as( select p.product_id, product_name, sale_date from product p right join sales s on p.product_id =s.product_id where sale_date between '2019-01-01' and '2019-03-31' ) select product_id, product_name from temp where product_id not in (select product_id from sales where sale_date not between '2019-01-01' and '2019-03-31') group by product_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 414, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with temp(product_id, product_name) as (select a.product_id, a.product_name from product a inner join sales b on a.product_id=b.product_id where sale_date <'2019-01-01' or sale_date>'2019-03-31') select a.product_id, a.product_name from product a inner join sales b on a.product_id=b.product_id group by a.product_id having a.product_id not in (select product_id from temp)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 415, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with tmp as (select a.product_id, product_name, sale_date from sales a join product b on a.product_id = b.product_id) select distinct a.product_id, product_name from tmp a where a.product_id not in (select distinct product_id from tmp where sale_date < date('2019-01-01') or sale_date > date('2019-03-31'))"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 416, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with tmp as (select distinct p.product_id, p.product_name from product p join sales s on p.product_id = s.product_id where s.sale_date between '2019-01-01' and '2019-03-31') select product_id,product_name from tmp where product_id not in (select distinct product_id as product_id from sales where datediff(sale_date,'2019-01-01')<0 or datediff(sale_date,'2019-03-31')>0)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 417, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with tmp as (select product_id, max(sale_date) maxdate, min(sale_date) mindate from sales group by 1) select a.product_id, b.product_name from tmp a inner join product b on a.product_id = b.product_id where a.maxdate <= '2019-03-31' and a.mindate >= '2019-01-01'"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 418, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as ( select product.product_id, product.product_name from product inner join sales on product.product_id = sales.product_id where sales.sale_date not between '2019-01-01' and '2019-03-31' ) select product_id, product_name from product where product_id not in ( select cte.product_id from cte )"]}
