{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 325, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with champs as ( select year, wimbledon as chm, b.player_name, 1 as slams from championships a join players b on a.wimbledon = b.player_id union all select year, fr_open as chm,b.player_name,1 as slams from championships a join players b on a.fr_open = b.player_id union all select year, us_open as chm,b.player_name,1 as slams from championships a join players b on a.us_open = b.player_id union all select year, au_open as chm,b.player_name,1 as slams from championships a join players b on a.au_open = b.player_id ) select chm as player_id, player_name,sum(slams) as grand_slams_count from champs group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 326, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with ct as ( select a.player_id, a.player_name, count(b.wimbledon) as val from players a join championships b on a.player_id = b.wimbledon group by a.player_id, a.player_name union all select a.player_id, a.player_name, count(b.fr_open) as val from players a join championships b on a.player_id = b.fr_open group by a.player_id, a.player_name union all select a.player_id,a.player_name, count(b.us_open) as val from players a join championships b on a.player_id = b.us_open group by a.player_id, a.player_name union all select a.player_id,a.player_name, count(b.au_open) as val from players a join championships b on a.player_id = b.au_open group by a.player_id, a.player_name) select distinct player_id, player_name, sum(val) over(partition by player_id) as grand_slams_count from ct"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 327, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( (select p.player_id, p.player_name, count(c.wimbledon) as c from players p inner join championships c on p.player_id = c.wimbledon group by 1) union all (select p.player_id, p.player_name, count(c.fr_open) from players p inner join championships c on p.player_id = c.fr_open group by 1) union all (select p.player_id, p.player_name, count(c.us_open) from players p inner join championships c on p.player_id = c.us_open group by 1) union all (select p.player_id, p.player_name, count(c.au_open) from players p inner join championships c on p.player_id = c.au_open group by 1) ) select player_id, player_name, sum(c) as grand_slams_count from cte group by 1 order by 2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 328, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select c.year,p.player_id,p.player_name from championships c inner join players p on p.player_id = c.wimbledon union all select c.year,p.player_id,p.player_name from championships c inner join players p on p.player_id = c.fr_open union all select c.year,p.player_id,p.player_name from championships c inner join players p on p.player_id = c.us_open union all select c.year,p.player_id,p.player_name from championships c inner join players p on p.player_id = c.au_open ) select player_id,player_name,count(player_id) as grand_slams_count from cte group by player_id order by player_name asc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 329, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select *,count(*) grand_slams_count from ( select wimbledon as game_won from championships union all select fr_open as game_won from championships union all select us_open as game_won from championships union all select au_open as game_won from championships ) tb group by game_won) select player_id, player_name, grand_slams_count from cte join players on game_won = player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 330, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id from championships union all select fr_open from championships union all select us_open from championships union all select au_open from championships ) select a.player_id,player_name,count(*) grand_slams_count from cte a inner join players b on a.player_id =b.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 331, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id from championships union all select fr_open as id from championships union all select us_open as id from championships union all select au_open as id from championships ) select player_id, player_name, count(*) grand_slams_count from players p inner join cte c on p.player_id = c.id group by id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 332, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as id, count(*) as cnt from championships group by wimbledon union all select fr_open as id, count(*) as cnt from championships group by fr_open union all select us_open as id, count(*) as cnt from championships group by us_open union all select au_open as id, count(*) as cnt from championships group by au_open) select cte.id as player_id, player_name, sum(cnt) as grand_slams_count from cte left join players p on cte.id = p.player_id group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 333, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id from championships union all select fr_open as player_id from championships union all select us_open as player_id from championships union all select au_open as player_id from championships ) select cte.player_id,players.player_name, count(cte.player_id) as grand_slams_count from cte left join players on cte.player_id = players.player_id group by cte.player_id,players.player_name order by player_id desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 334, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id, count(*) as wins from championships group by 1 union all select fr_open as player_id, count(*) as wins from championships group by 1 union all select us_open as player_id, count(*) as wins from championships group by 1 union all select au_open as player_id, count(*) as wins from championships group by 1 ), cte2 as ( select player_id, sum(wins) as grand_slams_count from cte group by 1 ) select a.player_id, player_name, grand_slams_count from cte2 a left join players b on a.player_id = b.player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 335, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as winner from championships union all select fr_open as winner from championships union all select us_open as winner from championships union all select au_open as winner from championships ) select player_id, player_name, count(*) as grand_slams_count from cte join players on cte.winner=players.player_id group by player_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 336, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon player_id, 'wimbledon' championship from championships union all select fr_open player_id, 'fr_open' championship from championships union all select us_open player_id, 'us_open' championship from championships union all select au_open player_id, 'au_open' championship from championships ) select cte.player_id , player_name, count(championship) grand_slams_count from cte join players using (player_id) group by cte.player_id"]}
