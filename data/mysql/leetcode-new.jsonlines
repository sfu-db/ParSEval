{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 22, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(insurance.tiv_2016),2) as tiv_2016 from insurance where insurance.tiv_2015 in ( select tiv_2015 from insurance group by tiv_2015 having count(*) > 1 ) and (lat, lon) in ( select lat, lon from insurance group by lat , lon having count(*) = 1 )"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 23, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select round(sum(tiv_2016),2) as tiv_2016 from ( select i1.*, i2.c1, i3.c2 from insurance i1 join ( select tiv_2015, count(*) as c1 from insurance i2 group by tiv_2015 )as i2 on i2.tiv_2015 = i1.tiv_2015 join ( select lat, lon, count(*) as c2 from insurance i2 group by lat, lon )as i3 on i3.lat = i1.lat and i3.lon = i1.lon ) as x where x.c1 > 1 and x.c2 = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 24, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum( i1.tiv_2016 ) as tiv_2016 from insurance as i1 left join ( select pid, count( * ) over( partition by concat( lat, ' ', lon ) ) as count_lat_lon, count( * ) over( partition by tiv_2015 ) as count_2015 from insurance ) as i2 on i1.pid = i2.pid where i2.count_lat_lon = 1 and i2.count_2015 >1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 25, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(base.tiv_2016) as tiv_2016 from ( select a.pid, a.tiv_2016 from (select * from insurance where tiv_2015 in (select tiv_2015 from (select tiv_2015, count(*) as n from insurance group by tiv_2015)base15 where n>1) ) a left join insurance b on a.pid !=b.pid and a.lat=b.lat and a.lon=b.lon where b.pid is null )base"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 26, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from ( select *, count(*) over (partition by lat, lon) as loc, count(*) over (partition by tiv_2015) as tiv from insurance ) as temp where loc=1 and tiv>1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 27, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from (select pid, tiv_2015, tiv_2016, count(*) over(partition by tiv_2015) as cnt, count(*) over(partition by concat(lat, ',',lon)) as loc_cnt from insurance) t where cnt > 1 and loc_cnt = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 28, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from (select tiv_2016, count(tiv_2015) over (partition by tiv_2015) as cnt2015, count(*) over (partition by lat, lon) as cntloc from insurance) t where cnt2015 > 1 and cntloc = 1"]}
{"benchmark": "benchmark/leetcode/raw_data/585.csv", "index": 29, "schema": "create table insurance (pid integer not null, tiv_2015 integer, tiv_2016 integer, lat integer, lon integer, constraint pk_insurance primary key (pid), constraint check_insurance check (tiv_2015 >= 0 and tiv_2016 >= 0));", "pair": ["select round(sum(tiv_2016),2) tiv_2016 from insurance where tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(*)>1) and (lat,lon) in (select lat,lon from insurance group by lat,lon having count(*)=1)", "select sum(tiv_2016) as tiv_2016 from (with temp as (select *, concat(lat,lon) as loc from insurance) select pid, tiv_2016 from temp where loc in (select loc from temp group by loc having count(loc) = 1) and tiv_2015 in (select tiv_2015 from insurance group by tiv_2015 having count(tiv_2015) >1)) t"]}
