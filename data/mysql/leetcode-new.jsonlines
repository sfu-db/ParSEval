{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 380, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with tab1 as ( select count(delivery_id) as same_day from delivery where order_date = customer_pref_delivery_date) select round(tab1.same_day/count(tab2.delivery_id)*100,2) as immediate_percentage from delivery as tab2,tab1"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 381, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select round(100*count(if(order_date = customer_pref_delivery_date, delivery_id,null))/count(*),2) as immediate_percentage from delivery"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 382, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "with t1 as ( select delivery_id, customer_id, order_date, customer_pref_delivery_date, case when order_date = customer_pref_delivery_date then 'yes' else 'no' end as immediate from delivery ), t2 as ( select count(immediate) as cyes from t1 where immediate = 'yes' ), t3 as ( select count(immediate) as cno from t1 where immediate = 'no' ) select round(t2.cyes/(t2.cyes+t3.cno)*100,2) as immediate_percentage from t2,t3"]}
{"benchmark": "benchmark/leetcode/raw_data/1173.csv", "index": 383, "schema": "create table delivery (delivery_id integer not null, customer_id integer, order_date date, customer_pref_delivery_date date, constraint pk_delivery primary key (delivery_id), constraint check_delivery check (order_date <= customer_pref_delivery_date));", "pair": ["select round((sum(order_date = customer_pref_delivery_date) / count(*)) * 100 , 2) as immediate_percentage from delivery", "select round( (select count(order_date) from delivery where order_date = customer_pref_delivery_date) * 100 / (select count(order_date) from delivery), 2) as immediate_percentage"]}
