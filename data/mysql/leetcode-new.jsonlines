{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 664, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select wimbledon as player_id, count(year) as count_wins from championships group by wimbledon union all select fr_open as player_id, count(year) as count_wins from championships group by fr_open union all select us_open as player_id, count(year) as count_wins from championships group by us_open union all select au_open as player_id, count(year) as count_wins from championships group by au_open ) (select p.*, sum(c.count_wins) as grand_slams_count from players p join cte c on p.player_id = c.player_id group by 1,2)"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 665, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "select player_id, player_name, sum(num_slams) grand_slams_count from ( select player_id, player_name, count(wimbledon) num_slams from championships c join players p on p.player_id = c.wimbledon group by 1 union all select player_id, player_name, count(fr_open) from championships c join players p on p.player_id = c.fr_open group by 1 union all select player_id, player_name, count(us_open) from championships c join players p on p.player_id = c.us_open group by 1 union all select player_id, player_name, count(au_open) from championships c join players p on p.player_id = c.au_open group by 1 ) t group by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 666, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with c as ( select year, wimbledon as win from championships union all select year, fr_open as win from championships union all select year, us_open as win from championships union all select year, au_open as win from championships ) select player_id, player_name, count(*) as grand_slams_count from c left join players p on p.player_id =c.win group by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1783.csv", "index": 667, "schema": "create table players (player_id integer not null, player_name varchar(30), constraint pk_players primary key (player_id)); create table championships (year integer not null, wimbledon integer, fr_open integer, us_open integer, au_open integer, constraint pk_championships primary key (year), foreign key (wimbledon) references players (player_id), foreign key (fr_open) references players (player_id), foreign key (us_open) references players (player_id), foreign key (au_open) references players (player_id));", "pair": ["select * from (select player_id, player_name, sum((case when player_id = wimbledon then 1 else 0 end + case when player_id = fr_open then 1 else 0 end + case when player_id = us_open then 1 else 0 end + case when player_id = au_open then 1 else 0 end)) as grand_slams_count from players cross join championships group by player_id) as z where grand_slams_count > 0", "with cte as ( select a.year, a.wimbledon from championships a union all select b.year, b.fr_open from championships b union all select c.year, c.us_open from championships c union all select d.year, d.au_open from championships d) select p.player_id, p.player_name, count(*) as grand_slams_count from cte c inner join players p on p.player_id=c.wimbledon group by p.player_id order by player_id desc"]}
