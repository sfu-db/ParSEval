{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 170, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(b.apple_count+coalesce(c.apple_count,0)) as apple_count,sum(b.orange_count+coalesce(c.orange_count,0)) as orange_count from boxes b left join chests c on coalesce(b.chest_id,0)=c.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 171, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(box_apple_cnt+chest_apple_cnt) as apple_count, sum(box_orange_cnt+chest_orange_cnt) as orange_count from (select t1.apple_count as box_apple_cnt, ifnull(t2.apple_count,0) as chest_apple_cnt, t1.orange_count as box_orange_cnt, ifnull(t2.orange_count,0) as chest_orange_cnt from boxes t1 left join chests t2 on t1.chest_id = t2.chest_id) t"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 172, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(boxes.apple_count) + sum(ifnull(chests.apple_count,0)) as apple_count, sum(boxes.orange_count) + sum(ifnull(chests.orange_count,0)) as orange_count from boxes left join chests using (chest_id)"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 173, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(c.apple1) as apple_count, sum(c.orange1) as orange_count from (select a.box_id, a.chest_id, a.apple_count+ifnull(b.apple_count,0) as apple1, a.orange_count+ifnull(b.orange_count,0) as orange1 from boxes a left join chests b on a.chest_id=b.chest_id )c"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 174, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(case when a.chest_id is not null then (a.apple_count+b.apple_count) else a.apple_count end) as apple_count, sum(case when a.chest_id is not null then (a.orange_count+b.orange_count) else a.orange_count end) as orange_count from boxes a left join chests b on a.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 175, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(case when a.chest_id is null then a.apple_count else a.apple_count + b.apple_count end) as apple_count, sum(case when a.chest_id is null then a.orange_count else a.orange_count + b.orange_count end) as orange_count from boxes a left join chests b on a.chest_id = b.chest_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1715.csv", "index": 176, "schema": "create table chests (chest_id integer not null, apple_count integer, orange_count integer, constraint pk_chests primary key (chest_id), constraint check_chests check (apple_count >= 0 and orange_count >= 0)); create table boxes (box_id integer not null, chest_id integer, apple_count integer, orange_count integer, constraint pk_boxes primary key (box_id), foreign key (chest_id) references chests (chest_id), constraint check_boxes check (apple_count >= 0 and orange_count >= 0));", "pair": ["select sum(b.apple_count + ifnull(c.apple_count, 0)) as apple_count , sum(b.orange_count + ifnull(c.orange_count,0)) as orange_count from boxes b left join chests c on b.chest_id = c.chest_id", "select sum(case when b.apple_count is null then 0 else b.apple_count end)+ sum(case when c.apple_count is null then 0 else c.apple_count end) as apple_count, sum(case when b.orange_count is null then 0 else b.orange_count end)+ sum(case when c.orange_count is null then 0 else c.orange_count end) as orange_count from boxes b left join chests c on b.chest_id=c.chest_id"]}
