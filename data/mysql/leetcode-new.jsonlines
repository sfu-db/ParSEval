{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 458, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "with cte as (select distinct product_id from sales where sale_date between '2019-01-01' and '2019-03-31'), cte1 as (select distinct product_id from sales where sale_date < '2019-01-01' or sale_date > '2019-03-31') select product_id,product_name from product where product_id in (select * from cte) and product_id not in (select * from cte1)"]}
{"benchmark": "benchmark/leetcode/raw_data/1084.csv", "index": 459, "schema": "create table product (product_id integer not null, product_name varchar(30), unit_price integer, constraint pk_product primary key (product_id), constraint check_product check (unit_price > 0)); create table sales (product_id integer, seller_id integer, buyer_id integer, sale_date date, quantity integer, price integer, foreign key (product_id) references product (product_id), constraint check_sales check (quantity > 0 and price > 0));", "pair": ["select p.product_id, p.product_name from product p inner join ( select product_id from sales group by product_id having min(sale_date) >= '2019-01-01' and max(sale_date) <= '2019-03-31' ) s on (p.product_id = s.product_id)", "select product.product_id, product.product_name from sales join product on sales.product_id = product.product_id group by sales.product_id having min(sale_date) between '2019-01-01' and '2019-03-31' and max(sale_date) between '2019-01-01' and '2019-03-31'"]}
