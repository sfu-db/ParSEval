{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 635, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id,(select b.name from employees as b where b.employee_id = a.reports_to) as name, sum(if(a.reports_to = a.reports_to,1,0)) as reports_count, round(avg(a.age)) as average_age from employees a where a.reports_to is not null group by a.reports_to order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 636, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(*) as reports_count, round(avg(e2.age)) as average_age from employees e1, employees e2 where e1.employee_id = e2.reports_to group by e1.employee_id order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 637, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to as employee_id, e2.name, count(e1.employee_id) as reports_count, round(sum(e1.age)/count(e1.employee_id)) as average_age from employees e1 inner join employees as e2 on e1.reports_to = e2.employee_id where e1.reports_to is not null group by e1.reports_to order by e1.reports_to"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 638, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(e1.employee_id) as reports_count, round(avg(e1.age), 0) as average_age from employees e1 join employees e2 on e1.reports_to = e2.employee_id group by e2.employee_id order by e2.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 639, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.reports_to employee_id, e2.name, e1.reports_count, e1.average_age from employees e2 right join ( select reports_to, count(*) reports_count, round(avg(age),0) average_age from employees where reports_to is not null group by reports_to) e1 on e1.reports_to = e2.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 640, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with managers as ( select reports_to, count(distinct employee_id) as reports_count, round(avg(age)) as average_age from employees e where reports_to is not null group by 1 having count(employee_id) > 0 ) select m.reports_to as employee_id, e.name, m.reports_count, m.average_age from managers m join employees e on m.reports_to = e.employee_id order by 1"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 641, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by tb1.employee_id order by tb1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 642, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select employee_id, name, reports_count, average_age from ( select reports_to as manager, round(avg(age),0) as average_age, count(*) as reports_count from employees where reports_to is not null group by reports_to ) as aaa left join employees on employees.employee_id=aaa.manager order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 643, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.employee_id) as reports_count, round(avg(e2.age)) as average_age from employees e1 inner join employees e2 on e1.employee_id = e2.reports_to group by e1.employee_id, e1.name order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 644, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select m.employee_id,m.name,count(*) as reports_count, round(avg(e.age),0) as average_age from employees as m join employees as e on m.employee_id=e.reports_to group by m.employee_id,m.name order by m.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 645, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.reports_to as employee_id, b.name as name, count(a.employee_id) as reports_count , round(avg(a.age)) as average_age from employees a left join employees b on a.reports_to = b.employee_id where a.reports_to is not null group by 1,2 order by 1,2"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 646, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select x.employee_id, x.name, count(*) as reports_count, round(avg(y.age),0) as average_age from employees x join employees y on y.reports_to = x.employee_id group by x.employee_id order by x.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 647, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e2.name, reports_count, average_age from (select reports_to employee_id, count(employee_id) reports_count, round(avg(age)) average_age from employees where reports_to is not null group by reports_to) e1 join employees e2 on e1.employee_id = e2.employee_id order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 648, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select sub1.employee_id, sub1.name, sub1.reports_count, sub1.average_age from ( select e1.employee_id, e1.name, count(*) reports_count, round(avg(e2.age), 0) average_age from employees e1 inner join employees e2 on e1.employee_id = e2.reports_to group by e1.employee_id order by e1.employee_id ) sub1 where sub1.employee_id is not null"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 649, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select t1.manager_id as employee_id, e.name as name, t1.reports_count, t1.average_age from (select reports_to as manager_id, count(*) as reports_count, round(avg(age),0) as average_age from employees group by reports_to having reports_to is not null) t1 join employees e on t1.manager_id = e.employee_id order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 650, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e1.employee_id, e1.name, count(e2.reports_to) reports_count, round(avg(e2.age)) average_age from employees e1 join employees e2 on e2.reports_to = e1.employee_id group by employee_id having count(e2.reports_to) >= 1 order by e1.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 651, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select a.employee_id, a.name, count(*) as reports_count, round(ifnull(avg(b.age),0)) as average_age from employees a join employees b on a.employee_id = b.reports_to group by a.employee_id, a.name order by a.employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 652, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with managers as (select employee_id, reports_to,name,age from employees where reports_to is not null) select m.reports_to as employee_id,e.name, count(m.reports_to) as reports_count,round(avg(m.age)) as average_age from managers m inner join employees e on m.reports_to = e.employee_id group by m.reports_to order by employee_id"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 653, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "with cte as (select reports_to as employee_id, count(*) as reports_count, round(avg(age),0) as average_age from employees group by reports_to having count(*) >= 1 and reports_to is not null) select cte.employee_id , employees.name, cte.reports_count, cte.average_age from cte join employees on cte.employee_id = employees.employee_id order by 1 , 2 desc"]}
{"benchmark": "benchmark/leetcode/raw_data/1731.csv", "index": 654, "schema": "create table employees (employee_id integer not null, name varchar(30), reports_to integer, age integer, constraint pk_employees primary key (employee_id), foreign key (reports_to) references employees (employee_id), constraint check_employees check (age > 0));", "pair": ["select tb1.employee_id, tb1.name, count(*) as reports_count, round(avg(tb2.age),0) as average_age from employees as tb1 join employees as tb2 on tb1.employee_id = tb2.reports_to group by 1 order by tb1.employee_id", "select e2.employee_id, e2.name, count(e1.employee_id) as reports_count, round(avg(e1.age)) as average_age from employees e1 join employees e2 on e1.reports_to = e2.employee_id group by 1, 2 order by 1"]}
