{"benchmark":"toxicology","index":282,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT DISTINCT T1.element FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.label = '+' AND SUBSTR(T1.atom_id, -1) = '4' AND LENGTH(T1.atom_id) = 7","SELECT T1.element, COUNT(T1.element) FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.label = '+' AND substr(T1.atom_id, 7, 1) = '4' AND T1.element IN ('cl', 'c', 'h', 'o', 's', 'n', 'p', 'na', 'br', 'f', 'i', 'sn', 'pb', 'te', 'ca') GROUP BY T1.element"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":283,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT CAST(COUNT(CASE WHEN T.element = 'h' THEN T.atom_id ELSE NULL END) AS REAL) \/ COUNT(T.atom_id) FROM ( SELECT DISTINCT T1.atom_id, T1.element, T1.molecule_id, T2.label FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.molecule_id = 'TR006' ) AS T UNION ALL SELECT DISTINCT T3.label FROM ( SELECT DISTINCT T1.atom_id, T1.element, T1.molecule_id, T2.label FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.molecule_id = 'TR006' ) AS T3","SELECT CAST(SUM(CASE WHEN element = 'h' THEN 1 ELSE 0 END) AS REAL) \/ COUNT(element), label FROM atom INNER JOIN molecule ON atom.molecule_id = molecule.molecule_id WHERE atom.molecule_id = 'TR006'"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":284,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T2.label AS flag_carcinogenic FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 'ca'","SELECT CASE WHEN EXISTS (SELECT 1 FROM molecule AS T1 INNER JOIN atom AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.element = 'ca' AND T1.label = '+') THEN 'Yes' ELSE 'No' END AS Is_Carcinogenic"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":285,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT DISTINCT T2.bond_type FROM atom AS T1 INNER JOIN bond AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 'te'","SELECT DISTINCT T2.bond_type FROM atom AS T1 INNER JOIN connected AS T3 ON T1.atom_id = T3.atom_id INNER JOIN bond AS T2 ON T3.bond_id = T2.bond_id WHERE T1.element = 'te'"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":286,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T1.element FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id INNER JOIN bond AS T3 ON T2.bond_id = T3.bond_id WHERE T3.bond_id = 'TR001_10_11'","SELECT CASE WHEN T1.element = 'cl' THEN 'Chlorine' WHEN T1.element = 'c' THEN 'Carbon' WHEN T1.element = 'h' THEN 'Hydrogen' WHEN T1.element = 'o' THEN 'Oxygen' WHEN T1.element = 's' THEN 'Sulfur' WHEN T1.element = 'n' THEN 'Nitrogen' WHEN T1.element = 'p' THEN 'Phosphorus' WHEN T1.element = 'na' THEN 'Sodium' WHEN T1.element = 'br' THEN 'Bromine' WHEN T1.element = 'f' THEN 'Fluorine' WHEN T1.element = 'i' THEN 'Iodine' WHEN T1.element = 'sn' THEN 'Tin' WHEN T1.element = 'pb' THEN 'Lead' WHEN T1.element = 'te' THEN 'Tellurium' WHEN T1.element = 'ca' THEN 'Calcium' END AS 'Element' FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id OR T1.atom_id = T2.atom_id2 WHERE T2.bond_id = 'TR001_10_11'"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":287,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT CAST(COUNT(CASE WHEN T.bond_type = '#' THEN T.bond_id ELSE NULL END) AS REAL) * 100 \/ COUNT(T.bond_id) FROM bond AS T","SELECT CAST(SUM(CASE WHEN bond.bond_type = '#' THEN 1 ELSE 0 END) AS REAL) * 100 \/ COUNT(molecule.molecule_id) AS percentage FROM molecule LEFT JOIN bond ON molecule.molecule_id = bond.molecule_id"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
