air":["SELECT T1.account_id , ( SELECT MAX(A11) - MIN(A11) FROM district ) FROM account AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id WHERE T2.district_id = ( SELECT district_id FROM client WHERE gender = 'F' ORDER BY birth_date ASC LIMIT 1 ) ORDER BY T2.A11 DESC LIMIT 1","SELECT T1.account_id, (SELECT MAX(T3.A11) FROM district AS T3) - T2.A11 AS Gap FROM account AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id INNER JOIN client AS T4 ON T1.account_id = T4.client_id WHERE T4.gender = 'F' ORDER BY T4.birth_date DESC, T2.A11 ASC LIMIT 1"],"ddl":"CREATE TABLE IF NOT EXISTS `account` (`account_id` INT, `district_id` INT, `frequency` TEXT, `date` DATE, PRIMARY KEY (`account_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `card` (`card_id` INT, `disp_id` INT, `type` TEXT, `issued` DATE, PRIMARY KEY (`card_id`), FOREIGN KEY (`disp_id`) REFERENCES disp (`disp_id`));CREATE TABLE IF NOT EXISTS `client` (`client_id` INT, `gender` TEXT, `birth_date` DATE, `district_id` INT, PRIMARY KEY (`client_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `disp` (`disp_id` INT, `client_id` INT, `account_id` INT, `type` TEXT, PRIMARY KEY (`disp_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `district` (`district_id` INT, `A2` TEXT, `A3` TEXT, `A4` TEXT, `A5` TEXT, `A6` TEXT, `A7` TEXT, `A8` INT, `A9` INT, `A10` FLOAT, `A11` INT, `A12` FLOAT, `A13` FLOAT, `A14` INT, `A15` INT, `A16` INT, PRIMARY KEY (`district_id`));CREATE TABLE IF NOT EXISTS `loan` (`loan_id` INT, `account_id` INT, `date` DATE, `amount` INT, `duration` INT, `payments` FLOAT, `status` TEXT, PRIMARY KEY (`loan_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `order` (`order_id` INT, `account_id` INT, `bank_to` TEXT, `account_to` INT, `amount` FLOAT, `k_symbol` TEXT, PRIMARY KEY (`order_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `trans` (`trans_id` INT, `account_id` INT, `date` DATE, `type` TEXT, `operation` TEXT, `amount` INT, `balance` INT, `k_symbol` TEXT, `bank` TEXT, `account` INT, PRIMARY KEY (`trans_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`))"}
