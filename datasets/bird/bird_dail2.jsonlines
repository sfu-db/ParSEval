value":"comments__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postHistory__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"postHistory__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__RelatedPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__ParentId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__OwnerUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"posts__LastEditorUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"tags__ExcerptPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"votes__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"votes__PostId"},{"value":"posts__Id"}]}],"pair":["SELECT CAST(SUM(IIF(T1.UpVotes = 0, 1, 0)) AS REAL) \/ COUNT(T1.Id) AS per1 FROM users AS T1 INNER JOIN comments AS T2 ON T1.Id = T2.UserId WHERE T2.Score BETWEEN 5 AND 10","SELECT CAST(SUM(CASE WHEN T2.UpVotes = 0 THEN 1 ELSE 0 END) AS REAL) * 100 \/ COUNT(T1.UserId) FROM comments AS T1 INNER JOIN users AS T2 ON T1.UserId = T2.Id WHERE T1.Score BETWEEN 5 AND 10"],"ddl":"CREATE TABLE IF NOT EXISTS `badges` (`Id` INT, `UserId` INT, `Name` TEXT, `Date` DATETIME, PRIMARY KEY (`Id`), FOREIGN KEY (`UserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `comments` (`Id` INT, `PostId` INT, `Score` INT, `Text` TEXT, `CreationDate` DATETIME, `UserId` INT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postHistory` (`Id` INT, `PostHistoryTypeId` INT, `PostId` INT, `RevisionGUID` TEXT, `CreationDate` DATETIME, `UserId` INT, `Text` TEXT, `Comment` TEXT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postLinks` (`Id` INT, `CreationDate` DATETIME, `PostId` INT, `RelatedPostId` INT, `LinkTypeId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `posts` (`Id` INT, `PostTypeId` INT, `AcceptedAnswerId` INT, `CreaionDate` DATETIME, `Score` INT, `ViewCount` INT, `Body` TEXT, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
