{"benchmark":"thrombosis_prediction","index":1174,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT T2.Diagnosis FROM Examination AS T1 INNER JOIN Patient AS T2 ON T1.ID = T2.ID WHERE T1.`Examination Date` BETWEEN '1985-01-01' AND '1995-12-31' GROUP BY T2.Diagnosis ORDER BY COUNT(T2.Diagnosis) DESC LIMIT 1","SELECT Diagnosis FROM Examination WHERE `Examination Date` BETWEEN '1985-01-01' AND '1995-12-31' GROUP BY Diagnosis ORDER BY COUNT(Diagnosis) DESC LIMIT 1"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1175,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT AVG('1999' - STRFTIME('%Y', T2.Birthday)) FROM Laboratory AS T1 INNER JOIN Patient AS T2 ON T1.ID = T2.ID WHERE T1.Date BETWEEN '1991-10-01' AND '1991-10-30'","SELECT AVG(1991 - strftime('%Y', Birthday)) FROM Patient WHERE ID IN (SELECT ID FROM Laboratory WHERE Date BETWEEN '1991-10-01' AND '1991-10-31')"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
