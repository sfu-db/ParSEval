{"benchmark":"toxicology","index":243,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT DISTINCT T2.molecule_id FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE SUBSTR(T1.atom_id, -2) BETWEEN '21' AND '25' AND T2.label = '+'","SELECT molecule_id FROM molecule WHERE label = '+' AND molecule_id IN (SELECT molecule_id FROM atom WHERE SUBSTRING(atom_id, 7, 2) BETWEEN 21 AND 25)"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":244,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T2.bond_id FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id WHERE T2.bond_id IN ( SELECT T3.bond_id FROM connected AS T3 INNER JOIN atom AS T4 ON T3.atom_id = T4.atom_id WHERE T4.element = 'p' ) AND T1.element = 'n'","SELECT T3.bond_id FROM connected AS T3 INNER JOIN atom AS T1 ON T3.atom_id = T1.atom_id INNER JOIN atom AS T2 ON T3.atom_id2 = T2.atom_id WHERE (T1.element = 'P' AND T2.element = 'N') OR (T1.element = 'N' AND T2.element = 'P')"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":245,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T1.label FROM molecule AS T1 INNER JOIN ( SELECT T.molecule_id, COUNT(T.bond_type) FROM bond AS T WHERE T.bond_type = '=' GROUP BY T.molecule_id ORDER BY COUNT(T.bond_type) DESC LIMIT 1 ) AS T2 ON T1.molecule_id = T2.molecule_id","SELECT CASE WHEN (SELECT label FROM molecule WHERE molecule_id = (SELECT molecule_id FROM bond WHERE bond_type = ' = ' GROUP BY molecule_id ORDER BY COUNT(bond_id) DESC LIMIT 1)) = '+' THEN 'Yes' ELSE 'No' END AS IsCarcinogenic"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
