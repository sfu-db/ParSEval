ECT T1.nationality FROM drivers AS T1 INNER JOIN results AS T2 ON T2.driverId = T1.driverId WHERE T2.fastestLapTime IS NOT NULL ORDER BY T2.fastestLapSpeed DESC LIMIT 1","SELECT T2.nationality FROM results AS T1 INNER JOIN drivers AS T2 ON T1.driverId = T2.driverId WHERE T1.fastestLapSpeed = ( SELECT MAX(fastestLapSpeed) FROM results )"],"ddl":"CREATE TABLE IF NOT EXISTS `circuits` (`circuitId` INT, `circuitRef` TEXT, `name` TEXT, `location` TEXT, `country` TEXT, `lat` FLOAT, `lng` FLOAT, `alt` INT, `url` TEXT, PRIMARY KEY (`circuitId`));CREATE TABLE IF NOT EXISTS `constructors` (`constructorId` INT, `constructorRef` TEXT, `name` TEXT, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`constructorId`));CREATE TABLE IF NOT EXISTS `drivers` (`driverId` INT, `driverRef` TEXT, `number` INT, `code` TEXT, `forename` TEXT, `surname` TEXT, `dob` DATE, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`driverId`));CREATE TABLE IF NOT EXISTS `seasons` (`year` INT, `url` TEXT, PRIMARY KEY (`year`));CREATE TABLE IF NOT EXISTS `races` (`raceId` INT, `year` INT, `round` INT, `circuitId` INT, `name` TEXT, `date` DATE, `time` TEXT, `url` TEXT, PRIMARY KEY (`raceId`), FOREIGN KEY (`year`) REFERENCES seasons (`year`));CREATE TABLE IF NOT EXISTS `constructorResults` (`constructorResultsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `status` TEXT, PRIMARY KEY (`constructorResultsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `constructorStandings` (`constructorStandingsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`constructorStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `driverStandings` (`driverStandingsId` INT, `raceId` INT, `driverId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`driverStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `lapTimes` (`raceId` INT, `driverId` INT, `lap` INT, `position` INT, `time` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `pitStops` (`raceId` INT, `driverId` INT, `stop` INT, `lap` INT, `time` TEXT, `duration` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `qualifying` (`qualifyId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `position` INT, `q1` TEXT, `q2` TEXT, `q3` TEXT, PRIMARY KEY (`qualifyId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `status` (`statusId` INT, `status` TEXT, PRIMARY KEY (`statusId`));CREATE TABLE IF NOT EXISTS `results` (`resultId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `grid` INT, `position` INT, `positionText` TEXT, `positionOrder` INT, `points` FLOAT, `laps` INT, `time` TEXT, `milliseconds` INT, `fastestLap` INT, `rank` INT, `fastestLapTime` TEXT, `fastestLapSpeed` TEXT, `statusId` INT, PRIMARY KEY (`resultId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`))"}
{"benchmark":"formula_1","index":881,"schema":{"circuits":{"circuitId":"int","circuitRef":"varchar","name":"varchar","location":"varchar","country":"varchar","lat":"real","lng":"real","alt":"int","url":"varchar"},"constructors":{"constructorId":"int","constructorRef":"varchar","name":"varchar","nationality":"varchar","url":"varchar"},"drivers":{"driverId":"int","driverRef":"varchar","number":"int","code":"varchar","forename":"varchar","surname":"varchar","dob":"date","nationality":"varchar","url":"varchar"},"seasons":{"year":"int","url":"varchar"},"races":{"raceId":"int","year":"int","round":"int","circuitId":"int","name":"varchar","date":"date","time":"varchar","url":"varchar"},"constructorResults":{"constructorResultsId":"int","raceId":"int","constructorId":"int","points":"real","status":"varchar"},"constructorStandings":{"constructorStandingsId":"int","raceId":"int","constructorId":"int","points":"real","position":"int","positionText":"varchar","wins":"int"},"driverStandings":{"driverStandingsId":"int","raceId":"int","driverId":"int","points":"real","position":"int","positionText":"varchar","wins":"int"},"lapTimes":{"raceId":"int","driverId":"int","lap":"int","position":"int","time":"varchar","milliseconds":"int"},"pitStops":{"raceId":"int","driverId":"int","stop":"int","lap":"int","time":"varchar","duration":"varchar","milliseconds":"int"},"qualifying":{"qualifyId":"int","raceId":"int","driverId":"int","constructorId":"int","number":"int","position":"int","q1":"varchar","q2":"varchar","q3":"varchar"},"status":{"statusId":"int","status":"varchar"},"results":{"resultId":"int","raceId":"int","driverId":"int","constructorId":"int","number":"int","grid":"int","position":"int","positionText":"varchar","positionOrder":"int","points":"real","laps":"int","time":"varchar","milliseconds":"int","fastestLap":"int","rank":"int","fastestLapTime":"varchar","fastestLapSpeed":"varchar","statusId":"int"}},"constraint":[{"primary":[{"value":"circuits__circuitId"}]},{"primary":[{"value":"constructors__constructorId"}]},{"primary":[{"value":"drivers__driverId"}]},{"primary":[{"value":"seasons__year"}]},{"primary":[{"value":"races__raceId"}]},{"primary":[{"value":"constructorResults__constructorResultsId"}]},{"primary":[{"value":"constructorStandings__constructorStandingsId"}]},{"primary":[{"value":"driverStandings__driverStandingsId"}]},{"primary":[{"value":"qualifying__qualifyId"}]},{"primary":[{"value":"status__statusId"}]},{"primary":[{"value":"results__resultId"}]},{"foreign":[{"value":"races__circuitId"},{"value":"circuits__circuitId"}]},{"foreign":[{"value":"races__year"},{"value":"seasons__year"}]},{"foreign":[{"value":"constructorResults__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"constructorResults__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"constructorStandings__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"constructorStandings__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"driverStandings__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"driverStandings__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"lapTimes__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"lapTimes__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"pitStops__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"pitStops__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"qualifying__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"qualifying__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"qualifying__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"results__statusId"},{"value":"status__statusId"}]},{"foreign":[{"value":"results__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"results__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"results__raceId"},{"value":"races__raceId"}]}],"pair":["SELECT (SUM(IIF(T2.raceId = 853, T2.fastestLapSpeed, 0)) - SUM(IIF(T2.raceId = 854, T2.fastestLapSpeed, 0))) * 100 \/ SUM(IIF(T2.raceId = 853, T2.fastestLapSpeed, 0)) FROM drivers AS T1 INNER JOIN results AS T2 ON T2.driverId = T1.driverId WHERE T1.forename = 'Paul' AND T1.surname = 'di Resta'","SELECT (CAST(T1.fastestLapSpeed AS REAL) - CAST(T2.fastestLapSpeed AS REAL)) * 100 \/ CAST(T1.fastestLapSpeed AS REAL) AS percentage FROM results AS T1 INNER JOIN results AS T2 ON T1.driverId = T2.driverId INNER JOIN drivers AS T3 ON T1.driverId = T3.driverId WHERE T3.forename = 'Paul' AND T3.surname = 'di Resta' AND T1.raceId = 853 AND T2.raceId = 854"],"ddl":"CREATE TABLE IF NOT EXISTS `circuits` (`circuitId` INT, `circuitRef` TEXT, `name` TEXT, `location` TEXT, `country` TEXT, `lat` FLOAT, `lng` FLOAT, `alt` INT, `url` TEXT, PRIMARY KEY (`circuitId`));CREATE TABLE IF NOT EXISTS `constructors` (`constructorId` INT, `constructorRef` TEXT, `name` TEXT, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`constructorId`));CREATE TABLE IF NOT EXISTS `drivers` (`driverId` INT, `driverRef` TEXT, `number` INT, `code` TEXT, `forename` TEXT, `surname` TEXT, `dob` DATE, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`driverId`));CREATE TABLE IF NOT EXISTS `seasons` (`year` INT, `url` TEXT, PRIMARY KEY (`year`));CREATE TABLE IF NOT EXISTS `races` (`raceId` INT, `year` INT, `round` INT, `circuitId` INT, `name` TEXT, `date` DATE, `time` TEXT, `url` TEXT, PRIMARY KEY (`raceId`), FOREIGN KEY (`year`) REFERENCES seasons (`year`));CREATE TABLE IF NOT EXISTS `constructorResults` (`constructorResultsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `status` TEXT, PRIMARY KEY (`constructorResultsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `constructorStandings` (`constructorStandingsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`constructorStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `driverStandings` (`driverStandingsId` INT, `raceId` INT, `driverId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`driverStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `lapTimes` (`raceId` INT, `driverId` INT, `lap` INT, `position` INT, `time` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `pitStops` (`raceId` INT, `driverId` INT, `stop` INT, `lap` INT, `time` TEXT, `duration` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `qualifying` (`qualifyId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `position` INT, `q1` TEXT, `q2` TEXT, `q3` TEXT, PRIMARY KEY (`qualifyId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `status` (`statusId` INT, `status` TEXT, PRIMARY KEY (`statusId`));CREATE TABLE IF NOT EXISTS `results` (`resultId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `grid` INT, `position` INT, `positionText` TEXT, `positionOrder` INT, `points` FLOAT, `laps` INT, `time` TEXT, `milliseconds` INT, `fastestLap` INT, `rank` INT, `fastestLapTime` TEXT, `fastestLapSpeed` TEXT, `statusId` INT, PRIMARY KEY (`resultId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`))"}
