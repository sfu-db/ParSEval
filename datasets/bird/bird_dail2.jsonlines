 superpower AS T3 ON T2.power_id = T3.id WHERE T1.superhero_name = '3-D Man'","SELECT T2.power_name FROM superhero AS T1 INNER JOIN hero_power AS T3 ON T1.id = T3.hero_id INNER JOIN superpower AS T2 ON T3.power_id = T2.id WHERE T1.superhero_name = '3-D Man'"],"ddl":"CREATE TABLE IF NOT EXISTS `alignment` (`id` INT, `alignment` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `attribute` (`id` INT, `attribute_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `colour` (`id` INT, `colour` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `gender` (`id` INT, `gender` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `publisher` (`id` INT, `publisher_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `race` (`id` INT, `race` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `superhero` (`id` INT, `superhero_name` TEXT, `full_name` TEXT, `gender_id` INT, `eye_colour_id` INT, `hair_colour_id` INT, `skin_colour_id` INT, `race_id` INT, `publisher_id` INT, `alignment_id` INT, `height_cm` INT, `weight_kg` INT, PRIMARY KEY (`id`), FOREIGN KEY (`alignment_id`) REFERENCES alignment (`id`));CREATE TABLE IF NOT EXISTS `hero_attribute` (`hero_id` INT, `attribute_id` INT, `attribute_value` INT, FOREIGN KEY (`attribute_id`) REFERENCES attribute (`id`));CREATE TABLE IF NOT EXISTS `superpower` (`id` INT, `power_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `hero_power` (`hero_id` INT, `power_id` INT, FOREIGN KEY (`hero_id`) REFERENCES superhero (`id`))"}
