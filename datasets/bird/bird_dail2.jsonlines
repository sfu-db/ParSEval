, `StatusType` TEXT, `County` TEXT, `District` TEXT, `School` TEXT, `Street` TEXT, `StreetAbr` TEXT, `City` TEXT, `Zip` TEXT, `State` TEXT, `MailStreet` TEXT, `MailStrAbr` TEXT, `MailCity` TEXT, `MailZip` TEXT, `MailState` TEXT, `Phone` TEXT, `Ext` TEXT, `Website` TEXT, `OpenDate` DATE, `ClosedDate` DATE, `Charter` INT, `CharterNum` TEXT, `FundingType` TEXT, `DOC` TEXT, `DOCType` TEXT, `SOC` TEXT, `SOCType` TEXT, `EdOpsCode` TEXT, `EdOpsName` TEXT, `EILCode` TEXT, `EILName` TEXT, `GSoffered` TEXT, `GSserved` TEXT, `Virtual` TEXT, `Magnet` INT, `Latitude` FLOAT, `Longitude` FLOAT, `AdmFName1` TEXT, `AdmLName1` TEXT, `AdmEmail1` TEXT, `AdmFName2` TEXT, `AdmLName2` TEXT, `AdmEmail2` TEXT, `AdmFName3` TEXT, `AdmLName3` TEXT, `AdmEmail3` TEXT, `LastUpdate` DATE, PRIMARY KEY (`CDSCode`))"}
