lue":"constructors__constructorId"}]},{"primary":[{"value":"drivers__driverId"}]},{"primary":[{"value":"seasons__year"}]},{"primary":[{"value":"races__raceId"}]},{"primary":[{"value":"constructorResults__constructorResultsId"}]},{"primary":[{"value":"constructorStandings__constructorStandingsId"}]},{"primary":[{"value":"driverStandings__driverStandingsId"}]},{"primary":[{"value":"qualifying__qualifyId"}]},{"primary":[{"value":"status__statusId"}]},{"primary":[{"value":"results__resultId"}]},{"foreign":[{"value":"races__circuitId"},{"value":"circuits__circuitId"}]},{"foreign":[{"value":"races__year"},{"value":"seasons__year"}]},{"foreign":[{"value":"constructorResults__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"constructorResults__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"constructorStandings__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"constructorStandings__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"driverStandings__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"driverStandings__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"lapTimes__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"lapTimes__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"pitStops__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"pitStops__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"qualifying__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"qualifying__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"qualifying__raceId"},{"value":"races__raceId"}]},{"foreign":[{"value":"results__statusId"},{"value":"status__statusId"}]},{"foreign":[{"value":"results__constructorId"},{"value":"constructors__constructorId"}]},{"foreign":[{"value":"results__driverId"},{"value":"drivers__driverId"}]},{"foreign":[{"value":"results__raceId"},{"value":"races__raceId"}]}],"pair":["SELECT AVG(CAST(SUBSTR(T2.fastestLapTime, 1, INSTR(T2.fastestLapTime, ':') - 1) AS INTEGER) * 60 + CAST(SUBSTR(T2.fastestLapTime, INSTR(T2.fastestLapTime, ':') + 1) AS REAL)) FROM drivers AS T1 INNER JOIN results AS T2 ON T1.driverId = T2.driverId WHERE T1.surname = 'Hamilton' AND T1.forename = 'Lewis'","SELECT AVG(strftime('%s', fastestLapTime) - strftime('%s', '00:00')) FROM results AS T1 INNER JOIN drivers AS T2 ON T1.driverId = T2.driverId WHERE T2.forename = 'Lewis' AND T2.surname = 'Hamilton'"],"ddl":"CREATE TABLE IF NOT EXISTS `circuits` (`circuitId` INT, `circuitRef` TEXT, `name` TEXT, `location` TEXT, `country` TEXT, `lat` FLOAT, `lng` FLOAT, `alt` INT, `url` TEXT, PRIMARY KEY (`circuitId`));CREATE TABLE IF NOT EXISTS `constructors` (`constructorId` INT, `constructorRef` TEXT, `name` TEXT, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`constructorId`));CREATE TABLE IF NOT EXISTS `drivers` (`driverId` INT, `driverRef` TEXT, `number` INT, `code` TEXT, `forename` TEXT, `surname` TEXT, `dob` DATE, `nationality` TEXT, `url` TEXT, PRIMARY KEY (`driverId`));CREATE TABLE IF NOT EXISTS `seasons` (`year` INT, `url` TEXT, PRIMARY KEY (`year`));CREATE TABLE IF NOT EXISTS `races` (`raceId` INT, `year` INT, `round` INT, `circuitId` INT, `name` TEXT, `date` DATE, `time` TEXT, `url` TEXT, PRIMARY KEY (`raceId`), FOREIGN KEY (`year`) REFERENCES seasons (`year`));CREATE TABLE IF NOT EXISTS `constructorResults` (`constructorResultsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `status` TEXT, PRIMARY KEY (`constructorResultsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `constructorStandings` (`constructorStandingsId` INT, `raceId` INT, `constructorId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`constructorStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `driverStandings` (`driverStandingsId` INT, `raceId` INT, `driverId` INT, `points` FLOAT, `position` INT, `positionText` TEXT, `wins` INT, PRIMARY KEY (`driverStandingsId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `lapTimes` (`raceId` INT, `driverId` INT, `lap` INT, `position` INT, `time` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `pitStops` (`raceId` INT, `driverId` INT, `stop` INT, `lap` INT, `time` TEXT, `duration` TEXT, `milliseconds` INT, FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `qualifying` (`qualifyId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `position` INT, `q1` TEXT, `q2` TEXT, `q3` TEXT, PRIMARY KEY (`qualifyId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`));CREATE TABLE IF NOT EXISTS `status` (`statusId` INT, `status` TEXT, PRIMARY KEY (`statusId`));CREATE TABLE IF NOT EXISTS `results` (`resultId` INT, `raceId` INT, `driverId` INT, `constructorId` INT, `number` INT, `grid` INT, `position` INT, `positionText` TEXT, `positionOrder` INT, `points` FLOAT, `laps` INT, `time` TEXT, `milliseconds` INT, `fastestLap` INT, `rank` INT, `fastestLapTime` TEXT, `fastestLapSpeed` TEXT, `statusId` INT, PRIMARY KEY (`resultId`), FOREIGN KEY (`raceId`) REFERENCES races (`raceId`))"}
