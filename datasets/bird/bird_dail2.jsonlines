T, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
{"benchmark":"codebase_community","index":708,"schema":{"badges":{"Id":"int","UserId":"int","Name":"varchar","Date":"DateTime"},"comments":{"Id":"int","PostId":"int","Score":"int","Text":"varchar","CreationDate":"DateTime","UserId":"int","UserDisplayName":"varchar"},"postHistory":{"Id":"int","PostHistoryTypeId":"int","PostId":"int","RevisionGUID":"varchar","CreationDate":"DateTime","UserId":"int","Text":"varchar","Comment":"varchar","UserDisplayName":"varchar"},"postLinks":{"Id":"int","CreationDate":"DateTime","PostId":"int","RelatedPostId":"int","LinkTypeId":"int"},"posts":{"Id":"int","PostTypeId":"int","AcceptedAnswerId":"int","CreaionDate":"DateTime","Score":"int","ViewCount":"int","Body":"varchar","OwnerUserId":"int","LasActivityDate":"DateTime","Title":"varchar","Tags":"varchar","AnswerCount":"int","CommentCount":"int","FavoriteCount":"int","LastEditorUserId":"int","LastEditDate":"DateTime","CommunityOwnedDate":"DateTime","ParentId":"int","ClosedDate":"DateTime","OwnerDisplayName":"varchar","LastEditorDisplayName":"varchar"},"tags":{"Id":"int","TagName":"varchar","Count":"int","ExcerptPostId":"int","WikiPostId":"int"},"users":{"Id":"int","Reputation":"int","CreationDate":"DateTime","DisplayName":"varchar","LastAccessDate":"DateTime","WebsiteUrl":"varchar","Location":"varchar","AboutMe":"varchar","Views":"int","UpVotes":"int","DownVotes":"int","AccountId":"int","Age":"int","ProfileImageUrl":"varchar"},"votes":{"Id":"int","PostId":"int","VoteTypeId":"int","CreationDate":"date","UserId":"int","BountyAmount":"int"}},"constraint":[{"primary":[{"value":"badges__Id"}]},{"primary":[{"value":"comments__Id"}]},{"primary":[{"value":"postHistory__Id"}]},{"primary":[{"value":"postLinks__Id"}]},{"primary":[{"value":"posts__Id"}]},{"primary":[{"value":"tags__Id"}]},{"primary":[{"value":"users__Id"}]},{"primary":[{"value":"votes__Id"}]},{"foreign":[{"value":"badges__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__UserId"},{"value":"users__Id"}]},{"foreign":[{"