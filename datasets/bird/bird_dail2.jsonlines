rId` INT, `CreaionDate` DATETIME, `Score` INT, `ViewCount` INT, `Body` TEXT, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
{"benchmark":"codebase_community","index":595,"schema":{"badges":{"Id":"int","UserId":"int","Name":"varchar","Date":"DateTime"},"comments":{"Id":"int","PostId":"int","Score":"int","Text":"varchar","CreationDate":"DateTime","UserId":"int","UserDisplayName":"varchar"},"postHistory":{"Id":"int","PostHistoryTypeId":"int","PostId":"int","RevisionGUID":"varchar","CreationDate":"DateTime","UserId":"int","Text":"varchar","Comment":"varchar","UserDisplayName":"varchar"},"postLinks":{"Id":"int","CreationDate":"DateTime","PostId":"int","RelatedPostId":"int","LinkTypeId":"int"},"posts":{"Id":"int","PostTypeId":"int","AcceptedAnswerId":"int","CreaionDate":"DateTime","Score":"int","ViewCount":"int","Body":"varchar","OwnerUserId":"int","LasActivityDate":"DateTime","Title":"varchar","Tags":"varchar","AnswerCount":"int","CommentCount":"int","FavoriteCount":"int","LastEditorUserId":"int","LastEditDate":"DateTime","CommunityOwnedDate":"DateTime","ParentId":"int","ClosedDate":"DateTime","OwnerDisplayName":"varchar","LastEditorDisplayName":"varchar"},"tags":{"Id":"int","TagName":"varchar","Count":"int","ExcerptPostId":"int","WikiPostId":"int"},"users":{"Id":"int","Reputation":"int","CreationDate":"DateTime","DisplayName":"varchar","LastAccessDate":"DateTime","WebsiteUrl":"varchar","Location":"varchar","AboutMe":"varchar","Views":"int","UpVotes":"int","DownVotes":"int","AccountId":"int","Age":"int","ProfileImageUrl":"varchar"},"votes":{"Id":"int","PostId":"int","VoteTypeId":"int","CreationDate":"date","UserId":"int","BountyAmount":"int"}},"constraint":[{"primary":[{"value":"badges__Id"}]},{"primary":[{"value":"comments__Id"}]},{"primary":[{"value":"postHistory__Id"}]},{"primary":[{"value":"postLinks__Id"}]},{"primary":[{"value":"posts__Id"}]},{"primary":[{"value":"tags__Id"}]},{"primary":[{"value":"users__Id"}]},{"primary":[{"value":"votes__Id"}]},{"foreign":[{"value":"badges__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postHistory__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"postHistory__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__RelatedPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__ParentId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__OwnerUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"posts__LastEditorUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"tags__ExcerptPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"votes__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"votes__PostId"},{"value":"posts__Id"}]}],"pair":["SELECT T2.Id, T2.Reputation FROM comments AS T1 INNER JOIN users AS T2 ON T1.UserId = T2.Id WHERE T1.PostId = 1","SELECT T1.DisplayName, T1.Reputation FROM users AS T1 INNER JOIN posts AS T2 ON T1.Id = T2.OwnerUserId WHERE T2.Id = 1"],"ddl":"CREATE TABLE IF NOT EXISTS `badges` (`Id` INT, `UserId` INT, `Name` TEXT, `Date` DATETIME, PRIMARY KEY (`Id`), FOREIGN KEY (`UserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `comments` (`Id` INT, `PostId` INT, `Score` INT, `Text` TEXT, `CreationDate` DATETIME, `UserId` INT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postHistory` (`Id` INT, `PostHistoryTypeId` INT, `PostId` INT, `RevisionGUID` TEXT, `CreationDate` DATETIME, `UserId` INT, `Text` TEXT, `Comment` TEXT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postLinks` (`Id` INT, `CreationDate` DATETIME, `PostId` INT, `RelatedPostId` INT, `LinkTypeId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `posts` (`Id` INT, `PostTypeId` INT, `AcceptedAnswerId` INT, `CreaionDate` DATETIME, `Score` INT, `ViewCount` INT, `Body` TEXT, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
{"benchmark":"codebase_community","index":596,"schema":{"badges":{"Id":"int","UserId":"int","Name":"varchar","Date":"DateTime"},"comments":{"Id":"int","PostId":"int","Score":"int","Text":"varchar","CreationDate":"DateTime","UserId":"int","UserDisplayName":"varchar"},"postHistory":{"Id":"int","PostHistoryTypeId":"int","PostId":"int","RevisionGUID":"varchar","CreationDate":"DateTime","UserId":"int","Text":"varchar","Comment":"varchar","UserDisplayName":"varchar"},"postLinks":{"Id":"int","CreationDate":"DateTime","PostId":"int","RelatedPostId":"int","LinkTypeId":"int"},"posts":{"Id":"int","PostTypeId":"int","AcceptedAnswerId":"int","CreaionDate":"DateTime","Score":"int","ViewCount":"int","Body":"varchar","OwnerUserId":"int","LasActivityDate":"DateTime","Title":"varchar","Tags":"varchar","AnswerCount":"int","CommentCount":"int","FavoriteCount":"int","LastEditorUserId":"int","LastEditDate":"DateTime","CommunityOwnedDate":"DateTime","ParentId":"int","ClosedDate":"DateTime","OwnerDisplayName":"varchar","LastEditorDisplayName":"varchar"},"tags":{"Id":"int","TagName":"varchar","Count":"int","ExcerptPostId":"int","WikiPostId":"int"},"users":{"Id":"int","Reputation":"int","CreationDate":"DateTime","DisplayName":"varchar","LastAccessDate":"DateTime","WebsiteUrl":"varchar","Location":"varchar","AboutMe":"varchar","Views":"int","UpVotes":"int","DownVotes":"int","AccountId":"int","Age":"int","ProfileImageUrl":"varchar"},"votes":{"Id":"int","PostId":"int","VoteTypeId":"int","CreationDate":"date","UserId":"int","BountyAmount":"int"}},"constraint":[{"primary":[{"value":"badges__Id"}]},{"primary":[{"value":"comments__Id"}]},{"primary":[{"value":"postHistory__Id"}]},{"primary":[{"value":"postLinks__Id"}]},{"primary":[{"value":"posts__Id"}]},{"primary":[{"value":"tags__Id"}]},{"primary":[{"value":"users__Id"}]},{"primary":[{"value":"votes__Id"}]},{"foreign":[{"value":"badges__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postHistory__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"postHistory__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__RelatedPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__ParentId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__OwnerUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"posts__LastEditorUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"tags__ExcerptPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"votes__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"votes__PostId"},{"value":"posts__Id"}]}],"pair":["SELECT T2.UserId FROM users AS T1 INNER JOIN postHistory AS T2 ON T1.Id = T2.UserId INNER JOIN posts AS T3 ON T2.PostId = T3.Id WHERE T3.ViewCount >= 1000 GROUP BY T2.UserId HAVING COUNT(DISTINCT T2.PostHistoryTypeId) = 1","SELECT UserId FROM postHistory GROUP BY UserId, PostId HAVING COUNT(Id) = 1 AND Views >= 1000"],"ddl":"CREATE TABLE IF NOT EXISTS `badges` (`Id` INT, `UserId` INT, `Name` TEXT, `Date` DATETIME, PRIMARY KEY (`Id`), FOREIGN KEY (`UserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `comments` (`Id` INT, `PostId` INT, `Score` INT, `Text` TEXT, `CreationDate` DATETIME, `UserId` INT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postHistory` (`Id` INT, `PostHistoryTypeId` INT, `PostId` INT, `RevisionGUID` TEXT, `CreationDate` DATETIME, `UserId` INT, `Text` TEXT, `Comment` TEXT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postLinks` (`Id` INT, `CreationDate` DATETIME, `PostId` INT, `RelatedPostId` INT, `LinkTypeId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `posts` (`Id` INT, `PostTypeId` INT, `AcceptedAnswerId` INT, `CreaionDate` DATETIME, `Score` INT, `ViewCount` INT, `Body` TEXT, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
{"benchmark":"codebase_community","index":597,"schema":{"badges":{"Id":"int","UserId":"int","Name":"varchar","Date":"DateTime"},"comments":{"Id":"int","PostId":"int","Score":"int","Text":"varchar","CreationDate":"DateTime","UserId":"int","UserDisplayName":"varchar"},"postHistory":{"Id":"int","PostHistoryTypeId":"int","PostId":"int","RevisionGUID":"varchar","CreationDate":"DateTime","UserId":"int","Text":"varchar","Comment":"varchar","UserDisplayName":"varchar"},"postLinks":{"Id":"int","CreationDate":"DateTime","PostId":"int","RelatedPostId":"int","LinkTypeId":"int"},"posts":{"Id":"int","PostTypeId":"int","AcceptedAnswerId":"int","CreaionDate":"DateTime","Score":"int","ViewCount":"int","Body":"varchar","OwnerUserId":"int","LasActivityDate":"DateTime","Title":"varchar","Tags":"varchar","AnswerCount":"int","CommentCount":"int","FavoriteCount":"int","LastEditorUserId":"int","LastEditDate":"DateTime","CommunityOwnedDate":"DateTime","ParentId":"int","ClosedDate":"DateTime","OwnerDisplayName":"varchar","LastEditorDisplayName":"varchar"},"tags":{"Id":"int","TagName":"varchar","Count":"int","ExcerptPostId":"int","WikiPostId":"int"},"users":{"Id":"int","Reputation":"int","CreationDate":"DateTime","DisplayName":"varchar","LastAccessDate":"DateTime","WebsiteUrl":"varchar","Location":"varchar","AboutMe":"varchar","Views":"int","UpVotes":"int","DownVotes":"int","AccountId":"int","Age":"int","ProfileImageUrl":"varchar"},"votes":{"Id":"int","PostId":"int","VoteTypeId":"int","CreationDate":"date","UserId":"int","BountyAmount":"int"}},"constraint":[{"primary":[{"value":"badges__Id"}]},{"primary":[{"value":"comments__Id"}]},{"primary":[{"value":"postHistory__Id"}]},{"primary":[{"value":"postLinks__Id"}]},{"primary":[{"value":"posts__Id"}]},{"primary":[{"value":"tags__Id"}]},{"primary":[{"value":"users__Id"}]},{"primary":[{"value":"votes__Id"}]},{"foreign":[{"value":"badges__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"comments__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postHistory__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"postHistory__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__RelatedPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"postLinks__PostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__ParentId"},{"value":"posts__Id"}]},{"foreign":[{"value":"posts__OwnerUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"posts__LastEditorUserId"},{"value":"users__Id"}]},{"foreign":[{"value":"tags__ExcerptPostId"},{"value":"posts__Id"}]},{"foreign":[{"value":"votes__UserId"},{"value":"users__Id"}]},{"foreign":[{"value":"votes__PostId"},{"value":"posts__Id"}]}],"pair":["SELECT Name FROM badges AS T1 INNER JOIN comments AS T2 ON T1.UserId = t2.UserId GROUP BY T2.UserId ORDER BY COUNT(T2.UserId) DESC LIMIT 1","SELECT T1.UserId, T2.Name FROM ( SELECT UserId, COUNT(Id) AS num FROM comments GROUP BY UserId ORDER BY num DESC LIMIT 1 ) AS T1 INNER JOIN badges AS T2 ON T1.UserId = T2.UserId "],"ddl":"CREATE TABLE IF NOT EXISTS `badges` (`Id` INT, `UserId` INT, `Name` TEXT, `Date` DATETIME, PRIMARY KEY (`Id`), FOREIGN KEY (`UserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `comments` (`Id` INT, `PostId` INT, `Score` INT, `Text` TEXT, `CreationDate` DATETIME, `UserId` INT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postHistory` (`Id` INT, `PostHistoryTypeId` INT, `PostId` INT, `RevisionGUID` TEXT, `CreationDate` DATETIME, `UserId` INT, `Text` TEXT, `Comment` TEXT, `UserDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `postLinks` (`Id` INT, `CreationDate` DATETIME, `PostId` INT, `RelatedPostId` INT, `LinkTypeId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `posts` (`Id` INT, `PostTypeId` INT, `AcceptedAnswerId` INT, `CreaionDate` DATETIME, `Score` INT, `ViewCount` INT, `Body` TEXT, `OwnerUserId` INT, `LasActivityDate` DATETIME, `Title` TEXT, `Tags` TEXT, `AnswerCount` INT, `CommentCount` INT, `FavoriteCount` INT, `LastEditorUserId` INT, `LastEditDate` DATETIME, `CommunityOwnedDate` DATETIME, `ParentId` INT, `ClosedDate` DATETIME, `OwnerDisplayName` TEXT, `LastEditorDisplayName` TEXT, PRIMARY KEY (`Id`), FOREIGN KEY (`LastEditorUserId`) REFERENCES users (`Id`));CREATE TABLE IF NOT EXISTS `tags` (`Id` INT, `TagName` TEXT, `Count` INT, `ExcerptPostId` INT, `WikiPostId` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`ExcerptPostId`) REFERENCES posts (`Id`));CREATE TABLE IF NOT EXISTS `users` (`Id` INT, `Reputation` INT, `CreationDate` DATETIME, `DisplayName` TEXT, `LastAccessDate` DATETIME, `WebsiteUrl` TEXT, `Location` TEXT, `AboutMe` TEXT, `Views` INT, `UpVotes` INT, `DownVotes` INT, `AccountId` INT, `Age` INT, `ProfileImageUrl` TEXT, PRIMARY KEY (`Id`));CREATE TABLE IF NOT EXISTS `votes` (`Id` INT, `PostId` INT, `VoteTypeId` INT, `CreationDate` DATE, `UserId` INT, `BountyAmount` INT, PRIMARY KEY (`Id`), FOREIGN KEY (`PostId`) REFERENCES posts (`Id`))"}
