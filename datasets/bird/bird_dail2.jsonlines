{"benchmark":"superhero","index":744,"schema":{"alignment":{"id":"int","alignment":"varchar"},"attribute":{"id":"int","attribute_name":"varchar"},"colour":{"id":"int","colour":"varchar"},"gender":{"id":"int","gender":"varchar"},"publisher":{"id":"int","publisher_name":"varchar"},"race":{"id":"int","race":"varchar"},"superhero":{"id":"int","superhero_name":"varchar","full_name":"varchar","gender_id":"int","eye_colour_id":"int","hair_colour_id":"int","skin_colour_id":"int","race_id":"int","publisher_id":"int","alignment_id":"int","height_cm":"int","weight_kg":"int"},"hero_attribute":{"hero_id":"int","attribute_id":"int","attribute_value":"int"},"superpower":{"id":"int","power_name":"varchar"},"hero_power":{"hero_id":"int","power_id":"int"}},"constraint":[{"primary":[{"value":"alignment__id"}]},{"primary":[{"value":"attribute__id"}]},{"primary":[{"value":"colour__id"}]},{"primary":[{"value":"gender__id"}]},{"primary":[{"value":"publisher__id"}]},{"primary":[{"value":"race__id"}]},{"primary":[{"value":"superhero__id"}]},{"primary":[{"value":"superpower__id"}]},{"foreign":[{"value":"superhero__skin_colour_id"},{"value":"colour__id"}]},{"foreign":[{"value":"superhero__race_id"},{"value":"race__id"}]},{"foreign":[{"value":"superhero__publisher_id"},{"value":"publisher__id"}]},{"foreign":[{"value":"superhero__hair_colour_id"},{"value":"colour__id"}]},{"foreign":[{"value":"superhero__gender_id"},{"value":"gender__id"}]},{"foreign":[{"value":"superhero__eye_colour_id"},{"value":"colour__id"}]},{"foreign":[{"value":"superhero__alignment_id"},{"value":"alignment__id"}]},{"foreign":[{"value":"hero_attribute__hero_id"},{"value":"superhero__id"}]},{"foreign":[{"value":"hero_attribute__attribute_id"},{"value":"attribute__id"}]},{"foreign":[{"value":"hero_power__power_id"},{"value":"superpower__id"}]},{"foreign":[{"value":"hero_power__hero_id"},{"value":"superhero__id"}]}],"pair":["SELECT (CAST(COUNT(*) AS REAL) * 100 \/ (SELECT COUNT(*) FROM superhero)), CAST(SUM(CASE WHEN T2.publisher_name = 'Marvel Comics' THEN 1 ELSE 0 END) AS REAL) FROM superhero AS T1 INNER JOIN publisher AS T2 ON T1.publisher_id = T2.id INNER JOIN alignment AS T3 ON T3.id = T1.alignment_id WHERE T3.alignment = 'Bad'","SELECT CAST(COUNT(CASE WHEN T1.alignment = 'Bad' THEN T2.id ELSE NULL END) AS REAL) * 100 \/ COUNT(T2.id), COUNT(CASE WHEN T1.alignment = 'Bad' AND T3.publisher_name = 'Marvel Comics' THEN T2.id ELSE NULL END) AS \"number\" FROM alignment AS T1 INNER JOIN superhero AS T2 ON T1.id = T2.alignment_id INNER JOIN publisher AS T3 ON T3.id = T2.publisher_id"],"ddl":"CREATE TABLE IF NOT EXISTS `alignment` (`id` INT, `alignment` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `attribute` (`id` INT, `attribute_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `colour` (`id` INT, `colour` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `gender` (`id` INT, `gender` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `publisher` (`id` INT, `publisher_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `race` (`id` INT, `race` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `superhero` (`id` INT, `superhero_name` TEXT, `full_name` TEXT, `gender_id` INT, `eye_colour_id` INT, `hair_colour_id` INT, `skin_colour_id` INT, `race_id` INT, `publisher_id` INT, `alignment_id` INT, `height_cm` INT, `weight_kg` INT, PRIMARY KEY (`id`), FOREIGN KEY (`alignment_id`) REFERENCES alignment (`id`));CREATE TABLE IF NOT EXISTS `hero_attribute` (`hero_id` INT, `attribute_id` INT, `attribute_value` INT, FOREIGN KEY (`attribute_id`) REFERENCES attribute (`id`));CREATE TABLE IF NOT EXISTS `superpower` (`id` INT, `power_name` TEXT, PRIMARY KEY (`id`));CREATE TABLE IF NOT EXISTS `hero_power` (`hero_id` INT, `power_id` INT, FOREIGN KEY (`hero_id`) REFERENCES superhero (`id`))"}
