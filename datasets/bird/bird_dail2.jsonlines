{"benchmark":"toxicology","index":271,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T2.label FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 'ca' GROUP BY T2.label ORDER BY COUNT(T2.label) DESC LIMIT 1","SELECT CASE WHEN SUM(CASE WHEN T2.label = '+' THEN 1 ELSE 0 END) > SUM(CASE WHEN T2.label = '-' THEN 1 ELSE 0 END) THEN 'Carcinogenic' ELSE 'Non-Carcinogenic' END AS Result FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 'Ca'"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":272,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T2.bond_id, T2.atom_id2, T1.element AS flag_have_CaCl FROM atom AS T1 INNER JOIN connected AS T2 ON T2.atom_id = T1.atom_id WHERE T2.bond_id = 'TR001_1_8' AND (T1.element = 'c1' OR T1.element = 'c')","SELECT CASE WHEN COUNT(DISTINCT T1.element) = 2 THEN 'yes' ELSE 'no' END AS yn FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id OR T1.atom_id = T2.atom_id2 WHERE T2.bond_id = 'TR001_1_8' AND T1.element IN ('cl', 'c')"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":273,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT DISTINCT T2.molecule_id FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id INNER JOIN bond AS T3 ON T2.molecule_id = T3.molecule_id WHERE T3.bond_type = '#' AND T1.element = 'c' AND T2.label = '-'","SELECT molecule_id FROM ( SELECT molecule_id, COUNT(*) AS cnt FROM atom WHERE element = 'c' AND molecule_id IN ( SELECT molecule_id FROM bond WHERE bond_type = '#' ) GROUP BY molecule_id ) AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.label = '-' ORDER BY cnt DESC LIMIT 2"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
