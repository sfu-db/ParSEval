{"benchmark":"toxicology","index":310,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT T1.atom_id, COUNT(DISTINCT T2.bond_type) FROM atom AS T1 INNER JOIN bond AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.molecule_id = 'TR346' GROUP BY T1.atom_id, T2.bond_type","SELECT T1.atom_id, COUNT(DISTINCT T3.bond_type) FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id INNER JOIN bond AS T3 ON T2.bond_id = T3.bond_id INNER JOIN molecule AS T4 ON T1.molecule_id = T4.molecule_id WHERE T4.label = 'TR346' GROUP BY T1.atom_id"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":311,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT COUNT(DISTINCT T2.molecule_id), SUM(CASE WHEN T2.label = '+' THEN 1 ELSE 0 END) FROM bond AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.bond_type = '='","SELECT COUNT(DISTINCT T1.molecule_id) AS TotalMolecules, COUNT(DISTINCT T2.molecule_id) AS CarcinogenicMolecules FROM bond AS T1 LEFT JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id AND T2.label = '+' WHERE T1.bond_type = '='"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
{"benchmark":"toxicology","index":312,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT COUNT(DISTINCT T1.molecule_id) FROM atom AS T1 INNER JOIN bond AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element <> 's' AND T2.bond_type <> '='","SELECT COUNT(DISTINCT m.molecule_id) FROM molecule m LEFT JOIN atom a ON m.molecule_id = a.molecule_id LEFT JOIN connected c ON a.atom_id = c.atom_id LEFT JOIN bond b ON c.bond_id = b.bond_id WHERE a.element != 's' AND b.bond_type != '='"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
