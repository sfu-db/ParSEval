{"benchmark":"thrombosis_prediction","index":1206,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT CASE WHEN (T1.SEX = 'F' AND T2.UA > 6.5) OR (T1.SEX = 'M' AND T2.UA < 8.0) THEN true ELSE false END FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T1.ID = 57266","SELECT CASE WHEN T1.SEX = 'M' AND T2.UA > 8.0 THEN 'Yes' WHEN T1.SEX = 'F' AND T2.UA > 6.5 THEN 'Yes' ELSE 'No' END AS 'Is_Uric_Acid_Normal' FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T1.ID = 57266"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS 