pair":["SELECT T1.district_id FROM district AS T1 INNER JOIN account AS T2 ON T1.district_id = T2.district_id INNER JOIN trans AS T3 ON T2.account_id = T3.account_id WHERE T3.type = 'VYDAJ' AND T2.date LIKE '1996-01%' ORDER BY A2 ASC LIMIT 10","SELECT T2.A2, T1.amount FROM trans AS T1 INNER JOIN district AS T2 ON T1.account_id = T2.district_id WHERE T1.type = 'VYDAJ' AND STRFTIME('%Y-%m', T1.date) = '1996-01' ORDER BY T1.amount DESC LIMIT 10"],"ddl":"CREATE TABLE IF NOT EXISTS `account` (`account_id` INT, `district_id` INT, `frequency` TEXT, `date` DATE, PRIMARY KEY (`account_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `card` (`card_id` INT, `disp_id` INT, `type` TEXT, `issued` DATE, PRIMARY KEY (`card_id`), FOREIGN KEY (`disp_id`) REFERENCES disp (`disp_id`));CREATE TABLE IF NOT EXISTS `client` (`client_id` INT, `gender` TEXT, `birth_date` DATE, `district_id` INT, PRIMARY KEY (`client_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `disp` (`disp_id` INT, `client_id` INT, `account_id` INT, `type` TEXT, PRIMARY KEY (`disp_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `district` (`district_id` INT, `A2` TEXT, `A3` TEXT, `A4` TEXT, `A5` TEXT, `A6` TEXT, `A7` TEXT, `A8` INT, `A9` INT, `A10` FLOAT, `A11` INT, `A12` FLOAT, `A13` FLOAT, `A14` INT, `A15` INT, `A16` INT, PRIMARY KEY (`district_id`));CREATE TABLE IF NOT EXISTS `loan` (`loan_id` INT, `account_id` INT, `date` DATE, `amount` INT, `duration` INT, `payments` FLOAT, `status` TEXT, PRIMARY KEY (`loan_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `order` (`order_id` INT, `account_id` INT, `bank_to` TEXT, `account_to` INT, `amount` FLOAT, `k_symbol` TEXT, PRIMARY KEY (`order_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `trans` (`trans_id` INT, `account_id` INT, `date` DATE, `type` TEXT, `operation` TEXT, `amount` INT, `balance` INT, `k_symbol` TEXT, `bank` TEXT, `account` INT, PRIMARY KEY (`trans_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`))"}
{"benchmark":"financial","index":131,"schema":{"account":{"account_id":"int","district_id":"int","frequency":"varchar","date":"date"},"card":{"card_id":"int","disp_id":"int","type":"varchar","issued":"date"},"client":{"client_id":"int","gender":"varchar","birth_date":"date","district_id":"int"},"disp":{"disp_id":"int","client_id":"int","account_id":"int","type":"varchar"},"district":{"district_id":"int","A2":"varchar","A3":"varchar","A4":"varchar","A5":"varchar","A6":"varchar","A7":"varchar","A8":"int","A9":"int","A10":"real","A11":"int","A12":"real","A13":"real","A14":"int","A15":"int","A16":"int"},"loan":{"loan_id":"int","account_id":"int","date":"date","amount":"int","duration":"int","payments":"real","status":"varchar"},"order":{"order_id":"int","account_id":"int","bank_to":"varchar","account_to":"int","amount":"real","k_symbol":"varchar"},"trans":{"trans_id":"int","account_id":"int","date":"date","type":"varchar","operation":"varchar","amount":"int","balance":"int","k_symbol":"varchar","bank":"varchar","account":"int"}},"constraint":[{"primary":[{"value":"account__account_id"}]},{"primary":[{"value":"card__card_id"}]},{"primary":[{"value":"client__client_id"}]},{"primary":[{"value":"disp__disp_id"}]},{"primary":[{"value":"district__district_id"}]},{"primary":[{"value":"loan__loan_id"}]},{"primary":[{"value":"order__order_id"}]},{"primary":[{"value":"trans__trans_id"}]},{"foreign":[{"value":"account__district_id"},{"value":"district__district_id"}]},{"foreign":[{"value":"card__disp_id"},{"value":"disp__disp_id"}]},{"foreign":[{"value":"client__district_id"},{"value":"district__district_id"}]},{"foreign":[{"value":"disp__client_id"},{"value":"client__client_id"}]},{"foreign":[{"value":"disp__account_id"},{"value":"account__account_id"}]},{"foreign":[{"value":"loan__account_id"},{"value":"account__account_id"}]},{"foreign":[{"value":"order__account_id"},{"value":"account__account_id"}]},{"foreign":[{"value":"trans__account_id"},{"value":"account__account_id"}]}],"pair":["SELECT COUNT(T3.account_id) FROM district AS T1 INNER JOIN client AS T2 ON T1.district_id = T2.district_id INNER JOIN disp AS T3 ON T2.client_id = T3.client_id WHERE T1.A3 = 'south Bohemia' AND T3.type != 'OWNER'","SELECT COUNT(DISTINCT T1.account_id) FROM account AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id LEFT JOIN disp AS T3 ON T1.account_id = T3.account_id LEFT JOIN card AS T4 ON T3.disp_id = T4.disp_id WHERE T2.A3 = 'South Bohemia' AND T4.card_id IS NULL"],"ddl":"CREATE TABLE IF NOT EXISTS `account` (`account_id` INT, `district_id` INT, `frequency` TEXT, `date` DATE, PRIMARY KEY (`account_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `card` (`card_id` INT, `disp_id` INT, `type` TEXT, `issued` DATE, PRIMARY KEY (`card_id`), FOREIGN KEY (`disp_id`) REFERENCES disp (`disp_id`));CREATE TABLE IF NOT EXISTS `client` (`client_id` INT, `gender` TEXT, `birth_date` DATE, `district_id` INT, PRIMARY KEY (`client_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `disp` (`disp_id` INT, `client_id` INT, `account_id` INT, `type` TEXT, PRIMARY KEY (`disp_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `district` (`district_id` INT, `A2` TEXT, `A3` TEXT, `A4` TEXT, `A5` TEXT, `A6` TEXT, `A7` TEXT, `A8` INT, `A9` INT, `A10` FLOAT, `A11` INT, `A12` FLOAT, `A13` FLOAT, `A14` INT, `A15` INT, `A16` INT, PRIMARY KEY (`district_id`));CREATE TABLE IF NOT EXISTS `loan` (`loan_id` INT, `account_id` INT, `date` DATE, `amount` INT, `duration` INT, `payments` FLOAT, `status` TEXT, PRIMARY KEY (`loan_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `order` (`order_id` INT, `account_id` INT, `bank_to` TEXT, `account_to` INT, `amount` FLOAT, `k_symbol` TEXT, PRIMARY KEY (`order_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `trans` (`trans_id` INT, `account_id` INT, `date` DATE, `type` TEXT, `operation` TEXT, `amount` INT, `balance` INT, `k_symbol` TEXT, `bank` TEXT, `account` INT, PRIMARY KEY (`trans_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`))"}
