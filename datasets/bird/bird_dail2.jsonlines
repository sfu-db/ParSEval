{"benchmark":"toxicology","index":216,"schema":{"atom":{"atom_id":"varchar","molecule_id":"varchar","element":"varchar"},"bond":{"bond_id":"varchar","molecule_id":"varchar","bond_type":"varchar"},"connected":{"atom_id":"varchar","atom_id2":"varchar","bond_id":"varchar"},"molecule":{"molecule_id":"varchar","label":"varchar"}},"constraint":[{"primary":[{"value":"atom__atom_id"}]},{"primary":[{"value":"bond__bond_id"}]},{"primary":[{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"atom__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"bond__molecule_id"},{"value":"molecule__molecule_id"}]},{"foreign":[{"value":"connected__bond_id"},{"value":"bond__bond_id"}]},{"foreign":[{"value":"connected__atom_id2"},{"value":"atom__atom_id"}]},{"foreign":[{"value":"connected__atom_id"},{"value":"atom__atom_id"}]}],"pair":["SELECT COUNT(DISTINCT CASE WHEN T1.element = 'i' THEN T1.atom_id ELSE NULL END) AS iodine_nums , COUNT(DISTINCT CASE WHEN T1.element = 's' THEN T1.atom_id ELSE NULL END) AS sulfur_nums FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id INNER JOIN bond AS T3 ON T2.bond_id = T3.bond_id WHERE T3.bond_type = '-'","SELECT COUNT(DISTINCT atom_id) FROM atom WHERE element IN ('i', 's') AND molecule_id IN ( SELECT molecule_id FROM bond WHERE bond_type = '-' )"],"ddl":"CREATE TABLE IF NOT EXISTS `atom` (`atom_id` TEXT, `molecule_id` TEXT, `element` TEXT, PRIMARY KEY (`atom_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `bond` (`bond_id` TEXT, `molecule_id` TEXT, `bond_type` TEXT, PRIMARY KEY (`bond_id`), FOREIGN KEY (`molecule_id`) REFERENCES molecule (`molecule_id`));CREATE TABLE IF NOT EXISTS `connected` (`atom_id` TEXT, `atom_id2` TEXT, `bond_id` TEXT, FOREIGN KEY (`atom_id`) REFERENCES atom (`atom_id`));CREATE TABLE IF NOT EXISTS `molecule` (`molecule_id` TEXT, `label` TEXT, PRIMARY KEY (`molecule_id`))"}
