pair":["SELECT T3.type FROM district AS T1 INNER JOIN account AS T2 ON T1.district_id = T2.district_id INNER JOIN disp AS T3 ON T2.account_id = T3.account_id WHERE T3.type != 'OWNER' AND T1.A11 BETWEEN 8000 AND 9000","SELECT DISTINCT account.frequency FROM account JOIN district ON account.district_id = district.district_id LEFT JOIN loan ON account.account_id = loan.account_id WHERE loan.account_id IS NULL AND district.A11 > 8000 AND district.A11 <= 9000"],"ddl":"CREATE TABLE IF NOT EXISTS `account` (`account_id` INT, `district_id` INT, `frequency` TEXT, `date` DATE, PRIMARY KEY (`account_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `card` (`card_id` INT, `disp_id` INT, `type` TEXT, `issued` DATE, PRIMARY KEY (`card_id`), FOREIGN KEY (`disp_id`) REFERENCES disp (`disp_id`));CREATE TABLE IF NOT EXISTS `client` (`client_id` INT, `gender` TEXT, `birth_date` DATE, `district_id` INT, PRIMARY KEY (`client_id`), FOREIGN KEY (`district_id`) REFERENCES district (`district_id`));CREATE TABLE IF NOT EXISTS `disp` (`disp_id` INT, `client_id` INT, `account_id` INT, `type` TEXT, PRIMARY KEY (`disp_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `district` (`district_id` INT, `A2` TEXT, `A3` TEXT, `A4` TEXT, `A5` TEXT, `A6` TEXT, `A7` TEXT, `A8` INT, `A9` INT, `A10` FLOAT, `A11` INT, `A12` FLOAT, `A13` FLOAT, `A14` INT, `A15` INT, `A16` INT, PRIMARY KEY (`district_id`));CREATE TABLE IF NOT EXISTS `loan` (`loan_id` INT, `account_id` INT, `date` DATE, `amount` INT, `duration` INT, `payments` FLOAT, `status` TEXT, PRIMARY KEY (`loan_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `order` (`order_id` INT, `account_id` INT, `bank_to` TEXT, `account_to` INT, `amount` FLOAT, `k_symbol` TEXT, PRIMARY KEY (`order_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`));CREATE TABLE IF NOT EXISTS `trans` (`trans_id` INT, `account_id` INT, `date` DATE, `type` TEXT, `operation` TEXT, `amount` INT, `balance` INT, `k_symbol` TEXT, `bank` TEXT, `account` INT, PRIMARY KEY (`trans_id`), FOREIGN KEY (`account_id`) REFERENCES account (`account_id`))"}
