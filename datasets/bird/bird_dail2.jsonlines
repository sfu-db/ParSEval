LE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1170,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT CAST(SUM(CASE WHEN T2.UA <= 8.0 AND T1.SEX = 'M' THEN 1 ELSE 0 END) AS REAL) \/ SUM(CASE WHEN T2.UA <= 6.5 AND T1.SEX = 'F' THEN 1 ELSE 0 END) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID","SELECT CAST(SUM(CASE WHEN SEX = 'M' AND UA <= 8.0 THEN 1 ELSE 0 END) AS REAL) \/ SUM(CASE WHEN SEX = 'F' AND UA <= 6.5 THEN 1 ELSE 0 END) FROM Patient INNER JOIN Laboratory ON Patient.ID = Laboratory.ID"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1171,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 INNER JOIN Examination AS T2 ON T1.ID = T2.ID WHERE T1.Admission = '+' AND STRFTIME('%Y', T2.`Examination Date`) - STRFTIME('%Y', T1.`First Date`) >= 1","SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 LEFT JOIN Examination AS T2 ON T1.ID = T2.ID WHERE strftime('%Y', T2.`Examination Date`) - strftime('%Y', T1.`First Date`) >= 1"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1172,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT COUNT(T1.ID) FROM Patient AS T1 INNER JOIN Examination AS T2 ON T1.ID = T2.ID WHERE STRFTIME('%Y', T2.`Examination Date`) BETWEEN '1990' AND '1993' AND STRFTIME('%Y', T2.`Examination Date`) - STRFTIME('%Y', T1.Birthday) < '18'","SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 INNER JOIN Examination AS T2 ON T1.ID = T2.ID WHERE strftime('%Y', T1.Birthday) > strftime('%Y', T2.`Examination Date`) - 18 AND strftime('%Y', T2.`Examination Date`) BETWEEN '1990' AND '1993'"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1173,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.`T-BIL` >= 2.0 AND T1.SEX = 'M'","SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T1.SEX = 'M' AND T2.`T-BIL` > 2.0"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREA