{"benchmark":"debit_card_specializing","index":1491,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT CAST(SUM(IIF(T2.Consumption > 46.73, 1, 0)) AS FLOAT) * 100 \/ COUNT(T1.CustomerID) FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Segment = 'LAM'","SELECT CAST(SUM(CASE WHEN T2.Consumption > 46.73 THEN 1 ELSE 0 END) AS REAL) * 100 \/ COUNT(*) FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Segment = 'LAM'"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1492,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT Country , ( SELECT COUNT(GasStationID) FROM gasstations WHERE Segment = 'Value for money' ) FROM gasstations WHERE Segment = 'Value for money' GROUP BY Country ORDER BY COUNT(GasStationID) DESC LIMIT 1","SELECT Country, COUNT(*) as NumberOfValueForMoneyStations FROM gasstations WHERE Segment = 'Value for Money' GROUP BY Country "],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
