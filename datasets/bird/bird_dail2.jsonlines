{"benchmark":"debit_card_specializing","index":1472,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT CAST(SUM(IIF(Currency = 'EUR', 1, 0)) AS FLOAT) \/ SUM(IIF(Currency = 'CZK', 1, 0)) FROM customers","SELECT CAST(SUM(IIF(Currency = 'EUR', 1, 0)) AS REAL) \/ SUM(IIF(Currency = 'CZK', 1, 0)) FROM customers"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1473,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT T1.CustomerID FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Segment = 'LAM' AND T2.date BETWEEN 201201 AND 201212 GROUP BY T1.CustomerID ORDER BY SUM(T2.Consumption) ASC LIMIT 1","SELECT T1.CustomerID FROM yearmonth AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T2.Segment = 'LAM' AND T1.Date BETWEEN '201201' AND '201212' ORDER BY T1.Consumption ASC LIMIT 1"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1474,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT AVG(T2.Consumption) \/ 12 FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE SUBSTRING(T2.Date, 1, 4) = '2013' AND T1.Segment = 'SME'","SELECT AVG(Consumption) \/ 12 FROM yearmonth WHERE Date BETWEEN '201301' AND '201312' AND CustomerID IN (SELECT CustomerID FROM customers WHERE Segment = 'SME')"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1475,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT T1.CustomerID FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Currency = 'CZK' AND T2.Date BETWEEN 201101 AND 201112 GROUP BY T1.CustomerID ORDER BY SUM(T2.Consumption) DESC LIMIT 1","SELECT T1.CustomerID, SUM(T2.Consumption) AS Total_Consumption FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Currency = 'CZK' AND STRFTIME('%Y', T2.Date) = '2011' GROUP BY T1.CustomerID ORDER BY Total_Consumption DESC LIMIT 1"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1476,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT COUNT(*) FROM ( SELECT T2.CustomerID FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Segment = 'KAM' AND SUBSTRING(T2.Date, 1, 4) = '2012' GROUP BY T2.CustomerID HAVING SUM(T2.Consumption) < 30000 ) AS t1","SELECT COUNT(DISTINCT CustomerID) FROM yearmonth INNER JOIN customers ON yearmonth.CustomerID = customers.CustomerID WHERE Date BETWEEN '201201' AND '201212' AND Consumption < 30000 AND Segment = 'KAM'"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1477,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT SUM(IIF(T1.Currency = 'CZK', T2.Consumption, 0)) - SUM(IIF(T1.Currency = 'EUR', T2.Consumption, 0)) FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE SUBSTRING(T2.Date, 1, 4) = '2012'","SELECT (SELECT SUM(Consumption) FROM yearmonth AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T2.Currency = 'CZK' AND T1.Date BETWEEN '201201' AND '201212') - (SELECT SUM(Consumption) FROM yearmonth AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T2.Currency = 'EUR' AND T1.Date BETWEEN '201201' AND '201212')"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1478,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT SUBSTRING(T2.Date, 1, 4) FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Currency = 'EUR' GROUP BY SUBSTRING(T2.Date, 1, 4) ORDER BY SUM(T2.Consumption) DESC LIMIT 1","SELECT STRFTIME('%Y', T1.Date) FROM \"transactions_1k\" AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T2.Currency = 'EUR' GROUP BY STRFTIME('%Y', T1.Date) ORDER BY SUM(T1.Amount) DESC LIMIT 1"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES cu