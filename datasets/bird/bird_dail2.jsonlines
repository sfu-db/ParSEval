{"benchmark":"thrombosis_prediction","index":1242,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT SUM(CASE WHEN T2.PLT < 100 THEN 1 ELSE 0 END) - SUM(CASE WHEN T2.PLT > 400 THEN 1 ELSE 0 END) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID","SELECT SUM(CASE WHEN PLT < 100 THEN 1 ELSE 0 END) AS LowerThanNormal, SUM(CASE WHEN PLT > 400 THEN 1 ELSE 0 END) AS HigherThanNormal, SUM(CASE WHEN PLT < 100 THEN 1 ELSE 0 END) - SUM(CASE WHEN PLT > 400 THEN 1 ELSE 0 END) AS Difference FROM Laboratory WHERE PLT IS NOT NULL"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1243,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT DISTINCT T1.ID FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.PLT BETWEEN 100 AND 400 AND STRFTIME('%Y', T2.Date) - STRFTIME('%Y', T1.Birthday) < 50 AND STRFTIME('%Y', T2.Date) = '1984'","SELECT T2.ID, T2.SEX, T2.Birthday, T2.Description, T2.`First Date`, T2.Admission, T2.Diagnosis FROM Laboratory AS T1 INNER JOIN Patient AS T2 ON T1.ID = T2.ID WHERE strftime('%Y', T1.Date) = '1984' AND (strftime('%Y', CURRENT_TIMESTAMP) - strftime('%Y', T2.Birthday)) < 50 AND T1.PLT BETWEEN 100 AND 400"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
{"benchmark":"thrombosis_prediction","index":1244,"schema":{"Examination":{"ID":"int","Examination Date":"date","aCL IgG":"real","aCL IgM":"real","ANA":"int","ANA Pattern":"varchar","aCL IgA":"int","Diagnosis":"varchar","KCT":"varchar","RVVT":"varchar","LAC":"varchar","Symptoms":"varchar","Thrombosis":"int"},"Patient":{"ID":"int","SEX":"varchar","Birthday":"date","Description":"date","First Date":"date","Admission":"varchar","Diagnosis":"varchar"},"Laboratory":{"ID":"int","Date":"date","GOT":"int","GPT":"int","LDH":"int","ALP":"int","TP":"real","ALB":"real","UA":"real","UN":"int","CRE":"real","T-BIL":"real","T-CHO":"int","TG":"int","CPK":"int","GLU":"int","WBC":"real","RBC":"real","HGB":"real","HCT":"real","PLT":"int","PT":"real","APTT":"int","FG":"real","PIC":"int","TAT":"int","TAT2":"int","U-PRO":"varchar","IGG":"int","IGA":"int","IGM":"int","CRP":"varchar","RA":"varchar","RF":"varchar","C3":"int","C4":"int","RNP":"varchar","SM":"varchar","SC170":"varchar","SSA":"varchar","SSB":"varchar","CENTROMEA":"varchar","DNA":"varchar","DNA-II":"int"}},"constraint":[{"primary":[{"value":"Patient__ID"}]},{"foreign":[{"value":"Examination__ID"},{"value":"Patient__ID"}]},{"foreign":[{"value":"Laboratory__ID"},{"value":"Patient__ID"}]}],"pair":["SELECT CAST(SUM(CASE WHEN T2.PT >= 14 AND T1.SEX = 'F' THEN 1 ELSE 0 END) AS REAL) * 100 \/ COUNT(*) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T1.Birthday) > 55","SELECT CAST(SUM(CASE WHEN T2.SEX = 'F' AND T1.PT >= 14 THEN 1 ELSE 0 END) AS REAL) * 100 \/ SUM(CASE WHEN T1.PT >= 14 THEN 1 ELSE 0 END) AS percentage FROM Laboratory AS T1 INNER JOIN Patient AS T2 ON T1.ID = T2.ID WHERE (strftime('%Y', 'now') - strftime('%Y', T2.Birthday)) > 55"],"ddl":"CREATE TABLE IF NOT EXISTS `Examination` (`ID` INT, `Examination Date` DATE, `aCL IgG` FLOAT, `aCL IgM` FLOAT, `ANA` INT, `ANA Pattern` TEXT, `aCL IgA` INT, `Diagnosis` TEXT, `KCT` TEXT, `RVVT` TEXT, `LAC` TEXT, `Symptoms` TEXT, `Thrombosis` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`));CREATE TABLE IF NOT EXISTS `Patient` (`ID` INT, `SEX` TEXT, `Birthday` DATE, `Description` DATE, `First Date` DATE, `Admission` TEXT, `Diagnosis` TEXT, PRIMARY KEY (`ID`));CREATE TABLE IF NOT EXISTS `Laboratory` (`ID` INT, `Date` DATE, `GOT` INT, `GPT` INT, `LDH` INT, `ALP` INT, `TP` FLOAT, `ALB` FLOAT, `UA` FLOAT, `UN` INT, `CRE` FLOAT, `T-BIL` FLOAT, `T-CHO` INT, `TG` INT, `CPK` INT, `GLU` INT, `WBC` FLOAT, `RBC` FLOAT, `HGB` FLOAT, `HCT` FLOAT, `PLT` INT, `PT` FLOAT, `APTT` INT, `FG` FLOAT, `PIC` INT, `TAT` INT, `TAT2` INT, `U-PRO` TEXT, `IGG` INT, `IGA` INT, `IGM` INT, `CRP` TEXT, `RA` TEXT, `RF` TEXT, `C3` INT, `C4` INT, `RNP` TEXT, `SM` TEXT, `SC170` TEXT, `SSA` TEXT, `SSB` TEXT, `CENTROMEA` TEXT, `DNA` TEXT, `DNA-II` INT, FOREIGN KEY (`ID`) REFERENCES Patient (`ID`))"}
