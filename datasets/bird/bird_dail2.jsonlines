{"benchmark":"debit_card_specializing","index":1500,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT SUM(T2.Consumption) \/ 12 AS MonthlyConsumption FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Currency = 'EUR' GROUP BY T1.CustomerID ORDER BY MonthlyConsumption DESC LIMIT 1","SELECT MAX(SUM(Consumption)\/12) FROM yearmonth AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T2.Currency = 'Euro'"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
{"benchmark":"debit_card_specializing","index":1501,"schema":{"customers":{"CustomerID":"int","Segment":"varchar","Currency":"varchar"},"gasstations":{"GasStationID":"int","ChainID":"int","Country":"varchar","Segment":"varchar"},"products":{"ProductID":"int","Description":"varchar"},"transactions_1k":{"TransactionID":"int","Date":"date","Time":"varchar","CustomerID":"int","CardID":"int","GasStationID":"int","ProductID":"int","Amount":"int","Price":"real"},"yearmonth":{"CustomerID":"int","Date":"varchar","Consumption":"real"}},"constraint":[{"primary":[{"value":"customers__CustomerID"}]},{"primary":[{"value":"gasstations__GasStationID"}]},{"primary":[{"value":"products__ProductID"}]},{"primary":[{"value":"transactions_1k__TransactionID"}]},{"foreign":[{"value":"yearmonth__CustomerID"},{"value":"customers__CustomerID"}]}],"pair":["SELECT T3.Description FROM transactions_1k AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID INNER JOIN products AS T3 ON T1.ProductID = T3.ProductID WHERE T2.Date = '201309'","SELECT p.Description FROM products AS p INNER JOIN transactions_1k AS t ON p.ProductID = t.ProductID WHERE SUBSTR(t.Date, 1, 6) = '201309'"],"ddl":"CREATE TABLE IF NOT EXISTS `customers` (`CustomerID` INT, `Segment` TEXT, `Currency` TEXT, PRIMARY KEY (`CustomerID`));CREATE TABLE IF NOT EXISTS `gasstations` (`GasStationID` INT, `ChainID` INT, `Country` TEXT, `Segment` TEXT, PRIMARY KEY (`GasStationID`));CREATE TABLE IF NOT EXISTS `products` (`ProductID` INT, `Description` TEXT, PRIMARY KEY (`ProductID`));CREATE TABLE IF NOT EXISTS `transactions_1k` (`TransactionID` INT, `Date` DATE, `Time` TEXT, `CustomerID` INT, `CardID` INT, `GasStationID` INT, `ProductID` INT, `Amount` INT, `Price` FLOAT, PRIMARY KEY (`TransactionID`));CREATE TABLE IF NOT EXISTS `yearmonth` (`CustomerID` INT, `Date` TEXT, `Consumption` FLOAT, FOREIGN KEY (`CustomerID`) REFERENCES customers (`CustomerID`))"}
